              <span>Access control</span>
            </article>

            <article>
              <span>Integrity verification</span>
            </article>
          </div>
        </div>
      </section>


      <section className={styles.completePathSection}>
        <div className={styles.shell}>
          <div className={styles.sectionIntro}>
            <p className={styles.blueEyebrow}>
              COMPLETE GOVERNANCE PATH
            </p>

            <h2>
              <span className={styles.keepLine}>
                Follow one AI activity from actor
              </span>

              <span className={styles.keepLine}>
                identity to durable evidence.
              </span>
            </h2>
          </div>


          <div className={styles.completePath}>
            {receiptPath.map((stage) => (
              <article key={stage.number}>
                <span>{stage.number}</span>
                <strong>{stage.label}</strong>
                <p>{stage.value}</p>
              </article>
            ))}

            <article className={styles.completeReceipt}>
              <span>11</span>
              <strong>Governance Receipt</strong>
              <p>GR-84291</p>
            </article>
          </div>


          <p className={styles.darkStatement}>
            One activity. One connected governance path.
            One durable evidence record.
          </p>
        </div>
      </section>


      <section className={styles.modelSection}>
        <div className={styles.shell}>
          <div className={styles.editorialGrid}>
            <div>
              <p className={styles.goldEyebrow}>
                THE AIGO-OS GOVERNANCE MODEL
              </p>

              <h2 className={styles.darkHeadline}>
                <span className={styles.keepLine}>
                  Governance Receipts are the evidence
                </span>

                <span className={styles.keepLine}>
                  endpoint of the governance process.
                </span>
              </h2>
            </div>

            <div className={styles.darkCopy}>
              <p>
                The receipt is meaningful because the
                preceding governance capabilities created
                the context behind it.
              </p>
            </div>
          </div>


          <div className={styles.platformRail}>
            {platformStages.map((stage, index) => (
              <article
                key={stage}
                className={
                  index === 5
                    ? styles.platformStageActive
                    : styles.platformStageComplete
                }
              >
                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                <strong>{stage}</strong>

                <small>
                  {index === 5
                    ? "Evidence preserved"
                    : "Governance context established"}
                </small>
              </article>
            ))}
          </div>
        </div>
      </section>


      <section className={styles.finalCta}>
        <div
          className={styles.finalGlow}
          aria-hidden="true"
        />

        <div className={styles.finalInner}>
          <p className={styles.blueEyebrow}>
            GOVERNANCE RECEIPTS
          </p>

          <h2>
            <span className={styles.keepLine}>
              Make AI governance explainable
            </span>

            <span className={styles.keepLine}>
              after the decision.
            </span>
          </h2>

          <p>
            Preserve the actor, authority, Business
            Significance, governance requirements,
            decision, human intervention and outcome
            behind consequential AI activity.
          </p>

          <div className={styles.heroActions}>
            <Link
              href="/demo"
              className={styles.primaryButton}
            >
              Request a Demo
            </Link>

            <Link
              href="/solutions/governance-compliance"
              className={styles.secondaryButton}
            >
              Explore AI Governance and Compliance
            </Link>
          </div>
        </div>
      </section>
    </div>
  );
}
