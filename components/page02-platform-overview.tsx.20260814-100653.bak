                <strong>Apply conditions or controls</strong>
              </article>

              <article
                className={
                  activeCapability === "human"
                    ? styles.outcomeActive
                    : undefined
                }
              >
                <CircleUserRound size={21} aria-hidden="true" />
                <span>HUMAN AUTHORITY</span>
                <strong>Route accountable intervention</strong>
              </article>

              <article
                className={
                  activeCapability === "receipts"
                    ? styles.outcomeActive
                    : undefined
                }
              >
                <FileCheck2 size={21} aria-hidden="true" />
                <span>EVIDENCE</span>
                <strong>Preserve governance receipt</strong>
              </article>
            </div>
          </div>
        </div>
      </section>


      <section className={styles.operatingModel}>
        <div className={styles.shell}>
          <div className={styles.centerHeading}>
            <p className={styles.goldEyebrow}>
              HOW THE PLATFORM OPERATES
            </p>

            <h2>
              Connect context. Determine governance.
              Preserve evidence.
            </h2>
          </div>

          <div className={styles.stageGrid}>
            {architectureStages.map((stage) => {
              const Icon = stage.icon;

              return (
                <article
