                        {tag}
                      </span>
                    ))}

                    <i aria-hidden="true" />
                  </div>
                </article>
              );
            })}
          </div>
        </div>
      </section>


      <section className={styles.advantages}>
        <div className={styles.shell}>
          <div className={styles.sectionIntro}>
            <div>
              <p className={styles.blueEyebrow}>
                WHY AIGO-OS IS DIFFERENT
              </p>

              <h2>
                Governance architecture built
                for AI that participates in operations.
              </h2>
            </div>

            <p>
              Enterprise AI can act through applications,
              tools, APIs and business processes. AIGO-OS
              keeps governance connected to the identity,
              authority and enterprise meaning of that activity.
            </p>
          </div>

          <div className={styles.advantageGrid}>
            {advantages.map((item) => {
              const Icon = item.icon;

              return (
                <article
                  className={styles.advantageCard}
                  key={item.title}
                >
                  <div className={styles.advantageIcon}>
                    <Icon size={22} aria-hidden="true" />
                  </div>

                  <h3>{item.title}</h3>

                  <p>{item.description}</p>
                </article>
              );
            })}
          </div>
        </div>
      </section>


      <section className={styles.capabilities}>
        <div className={styles.shell}>
          <div className={styles.centerHeading}>
            <p className={styles.goldEyebrow}>
              PLATFORM CAPABILITIES
            </p>

            <h2>
              One platform. Six connected
              governance capabilities.
            </h2>

            <p>
              Each capability answers a different governance
              question, but they operate together around the
              same AI actor and activity.
            </p>
          </div>

          <div className={styles.capabilityGrid}>
            {capabilityLinks.map((item) => {
              const Icon = item.icon;

              return (
                <Link
