"use client";

import { useEffect, useMemo, useState } from "react";
import Link from "next/link";
import {
  ArrowRight,
  BadgeCheck,
  Blocks,
  BookOpenCheck,
  Bot,
  BrainCircuit,
  Building2,
  Check,
  CircleUserRound,
  FileCheck2,
  Fingerprint,
  GitBranch,
  Network,
  Scale,
  ShieldCheck,
  Sparkles,
  Workflow,
} from "lucide-react";

import styles from "@/styles/page02-platform-overview.module.css";

type CapabilityKey =
  | "passport"
  | "authority"
  | "significance"
  | "decisioning"
  | "human"
  | "receipts";

const capabilityOrder: CapabilityKey[] = [
  "passport",
  "authority",
  "significance",
  "decisioning",
  "human",
  "receipts",
];

const architectureCapabilities = {
  passport: {
    label: "Actor Passports",
    caption: "Resolve technical identity",
    icon: Fingerprint,
    input: ["Agent identity", "Service identity"],
    output: ["Persistent actor", "Governance context"],
  },
  authority: {
    label: "Machine Authority",
    caption: "Evaluate delegated autonomy",
    icon: ShieldCheck,
    input: ["Permissions", "Delegation"],
    output: ["Allowed scope", "Operating limits"],
  },
  significance: {
    label: "Business Significance",
    caption: "Interpret enterprise meaning",
    icon: BrainCircuit,
    input: ["Business process", "Risk and policy"],
    output: ["Materiality", "Business impact"],
  },
  decisioning: {
    label: "Governance Decisioning",
    caption: "Determine what applies now",
    icon: Scale,
    input: ["Current activity", "Governance context"],
    output: ["Allow or constrain", "Review or escalate"],
  },
  human: {
    label: "Human Authority",
    caption: "Resolve accountable intervention",
    icon: CircleUserRound,
    input: ["Decision boundary", "Authority owner"],
    output: ["Human judgment", "Accountable action"],
  },
  receipts: {
    label: "Governance Receipts",
    caption: "Preserve reconstructable evidence",
    icon: FileCheck2,
    input: ["Decision context", "Outcome"],
    output: ["Evidence history", "Assurance record"],
  },
} satisfies Record<
  CapabilityKey,
  {
    label: string;
    caption: string;
    icon: typeof Fingerprint;
    input: string[];
    output: string[];
  }
>;

const capabilityLinks = [
  {
    number: "01",
    eyebrow: "ACTOR CONTEXT",
    title: "Actor Passports",
    description:
      "Connect technical AI identity, platform relationships and service representations to one persistent governance identity.",
    href: "/product/actor-passports",
    icon: Fingerprint,
  },
  {
    number: "02",
    eyebrow: "AUTHORITY",
    title: "Machine Authority",
    description:
      "Define and evaluate what autonomy has actually been delegated to an AI actor, including scope, limits and conditions.",
    href: "/product/authority",
    icon: ShieldCheck,
  },
  {
    number: "03",
    eyebrow: "BUSINESS CONTEXT",
    title: "Business Significance",
    description:
      "Determine what an AI activity means to the enterprise by connecting purpose, ownership, impact, risk and business context.",
    href: "/product/business-significance",
    icon: BrainCircuit,
  },
  {
    number: "04",
    eyebrow: "GOVERNANCE",
    title: "Governance Decisioning",
    description:
      "Determine the governance response appropriate to the actor, activity, delegated authority and current enterprise context.",
    href: "/product/governance-decisioning",
    icon: Scale,
  },
  {
    number: "05",
    eyebrow: "HUMAN AUTHORITY",
    title: "Human Authority & Intervention",
    description:
      "Bring accountable human judgment into the operating path when delegated machine authority is no longer sufficient.",
    href: "/product/human-authority",
    icon: CircleUserRound,
  },
  {
    number: "06",
    eyebrow: "EVIDENCE",
    title: "Governance Receipts",
    description:
      "Preserve the context, reasoning, authority, outcome and evidence required to reconstruct consequential governance decisions.",
    href: "/product/governance-receipts",
    icon: FileCheck2,
  },
];

const architectureStages = [
  {
    eyebrow: "01",
    title: "Connect context",
    description:
      "Resolve the AI actor and connect technical identity, enterprise relationships, purpose, ownership, authority, policy and operating context.",
    icon: Network,
    tags: ["Actor", "Identity", "Purpose", "Authority"],
  },
  {
    eyebrow: "02",
    title: "Determine governance",
    description:
      "Interpret what the activity means now and determine whether autonomy remains appropriate, conditions apply or accountable intervention is required.",
    icon: Workflow,
    tags: ["Activity", "Significance", "Decision", "Human authority"],
  },
  {
    eyebrow: "03",
    title: "Preserve evidence",
    description:
      "Keep the context behind consequential decisions connected so governance outcomes can be reconstructed and explained later.",
    icon: BookOpenCheck,
    tags: ["Reasoning", "Outcome", "Receipt", "Assurance"],
  },
];

const advantages = [
  {
    title: "Identity before governance",
    description:
      "AIGO-OS governs persistent actors rather than treating fragmented technical identifiers as separate governance subjects.",
    icon: Fingerprint,
  },
  {
    title: "Authority beyond access",
    description:
      "Technical permission does not by itself determine whether an AI actor should perform an action in its current context.",
    icon: ShieldCheck,
  },
  {
    title: "Business context changes the decision",
    description:
      "The same technical action can require a different response when purpose, business process, risk, ownership or impact changes.",
    icon: Building2,
  },
  {
    title: "Human authority is part of the system",
    description:
      "Accountable intervention is an explicit governance state when autonomous authority reaches its limit.",
    icon: CircleUserRound,
  },
  {
    title: "Evidence is generated with governance",
    description:
      "Governance Receipts preserve enough context to reconstruct what was understood, what was decided and why.",
    icon: FileCheck2,
  },
  {
    title: "Built to integrate, not replace",
    description:
      "AIGO-OS uses relevant context from enterprise platforms and connects governance outcomes to supported operating paths.",
    icon: Blocks,
  },
];

export function Page02PlatformOverview() {
  const [activeCapability, setActiveCapability] =
    useState<CapabilityKey>("passport");

  useEffect(() => {
    const timer = window.setInterval(() => {
      setActiveCapability((current) => {
        const currentIndex = capabilityOrder.indexOf(current);
        const nextIndex = (currentIndex + 1) % capabilityOrder.length;
        return capabilityOrder[nextIndex];
      });
    }, 2800);

    return () => window.clearInterval(timer);
  }, []);

  const active = useMemo(
    () => architectureCapabilities[activeCapability],
    [activeCapability],
  );

  return (
    <div className={styles.page}>
      <section className={styles.hero}>
        <div className={styles.heroGrid} aria-hidden="true" />
        <div className={styles.heroGlow} aria-hidden="true" />

        <div className={styles.shell}>
          <div className={styles.heroLayout}>
            <div className={styles.heroCopy}>
              <p className={styles.blueEyebrow}>
                AIGO-OS PLATFORM
              </p>

              <h1 className={styles.heroTitle}>
                <span>
                  The governance operating system
                </span>

                <span>
                  for consequential enterprise AI.
                </span>
              </h1>

              <p className={styles.heroLead}>
                AIGO-OS connects AI systems, enterprise context
                and accountable authority so governance can
                respond to what AI activity actually means as
                it happens.
              </p>

              <div className={styles.heroActions}>
                <Link
                  className={styles.primaryButton}
                  href="/contact?intent=demo"
                >
                  Request a Demo
                  <ArrowRight size={18} aria-hidden="true" />
                </Link>

                <a
                  className={styles.secondaryButton}
                  href="#platform-architecture"
                >
                  See Platform Architecture
                  <ArrowRight size={18} aria-hidden="true" />
                </a>
              </div>

              <div className={styles.heroPrinciples}>
                <span>
                  <Check size={15} aria-hidden="true" />
                  Persistent identity
                </span>

                <span>
                  <Check size={15} aria-hidden="true" />
                  Delegated authority
                </span>

                <span>
                  <Check size={15} aria-hidden="true" />
                  Contextual governance
                </span>

                <span>
                  <Check size={15} aria-hidden="true" />
                  Reconstructable evidence
                </span>
              </div>
            </div>

            <div
              className={styles.heroPlatformVisual}
              aria-label="AIGO-OS platform architecture preview"
            >
              <div className={styles.previewSources}>
                <div>
                  <span>AI SYSTEMS</span>
                  <strong>Agents</strong>
                  <strong>Applications</strong>
                  <strong>Models</strong>
                </div>

                <div>
                  <span>ENTERPRISE CONTEXT</span>
                  <strong>Identity</strong>
                  <strong>Business systems</strong>
                  <strong>Risk and policy</strong>
                </div>
              </div>

              <div className={styles.previewConnector}>
                <i />
                <b />
              </div>

              <div className={styles.previewCore}>
                <div className={styles.previewCoreHeader}>
                  <span>GOVERNANCE OPERATING SYSTEM</span>
                  <strong>AIGO-OS</strong>
                </div>

                <div className={styles.previewCapabilityGrid}>
                  <span>Actor</span>
                  <span>Authority</span>
                  <span>Significance</span>
                  <span>Decisioning</span>
                  <span>Human authority</span>
                  <span>Receipts</span>
                </div>

                <div className={styles.previewOutcome}>
                  <span>GOVERNED OUTCOME</span>
                  <strong>
                    Context determines the governance path.
                  </strong>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <section
        className={styles.architecture}
        id="platform-architecture"
      >
        <div className={styles.shell}>
          <div className={styles.sectionIntro}>
            <div>
              <p className={styles.goldEyebrow}>
                PLATFORM ARCHITECTURE
              </p>

              <h2>
                One governance layer across
                connected enterprise AI.
              </h2>
            </div>

            <p>
              AIGO-OS does not replace the systems that operate,
              observe, secure or manage enterprise AI. It brings
              the relevant context from those systems together
              around the governance of each consequential
              activity.
            </p>
          </div>

          <div className={styles.architectureBoard}>
            <div className={styles.architectureInputs}>
              <article
                className={
                  active.input.some((item) =>
                    [
                      "Agent identity",
                      "Service identity",
                      "Permissions",
                      "Delegation",
                      "Current activity",
                    ].includes(item),
                  )
                    ? styles.contextCardActive
                    : undefined
                }
              >
                <div className={styles.contextIcon}>
                  <Bot size={20} aria-hidden="true" />
                </div>

                <span>AI SYSTEMS</span>

                <strong>Technical operating context</strong>

                <div className={styles.contextTags}>
                  <b>AI agents</b>
                  <b>Applications</b>
                  <b>Models</b>
                  <b>Automations</b>
                  <b>AI platforms</b>
                  <b>Service identities</b>
                </div>
              </article>

              <article
                className={
                  active.input.some((item) =>
                    [
                      "Business process",
                      "Risk and policy",
                      "Governance context",
                      "Authority owner",
                    ].includes(item),
                  )
                    ? styles.contextCardActive
                    : undefined
                }
              >
                <div className={styles.contextIcon}>
                  <Building2 size={20} aria-hidden="true" />
                </div>

                <span>ENTERPRISE CONTEXT</span>

                <strong>Business and governance context</strong>

                <div className={styles.contextTags}>
                  <b>Identity and access</b>
                  <b>Business systems</b>
                  <b>Security</b>
                  <b>Observability</b>
                  <b>Policy and GRC</b>
                  <b>Human ownership</b>
                </div>
              </article>
            </div>

            <div className={styles.architectureFlow}>
              <span>CONTEXT</span>
              <i />
              <b />
            </div>

            <div className={styles.architectureCore}>
              <div className={styles.coreHeading}>
                <div>
                  <span>AI GOVERNANCE OPERATING SYSTEM</span>
                  <strong>AIGO-OS</strong>
