                  <span>ESTABLISHES</span>
                  {active.output.map((item) => (
                    <b key={item}>{item}</b>
                  ))}
                </div>
              </div>
            </div>

            <div className={styles.architectureFlow}>
              <span>GOVERNANCE PATH</span>
              <i />
              <b />
            </div>

            <div className={styles.outcomeGrid}>
              <article
                className={
                  activeCapability === "authority" ||
                  activeCapability === "decisioning"
                    ? styles.outcomeActive
                    : undefined
