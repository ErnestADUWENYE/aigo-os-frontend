                  <div className={styles.stageTop}>
                    <span>{stage.eyebrow}</span>

                    <div>
                      <Icon size={22} aria-hidden="true" />
                    </div>
                  </div>

                  <h3>{stage.title}</h3>

                  <p>{stage.description}</p>

                  <div className={styles.stageVisual}>
                    {stage.tags.map((tag, index) => (
                      <span
                        className={index === 1 ? styles.stageTagActive : ""}
