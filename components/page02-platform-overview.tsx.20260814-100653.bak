                >
                  <div className={styles.capabilityCardTop}>
                    <span>{item.number}</span>

                    <div>
                      <Icon size={20} aria-hidden="true" />
                    </div>
                  </div>

                  <p className={styles.capabilityEyebrow}>
                    {item.eyebrow}
                  </p>

                  <h3>{item.title}</h3>

                  <p>{item.description}</p>

                  <strong>
                    Explore capability
                    <ArrowRight size={17} aria-hidden="true" />
                  </strong>
                </Link>
              );
            })}
          </div>
        </div>
      </section>


      <section className={styles.integration}>
        <div className={styles.shell}>
          <div className={styles.integrationPanel}>
            <div>
              <p className={styles.goldEyebrow}>
                BUILT FOR THE ENTERPRISE STACK
              </p>

              <h2>
                AIGO-OS integrates with the systems
                already operating your enterprise.
              </h2>

              <p>
                Identity, observability, security, business
                applications and GRC systems remain important.
                AIGO-OS connects relevant context from those
                platforms to the continuous governance of
                enterprise AI.
              </p>
            </div>

            <div className={styles.integrationVisual}>
              <div className={styles.enterpriseColumn}>
                <span>ENTERPRISE SYSTEMS</span>

                <b>Identity and access</b>
                <b>Security</b>
                <b>Observability</b>
                <b>Business systems</b>
                <b>Policy and GRC</b>
              </div>

              <div className={styles.integrationBridge}>
                <i />
                <Network size={25} aria-hidden="true" />
                <i />
              </div>

              <div className={styles.aigoColumn}>
                <span>GOVERNANCE OPERATING LAYER</span>

                <strong>AIGO-OS</strong>

                <div>
                  <b>Actor</b>
                  <b>Authority</b>
                  <b>Significance</b>
                  <b>Decision</b>
                  <b>Human authority</b>
                  <b>Evidence</b>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <section className={styles.finalCta}>
        <div className={styles.shell}>
          <div className={styles.finalPanel}>
            <div>
              <p className={styles.blueEyebrow}>
                SEE AIGO-OS IN YOUR ENVIRONMENT
              </p>

              <h2>
                See how connected governance changes
                the way enterprise AI can operate.
              </h2>
            </div>

            <div>
              <p>
                Explore how AIGO-OS connects actor identity,
