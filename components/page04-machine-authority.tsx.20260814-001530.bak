"use client";
import { useEffect, useState } from "react";
import Link from "next/link";

import {
  ArrowRight,
  Bot,
  Check,
  CircleAlert,
  CloudCog,
  Fingerprint,
  Gauge,
  KeyRound,
  Network,
  ShieldCheck,
  SlidersHorizontal,
  UserRoundCheck,
  X,
} from "lucide-react";

import styles from "@/styles/page04-machine-authority.module.css";

type AuthorityState =
  | "allowed"
  | "conditional"
  | "outside";

const authoritySequence: AuthorityState[] = [
  "allowed",
  "conditional",
  "outside",
];

const authorityActions = [
  {
    label: "Inspect production telemetry",
    detail: "Autonomous",
    state: "allowed" as AuthorityState,
  },
  {
    label: "Restart approved service",
    detail: "Autonomous",
    state: "allowed" as AuthorityState,
  },
  {
    label: "Change production configuration",
    detail: "Conditions apply",
    state: "conditional" as AuthorityState,
  },
  {
    label: "Deploy new application version",
    detail: "Human authority required",
    state: "conditional" as AuthorityState,
  },
  {
    label: "Disable security controls",
    detail: "Not delegated",
    state: "outside" as AuthorityState,
  },
  {
    label: "Expand its own authority",
    detail: "Not delegated",
    state: "outside" as AuthorityState,
  },
];

const authorityDimensions = [
  {
    number: "01",
    title: "Actor",
    description:
      "Which governed AI actor has received the authority.",
    icon: Fingerprint,
  },
  {
    number: "02",
    title: "Permitted actions",
    description:
      "Which business or operational actions may be exercised autonomously.",
    icon: Check,
  },
  {
    number: "03",
    title: "Scope",
    description:
      "Which systems, resources, environments or business areas the authority covers.",
    icon: Network,
  },
  {
    number: "04",
    title: "Conditions and limits",
    description:
      "The circumstances, thresholds and boundaries that constrain autonomous operation.",
    icon: SlidersHorizontal,
  },
];

export function Page04MachineAuthority() {
  const [activeState, setActiveState] =
    useState<AuthorityState>("allowed");

  useEffect(() => {
    const timer = window.setInterval(() => {
      setActiveState((current) => {
        const index =
          authoritySequence.indexOf(current);

        return authoritySequence[
          (index + 1) % authoritySequence.length
        ];
      });
    }, 2400);

    return () => window.clearInterval(timer);
  }, []);

  return (
    <main className={styles.page}>
      <section className={styles.hero}>
        <div
          className={styles.heroGrid}
          aria-hidden="true"
        />

        <div
          className={styles.heroGlow}
          aria-hidden="true"
        />

        <div className={styles.shell}>
          <div className={styles.heroLayout}>
            <div className={styles.heroCopy}>
              <p className={styles.heroEyebrow}>
                MACHINE AUTHORITY
              </p>

              <h1 className={styles.heroTitle}>
                <span>
                  Define what autonomous AI
                </span>

                <span>
                  is actually authorized to do.
                </span>
              </h1>

              <p className={styles.heroLead}>
                Technical access tells you what an AI
                actor can execute. Machine Authority
                establishes what the enterprise has
                actually delegated to that actor.
              </p>

              <p className={styles.heroBody}>
                AIGO-OS represents permitted actions,
                operating scope, conditions, limits and
                boundaries so autonomous AI can operate
                within authority the enterprise has
                explicitly established.
              </p>

              <div className={styles.heroButtons}>
                <Link
                  href="/contact?intent=demo"
                  className={styles.primaryButton}
                >
                  Request a Demo
                  <ArrowRight
                    size={18}
                    aria-hidden="true"
                  />
                </Link>

                <a
                  href="#authority-gap"
                  className={styles.secondaryButton}
                >
                  See the authority boundary
                  <ArrowRight
                    size={18}
                    aria-hidden="true"
                  />
                </a>
              </div>

              <div className={styles.heroChecks}>
                <span>
                  <Check
                    size={15}
                    aria-hidden="true"
                  />
                  Explicit delegated autonomy
                </span>

                <span>
                  <Check
                    size={15}
                    aria-hidden="true"
                  />
                  Defined operating scope
                </span>

                <span>
                  <Check
                    size={15}
                    aria-hidden="true"
                  />
                  Clear human boundaries
                </span>
              </div>
            </div>


            <div className={styles.heroVisualWrap}>
              <div className={styles.authorityVisual}>
                <div className={styles.visualHeader}>
                  <div>
                    <span>
                      LIVE AUTHORITY MODEL
                    </span>

                    <strong>
                      Production Operations Agent
                    </strong>
                  </div>

                  <div className={styles.liveStatus}>
                    <i />
                    AUTHORITY ACTIVE
                  </div>
                </div>

                <div className={styles.visualCanvas}>
                  <div className={styles.actorCore}>
                    <div className={styles.actorIcon}>
                      <Bot
                        size={23}
                        aria-hidden="true"
                      />
                    </div>

                    <span>AI ACTOR</span>

                    <strong>ops-agent-17</strong>

                    <small>
                      Actor Passport connected
                    </small>
                  </div>

                  <div className={styles.boundary}>
                    <span
                      className={styles.boundaryLabel}
                    >
                      DELEGATED MACHINE AUTHORITY
                    </span>

                    {authorityActions.map(
                      (action, index) => {
                        const active =
                          activeState ===
                          action.state;

                        return (
                          <button
                            key={action.label}
                            type="button"
                            onClick={() =>
                              setActiveState(
                                action.state
                              )
                            }
                            className={[
                              styles.actionNode,
                              styles[
                                `actionNode${index + 1}`
                              ],
                              styles[
                                `actionNode_${action.state}`
                              ],
                              active
                                ? styles.actionNodeActive
                                : "",
                            ].join(" ")}
                          >
                            <span
                              className={
                                styles.actionIcon
                              }
                            >
                              {action.state ===
                              "allowed" ? (
                                <Check
                                  size={12}
                                  aria-hidden="true"
                                />
                              ) : action.state ===
                                "conditional" ? (
                                <CircleAlert
                                  size={12}
                                  aria-hidden="true"
                                />
                              ) : (
                                <X
                                  size={12}
                                  aria-hidden="true"
                                />
                              )}
                            </span>

                            <span
                              className={
                                styles.actionText
                              }
                            >
                              <strong>
                                {action.label}
                              </strong>

                              <small>
                                {action.detail}
                              </small>
                            </span>
                          </button>
                        );
                      }
                    )}
                  </div>
                </div>

                <div className={styles.legend}>
                  <button
                    type="button"
                    onClick={() =>
                      setActiveState("allowed")
                    }
                    className={
                      activeState === "allowed"
                        ? styles.legendActive
                        : ""
                    }
                  >
                    <i
                      className={styles.greenDot}
                    />
                    Within authority
                  </button>

                  <button
                    type="button"
                    onClick={() =>
                      setActiveState("conditional")
                    }
                    className={
                      activeState ===
                      "conditional"
                        ? styles.legendActive
                        : ""
                    }
                  >
                    <i
                      className={styles.goldDot}
                    />
                    Boundary condition
                  </button>

                  <button
                    type="button"
                    onClick={() =>
                      setActiveState("outside")
                    }
                    className={
                      activeState === "outside"
                        ? styles.legendActive
                        : ""
                    }
                  >
                    <i
                      className={styles.redDot}
                    />
                    Outside authority
                  </button>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>


      <section
        className={styles.lightSection}
        id="authority-gap"
      >
        <div className={styles.shell}>
          <div className={styles.splitHeading}>
            <div>
              <p className={styles.goldEyebrow}>
                THE AUTHORITY GAP
              </p>

              <h2>
                <span>
                  Technical permission does not
                </span>

                <span>
                  establish business authority.
                </span>
              </h2>
            </div>

            <p>
              An AI actor may have credentials, API
              access and technical permissions that
              support many possible actions. The
              enterprise may intend that actor to use
              only a defined subset under specific
              operating conditions.
            </p>
          </div>


          <div className={styles.accessComparison}>
            <article className={styles.largeCard}>
              <div className={styles.cardLabel}>
                <span className={styles.iconWell}>
                  <KeyRound
                    size={20}
                    aria-hidden="true"
                  />
                </span>

                <strong>
                  TECHNICAL ACCESS
                </strong>
              </div>

              <h3>
                What the connected systems permit
              </h3>

              <div className={styles.rows}>
                <div>
                  <span>Cloud API</span>
                  <strong>Accessible</strong>
                </div>

                <div>
                  <span>Deployment service</span>
                  <strong>Execute</strong>
                </div>

                <div>
                  <span>
                    Production configuration
                  </span>

                  <strong>Write access</strong>
                </div>

                <div>
                  <span>
                    Infrastructure controls
                  </span>

                  <strong>Available</strong>
                </div>
              </div>

              <p className={styles.cardFoot}>
                Access controls answer whether an
                identity can technically reach or
                operate a resource.
              </p>
            </article>


            <div
              className={styles.bridge}
              aria-hidden="true"
            >
              <i />
              <ShieldCheck size={24} />
              <i />
            </div>


            <article
              className={`${styles.largeCard} ${styles.largeCardActive}`}
            >
              <div className={styles.cardLabel}>
                <span className={styles.iconWell}>
                  <ShieldCheck
                    size={20}
                    aria-hidden="true"
                  />
                </span>

                <strong>
                  AIGO-OS MACHINE AUTHORITY
                </strong>
              </div>

              <h3>
                What the enterprise has delegated
              </h3>

              <div className={styles.rows}>
                <div>
                  <span>Purpose</span>

                  <strong>
                    Production operations
                  </strong>
                </div>

                <div>
                  <span>Autonomous action</span>

                  <strong>
                    Restart approved services
                  </strong>
                </div>

                <div>
                  <span>Environment</span>
                  <strong>Production</strong>
                </div>

                <div>
                  <span>Boundary</span>

                  <strong>
                    Deployment requires human authority
                  </strong>
                </div>
              </div>

              <p className={styles.cardFoot}>
                Machine Authority answers whether the
                actor is authorized to exercise a
                capability within its delegated scope.
              </p>
            </article>
          </div>


          <div className={styles.noteCard}>
            <KeyRound
              size={20}
              aria-hidden="true"
            />

            <div>
              <strong>
                Access answers whether execution is
                technically possible.
              </strong>

              <p>
                Machine Authority answers whether
                autonomous exercise of that capability
                has actually been delegated.
              </p>
            </div>
          </div>
        </div>
      </section>


      <section className={styles.modelSection}>
        <div className={styles.shell}>
          <div className={styles.centerHeading}>
            <p className={styles.blueEyebrow}>
              AUTHORITY MODEL
            </p>

            <h2>
              <span>
                Make delegated autonomy
              </span>

              <span>
                explicit and governable.
              </span>
            </h2>

            <p>
              Machine Authority is more than a list of
              permitted actions. It records who
              received authority, what was delegated,
              where that authority applies and the
              conditions under which autonomous
              operation remains valid.
            </p>
          </div>

          <div className={styles.fourCards}>
            {authorityDimensions.map((item) => {
              const Icon = item.icon;

              return (
                <article
                  className={styles.standardCard}
                  key={item.number}
                >
                  <div className={styles.cardTop}>
                    <span>{item.number}</span>

                    <span className={styles.iconWell}>
                      <Icon
                        size={21}
                        aria-hidden="true"
                      />
                    </span>
                  </div>

                  <h3>{item.title}</h3>

                  <p>{item.description}</p>
                </article>
              );
            })}
          </div>
        </div>
      </section>


      <section className={styles.darkSection}>
        <div className={styles.shell}>
          <div className={styles.scenarioLayout}>
            <div className={styles.scenarioCopy}>
              <p className={styles.darkGoldEyebrow}>
                AUTHORITY IN ACTION
              </p>

              <h2>
                Technical capability and delegated authority are not the same thing.
              </h2>

              <p>
                The Production Operations Agent can
                interact with cloud and deployment
                systems. That technical capability does
                not automatically give it autonomous
                authority to use every available
                operation.
              </p>

              <p>
                AIGO-OS evaluates the proposed activity
                against the Machine Authority connected
                to the governed actor.
              </p>

              <div className={styles.resultCard}>
                <ShieldCheck
                  size={21}
                  aria-hidden="true"
                />

                <div>
                  <span>AUTHORITY RESULT</span>

                  <strong>
                    Production deployment is outside
                    delegated autonomous authority.
                  </strong>
                </div>
              </div>
            </div>


            <div className={styles.evaluationPanel}>
              <div className={styles.evalHeading}>
                <span>PROPOSED ACTIVITY</span>

                <strong>
                  Deploy application release 4.8
                </strong>
              </div>

              <div className={styles.evalGrid}>
                <article>
                  <span
                    className={styles.darkIconWell}
                  >
                    <Fingerprint
                      size={18}
                      aria-hidden="true"
                    />
                  </span>

                  <small>ACTOR</small>

                  <strong>
                    Production Operations Agent
                  </strong>
                </article>

                <article>
                  <span
                    className={styles.darkIconWell}
                  >
                    <CloudCog
                      size={18}
                      aria-hidden="true"
                    />
                  </span>

                  <small>
                    TECHNICAL CAPABILITY
                  </small>

                  <strong>
                    Deployment API accessible
                  </strong>
                </article>

                <article>
                  <span
                    className={styles.darkIconWell}
                  >
                    <ShieldCheck
                      size={18}
                      aria-hidden="true"
                    />
                  </span>

                  <small>MACHINE AUTHORITY</small>

                  <strong>
                    Observe and remediate approved
                    services
                  </strong>
                </article>

                <article
                  className={styles.warningCard}
                >
                  <span
                    className={styles.goldIconWell}
                  >
                    <UserRoundCheck
                      size={18}
                      aria-hidden="true"
                    />
                  </span>

                  <small>BOUNDARY</small>

                  <strong>
                    Production deployment requires
                    human authority
                  </strong>
                </article>
              </div>

              <div className={styles.evalResult}>
                <span>
                  AUTHORITY EVALUATION
                </span>

                <strong>
                  OUTSIDE DELEGATED MACHINE AUTHORITY
                </strong>

                <small>
                  Technical access remains available.
                  Autonomous authority does not.
                </small>
              </div>
            </div>
          </div>
        </div>
      </section>


      <section
        className={styles.connectedSection}
      >
        <div className={styles.shell}>
          <div className={styles.splitHeading}>
            <div>
              <p className={styles.blueEyebrow}>
                CONNECTED GOVERNANCE
              </p>

              <h2>
                Machine Authority establishes the autonomy available to the actor.
              </h2>
            </div>

            <p>
              Machine Authority does not determine the
              complete governance response. Its result
              becomes context for Business Significance
              and Governance Decisioning.
            </p>
          </div>
<div className={styles.noteCard}>
            <Gauge
              size={21}
              aria-hidden="true"
            />

            <div>
              <strong>
                Being outside Machine Authority is
                important. It is not the whole
                governance decision.
              </strong>

              <p>
                Business Significance next determines
                what the current activity means in its
                enterprise context.
              </p>
            </div>
          </div>
        </div>
      </section>


      <section className={styles.finalSection}>
        <div className={styles.shell}>
          <div className={styles.finalGrid}>
            <div>
              <p className={styles.darkGoldEyebrow}>
                MACHINE AUTHORITY
              </p>

              <h2>
                Give autonomous AI room to operate without giving it unlimited authority.
              </h2>
            </div>

            <div>
              <p>
                Represent delegated autonomy explicitly
                so AIGO-OS can distinguish technical
                capability from the authority the
                enterprise actually intended an AI
                actor to exercise.
              </p>

              <div className={styles.heroButtons}>
                <Link
                  href="/product/business-significance"
                  className={styles.primaryButton}
                >
                  Explore Business Significance

                  <ArrowRight
                    size={18}
                    aria-hidden="true"
                  />
                </Link>

                <Link
                  href="/contact?intent=demo"
                  className={styles.secondaryButton}
                >
                  Request a Demo
                </Link>
              </div>
            </div>
          </div>
        </div>
      </section>
    </main>
  );
}





