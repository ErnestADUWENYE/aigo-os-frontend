                          active
                            ? styles.passportFieldActive
                            : "",
                        ].join(" ")}
                      >
                        <span className={styles.fieldIcon}>
                          <Icon
                            size={17}
                            aria-hidden="true"
                          />
                        </span>

                        <span className={styles.fieldCopy}>
                          <small>
                            {field.label}
                          </small>

                          <strong>
                            {field.value}
                          </strong>
                        </span>
                      </button>
                    );
