          </div>


          <div className={styles.conceptFlow}>
            <article className={styles.conceptCard}>
              <div className={styles.conceptTop}>
                <span className={styles.conceptNumber}>
                  01
                </span>

                <div className={styles.conceptIcon}>
                  <ServerCog
                    size={23}
                    aria-hidden="true"
                  />
