                <div className={styles.conceptIcon}>
                  <Network
                    size={23}
                    aria-hidden="true"
                  />
                </div>
              </div>

              <span className={styles.conceptLabel}>
                RESOLVE
              </span>

              <h3>
                Connect what belongs together
              </h3>

              <p>
                AIGO-OS uses the available evidence to determine
                which technical identities, workloads and systems
