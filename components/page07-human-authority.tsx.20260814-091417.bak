                <span>PROCUREMENT MANAGER</span>
                <strong>Up to GBP 50,000</strong>
              </article>

              <article
                className={
                  activeEscalation.authority ===
                  "Finance Controller"
                    ? styles.escalationActive
                    : ""
                }
              >
                <span>FINANCE CONTROLLER</span>
                <strong>Up to GBP 250,000</strong>
              </article>

              <article
                className={
                  activeEscalation.authority ===
                  "Finance Director"
                    ? styles.escalationActive
                    : ""
                }
              >
                <span>FINANCE DIRECTOR</span>
                <strong>
                  Above GBP 250,000
                </strong>
              </article>

              <article
                className={
                  activeEscalation.authority ===
                  "Risk or Governance Owner"
                    ? styles.escalationActive
                    : ""
                }
              >
                <span>RISK OR GOVERNANCE OWNER</span>
                <strong>
                  Policy exception or material issue
                </strong>
              </article>
            </div>


            <article className={styles.escalationResult}>
              <span>RESOLVED AUTHORITY</span>

              <strong>
                {activeEscalation.authority}
              </strong>

              <p>
                {activeEscalation.scope}
              </p>
            </article>
          </div>
        </div>
      </section>


      <section className={styles.evidenceSection}>
        <div className={styles.shell}>
          <div className={styles.editorialGrid}>
            <div>
              <p className={styles.goldEyebrow}>
                ACCOUNTABILITY AND EVIDENCE
              </p>

              <h2 className={styles.darkHeadline}>
                <span className={styles.keepLine}>
                  Preserve who intervened, what
                </span>

                <span className={styles.keepLine}>
                  authority they exercised and why.
                </span>
              </h2>
            </div>

            <div className={styles.darkCopy}>
              <p>
                Human intervention becomes part of the
                governance history of the AI activity.
              </p>

              <p>
                AIGO-OS preserves the authority
                relationship, decision, conditions,
                context and resulting action.
              </p>
            </div>
          </div>


          <div className={styles.interventionRecord}>
            <article>
              <span>ACTOR PASSPORT</span>
              <strong>Procurement Agent 07</strong>
            </article>

            <article>
              <span>MACHINE AUTHORITY</span>
              <strong>
                GBP 50,000 autonomous limit
              </strong>
            </article>

            <article>
              <span>BUSINESS SIGNIFICANCE</span>
              <strong>High</strong>
            </article>

            <article>
              <span>GOVERNANCE DECISION</span>
              <strong>
                Human Authority Required
              </strong>
            </article>

            <article className={styles.recordHuman}>
              <span>HUMAN AUTHORITY</span>
              <strong>Finance Controller</strong>
            </article>

            <article className={styles.recordDecision}>
              <span>HUMAN DECISION</span>
              <strong>
                Approved with condition
              </strong>
            </article>

            <article>
              <span>CONDITION</span>
              <strong>
                Supplier verification required
              </strong>
            </article>

            <article>
              <span>OUTCOME</span>
              <strong>
                Executed after verification
              </strong>
            </article>

            <article className={styles.receiptRecord}>
              <span>GOVERNANCE RECEIPT</span>
              <strong>GR-84291</strong>
            </article>
          </div>


          <div className={styles.sectionAction}>
            <Link
              href="/product/governance-receipts"
              className={styles.darkSecondaryButton}
            >
              Explore Governance Receipts
            </Link>
          </div>
        </div>
      </section>


      <section className={styles.roleSection}>
        <div className={styles.shell}>
          <div className={styles.sectionIntro}>
            <p className={styles.blueEyebrow}>
              THE AIGO-OS GOVERNANCE MODEL
            </p>

            <h2>
              <span className={styles.keepLine}>
                Human Authority is where accountability
              </span>

              <span className={styles.keepLine}>
                enters consequential AI decisions.
              </span>
            </h2>
          </div>


          <div className={styles.platformRail}>
            {platformStages.map((stage, index) => (
              <article
                key={stage}
                className={
                  index === 4
                    ? styles.platformStageActive
                    : index < 4
                      ? styles.platformStageComplete
                      : styles.platformStage
                }
              >
                <span>
                  {String(index + 1).padStart(2, "0")}
                </span>

                <strong>{stage}</strong>

                {index < 4 && (
                  <small>Established upstream</small>
                )}

                {index === 4 && (
                  <small>Current capability</small>
                )}

                {index === 5 && (
                  <small>Evidence next</small>
                )}
              </article>
            ))}
          </div>
        </div>
      </section>


      <section className={styles.finalCta}>
        <div
          className={styles.finalGlow}
          aria-hidden="true"
        />

        <div className={styles.finalInner}>
          <p className={styles.blueEyebrow}>
            HUMAN AUTHORITY & INTERVENTION
          </p>

          <h2>
            <span className={styles.keepLine}>
              Keep autonomy where it belongs.
            </span>

            <span className={styles.keepLine}>
              Bring accountable people into the
              decisions that require them.
            </span>
          </h2>

          <p>
            Use Machine Authority, Business Significance
            and Governance Decisioning to determine when
            autonomous AI can continue and when an
            accountable human authority must take
            responsibility for what happens next.
          </p>

          <div className={styles.heroActions}>
            <Link
              href="/demo"
              className={styles.primaryButton}
            >
              Request a Demo
            </Link>

            <Link
              href="/product/governance-receipts"
              className={styles.secondaryButton}
            >
              Explore Governance Receipts
            </Link>
          </div>
        </div>
      </section>
    </div>
  );
}
