  | "information";

type BoundaryKey =
  | "routine"
  | "controlled"
  | "human";

type EscalationKey =
  | "35000"
  | "87500"
  | "600000"
  | "exception";

const humanDecisions: Record<
  HumanDecisionKey,
  {
    label: string;
