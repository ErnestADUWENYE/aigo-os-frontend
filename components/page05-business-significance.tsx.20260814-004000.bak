              {(
                Object.keys(
                  correlationObjects,
                ) as CorrelationKey[]
              ).map((key) => (
                <button
                  key={key}
                  type="button"
                  onClick={() =>
                    toggleCorrelation(key)
                  }
                  className={
                    correlation[key]
                      ? styles.correlationObjectActive
                      : styles.correlationObject
                  }
                >
                  <span>
                    {correlationObjects[key].label}
                  </span>

                  <strong>
                    {correlationObjects[key].value}
                  </strong>

                  <small>
                    {correlation[key]
                      ? "Connected"
