            <div className={styles.heroCopy}>
              <p className={styles.blueEyebrow}>
                BUSINESS SIGNIFICANCE
              </p>

              <h1 className={styles.heroTitle}>
                <span className={styles.keepLine}>
                  Know what AI activity means
                </span>

                <span className={styles.keepLine}>
                  to your business.
                </span>
              </h1>

              <p className={styles.heroLead}>
                A technical event can tell you what happened.
                It does not explain the business meaning of
                the situation.
              </p>

              <p className={styles.heroSupporting}>
                AIGO-OS correlates AI activity with actor
                identity, delegated authority and relevant
                enterprise context to determine whether the
                situation is routine, consequential,
                exceptional or potentially inappropriate.
              </p>

              <div className={styles.heroActions}>
                <Link
                  href="/demo"
                  className={styles.primaryButton}
                >
                  Request a Demo
                </Link>

                <Link
                  href="/product/governance-decisioning"
                  className={styles.secondaryButton}
                >
                  Explore Governance Decisioning
                </Link>
              </div>
            </div>


            <div className={styles.heroMeaningVisual}>
              <div className={styles.visualLabel}>
                <span>
                  FROM EVENT TO BUSINESS MEANING
                </span>

                <strong>
                  Context resolves progressively
                </strong>
              </div>


              <div className={styles.eventCore}>
                <span>AI ACTIVITY</span>

                <strong>
                  INITIATE SUPPLIER PAYMENT
                </strong>

                <div>
                  <small>Actor reference</small>
                  <b>svc-ai-proc-07</b>
                </div>

                <div>
                  <small>Amount</small>
                  <b>GBP 87,500</b>
                </div>

                <div>
                  <small>API response</small>
                  <b>Successful</b>
                </div>

                <div>
                  <small>System status</small>
                  <b>Normal</b>
                </div>
              </div>


              <div className={styles.resolvedContext}>
                <article className={styles.contextActor}>
                  <span>ACTOR PASSPORT</span>
                  <strong>Procurement Agent 07</strong>
                </article>

                <article className={styles.contextAuthority}>
                  <span>MACHINE AUTHORITY</span>
                  <strong>GBP 50,000 autonomous limit</strong>
                </article>

                <article className={styles.contextSupplier}>
                  <span>SUPPLIER</span>
                  <strong>New</strong>
                </article>

                <article className={styles.contextVerification}>
                  <span>VERIFICATION</span>
                  <strong>Incomplete</strong>
                </article>

                <article className={styles.contextProcess}>
                  <span>PROCESS</span>
                  <strong>Procurement</strong>
                </article>

                <article className={styles.contextPolicy}>
                  <span>POLICY</span>
                  <strong>
                    New Supplier Payment Control
                  </strong>
                </article>

                <article className={styles.contextConsequence}>
                  <span>POTENTIAL CONSEQUENCE</span>
                  <strong>Material financial transfer</strong>
                </article>
              </div>


              <div className={styles.significanceObject}>
                <span>BUSINESS SIGNIFICANCE</span>

                <strong>HIGH</strong>

                <small>
                  Meaning established from correlated context
                </small>
              </div>


              <div className={styles.governanceNext}>
                <span>NEXT</span>
                <strong>GOVERNANCE DECISIONING</strong>
              </div>
            </div>
          </div>


          <div className={styles.heroStatement}>
            <div>
              <span>ACTIVITY</span>
              <strong>What happened</strong>
            </div>

            <div className={styles.statementPath}>
              <span />
            </div>

            <div>
