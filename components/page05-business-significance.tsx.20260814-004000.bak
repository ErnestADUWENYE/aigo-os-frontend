                  </small>
                </button>
              ))}
            </div>


            <div className={styles.correlationCore}>
              <div
                className={
                  activeCorrelationCount >= 7
                    ? styles.significanceCoreHigh
                    : activeCorrelationCount >= 5
                      ? styles.significanceCoreElevated
                      : styles.significanceCoreDeveloping
                }
              >
                <span>
                  BUSINESS SIGNIFICANCE
                </span>

                <strong>
                  {correlationSignificance}
                </strong>

                <small>
                  {activeCorrelationCount} of 7 relevant
                  context relationships connected
                </small>
              </div>


              <div className={styles.contextReasons}>
                {correlation.authority && (
                  <span>Authority exceeded</span>
                )}

                {correlation.supplier && (
                  <span>New supplier</span>
                )}

                {correlation.verification && (
                  <span>
                    Verification incomplete
                  </span>
                )}

                {correlation.payment && (
                  <span>
                    Material financial consequence
                  </span>
                )}

                {correlation.beneficiary && (
                  <span>
                    Beneficiary recently changed
                  </span>
                )}

                {correlation.policy && (
