            </article>
          </div>


          <p className={styles.lightStatement}>
            Business Significance is contextual. It is not
            inherent in the technical event.
          </p>
        </div>
      </section>


      <section className={styles.modelSection}>
        <div className={styles.shell}>
          <div className={styles.sectionIntro}>
            <p className={styles.blueEyebrow}>
              SIGNIFICANCE MODEL
            </p>

            <h2>
              <span className={styles.keepLine}>
                Bring together the context that makes
              </span>

              <span className={styles.keepLine}>
                AI activity meaningful.
              </span>
            </h2>

            <p>
              Not every factor matters equally in every
              situation. AIGO-OS associates the context
              relevant to the specific activity being
              governed.
            </p>
          </div>


          <div className={styles.dimensionGrid}>
            {dimensions.map((dimension) => (
              <article
                key={dimension.number}
                className={styles.dimensionCard}
              >
                <div className={styles.dimensionTop}>
                  <span>{dimension.number}</span>

                  <div>
                    <span />
                  </div>
                </div>

                <h3>{dimension.title}</h3>

                <p>{dimension.question}</p>

                <div className={styles.dimensionItems}>
                  {dimension.items.map((item) => (
                    <span key={item}>
                      {item}
                    </span>
                  ))}
                </div>
              </article>
            ))}
          </div>


          <p className={styles.darkRuntimeStatement}>
            AIGO-OS correlates the relevant factors to
            establish what the activity means in the current
            situation.
          </p>
        </div>
      </section>


      <section className={styles.integrationSection}>
        <div className={styles.shell}>
          <div className={styles.editorialGrid}>
            <div>
              <p className={styles.goldEyebrow}>
                INTEGRATION, NOT OBSERVABILITY
              </p>

              <h2 className={styles.darkHeadline}>
                <span className={styles.keepLine}>
                  Use operational visibility.
                </span>

                <span className={styles.keepLine}>
                  Do not rebuild it.
                </span>
