const governanceModel = [
  "Actor Passports",
  "Machine Authority",
  "Business Significance",
  "Governance Decisioning",
  "Human Authority",
  "Governance Receipts",
];

export function Page05BusinessSignificance() {
  const [paymentScenario, setPaymentScenario] =
    useState<PaymentScenarioKey>("high");

  const [refundScenario, setRefundScenario] =
    useState<RefundScenarioKey>("standard");

  const [correlation, setCorrelation] =
    useState<Record<CorrelationKey, boolean>>({
      payment: true,
      supplier: false,
      beneficiary: false,
      actor: true,
      authority: true,
      verification: false,
      policy: false,
    });

  const activePayment =
    paymentScenarios[paymentScenario];

  const activeRefund =
    refundScenarios[refundScenario];

  const activeCorrelationCount =
    Object.values(correlation).filter(Boolean).length;

  const correlationSignificance =
    activeCorrelationCount >= 7
      ? "HIGH"
      : activeCorrelationCount >= 5
        ? "ELEVATED"
        : "DEVELOPING";

  function toggleCorrelation(key: CorrelationKey) {
    setCorrelation((current) => ({
      ...current,
      [key]: !current[key],
    }));
  }

  return (
    <div className={styles.page}>
      <section className={styles.hero}>
        <div
          className={styles.heroGrid}
          aria-hidden="true"
        />

        <div
          className={styles.heroGlow}
          aria-hidden="true"
        />

        <div className={styles.shell}>
