.page {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: clip;
}

.page,
.page *,
.page *::before,
.page *::after {
  box-sizing: border-box;
}


/* ============================================================
   CANONICAL PAGE FRAME
   ============================================================ */

.shell {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 48px;
}


/* ============================================================
   SHARED
   ============================================================ */

.blueEyebrow,
.goldEyebrow {
  margin: 0;
  font-size: 0.7rem;
  line-height: 1.4;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.blueEyebrow {
  color: #69adff;
}

.goldEyebrow {
  color: #c7953f;
}

.keepLine {
  display: block;
  white-space: nowrap;
}

.primaryButton,
.secondaryButton,
.darkSecondaryButton {
  min-height: 48px;
  padding: 0 21px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 0.91rem;
  font-weight: 720;
  text-decoration: none;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.primaryButton {
  border: 1px solid #5b9cff;
  background: #2f7cff;
  color: #ffffff;
  box-shadow:
    0 14px 34px rgba(47, 124, 255, 0.22);
}

.secondaryButton {
  border:
    1px solid rgba(131, 177, 233, 0.24);
  background:
    rgba(255, 255, 255, 0.05);
  color: #eef6ff;
}

.darkSecondaryButton {
  border:
    1px solid rgba(23, 53, 77, 0.15);
  background: #f7f3eb;
  color: #15334a;
}

.primaryButton:hover,
.secondaryButton:hover,
.darkSecondaryButton:hover {
  transform: translateY(-2px);
}

.heroActions {
  margin-top: 28px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.sectionAction {
  margin-top: 28px;
}


/* ============================================================
   HERO
   ============================================================ */

.hero {
  position: relative;
  overflow: hidden;
  padding: 78px 0 92px;
  background:
    radial-gradient(
      circle at 78% 17%,
      rgba(47, 124, 255, 0.15),
      transparent 34%
    ),
    #061727;
  color: #f4f8fd;
}

.heroGrid {
  position: absolute;
  inset: 0;
  opacity: 0.3;
  pointer-events: none;
  background:
    linear-gradient(
      rgba(255, 255, 255, 0.017) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.017) 1px,
      transparent 1px
    );
  background-size: 54px 54px;
}

.heroGlow {
  position: absolute;
  right: 3%;
  top: 0;
  width: 620px;
  height: 620px;
  border-radius: 50%;
  background:
    rgba(48, 124, 255, 0.07);
  filter: blur(90px);
}

.heroLayout {
  position: relative;
  z-index: 1;
  min-height: 650px;
  display: grid;
  grid-template-columns:
    minmax(0, 0.92fr)
    minmax(0, 1.08fr);
  gap: clamp(70px, 7vw, 110px);
  align-items: center;
}

.heroLayout > * {
  min-width: 0;
}

.heroCopy {
  width: 100%;
  max-width: 645px;
}

.heroTitle {
  margin: 20px 0 0;
  width: 100%;
  max-width: 690px;
  font-size:
    clamp(3rem, 4vw, 4.5rem);
  line-height: 1;
  letter-spacing: -0.052em;
  font-weight: 660;
}

.heroTitle span + span {
  margin-top: 7px;
}

.heroLead {
  margin: 28px 0 0;
  color: #eef5ff;
  font-size: 1.07rem;
  line-height: 1.68;
}

.heroSupporting {
  margin: 12px 0 0;
  color: #aebed0;
  font-size: 0.95rem;
  line-height: 1.72;
}


/* ============================================================
   HERO DECISION VISUAL
   ============================================================ */

.heroDecisionVisual {
  position: relative;
  width: 100%;
  max-width: 610px;
  min-height: 590px;
  margin-left: auto;
  overflow: hidden;
}

.visualLabel {
  position: absolute;
  z-index: 10;
  top: 0;
  left: 50%;
  transform: translateX(-50%);
  width: max-content;
  max-width: 90%;
  text-align: center;
}

.visualLabel span {
  display: block;
  color: #68afff;
  font-size: 0.55rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.visualLabel strong {
  display: block;
  margin-top: 5px;
  color: #8fa8bd;
  font-size: 0.67rem;
}

.inputCluster {
  position: absolute;
  inset: 0;
}

.inputCluster article {
  position: absolute;
  width: 158px;
  padding: 10px 11px;
  border:
    1px solid rgba(103, 170, 247, 0.15);
  border-radius: 10px;
  background:
    linear-gradient(
      145deg,
      #0f304e,
      #09243c
    );
  box-shadow:
    7px 10px 17px rgba(0, 0, 0, 0.17);
  animation:
    inputDecisionGlow
    13s
    ease-in-out
    infinite;
}

.inputCluster article span {
  display: block;
  color: #68afff;
  font-size: 0.46rem;
  font-weight: 800;
}

.inputCluster article strong {
  display: block;
  margin-top: 4px;
  color: #bacbd9;
  font-size: 0.56rem;
  line-height: 1.35;
}

.heroActor {
  left: 3px;
  top: 90px;
  animation-delay: 0s !important;
}

.heroActivity {
  right: 4px;
  top: 93px;
  animation-delay: 1.1s !important;
}

.heroAuthority {
  left: 0;
  top: 207px;
  animation-delay: 2.2s !important;
}

.heroSignificance {
  right: 0;
  top: 209px;
  animation-delay: 3.3s !important;
}

.heroPayment {
  left: 18px;
  top: 324px;
  animation-delay: 4.4s !important;
}

.heroSupplier {
  right: 17px;
  top: 326px;
  animation-delay: 5.5s !important;
}

.heroVerification {
  left: 35px;
  bottom: 120px;
  animation-delay: 6.6s !important;
}

.heroControl {
  right: 35px;
  bottom: 120px;
  animation-delay: 7.7s !important;
}

@keyframes inputDecisionGlow {
  0%,
  100% {
    border-color:
      rgba(103, 170, 247, 0.15);
  }

  5%,
  10% {
    border-color:
      rgba(103, 176, 255, 0.6);
    box-shadow:
      0 0 16px
        rgba(83, 165, 255, 0.19),
      7px 10px 17px
        rgba(0, 0, 0, 0.17);
  }
}

.decisionCore {
  position: absolute;
  z-index: 8;
  left: 50%;
  top: 49%;
  width: 270px;
  padding: 22px;
  transform: translate(-50%, -50%);
  text-align: center;
  border:
    1px solid rgba(205, 158, 68, 0.36);
  border-radius: 20px;
  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(205, 158, 68, 0.08),
      transparent 39%
    ),
    #13344d;
  box-shadow:
    0 0 26px
      rgba(191, 136, 37, 0.09),
    12px 17px 29px rgba(0, 0, 0, 0.22);
}

.decisionCore > span {
  display: block;
  color: #d0a04b;
  font-size: 0.53rem;
  font-weight: 800;
}

.decisionCore > strong {
  display: block;
  margin-top: 10px;
  color: #f1c875;
  font-size: 1.03rem;
  line-height: 1.35;
}

.decisionCore > p {
  margin: 12px 0 0;
  color: #aabccc;
  font-size: 0.62rem;
  line-height: 1.55;
}

.decisionRoute {
  margin-top: 15px;
  padding: 10px;
  border:
    1px solid rgba(103, 172, 251, 0.17);
  border-radius: 8px;
  background:
    rgba(255, 255, 255, 0.035);
}

.decisionRoute span {
  display: block;
  color: #718ea8;
  font-size: 0.45rem;
  font-weight: 800;
}

.decisionRoute b {
  display: block;
  margin-top: 4px;
  color: #b9cee0;
  font-size: 0.56rem;
}

.heroStatement {
  position: relative;
  z-index: 2;
  margin-top: 23px;
  padding: 17px 19px;
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    70px
    minmax(0, 1fr)
    70px
    minmax(0, 1fr);
  gap: 11px;
  align-items: center;
  border:
    1px solid rgba(103, 167, 241, 0.13);
  border-radius: 16px;
  background:
    rgba(255, 255, 255, 0.032);
}

.heroStatement > div:not(.statementPath) span {
  display: block;
  color: #68afff;
  font-size: 0.5rem;
  font-weight: 800;
}

.heroStatement > div:not(.statementPath) strong {
  display: block;
  margin-top: 4px;
  color: #b7c8d7;
  font-size: 0.67rem;
}

.statementPath span {
  width: 100%;
  height: 1px;
  display: block;
  background:
    linear-gradient(
      to right,
      transparent,
      #62aaff,
      transparent
    );
}


/* ============================================================
   SHARED EDITORIAL
   ============================================================ */

.editorialGrid {
  display: grid;
  grid-template-columns:
    minmax(0, 1.3fr)
    minmax(320px, 0.7fr);
  gap: clamp(52px, 6vw, 94px);
  align-items: center;
}

.editorialGrid > * {
  min-width: 0;
}

.darkHeadline,
.lightHeadline,
.darkRoleTitle {
  margin: 19px 0 0;
  width: 100%;
  max-width: 980px;
  font-size:
    clamp(2.5rem, 3.4vw, 3.8rem);
  line-height: 1.03;
  letter-spacing: -0.048em;
  font-weight: 650;
}

.darkHeadline,
.darkRoleTitle {
  color: #102e47;
}

.lightHeadline {
  color: #f2f7fd;
}

.darkCopy,
.lightCopy {
  max-width: 490px;
}

.darkCopy p,
.lightCopy p {
  margin: 0;
  font-size: 0.98rem;
  line-height: 1.74;
}

.darkCopy p {
  color: #526b7e;
}

.lightCopy p {
  color: #acbed0;
}

.darkCopy p + p,
.lightCopy p + p {
  margin-top: 13px;
}

.sectionIntro {
  width: 100%;
  max-width: 990px;
}

.sectionIntro h2 {
  margin: 18px 0 0;
  width: 100%;
  max-width: 980px;
  color: #f2f7fd;
  font-size:
    clamp(2.5rem, 3.45vw, 3.85rem);
  line-height: 1.03;
  letter-spacing: -0.048em;
}

.sectionIntro > p:last-child {
  max-width: 760px;
  margin: 21px 0 0;
  color: #aebfd0;
  font-size: 0.98rem;
  line-height: 1.72;
}

.lightStatement,
.darkRuntimeStatement {
  margin: 32px 0 0;
  padding: 19px 22px;
  border-left: 3px solid #67afff;
  font-size: 0.94rem;
  line-height: 1.68;
}

.lightStatement {
  color: #435e73;
  background:
    rgba(16, 45, 70, 0.04);
}

.darkRuntimeStatement {
  color: #bed0de;
  background:
    rgba(255, 255, 255, 0.035);
}


/* ============================================================
   CONTEXTUAL GOVERNANCE
   ============================================================ */

.contextSection {
  padding: 100px 0;
  background: #eee9dd;
}

.scenarioWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    190px
    minmax(0, 0.76fr)
    minmax(0, 1fr)
    minmax(0, 0.9fr);
  gap: 12px;
}

.scenarioWorkspace > * {
  min-width: 0;
}

.scenarioControls {
  display: grid;
  align-content: start;
  gap: 8px;
}

.scenarioButton,
.scenarioButtonActive {
  min-height: 77px;
  padding: 13px;
  border-radius: 11px;
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.scenarioButton {
  border:
    1px solid rgba(31, 58, 79, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e5ded3
    );
  color: #355169;
}

.scenarioButtonActive {
  border:
    1px solid rgba(81, 153, 233, 0.28);
  background: #153d5e;
  color: #eef6ff;
  transform: translateY(-2px);
}

.scenarioButton span,
.scenarioButtonActive span {
  display: block;
  color: #74899b;
  font-size: 0.53rem;
  font-weight: 800;
}

.scenarioButtonActive span {
  color: #76b7ff;
}

.scenarioButton strong,
.scenarioButtonActive strong {
  display: block;
  margin-top: 6px;
  font-size: 0.71rem;
}

.constantContext,
.variableContext,
.scenarioDecision {
  min-height: 355px;
  padding: 22px;
  border-radius: 18px;
}

.constantContext,
.variableContext {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ddd1
    );
}

.constantContext > span,
.variableContext > span,
.scenarioDecision > span {
  color: #74899b;
  font-size: 0.55rem;
  font-weight: 800;
}

.constantContext > strong {
  display: block;
  margin-top: 19px;
  color: #17364e;
  font-size: 1.12rem;
}

.constantContext > small {
  display: block;
  margin-top: 12px;
  color: #607587;
  font-size: 0.69rem;
}

.variableContext dl {
  margin: 18px 0 0;
  display: grid;
  gap: 7px;
}

.variableContext dl div {
  padding: 9px;
  border-radius: 8px;
  background:
    rgba(20, 48, 70, 0.04);
}

.variableContext dt {
  color: #74899b;
  font-size: 0.53rem;
}

.variableContext dd {
  margin: 4px 0 0;
  color: #213e54;
  font-size: 0.67rem;
  font-weight: 700;
}

.scenarioDecision {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.scenarioDecision > strong {
  margin-top: 16px;
  font-size: 1.04rem;
  line-height: 1.38;
}

.scenarioDecision p {
  margin: 13px 0 0;
  font-size: 0.72rem;
  line-height: 1.6;
}

.decisionContinue {
  border:
    1px solid rgba(78, 156, 104, 0.22);
  background:
    rgba(77, 156, 103, 0.09);
}

.decisionContinue > strong {
  color: #397c50;
}

.decisionContinue p {
  color: #506c5b;
}

.decisionControl {
  border:
    1px solid rgba(192, 143, 52, 0.27);
  background:
    rgba(193, 143, 49, 0.08);
}

.decisionControl > strong {
  color: #936920;
}

.decisionControl p {
  color: #746246;
}

.decisionHuman {
  border:
    1px solid rgba(84, 145, 211, 0.25);
  background:
    rgba(67, 131, 199, 0.08);
}

.decisionHuman > strong {
  color: #376b9c;
}

.decisionHuman p {
  color: #526b80;
}

.decisionBlocked {
  border:
    1px solid rgba(176, 102, 79, 0.22);
  background:
    rgba(165, 86, 66, 0.075);
}

.decisionBlocked > strong {
  color: #984e3c;
}

.decisionBlocked p {
  color: #78574f;
}


/* ============================================================
   INPUTS
   ============================================================ */

.inputsSection {
  padding: 100px 0;
  background: #071b2e;
}

.inputGrid {
  margin-top: 54px;
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 13px;
}

.inputCard {
  min-width: 0;
  min-height: 225px;
  padding: 21px;
  border:
    1px solid rgba(101, 162, 231, 0.14);
  border-radius: 18px;
  background:
    linear-gradient(
      145deg,
      #0d2c47,
      #071f34
    );
}

.inputCardTop {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.inputCardTop > span {
  color: #718ca5;
  font-size: 0.56rem;
  font-weight: 800;
}

.inputCardTop > div {
  width: 35px;
  height: 35px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background:
    radial-gradient(
      circle at 35% 30%,
      #20557e,
      #09283f 68%
    );
}

.inputCardTop > div span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #67afff;
}

.inputCard h3 {
  margin: 18px 0 0;
  color: #eef6ff;
  font-size: 1.12rem;
}

.inputCard p {
  margin: 9px 0 0;
  color: #879fb5;
  font-size: 0.7rem;
  line-height: 1.53;
}

.inputCard > strong {
  display: block;
  margin-top: 17px;
  color: #b2c4d3;
  font-size: 0.7rem;
}

.inputDecisionTarget {
  max-width: 570px;
  margin: 26px auto 0;
  padding: 21px;
  text-align: center;
  border:
    1px solid rgba(205, 158, 68, 0.28);
  border-radius: 16px;
  background:
    rgba(193, 139, 40, 0.07);
}

.inputDecisionTarget span {
  display: block;
  color: #c99a46;
  font-size: 0.54rem;
  font-weight: 800;
}

.inputDecisionTarget strong {
  display: block;
  margin-top: 8px;
  color: #efc571;
  font-size: 1.08rem;
}

.inputDecisionTarget small {
  display: block;
  margin-top: 6px;
  color: #91a5b6;
  font-size: 0.61rem;
}


/* ============================================================
   OUTCOMES
   ============================================================ */

.outcomesSection {
  padding: 100px 0;
  background: #eee9dd;
}

.outcomeGrid {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 12px;
}

.outcomeCard,
.outcomeCardHuman,
.outcomeCardBlocked {
  min-width: 0;
  min-height: 220px;
  padding: 21px;
  border-radius: 17px;
}

.outcomeCard {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #fbf9f4,
      #e4ded2
    );
}

.outcomeCardHuman {
  border:
    1px solid rgba(75, 145, 220, 0.21);
  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    );
}

.outcomeCardBlocked {
  border:
    1px solid rgba(168, 93, 70, 0.2);
  background:
    rgba(165, 86, 66, 0.07);
}

.outcomeCard > span,
.outcomeCardHuman > span,
.outcomeCardBlocked > span {
  color: #74899b;
  font-size: 0.54rem;
  font-weight: 800;
}

.outcomeCardHuman > span {
  color: #68afff;
}

.outcomeCard h3,
.outcomeCardHuman h3,
.outcomeCardBlocked h3 {
  margin: 20px 0 0;
  font-size: 1.14rem;
}

.outcomeCard h3,
.outcomeCardBlocked h3 {
  color: #18364d;
}

.outcomeCardHuman h3 {
  color: #eef6ff;
}

.outcomeCard p,
.outcomeCardHuman p,
.outcomeCardBlocked p {
  margin: 10px 0 0;
  font-size: 0.71rem;
  line-height: 1.56;
}

.outcomeCard p,
.outcomeCardBlocked p {
  color: #5d7283;
}

.outcomeCardHuman p {
  color: #afc1d0;
}


/* ============================================================
   POLICY
   ============================================================ */

.policySection {
  padding: 100px 0;
  background: #081f34;
}

.policyWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    minmax(0, 0.82fr)
    minmax(0, 1fr)
    minmax(0, 0.9fr);
  gap: 13px;
}

.policyWorkspace > * {
  min-width: 0;
}

.policyObject,
.policyActivity,
.policyDecision {
  min-height: 370px;
  padding: 23px;
  border-radius: 18px;
}

.policyObject,
.policyActivity {
  border:
    1px solid rgba(100, 160, 227, 0.13);
  background: #0c2a45;
}

.policyDecision {
  border:
    1px solid rgba(205, 158, 68, 0.26);
  background:
    radial-gradient(
      circle at 80% 0%,
      rgba(205, 158, 68, 0.07),
      transparent 33%
    ),
    #13344d;
}

.policyObject > span,
.policyActivity > span,
.policyDecision > span {
  color: #718ea8;
  font-size: 0.55rem;
  font-weight: 800;
}

.policyDecision > span {
  color: #d0a04a;
}

.policyObject h3 {
  margin: 17px 0 0;
  color: #eef6ff;
  font-size: 1.18rem;
}

.policyObject p {
  margin: 14px 0 0;
  color: #a7b9c9;
  font-size: 0.74rem;
  line-height: 1.64;
}

.policyActivity dl {
  margin: 18px 0 0;
  display: grid;
  gap: 7px;
}

.policyActivity dl div {
  padding: 9px 10px;
  border-radius: 8px;
  background:
    rgba(255, 255, 255, 0.04);
}

.policyActivity dt {
  color: #718da6;
  font-size: 0.52rem;
}

.policyActivity dd {
  margin: 4px 0 0;
  color: #dbe7f1;
  font-size: 0.67rem;
  font-weight: 700;
}

.policyDecision > strong {
  display: block;
  margin-top: 17px;
  color: #f0c574;
  font-size: 1rem;
  line-height: 1.4;
}

.policyDecision > div {
  margin-top: 15px;
  padding: 11px;
  border-radius: 9px;
  background:
    rgba(255, 255, 255, 0.04);
}

.policyDecision small {
  display: block;
  color: #788fa3;
  font-size: 0.49rem;
  font-weight: 800;
}

.policyDecision b {
  display: block;
  margin-top: 5px;
  color: #bccddd;
  font-size: 0.64rem;
}


/* ============================================================
   RULES
   ============================================================ */

.rulesSection {
  padding: 100px 0;
  background: #eee9dd;
}

.rulesComparison {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    150px
    minmax(0, 1fr);
  gap: 20px;
  align-items: center;
}

.rulesComparison > * {
  min-width: 0;
}

.rulesComparison article {
  min-height: 330px;
  padding: 24px;
  border-radius: 17px;
}

.rulesComparison article:first-child {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ddd2
    );
}

.aigoDecisioning {
  border:
    1px solid rgba(74, 145, 222, 0.23);
  background:
    linear-gradient(
      145deg,
      #173e5e,
      #0c2e49
    );
}

.rulesComparison article > span {
  color: #74899b;
  font-size: 0.55rem;
  font-weight: 800;
}

.aigoDecisioning > span {
  color: #68afff !important;
}

.rulesComparison h3 {
  margin: 17px 0 0;
  color: #17364e;
  font-size: 1.18rem;
}

.aigoDecisioning h3 {
  color: #eef6ff;
}

.rulesComparison article > div {
  margin-top: 19px;
  display: grid;
  gap: 7px;
}

.rulesComparison article > div span {
  padding: 9px 10px;
  border-radius: 8px;
  font-size: 0.67rem;
}

.rulesComparison article:first-child > div span {
  background:
    rgba(20, 48, 70, 0.04);
  color: #586f81;
}

.aigoDecisioning > div span {
  background:
    rgba(255, 255, 255, 0.045);
  color: #afc1d1;
}

.rulesBridge {
  text-align: center;
}

.rulesBridge > span {
  width: 85px;
  height: 2px;
  display: block;
  margin: 0 auto 9px;
  background:
    linear-gradient(
      to right,
      transparent,
      #5fa8ff,
      transparent
    );
}

.rulesBridge strong {
  color: #71869a;
  font-size: 0.61rem;
}


/* ============================================================
   DETERMINISTIC
   ============================================================ */

.deterministicSection {
  padding: 100px 0;
  background: #071b2e;
}

.deterministicFlow {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 9px;
}

.deterministicFlow article {
  min-width: 0;
  min-height: 165px;
  padding: 18px;
  border:
    1px solid rgba(99, 160, 228, 0.12);
  border-radius: 13px;
  background: #0b2943;
}

.deterministicFlow article > span {
  color: #718da6;
  font-size: 0.52rem;
  font-weight: 800;
}

.deterministicFlow article > strong {
  display: block;
  margin-top: 14px;
  color: #b7c7d5;
  font-size: 0.72rem;
}

.deterministicFlow article > b {
  display: block;
  margin-top: 9px;
  color: #eef6ff;
  font-size: 0.82rem;
}

.deterministicDecision {
  grid-column: 2 / 4;
  min-height: 140px !important;
  text-align: center;
  border-color:
    rgba(205, 158, 68, 0.27) !important;
  background:
    rgba(190, 137, 40, 0.07) !important;
}

.deterministicDecision > span {
  color: #d0a04a !important;
}

.deterministicDecision > strong {
  color: #f0c575 !important;
  font-size: 1.08rem !important;
}


/* ============================================================
   EXPLANATION
   ============================================================ */

.explanationSection {
  padding: 100px 0;
  background: #eee9dd;
}

.explanationWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    240px
    minmax(0, 1fr)
    260px;
  gap: 16px;
  align-items: stretch;
}

.explanationWorkspace > * {
  min-width: 0;
}

.explanationDecision {
  min-height: 340px;
  padding: 23px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border:
    1px solid rgba(70, 142, 219, 0.22);
  border-radius: 18px;
  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    );
  text-align: center;
}

.explanationDecision span {
  color: #68afff;
  font-size: 0.54rem;
  font-weight: 800;
}

.explanationDecision strong {
  margin-top: 14px;
  color: #eef6ff;
  font-size: 1.04rem;
  line-height: 1.4;
}

.explanationDecision small {
  margin-top: 10px;
  color: #8fa5b8;
  font-size: 0.6rem;
}

.explanationReasons {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.explanationReasons article {
  min-width: 0;
  padding: 14px;
  border:
    1px solid rgba(35, 58, 77, 0.09);
  border-radius: 10px;
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e5ded3
    );
}

.explanationReasons span {
  display: block;
  color: #74899b;
  font-size: 0.5rem;
  font-weight: 800;
}

.explanationReasons strong {
  display: block;
  margin-top: 6px;
  color: #203e54;
  font-size: 0.66rem;
  line-height: 1.4;
}

.requiredResponse {
  min-height: 340px;
  padding: 23px;
  border:
    1px solid rgba(192, 143, 52, 0.25);
  border-radius: 18px;
  background:
    rgba(192, 143, 52, 0.07);
}

.requiredResponse > span {
  color: #a4772a;
  font-size: 0.54rem;
  font-weight: 800;
}

.requiredResponse > strong {
  display: block;
  margin-top: 18px;
  padding: 11px;
  border-radius: 8px;
  background:
    rgba(122, 87, 28, 0.06);
  color: #6d4d1e;
  font-size: 0.7rem;
  line-height: 1.45;
}


/* ============================================================
   GOVERNANCE MOMENTS
   ============================================================ */

.momentsSection {
  padding: 100px 0;
  background: #081f34;
}

.momentGrid {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
  gap: 13px;
}

.momentGrid article {
  min-width: 0;
  min-height: 250px;
  padding: 22px;
  border:
    1px solid rgba(100, 160, 227, 0.13);
  border-radius: 17px;
  background: #0c2a45;
}

.momentGrid article > span {
  color: #718ea8;
  font-size: 0.55rem;
  font-weight: 800;
}

.momentGrid h3 {
  margin: 20px 0 0;
  color: #eef6ff;
  font-size: 1.15rem;
}

.momentGrid p {
  margin: 11px 0 0;
  color: #9bb0c2;
  font-size: 0.72rem;
  line-height: 1.58;
}

.integrationBoundary {
  margin-top: 22px;
  padding: 22px;
  border:
    1px solid rgba(205, 158, 68, 0.22);
  border-radius: 15px;
  background:
    rgba(192, 139, 40, 0.06);
}

.integrationBoundary span {
  display: block;
  color: #c99a46;
  font-size: 0.54rem;
  font-weight: 800;
}

.integrationBoundary strong {
  display: block;
  margin-top: 9px;
  color: #d9c39d;
  font-size: 0.82rem;
  line-height: 1.56;
}


/* ============================================================
   CONTROLLED ACTION
   ============================================================ */

.controlledActionSection {
  padding: 100px 0;
  background: #eee9dd;
}

.actionWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    240px
    minmax(0, 1fr)
    280px;
  gap: 18px;
  align-items: center;
}

.actionWorkspace > * {
  min-width: 0;
}

.actionDecision,
.connectedSystem {
  min-height: 270px;
  padding: 23px;
  border-radius: 17px;
}

.actionDecision {
  display: flex;
  flex-direction: column;
  justify-content: center;
  border:
    1px solid rgba(70, 142, 219, 0.22);
  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    );
}

.actionDecision span {
  color: #68afff;
  font-size: 0.54rem;
  font-weight: 800;
}

.actionDecision strong {
  margin-top: 13px;
  color: #eef6ff;
  font-size: 1rem;
  line-height: 1.4;
}

.integrationActions {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 8px;
}

.integrationActions span {
  padding: 13px;
  border:
    1px solid rgba(35, 58, 77, 0.09);
  border-radius: 10px;
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
  color: #526a7d;
  font-size: 0.68rem;
}

.connectedSystem {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.connectedSystem span {
  color: #74899b;
  font-size: 0.54rem;
  font-weight: 800;
}

.connectedSystem strong {
  display: block;
  margin-top: 16px;
  color: #17364e;
  font-size: 1.06rem;
}

.connectedSystem p {
  margin: 12px 0 0;
  color: #5c7182;
  font-size: 0.72rem;
  line-height: 1.58;
}


/* ============================================================
   HUMAN AUTHORITY
   ============================================================ */

.humanSection {
  padding: 100px 0;
  background: #071b2e;
}

.humanTransition {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    55px
    minmax(0, 1fr)
    55px
    minmax(0, 1fr)
    55px
    minmax(0, 1fr);
  gap: 7px;
  align-items: center;
}

.humanTransition > article {
  min-width: 0;
  min-height: 145px;
  padding: 17px;
  border:
    1px solid rgba(99, 160, 228, 0.12);
  border-radius: 13px;
  background: #0b2943;
}

.humanTransition > article span {
  color: #718da6;
  font-size: 0.52rem;
  font-weight: 800;
}

.humanTransition > article strong {
  display: block;
  margin-top: 18px;
  color: #dce7f1;
  font-size: 0.71rem;
  line-height: 1.42;
}

.humanTransition > div:not(.accountableRole) span {
  width: 100%;
  height: 1px;
  display: block;
  background:
    linear-gradient(
      to right,
      transparent,
      #5fa8ff,
      transparent
    );
}

.humanRequired {
  border-color:
    rgba(205, 158, 68, 0.27) !important;
  background:
    rgba(192, 139, 40, 0.07) !important;
}

.humanRequired span {
  color: #c99a46 !important;
}

.humanRequired strong {
  color: #efc572 !important;
}

.accountableRole {
  grid-column: 3 / 7;
  min-height: 135px;
  margin-top: 14px;
  padding: 20px;
  text-align: center;
  border:
    1px solid rgba(84, 146, 210, 0.22);
  border-radius: 14px;
  background:
    linear-gradient(
      145deg,
      #153b5c,
      #0c2b46
    );
}

.accountableRole span {
  display: block;
  color: #68afff;
  font-size: 0.53rem;
  font-weight: 800;
}

.accountableRole strong {
  display: block;
  margin-top: 8px;
  color: #eef6ff;
  font-size: 1rem;
}

.accountableRole small {
  display: block;
  margin-top: 7px;
  color: #8199ad;
  font-size: 0.59rem;
}

.triggerGrid {
  margin-top: 20px;
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 8px;
}

.triggerGrid span {
  padding: 11px;
  border:
    1px solid rgba(100, 160, 227, 0.11);
  border-radius: 9px;
  background:
    rgba(255, 255, 255, 0.035);
  color: #9eb2c4;
  font-size: 0.65rem;
}


/* ============================================================
   REASSESSMENT
   ============================================================ */

.reassessmentSection {
  padding: 100px 0;
  background: #eee9dd;
}

.timelineWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    220px
    minmax(0, 1fr)
    minmax(0, 0.72fr);
  gap: 13px;
}

.timelineWorkspace > * {
  min-width: 0;
}

.timelineControls {
  display: grid;
  align-content: start;
  gap: 8px;
}

.timelineButton,
.timelineButtonActive {
  min-height: 78px;
  padding: 12px;
  border-radius: 10px;
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.timelineButton {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.timelineButtonActive {
  border:
    1px solid rgba(77, 147, 225, 0.25);
  background: #163e5e;
}

.timelineButton span,
.timelineButtonActive span {
  display: block;
  color: #74899b;
  font-size: 0.53rem;
  font-weight: 800;
}

.timelineButtonActive span {
  color: #68afff;
}

.timelineButton strong,
.timelineButtonActive strong {
  display: block;
  margin-top: 6px;
  font-size: 0.65rem;
  line-height: 1.35;
}

.timelineButton strong {
  color: #365268;
}

.timelineButtonActive strong {
  color: #eef6ff;
}

.timelineContext,
.timelineDecision {
  min-height: 350px;
  padding: 22px;
  border-radius: 18px;
}

.timelineContext {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.timelineContext > span,
.timelineDecision > span {
  color: #74899b;
  font-size: 0.55rem;
  font-weight: 800;
}

.timelineContext dl {
  margin: 18px 0 0;
  display: grid;
  gap: 8px;
}

.timelineContext dl div {
  padding: 10px;
  border-radius: 8px;
  background:
    rgba(20, 48, 70, 0.04);
}

.timelineContext dt {
  color: #74899b;
  font-size: 0.53rem;
}

.timelineContext dd {
  margin: 4px 0 0;
  color: #203e54;
  font-size: 0.69rem;
  font-weight: 700;
}

.timelineDecision {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.timelineDecision strong {
  margin-top: 15px;
  font-size: 1.13rem;
  line-height: 1.4;
}

.timelineContinue {
  border:
    1px solid rgba(79, 158, 105, 0.22);
  background:
    rgba(78, 157, 104, 0.08);
}

.timelineContinue strong {
  color: #3d7e52;
}

.timelineReassess {
  border:
    1px solid rgba(75, 143, 214, 0.21);
  background:
    rgba(67, 130, 195, 0.07);
}

.timelineReassess strong {
  color: #3e729f;
}

.timelineControl {
  border:
    1px solid rgba(192, 143, 52, 0.25);
  background:
    rgba(193, 143, 49, 0.07);
}

.timelineControl strong {
  color: #946a21;
}

.timelineBlocked {
  border:
    1px solid rgba(176, 102, 79, 0.22);
  background:
    rgba(165, 86, 66, 0.075);
}

.timelineBlocked strong {
  color: #984e3c;
}


/* ============================================================
   EVIDENCE
   ============================================================ */

.evidenceSection {
  padding: 100px 0;
  background: #081f34;
}

.evidenceFlow {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    repeat(6, minmax(0, 1fr));
  gap: 8px;
}

.evidenceFlow article {
  min-width: 0;
  min-height: 150px;
  padding: 16px;
  border:
    1px solid rgba(99, 160, 228, 0.12);
  border-radius: 12px;
  background: #0b2943;
}

.evidenceFlow article span {
  color: #718da6;
  font-size: 0.5rem;
  font-weight: 800;
}

.evidenceFlow article strong {
  display: block;
  margin-top: 20px;
  color: #dce7f1;
  font-size: 0.66rem;
  line-height: 1.42;
}

.futureEvidence {
  opacity: 0.78;
}

.receiptPreview {
  border-color:
    rgba(205, 158, 68, 0.25) !important;
  background:
    rgba(192, 139, 40, 0.07) !important;
}

.receiptPreview span {
  color: #c99a46 !important;
}

.receiptPreview strong {
  color: #efc572 !important;
}


/* ============================================================
   PLATFORM ROLE
   ============================================================ */

.roleSection {
  padding: 100px 0;
  background: #eee9dd;
}

.roleSection .sectionIntro h2 {
  color: #102e47;
}

.platformRail {
  margin-top: 52px;
  display: grid;
  grid-template-columns:
    repeat(6, minmax(0, 1fr));
  gap: 8px;
}

.platformStage,
.platformStageActive,
.platformStageComplete {
  min-width: 0;
  min-height: 130px;
  padding: 16px;
  border-radius: 13px;
}

.platformStage {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.platformStageComplete {
  border:
    1px solid rgba(78, 154, 101, 0.17);
  background:
    rgba(58, 130, 81, 0.07);
}

.platformStageActive {
  border:
    1px solid rgba(74, 145, 222, 0.26);
  background:
    linear-gradient(
      145deg,
      #173e5e,
      #0c2e49
    );
}

.platformStage span,
.platformStageActive span,
.platformStageComplete span {
  color: #71879a;
  font-size: 0.53rem;
  font-weight: 800;
}

.platformStageActive span {
  color: #68afff;
}

.platformStageComplete span {
  color: #489765;
}

.platformStage strong,
.platformStageActive strong,
.platformStageComplete strong {
  display: block;
  margin-top: 22px;
  font-size: 0.71rem;
  line-height: 1.4;
}

.platformStage strong,
.platformStageComplete strong {
  color: #17364e;
}

.platformStageActive strong {
  color: #eef6ff;
}

.platformStage small,
.platformStageActive small,
.platformStageComplete small {
  display: block;
  margin-top: 7px;
  color: #718ca5;
  font-size: 0.53rem;
}


/* ============================================================
   FINAL CTA
   ============================================================ */

.finalCta {
  position: relative;
  overflow: hidden;
  padding: 105px 48px;
  background: #051423;
}

.finalGlow {
  position: absolute;
  left: 50%;
  top: -180px;
  width: 720px;
  height: 400px;
  transform: translateX(-50%);
  border-radius: 50%;
  background:
    rgba(47, 124, 255, 0.12);
  filter: blur(80px);
}

.finalInner {
  position: relative;
  z-index: 1;
  max-width: 980px;
  margin-inline: auto;
  text-align: center;
}

.finalInner h2 {
  margin: 18px 0 0;
  color: #f2f7fd;
  font-size:
    clamp(2.65rem, 4vw, 4.45rem);
  line-height: 1;
  letter-spacing: -0.048em;
}

.finalInner > p {
  max-width: 750px;
  margin: 23px auto 0;
  color: #aebed0;
  font-size: 0.97rem;
  line-height: 1.7;
}

.finalInner .heroActions {
  justify-content: center;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1180px) {
  .shell {
    padding-inline: 36px;
  }

  .heroLayout {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 0.95fr);
    gap: 58px;
  }

  .heroTitle {
    font-size:
      clamp(2.85rem, 3.9vw, 4rem);
  }

  .heroDecisionVisual {
    max-width: 560px;
  }

  .darkHeadline,
  .lightHeadline,
  .darkRoleTitle,
  .sectionIntro h2 {
    font-size:
      clamp(2.35rem, 3.25vw, 3.45rem);
  }

  .inputGrid,
  .outcomeGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .platformRail,
  .evidenceFlow {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  .shell {
    padding-inline: 28px;
  }

  .heroLayout,
  .editorialGrid {
    grid-template-columns: 1fr;
  }

  .heroCopy {
    max-width: 760px;
  }

  .heroDecisionVisual {
    max-width: 700px;
    margin-inline: auto;
  }

  .heroStatement {
    grid-template-columns: 1fr;
  }

  .statementPath {
    display: none;
  }

  .scenarioWorkspace {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .scenarioControls {
    grid-column: 1 / -1;
    grid-template-columns:
      repeat(4, minmax(0, 1fr));
  }

  .policyWorkspace,
  .rulesComparison,
  .explanationWorkspace,
  .actionWorkspace,
  .timelineWorkspace {
    grid-template-columns: 1fr;
  }

  .rulesBridge {
    padding: 14px 0;
  }

  .deterministicFlow {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .deterministicDecision {
    grid-column: 1 / -1;
  }

  .humanTransition {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .humanTransition > div:not(.accountableRole) {
    display: none;
  }

  .accountableRole {
    grid-column: 1 / -1;
  }

  .triggerGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 700px) {
  .shell {
    padding-inline: 20px;
  }

  .keepLine {
    display: inline;
    white-space: normal;
  }

  .keepLine + .keepLine::before {
    content: " ";
  }

  .hero {
    padding: 60px 0 72px;
  }

  .heroTitle {
    font-size:
      clamp(2.45rem, 10vw, 3.45rem);
  }

  .darkHeadline,
  .lightHeadline,
  .darkRoleTitle,
  .sectionIntro h2 {
    font-size:
      clamp(2.2rem, 9vw, 3.05rem);
  }

  .heroDecisionVisual {
    min-height: 590px;
    transform: scale(0.9);
    transform-origin: top center;
    margin-bottom: -55px;
  }

  .contextSection,
  .inputsSection,
  .outcomesSection,
  .policySection,
  .rulesSection,
  .deterministicSection,
  .explanationSection,
  .momentsSection,
  .controlledActionSection,
  .humanSection,
  .reassessmentSection,
  .evidenceSection,
  .roleSection {
    padding: 74px 0;
  }

  .scenarioWorkspace,
  .inputGrid,
  .outcomeGrid,
  .deterministicFlow,
  .momentGrid,
  .explanationReasons,
  .integrationActions,
  .humanTransition,
  .triggerGrid,
  .platformRail,
  .evidenceFlow {
    grid-template-columns: 1fr;
  }

  .scenarioControls {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .deterministicDecision,
  .accountableRole {
    grid-column: auto;
  }

  .heroActions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .heroActions a {
    width: 100%;
  }

  .finalCta {
    padding: 80px 20px;
  }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .inputCluster article {
    animation: none !important;
  }

  .primaryButton,
  .secondaryButton,
  .darkSecondaryButton,
  .scenarioButton,
  .scenarioButtonActive,
  .timelineButton,
  .timelineButtonActive {
    transition: none !important;
  }
}

/* ============================================================
   PAGE 06 HERO DIAGRAM FINAL OVERRIDE
   Structural grid. No overlapping absolute cards.
   ============================================================ */

.heroDecisionVisual {
  position: relative !important;

  width: 100% !important;
  max-width: 650px !important;

  min-height: 0 !important;
  height: auto !important;

  margin-left: auto !important;

  padding: 0 !important;

  overflow: visible !important;

  display: grid !important;

  grid-template-columns:
    172px
    minmax(205px, 220px)
    172px !important;

  grid-template-rows:
    auto
    repeat(4, 72px) !important;

  column-gap: 24px !important;
  row-gap: 17px !important;

  justify-content: center !important;
  align-content: center !important;
  align-items: center !important;
}


/* ============================================================
   DIAGRAM TITLE
   Keep it attached directly to the visual.
   ============================================================ */

.visualLabel {
  position: static !important;

  grid-column: 1 / 4 !important;
  grid-row: 1 !important;

  z-index: 20 !important;

  width: 100% !important;
  max-width: none !important;

  margin: 0 0 9px !important;

  transform: none !important;

  text-align: center !important;
}

.visualLabel span {
  display: block !important;

  color: #69adff !important;

  font-size: 0.56rem !important;
  line-height: 1.25 !important;

  font-weight: 800 !important;
  letter-spacing: 0.11em !important;

  text-transform: uppercase !important;
}

.visualLabel strong {
  display: block !important;

  margin-top: 5px !important;

  color: #91a8bb !important;

  font-size: 0.66rem !important;
  line-height: 1.4 !important;
}


/* ============================================================
   IMPORTANT:
   Allow cards inside inputCluster to participate directly
   in the heroDecisionVisual grid.
   ============================================================ */

.inputCluster {
  display: contents !important;
}


/* Remove all old cluster decorations that can confuse layout */

.inputCluster::before,
.inputCluster::after {
  display: none !important;
}


/* ============================================================
   ALL CONTEXT CARDS
   ============================================================ */

.inputCluster article {
  position: static !important;

  top: auto !important;
  right: auto !important;
  bottom: auto !important;
  left: auto !important;

  z-index: 5 !important;

  width: 172px !important;
  min-width: 172px !important;
  max-width: 172px !important;

  min-height: 60px !important;
  height: auto !important;

  margin: 0 !important;

  padding: 10px 12px !important;

  transform: none;

  border:
    1px solid rgba(103, 170, 247, 0.22) !important;

  border-radius: 10px !important;

  background:
    linear-gradient(
      145deg,
      rgba(14, 47, 76, 0.99),
      rgba(8, 34, 57, 0.99)
    ) !important;

  box-shadow:
    6px 9px 17px
    rgba(0, 0, 0, 0.18) !important;

  animation:
    page06ContextGlow
    12s
    ease-in-out
    infinite !important;
}

.inputCluster article span {
  display: block !important;

  color: #69adff !important;

  font-size: 0.46rem !important;
  line-height: 1.2 !important;

  font-weight: 800 !important;

  white-space: normal !important;
}

.inputCluster article strong {
  display: block !important;

  margin-top: 5px !important;

  color: #d6e4ef !important;

  font-size: 0.56rem !important;
  line-height: 1.32 !important;

  font-weight: 700 !important;

  white-space: normal !important;
  overflow-wrap: normal !important;
  word-break: normal !important;
}


/* ============================================================
   EXACT GRID POSITIONS
   LEFT
   ============================================================ */

.heroActor {
  grid-column: 1 !important;
  grid-row: 2 !important;

  animation-delay: 0s !important;
}

.heroAuthority {
  grid-column: 1 !important;
  grid-row: 3 !important;

  animation-delay: 1.15s !important;
}

.heroPayment {
  grid-column: 1 !important;
  grid-row: 4 !important;

  animation-delay: 2.3s !important;
}

.heroVerification {
  grid-column: 1 !important;
  grid-row: 5 !important;

  animation-delay: 3.45s !important;
}


/* ============================================================
   EXACT GRID POSITIONS
   RIGHT
   ============================================================ */

.heroActivity {
  grid-column: 3 !important;
  grid-row: 2 !important;

  animation-delay: 4.6s !important;
}

.heroSignificance {
  grid-column: 3 !important;
  grid-row: 3 !important;

  animation-delay: 5.75s !important;
}

.heroSupplier {
  grid-column: 3 !important;
  grid-row: 4 !important;

  animation-delay: 6.9s !important;
}

.heroControl {
  grid-column: 3 !important;
  grid-row: 5 !important;

  animation-delay: 8.05s !important;
}


/* ============================================================
   CENTER GOVERNANCE DECISION
   No absolute positioning.
   It owns the middle column.
   ============================================================ */

.decisionCore {
  position: static !important;

  grid-column: 2 !important;
  grid-row: 2 / 6 !important;

  z-index: 10 !important;

  align-self: center !important;

  width: 100% !important;
  max-width: 220px !important;

  min-width: 0 !important;

  min-height: 228px !important;
  height: auto !important;

  margin: 0 !important;

  padding: 18px 15px !important;

  transform: none !important;

  display: flex !important;
  flex-direction: column !important;
  justify-content: center !important;

  text-align: center !important;

  border:
    1px solid rgba(205, 158, 68, 0.42) !important;

  border-radius: 18px !important;

  background:
    radial-gradient(
      circle at 50% 0%,
      rgba(205, 158, 68, 0.1),
      transparent 42%
    ),
    linear-gradient(
      145deg,
      #153b58,
      #103149
    ) !important;

  box-shadow:
    0 0 20px
      rgba(191, 136, 37, 0.08),
    9px 14px 25px
      rgba(0, 0, 0, 0.21) !important;

  animation:
    page06DecisionGlow
    12s
    ease-in-out
    infinite !important;
}

.decisionCore > span {
  display: block !important;

  color: #d0a04b !important;

  font-size: 0.47rem !important;
  line-height: 1.25 !important;

  font-weight: 800 !important;
}

.decisionCore > strong {
  display: block !important;

  margin-top: 9px !important;

  color: #f2c975 !important;

  font-size: 0.84rem !important;
  line-height: 1.32 !important;

  font-weight: 800 !important;
}

.decisionCore > p {
  margin: 10px 0 0 !important;

  color: #b4c5d2 !important;

  font-size: 0.53rem !important;
  line-height: 1.5 !important;
}


/* ============================================================
   NEXT STATE
   ============================================================ */

.decisionRoute {
  margin-top: 12px !important;

  padding: 9px 7px !important;

  border:
    1px solid rgba(103, 172, 251, 0.17) !important;

  border-radius: 8px !important;

  background:
    rgba(255, 255, 255, 0.035) !important;
}

.decisionRoute span {
  display: block !important;

  color: #8299ad !important;

  font-size: 0.41rem !important;
  line-height: 1.2 !important;

  font-weight: 800 !important;
}

.decisionRoute b {
  display: block !important;

  margin-top: 4px !important;

  color: #d6e1e9 !important;

  font-size: 0.47rem !important;
  line-height: 1.32 !important;

  font-weight: 800 !important;
}


/* ============================================================
   STRONG SEQUENTIAL BLUE GLOW
   Text stays visible throughout.
   ============================================================ */

@keyframes page06ContextGlow {
  0%,
  100% {
    border-color:
      rgba(103, 170, 247, 0.22);

    box-shadow:
      6px 9px 17px
      rgba(0, 0, 0, 0.18);

    filter: brightness(1);

    transform: translateY(0);
  }

  5% {
    border-color:
      rgba(105, 181, 255, 0.7);

    box-shadow:
      0 0 10px
        rgba(66, 159, 255, 0.3),
      6px 9px 17px
        rgba(0, 0, 0, 0.18);
  }

  9% {
    border-color:
      rgba(108, 190, 255, 1);

    box-shadow:
      0 0 7px
        rgba(83, 178, 255, 0.85),
      0 0 22px
        rgba(53, 149, 255, 0.55),
      0 0 38px
        rgba(46, 130, 241, 0.22),
      6px 9px 17px
        rgba(0, 0, 0, 0.18);

    filter: brightness(1.13);

    transform: translateY(-2px);
  }

  15% {
    border-color:
      rgba(103, 174, 248, 0.42);

    box-shadow:
      0 0 12px
        rgba(55, 148, 255, 0.17),
      6px 9px 17px
        rgba(0, 0, 0, 0.18);

    filter: brightness(1);

    transform: translateY(0);
  }

  20% {
    border-color:
      rgba(103, 170, 247, 0.22);

    box-shadow:
      6px 9px 17px
        rgba(0, 0, 0, 0.18);
  }
}


/* ============================================================
   GOLD CENTER RESPONSE
   ============================================================ */

@keyframes page06DecisionGlow {
  0%,
  76%,
  100% {
    border-color:
      rgba(205, 158, 68, 0.42);

    box-shadow:
      0 0 20px
        rgba(191, 136, 37, 0.08),
      9px 14px 25px
        rgba(0, 0, 0, 0.21);

    filter: brightness(1);
  }

  82% {
    border-color:
      rgba(240, 183, 76, 1);

    box-shadow:
      0 0 8px
        rgba(238, 177, 65, 0.65),
      0 0 26px
        rgba(220, 156, 44, 0.34),
      0 0 48px
        rgba(198, 132, 27, 0.15),
      9px 14px 25px
        rgba(0, 0, 0, 0.21);

    filter: brightness(1.08);
  }

  90% {
    border-color:
      rgba(205, 158, 68, 0.48);

    box-shadow:
      0 0 18px
        rgba(191, 136, 37, 0.12),
      9px 14px 25px
        rgba(0, 0, 0, 0.21);

    filter: brightness(1);
  }
}


