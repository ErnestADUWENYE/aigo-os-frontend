.page {
  --navy-950: #06192b;
  --navy-900: #082239;
  --navy-850: #0b2a46;
  --navy-800: #103654;
  --navy-700: #174564;
  --ink: #102e49;
  --muted: #617a93;
  --muted-light: #a9bdd1;
  --blue: #2f8cff;
  --blue-bright: #65aeff;
  --gold: #d7a640;
  --cream: #f2ede1;
  --cream-2: #ebe5d8;
  --white: #f8fbff;
  --green: #63d58b;

  overflow: hidden;

  background: var(--cream);

  color: var(--ink);
}

.shell {
  width: min(1480px, calc(100% - 96px));

  margin-inline: auto;
}

.blueEyebrow,
.goldEyebrow {
  margin: 0;

  font-size: 12px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.14em;
}

.blueEyebrow {
  color: var(--blue-bright);
}

.goldEyebrow {
  color: var(--gold);
}


/* ============================================================
   HERO
   ============================================================ */

.hero {
  position: relative;

  min-height: 760px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 78% 28%,
      rgba(43, 132, 232, 0.18),
      transparent 32%
    ),
    linear-gradient(
      135deg,
      #06192b,
      #08243d 58%,
      #061a2d
    );

  color: var(--white);
}

.heroGrid {
  position: absolute;
  inset: 0;

  opacity: 0.16;

  background-image:
    linear-gradient(
      rgba(112, 170, 225, 0.12) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(112, 170, 225, 0.12) 1px,
      transparent 1px
    );

  background-size: 58px 58px;
}

.heroGlow {
  position: absolute;

  width: 780px;
  height: 780px;

  right: -220px;
  top: -220px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(45, 144, 255, 0.20),
      rgba(45, 144, 255, 0.04) 46%,
      transparent 70%
    );

  filter: blur(10px);
}

.heroLayout {
  position: relative;
  z-index: 2;

  min-height: 760px;

  display: grid;
  grid-template-columns:
    minmax(0, 0.88fr)
    minmax(600px, 1.12fr);

  align-items: center;

  gap: clamp(54px, 6vw, 110px);

  padding-block: 76px 82px;
}

.heroCopy {
  max-width: 650px;
}

.heroTitle {
  margin: 22px 0 24px;

  font-size: clamp(50px, 5.25vw, 82px);
  line-height: 0.98;
  font-weight: 800;

  letter-spacing: -0.055em;
}

.heroTitle span {
  display: block;
}

.heroTitle span + span {
  margin-top: 12px;

  color: #b8cae0;

  font-size: 0.78em;
  line-height: 1.04;
  font-weight: 660;

  letter-spacing: -0.045em;
}

.heroLead {
  max-width: 640px;

  margin: 0;

  color: #bed0e2;

  font-size: 19px;
  line-height: 1.72;
}

.heroActions {
  display: flex;
  flex-wrap: wrap;

  gap: 14px;

  margin-top: 32px;
}

.primaryButton,
.secondaryButton {
  min-height: 56px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  padding: 0 26px;

  border-radius: 12px;

  font-size: 15px;
  font-weight: 780;

  text-decoration: none;

  transition:
    transform 160ms ease,
    box-shadow 160ms ease,
    background 160ms ease;
}

.primaryButton {
  background:
    linear-gradient(
      145deg,
      #3790ff,
      #2476e5
    );

  color: #ffffff;

  box-shadow:
    0 12px 26px rgba(24, 117, 229, 0.24),
    inset 0 1px 0 rgba(255,255,255,0.2);
}

.primaryButton:hover {
  transform: translateY(-2px);

  box-shadow:
    0 16px 34px rgba(24, 117, 229, 0.34);
}

.secondaryButton {
  border: 1px solid rgba(162, 203, 241, 0.22);

  background: rgba(255,255,255,0.05);

  color: #ffffff;
}

.secondaryButton:hover {
  background: rgba(255,255,255,0.09);
}

.heroPrinciples {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 12px 20px;

  margin-top: 34px;
}

.heroPrinciples span {
  display: flex;
  align-items: center;

  gap: 8px;

  color: #9fb7cf;

  font-size: 13px;
  font-weight: 650;
}

.heroPrinciples svg {
  color: var(--green);
}


/* ============================================================
   HERO PLATFORM VISUAL
   ============================================================ */

.heroPlatformVisual {
  position: relative;

  min-width: 0;

  padding: 20px;

  perspective: 1200px;
}

.previewSources {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 14px;
}

.previewSources > div {
  min-height: 154px;

  padding: 18px;

  border: 1px solid rgba(97, 167, 230, 0.22);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      rgba(17, 57, 89, 0.82),
      rgba(8, 35, 58, 0.92)
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.04),
    0 18px 35px rgba(0,0,0,0.18);
}

.previewSources span,
.previewCoreHeader span,
.previewOutcome span {
  display: block;

  margin-bottom: 12px;

  color: #77b8ff;

  font-size: 10px;
  font-weight: 850;

  letter-spacing: 0.11em;
}

.previewSources strong {
  display: block;

  margin-top: 7px;

  padding: 8px 10px;

  border-radius: 8px;

  background: rgba(255,255,255,0.055);

  color: #c5d7e8;

  font-size: 12px;
  font-weight: 620;
}

.previewConnector {
  position: relative;

  width: 2px;
  height: 58px;

  margin: 0 auto;

  background: rgba(90, 164, 239, 0.44);
}

.previewConnector b {
  position: absolute;

  width: 8px;
  height: 8px;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background: #67abff;

  box-shadow:
    0 0 18px rgba(83, 164, 255, 0.9);
}

.previewCore {
  position: relative;

  padding: 28px;

  border: 1px solid rgba(94, 169, 238, 0.28);
  border-radius: 26px;

  background:
    linear-gradient(
      150deg,
      rgba(17, 57, 91, 0.98),
      rgba(7, 34, 57, 0.98)
    );

  box-shadow:
    0 30px 60px rgba(0, 10, 24, 0.32),
    inset 0 1px 0 rgba(255,255,255,0.05);

  transform: rotateX(1deg) rotateY(-1deg);
}

.previewCore::before {
  content: "";

  position: absolute;
  inset: 10px;

  pointer-events: none;

  border: 1px solid rgba(72, 150, 223, 0.11);
  border-radius: 18px;
}

.previewCoreHeader {
  position: relative;
  z-index: 1;
}

.previewCoreHeader strong {
  color: #ffffff;

  font-size: 26px;
}

.previewCapabilityGrid {
  position: relative;
  z-index: 1;

  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 10px;

  margin-top: 24px;
}

.previewCapabilityGrid span {
  min-height: 45px;

  display: flex;
  align-items: center;
  justify-content: center;

  padding: 9px;

  border: 1px solid rgba(94, 166, 231, 0.16);
  border-radius: 10px;

  background: rgba(255,255,255,0.045);

  color: #b8cee3;

  font-size: 11px;
  font-weight: 680;

  text-align: center;
}

.previewOutcome {
  position: relative;
  z-index: 1;

  margin-top: 22px;
  padding: 18px;

  border: 1px solid rgba(210, 166, 65, 0.30);
  border-radius: 15px;

  background:
    linear-gradient(
      135deg,
      rgba(209, 164, 62, 0.09),
      rgba(255,255,255,0.03)
    );
}

.previewOutcome span {
  color: var(--gold);
}

.previewOutcome strong {
  color: #ffffff;

  font-size: 16px;
}


/* ============================================================
   SHARED SECTION HEADINGS
   ============================================================ */

.sectionIntro {
  display: grid;
  grid-template-columns:
    minmax(0, 1.35fr)
    minmax(360px, 0.65fr);

  align-items: end;

  gap: 70px;

  margin-bottom: 46px;
}

.sectionIntro h2,
.centerHeading h2,
.integrationPanel h2,
.finalPanel h2 {
  margin: 14px 0 0;

  font-size: clamp(42px, 4vw, 64px);
  line-height: 1.02;
  font-weight: 800;

  letter-spacing: -0.05em;
}

.sectionIntro > p {
  max-width: 520px;

  margin: 0 0 5px;

  color: var(--muted);

  font-size: 17px;
  line-height: 1.7;
}

.centerHeading {
  max-width: 900px;

  margin: 0 auto 48px;

  text-align: center;
}

.centerHeading > p:last-child {
  max-width: 710px;

  margin: 20px auto 0;

  color: var(--muted);

  font-size: 16px;
  line-height: 1.7;
}


/* ============================================================
   PLATFORM ARCHITECTURE
   ============================================================ */

.architecture {
  padding: 112px 0 124px;

  background:
    linear-gradient(
      180deg,
      #f3eee3,
      #ebe5d8
    );
}

.architectureBoard {
  position: relative;

  padding: 32px;

  border: 1px solid rgba(17, 52, 82, 0.11);
  border-radius: 30px;

  background:
    radial-gradient(
      circle at 50% 40%,
      rgba(51, 135, 221, 0.11),
      transparent 34%
    ),
    linear-gradient(
      145deg,
      #071e33,
      #0b2b48
    );

  box-shadow:
    0 35px 70px rgba(21, 39, 54, 0.18),
    inset 0 1px 0 rgba(255,255,255,0.05);

  overflow: hidden;
}

.architectureInputs {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 18px;
}

.architectureInputs article {
  padding: 22px;

  border: 1px solid rgba(95, 160, 220, 0.18);
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      rgba(20, 59, 91, 0.76),
      rgba(9, 37, 61, 0.82)
    );

  transition:
    transform 220ms ease,
    border-color 220ms ease,
    box-shadow 220ms ease;
}

.architectureInputs .contextCardActive {
  transform: translateY(-2px);

  border-color: rgba(91, 175, 255, 0.62);

  box-shadow:
    0 0 0 1px rgba(74, 164, 255, 0.12),
    0 0 32px rgba(39, 137, 238, 0.18);
}

.contextIcon {
  width: 38px;
  height: 38px;

  display: grid;
  place-items: center;

  margin-bottom: 20px;

  border-radius: 11px;

  background: rgba(71, 157, 245, 0.11);

  color: #72b5ff;
}

.architectureInputs article > span,
.coreHeading span,
.activeExplanation span,
.outcomeGrid span,
.integrationVisual span {
  display: block;

  color: #73b6fb;

  font-size: 9px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.11em;
}

.architectureInputs article > strong {
  display: block;

  margin-top: 8px;

  color: #f1f7fd;

  font-size: 17px;
}

.contextTags {
  display: flex;
  flex-wrap: wrap;

  gap: 8px;

  margin-top: 18px;
}

.contextTags b {
  padding: 8px 10px;

  border-radius: 8px;

  background: rgba(255,255,255,0.05);

  color: #b7ccdf;

  font-size: 11px;
  font-weight: 600;
}

.architectureFlow {
  height: 68px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  gap: 5px;

  color: #7596b5;

  font-size: 8px;
  font-weight: 800;

  letter-spacing: 0.1em;
}

.architectureFlow i {
  display: block;

  width: 1px;
  height: 24px;

  background:
    linear-gradient(
      #507fa7,
      #62acff
    );
}

.architectureFlow b {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #63aaff;

  box-shadow:
    0 0 15px rgba(85, 166, 255, 0.9);
}

.architectureCore {
  padding: 26px;

  border: 1px solid rgba(83, 156, 225, 0.27);
  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      rgba(14, 52, 82, 0.96),
      rgba(6, 29, 49, 0.98)
    );

  box-shadow:
    0 25px 45px rgba(0,0,0,0.20),
    inset 0 1px 0 rgba(255,255,255,0.045);
}

.coreHeading {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 24px;
}

.coreHeading strong {
  display: block;

  margin-top: 5px;

  color: #ffffff;

  font-size: 28px;
}

.liveIndicator {
  display: flex;
  align-items: center;

  gap: 8px;

  color: #7edc9b;

  font-size: 9px;
  font-weight: 800;

  letter-spacing: 0.08em;
}

.liveIndicator i {
  width: 8px;
  height: 8px;

  border-radius: 50%;

  background: #67d68e;

  box-shadow:
    0 0 16px rgba(99, 213, 139, 0.9);
}

.coreCapabilityGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 12px;

  margin-top: 24px;
}

.coreCapability {
  min-width: 0;
  min-height: 86px;

  display: flex;
  align-items: center;

  gap: 13px;

  padding: 14px;

  cursor: pointer;

  border: 1px solid rgba(91, 154, 210, 0.14);
  border-radius: 13px;

  background: rgba(255,255,255,0.035);

  color: inherit;

  text-align: left;

  transition:
    transform 220ms ease,
    border-color 220ms ease,
    background 220ms ease,
    box-shadow 220ms ease;
}

.coreCapability:hover {
  transform: translateY(-2px);

  border-color: rgba(91, 174, 248, 0.40);

  background: rgba(255,255,255,0.055);
}

.coreCapabilityActive {
  transform: translateY(-3px);

  border-color: rgba(89, 175, 255, 0.88);

  background:
    linear-gradient(
      145deg,
      rgba(39, 122, 203, 0.22),
      rgba(255,255,255,0.055)
    );

  box-shadow:
    0 0 0 1px rgba(58, 150, 241, 0.11),
    0 0 26px rgba(51, 141, 230, 0.22);
}

.coreCapabilityIcon {
  flex: 0 0 auto;

  width: 40px;
  height: 40px;

  display: grid;
  place-items: center;

  border-radius: 11px;

  background: rgba(65, 153, 240, 0.10);

  color: #6eb4ff;
}

.coreCapability strong,
.coreCapability small {
  display: block;
}

.coreCapability strong {
  color: #eef6fd;

  font-size: 12px;
  line-height: 1.3;
}

.coreCapability small {
  margin-top: 4px;

  color: #7f9bb6;

  font-size: 9px;
  line-height: 1.35;
}

.activeExplanation {
  display: grid;
  grid-template-columns:
    minmax(180px, 1fr)
    minmax(160px, 0.85fr)
    auto
    minmax(160px, 0.85fr);

  align-items: center;

  gap: 18px;

  margin-top: 20px;
  padding: 18px;

  border: 1px solid rgba(212, 169, 69, 0.22);
  border-radius: 14px;

  background:
    linear-gradient(
      135deg,
      rgba(217, 169, 56, 0.08),
      rgba(255,255,255,0.025)
    );
}

.activeExplanation > div:first-child span {
  color: var(--gold);
}

.activeExplanation strong {
  display: block;

  margin-top: 6px;

  color: #ffffff;

  font-size: 16px;
}

.activeExplanation b {
  display: block;

  margin-top: 5px;

  color: #b8ccde;

  font-size: 10px;
  font-weight: 620;
}

.explanationArrow {
  color: #d2a744;
}

.outcomeGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 12px;
}

.outcomeGrid article {
  min-height: 118px;

  padding: 18px;

  border: 1px solid rgba(90, 156, 215, 0.17);
  border-radius: 16px;

  background: rgba(255,255,255,0.035);

  color: #80bfff;

  transition:
    transform 220ms ease,
    border-color 220ms ease,
    background 220ms ease,
    box-shadow 220ms ease;
}

.outcomeGrid .outcomeActive {
  transform: translateY(-3px);

  border-color: rgba(89, 178, 255, 0.72);

  background: rgba(46, 133, 219, 0.14);

  box-shadow:
    0 0 26px rgba(46, 139, 232, 0.18);
}

.outcomeGrid span {
  margin-top: 16px;
}

.outcomeGrid strong {
  display: block;

  margin-top: 7px;

  color: #dce9f5;

  font-size: 12px;
  line-height: 1.4;
}


/* ============================================================
   OPERATING MODEL
   ============================================================ */

.operatingModel {
  padding: 118px 0;

  background: #f7f4ec;
}

.stageGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 20px;
}

.stageCard {
  min-height: 470px;

  padding: 28px;

  border: 1px solid rgba(17, 49, 77, 0.12);
  border-radius: 22px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5f3ec
    );

  box-shadow:
    0 16px 34px rgba(43, 56, 67, 0.07);
}

.stageTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.stageTop > span {
  color: var(--blue);

  font-size: 11px;
  font-weight: 850;
}

.stageTop > div {
  width: 44px;
  height: 44px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background: #e8f2fc;

  color: #277fd5;
}

.stageCard h3 {
  margin: 35px 0 12px;

  font-size: 29px;
  line-height: 1.05;

  letter-spacing: -0.035em;
}

.stageCard > p {
  min-height: 112px;

  margin: 0;

  color: var(--muted);

  font-size: 15px;
  line-height: 1.65;
}

.stageVisual {
  position: relative;

  min-height: 160px;

  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  align-content: center;

  gap: 10px;

  margin-top: 30px;
  padding: 22px;

  overflow: hidden;

  border-radius: 15px;

  background:
    linear-gradient(
      rgba(35, 108, 179, 0.04) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(35, 108, 179, 0.04) 1px,
      transparent 1px
    ),
    #f6f8fa;

  background-size: 28px 28px;
}

.stageVisual span {
  position: relative;
  z-index: 2;

  display: flex;
  align-items: center;
  justify-content: center;

  min-height: 38px;

  padding: 8px;

  border: 1px solid #d8e2eb;
  border-radius: 9px;

  background: rgba(255,255,255,0.9);

  color: #46637d;

  font-size: 10px;
  font-weight: 650;

  text-align: center;
}

.stageVisual .stageTagActive {
  border-color: rgba(50, 137, 225, 0.42);

  background: #e9f4ff;

  color: #1e6dbd;

  box-shadow:
    0 5px 16px rgba(34, 116, 198, 0.10);
}

.stageVisual i {
  position: absolute;

  width: 110px;
  height: 2px;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  background:
    linear-gradient(
      90deg,
      transparent,
      #72aae0,
      transparent
    );
}


/* ============================================================
   ADVANTAGES
   ============================================================ */

.advantages {
  padding: 116px 0;

  background:
    linear-gradient(
      145deg,
      #071d31,
      #0b2c48
    );

  color: var(--white);
}

.advantages .sectionIntro > p {
  color: #a9bfd4;
}

.advantageGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 18px;
}

.advantageCard {
  min-height: 280px;

  padding: 26px;

  border: 1px solid rgba(91, 159, 220, 0.17);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      rgba(22, 66, 101, 0.62),
      rgba(8, 34, 56, 0.78)
    );

  box-shadow:
    inset 0 1px 0 rgba(255,255,255,0.035),
    0 18px 32px rgba(0,0,0,0.13);

  transition:
    transform 180ms ease,
    border-color 180ms ease;
}

.advantageCard:hover {
  transform: translateY(-3px);

  border-color: rgba(92, 173, 247, 0.36);
}

.advantageIcon {
  width: 46px;
  height: 46px;

  display: grid;
  place-items: center;

  border-radius: 13px;

  background: rgba(71, 154, 237, 0.10);

  color: #6eb5ff;
}

.advantageCard h3 {
  margin: 28px 0 12px;

  color: #f2f7fc;

  font-size: 23px;
  line-height: 1.1;

  letter-spacing: -0.025em;
}

.advantageCard p {
  margin: 0;

  color: #a8bfd4;

  font-size: 14px;
  line-height: 1.7;
}


/* ============================================================
   SIX CAPABILITIES
   ============================================================ */

.capabilities {
  padding: 116px 0 126px;

  background:
    linear-gradient(
      180deg,
      #f3eee3,
      #ede6d9
    );
}

.capabilityGrid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 18px;
}

.capabilityCard {
  position: relative;

  min-height: 360px;

  display: flex;
  flex-direction: column;

  padding: 28px;

  border: 1px solid rgba(16, 51, 81, 0.12);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5f2ea
    );

  color: inherit;

  text-decoration: none;

  box-shadow:
    0 14px 32px rgba(39, 55, 67, 0.07);

  transition:
    transform 180ms ease,
    border-color 180ms ease,
    box-shadow 180ms ease;
}

.capabilityCard:hover {
  transform: translateY(-4px);

  border-color: rgba(37, 126, 218, 0.30);

  box-shadow:
    0 22px 42px rgba(39, 55, 67, 0.11);
}

.capabilityCardTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.capabilityCardTop > span {
  color: var(--blue);

  font-size: 11px;
  font-weight: 850;
}

.capabilityCardTop > div {
  width: 44px;
  height: 44px;

  display: grid;
  place-items: center;

  border-radius: 12px;

  background: #e8f2fc;

  color: #267bd1;
}

.capabilityEyebrow {
  margin: 40px 0 0 !important;

  color: #6c8aa6 !important;

  font-size: 9px !important;
  font-weight: 850 !important;

  letter-spacing: 0.11em;
}

.capabilityCard h3 {
  margin: 9px 0 14px;

  font-size: 26px;
  line-height: 1.08;

  letter-spacing: -0.035em;
}

.capabilityCard > p:not(.capabilityEyebrow) {
  margin: 0;

  color: var(--muted);

  font-size: 14px;
  line-height: 1.65;
}

.capabilityCard > strong {
  display: flex;
  align-items: center;

  gap: 8px;

  margin-top: auto;
  padding-top: 24px;

  color: #1873ce;

  font-size: 13px;
}


/* ============================================================
   INTEGRATION SECTION
   ============================================================ */

.integration {
  padding: 116px 0;

  background: #f8f5ee;
}

.integrationPanel {
  display: grid;
  grid-template-columns:
    minmax(0, 0.82fr)
    minmax(600px, 1.18fr);

  align-items: center;

  gap: 70px;
}

.integrationPanel > div:first-child > p:last-child {
  max-width: 600px;

  margin: 24px 0 0;

  color: var(--muted);

  font-size: 16px;
  line-height: 1.75;
}

.integrationVisual {
  display: grid;
  grid-template-columns:
    minmax(180px, 0.7fr)
    100px
    minmax(300px, 1.3fr);

  align-items: center;

  padding: 24px;

  border-radius: 24px;

  background:
    linear-gradient(
      145deg,
      #0a2238,
      #0e3352
    );

  box-shadow:
    0 28px 55px rgba(18, 43, 63, 0.18);
}

.enterpriseColumn,
.aigoColumn {
  padding: 20px;

  border: 1px solid rgba(90, 161, 225, 0.17);
  border-radius: 16px;

  background: rgba(255,255,255,0.04);
}

.enterpriseColumn b {
  display: block;

  margin-top: 9px;
  padding: 9px 10px;

  border-radius: 8px;

  background: rgba(255,255,255,0.05);

  color: #c1d1df;

  font-size: 10px;
  font-weight: 610;
}

.integrationBridge {
  display: flex;
  align-items: center;

  color: #63aaff;
}

.integrationBridge i {
  flex: 1;

  height: 1px;

  background: #4f86b8;
}

.aigoColumn strong {
  display: block;

  margin-top: 9px;

  color: #ffffff;

  font-size: 27px;
}

.aigoColumn > div {
  display: grid;
  grid-template-columns: repeat(2, minmax(0, 1fr));

  gap: 8px;

  margin-top: 20px;
}

.aigoColumn b {
  padding: 9px;

  border-radius: 8px;

  background: rgba(255,255,255,0.05);

  color: #bed0df;

  font-size: 10px;
  font-weight: 620;

  text-align: center;
}


/* ============================================================
   FINAL CTA
   ============================================================ */

.finalCta {
  padding: 86px 0;

  background:
    linear-gradient(
      135deg,
      #06192b,
      #0b2b47
    );

  color: #ffffff;
}

.finalPanel {
  display: grid;
  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(380px, 0.85fr);

  align-items: center;

  gap: 80px;
}

.finalPanel > div:last-child > p {
  margin: 0 0 26px;

  color: #aec3d6;

  font-size: 16px;
  line-height: 1.7;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1260px) {
  .shell {
    width: min(100% - 64px, 1420px);
  }

  .heroLayout {
    grid-template-columns:
      minmax(0, 0.9fr)
      minmax(520px, 1.1fr);
  }

  .integrationPanel {
    grid-template-columns: 1fr;
  }
}

@media (max-width: 1080px) {
  .hero {
    min-height: auto;
  }

  .heroLayout {
    min-height: auto;

    grid-template-columns: 1fr;

    padding-block: 80px;
  }

  .heroCopy {
    max-width: 780px;
  }

  .heroPlatformVisual {
    max-width: 820px;

    margin-inline: auto;
  }

  .sectionIntro {
    grid-template-columns: 1fr;

    gap: 24px;
  }

  .sectionIntro > p {
    max-width: 700px;
  }

  .coreCapabilityGrid,
  .advantageGrid,
  .capabilityGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .outcomeGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .stageGrid {
    grid-template-columns: 1fr;
  }

  .stageCard {
    min-height: auto;
  }

  .stageCard > p {
    min-height: auto;
  }

  .finalPanel {
    grid-template-columns: 1fr;

    gap: 30px;
  }
}

@media (max-width: 760px) {
  .shell {
    width: calc(100% - 34px);
  }

  .heroLayout {
    padding-block: 62px 70px;
  }

  .heroTitle {
    font-size: clamp(44px, 12vw, 62px);
  }

  .heroLead {
    font-size: 17px;
  }

  .heroPrinciples {
    grid-template-columns: 1fr;
  }

  .previewSources,
  .architectureInputs,
  .coreCapabilityGrid,
  .advantageGrid,
  .capabilityGrid,
  .outcomeGrid {
    grid-template-columns: 1fr;
  }

  .previewCapabilityGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .architecture {
    padding-block: 80px;
  }

  .architectureBoard {
    padding: 18px;

    border-radius: 22px;
  }

  .activeExplanation {
    grid-template-columns: 1fr;
  }

  .explanationArrow {
    transform: rotate(90deg);
  }

  .integrationVisual {
    grid-template-columns: 1fr;

    gap: 18px;
  }

  .integrationBridge {
    min-height: 60px;

    flex-direction: column;
  }

  .integrationBridge i {
    width: 1px;
    min-height: 20px;
  }

  .aigoColumn > div {
    grid-template-columns: 1fr;
  }

  .sectionIntro h2,
  .centerHeading h2,
  .integrationPanel h2,
  .finalPanel h2 {
    font-size: clamp(38px, 10vw, 54px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .page *,
  .page *::before,
  .page *::after {
    scroll-behavior: auto !important;

    transition-duration: 0.01ms !important;
    animation-duration: 0.01ms !important;
    animation-iteration-count: 1 !important;
  }
}


/* === PAGE 02 CONTRAST LOCK START === */

/*
  Page 02 contains alternating dark and light sections.
  The public-site global typography can otherwise make
  headings inherit the light navigation/page text color.

  These rules deliberately lock readable colors inside
  each light section without changing the dark sections.
*/


/* ------------------------------------------------------------
   LIGHT SECTION BASE COLORS
   ------------------------------------------------------------ */

.architecture,
.operatingModel,
.capabilities,
.integration {
  color: #102e49 !important;
}


/* ------------------------------------------------------------
   ARCHITECTURE SECTION INTRO
   ------------------------------------------------------------ */

.architecture .sectionIntro h2 {
  color: #102e49 !important;
}

.architecture .sectionIntro > p {
  color: #536f89 !important;
}

.architecture .goldEyebrow {
  color: #c58f25 !important;
}


/* ------------------------------------------------------------
   HOW THE PLATFORM OPERATES
   ------------------------------------------------------------ */

.operatingModel .centerHeading h2 {
  color: #102e49 !important;
}

.operatingModel .centerHeading > p {
  color: #5d7690 !important;
}

.operatingModel .goldEyebrow {
  color: #c58f25 !important;
}


/* Stage card text */

.operatingModel .stageCard {
  color: #102e49 !important;
}

.operatingModel .stageCard h3 {
  color: #102e49 !important;
}

.operatingModel .stageCard > p {
  color: #5d7690 !important;
}

.operatingModel .stageTop > span {
  color: #1d78d5 !important;
}


/* Diagram labels remain darker than their backgrounds */

.operatingModel .stageVisual span {
  color: #314f69 !important;
}

.operatingModel .stageVisual .stageTagActive {
  color: #0968c4 !important;
}


/* ------------------------------------------------------------
   PLATFORM CAPABILITIES
   ------------------------------------------------------------ */

.capabilities .centerHeading h2 {
  color: #102e49 !important;
}

.capabilities .centerHeading > p {
  color: #5d7690 !important;
}

.capabilities .goldEyebrow {
  color: #c58f25 !important;
}


/* Each capability card */

.capabilities .capabilityCard {
  color: #102e49 !important;
}

.capabilities .capabilityCard h3 {
  color: #102e49 !important;
}

.capabilities .capabilityEyebrow {
  color: #527491 !important;
}

.capabilities .capabilityCard > p:not(.capabilityEyebrow) {
  color: #5d7690 !important;
}

.capabilities .capabilityCard > strong {
  color: #0873da !important;
}

.capabilities .capabilityCardTop > span {
  color: #1678d8 !important;
}


/* ------------------------------------------------------------
   ENTERPRISE INTEGRATION SECTION
   ------------------------------------------------------------ */

.integration .goldEyebrow {
  color: #c58f25 !important;
}

.integration .integrationPanel h2 {
  color: #102e49 !important;
}

.integration .integrationPanel > div:first-child > p:last-child {
  color: #536f89 !important;
}


/* ------------------------------------------------------------
   GENERAL LIGHT-SECTION PROTECTION
   ------------------------------------------------------------ */

/*
  These are intentionally scoped to Page 02 light sections.
  They prevent broad public-site heading rules from turning
  text white again.
*/

.architecture h1,
.architecture h2,
.architecture h3,
.architecture h4,
.operatingModel h1,
.operatingModel h2,
.operatingModel h3,
.operatingModel h4,
.capabilities h1,
.capabilities h2,
.capabilities h3,
.capabilities h4,
.integration h1,
.integration h2,
.integration h3,
.integration h4 {
  color: #102e49 !important;
}


/*
  Do not globally recolor every paragraph because some
  paragraphs live inside the dark architecture visualization.
  Only normal light-area copy is targeted above.
*/


/* ------------------------------------------------------------
   CARD CONTRAST
   ------------------------------------------------------------ */

.stageCard,
.capabilityCard {
  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f7f4ed 100%
    ) !important;

  border-color: rgba(16, 46, 73, 0.14) !important;
}


/* Slightly stronger card typography for desktop visibility */

.stageCard h3,
.capabilityCard h3 {
  font-weight: 800 !important;
}


/* ------------------------------------------------------------
   DARK SECTIONS REMAIN LIGHT TEXT
   ------------------------------------------------------------ */

/*
  Explicitly protect the dark sections from the rules above.
*/

.hero,
.advantages,
.finalCta {
  color: #f8fbff !important;
}

.hero h1,
.hero h2,
.hero h3,
.advantages h1,
.advantages h2,
.advantages h3,
.finalCta h1,
.finalCta h2,
.finalCta h3 {
  color: #f8fbff !important;
}

.advantages .sectionIntro h2 {
  color: #f8fbff !important;
}

.advantages .sectionIntro > p {
  color: #a9bfd4 !important;
}

.advantages .advantageCard h3 {
  color: #f2f7fc !important;
}

.advantages .advantageCard p {
  color: #a8bfd4 !important;
}


/* === PAGE 02 CONTRAST LOCK END === */


