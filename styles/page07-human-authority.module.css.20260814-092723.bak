.page {
  --navy: #071f34;
  --navy-2: #0a304e;
  --ink: #102f4d;
  --body: #536f87;
  --blue: #147fd8;
  --gold: #b47c12;
  --cream: #f2ede3;
  --line: #cedae3;

  overflow: hidden;
  background: #ffffff;
  color: var(--ink);
}

.shell {
  width: min(1180px, calc(100% - 48px));
  margin: 0 auto;
}

.blueEyebrow,
.blueDarkEyebrow,
.goldEyebrow {
  margin: 0;

  font-size: 10px;
  line-height: 1.2;
  font-weight: 850;
  letter-spacing: 0.12em;
}

.blueEyebrow {
  color: #70baf1;
}

.blueDarkEyebrow {
  color: var(--blue);
}

.goldEyebrow {
  color: var(--gold);
}


/* ==========================================================
   HERO
========================================================== */

.hero {
  position: relative;

  min-height: 680px;

  display: flex;
  align-items: center;

  padding: 94px 0 84px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 77% 40%,
      rgba(36, 135, 209, 0.17),
      transparent 29%
    ),
    linear-gradient(
      135deg,
      #061b2e,
      #082b47 58%,
      #071f35
    );
}

.heroGrid {
  position: absolute;
  inset: 0;

  opacity: 0.07;

  background-image:
    linear-gradient(
      rgba(103, 177, 232, 0.18) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(103, 177, 232, 0.18) 1px,
      transparent 1px
    );

  background-size: 48px 48px;
}

.heroLayout {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns:
    minmax(0, 1.1fr)
    minmax(360px, 0.9fr);

  gap: 76px;
  align-items: center;
}

.heroCopy h1 {
  max-width: 760px;

  margin: 18px 0 0;

  color: #ffffff;

  font-size: clamp(46px, 5vw, 68px);
  line-height: 1.02;
  font-weight: 820;
  letter-spacing: -0.052em;

  text-wrap: balance;
}

.heroLead {
  max-width: 680px;

  margin: 24px 0 0;

  color: #d7e6f1;

  font-size: 18px;
  line-height: 1.62;
}

.heroSupporting {
  max-width: 670px;

  margin: 15px 0 0;

  color: #9fb9cc;

  font-size: 14px;
  line-height: 1.72;
}

.heroActions {
  display: flex;
  flex-wrap: wrap;
  gap: 12px;

  margin-top: 30px;
}

.primaryButton,
.secondaryButton {
  min-height: 46px;

  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 9px;

  padding: 0 18px;

  border-radius: 8px;

  text-decoration: none;

  font-size: 12px;
  font-weight: 800;
}

.primaryButton {
  background: #ffffff;
  color: #123a5c;
}

.secondaryButton {
  border: 1px solid rgba(139, 192, 235, 0.34);

  background: rgba(255,255,255,0.035);

  color: #e6f1f9;
}

.heroVisual {
  width: 91%;
  justify-self: end;
}

.taskPanel {
  padding: 27px;

  border: 1px solid rgba(99, 173, 230, 0.27);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #103957,
      #092a45 58%,
      #071f35
    );

  box-shadow:
    0 32px 60px rgba(0, 8, 20, 0.34),
    inset 0 1px 0 rgba(255,255,255,0.05);
}

.taskPanelTop {
  display: flex;
  align-items: center;
  gap: 15px;
}

.taskIcon {
  width: 52px;
  height: 52px;

  flex: 0 0 52px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(103,178,236,0.26);
  border-radius: 14px;

  background: rgba(48,138,210,0.10);

  color: #6eb8f2;
}

.taskPanelTop span,
.taskContext span,
.taskAssignment span {
  display: block;

  color: #73b8ef;

  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.10em;
}

.taskPanelTop strong {
  display: block;

  margin-top: 6px;

  color: #ffffff;

  font-size: 17px;
  line-height: 1.35;
}

.taskContext {
  display: grid;
  gap: 8px;

  margin-top: 24px;
}

.taskContext > div {
  padding: 13px 15px;

  border: 1px solid rgba(111,176,226,0.14);
  border-radius: 10px;

  background: rgba(255,255,255,0.025);
}

.taskContext strong {
  display: block;

  margin-top: 5px;

  color: #dce9f3;

  font-size: 11px;
  line-height: 1.45;
}

.taskAssignment {
  display: flex;
  align-items: center;
  gap: 12px;

  margin-top: 14px;

  padding: 15px;

  border: 1px solid rgba(83,180,228,0.29);
  border-radius: 11px;

  background: rgba(45,134,190,0.10);

  color: #75bff1;
}

.taskAssignment strong {
  display: block;

  margin-top: 4px;

  color: #ffffff;

  font-size: 12px;
}


/* ==========================================================
   SECTION INTRO
========================================================== */

.sectionIntro,
.sectionIntroDark {
  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(300px, 0.85fr);

  gap: 72px;
  align-items: end;

  margin-bottom: 48px;
}

.sectionIntro h2,
.sectionIntroCentered h2,
.sectionIntroDark h2,
.valueCopy h2 {
  margin: 12px 0 0;

  font-size: clamp(36px, 4vw, 52px);
  line-height: 1.05;
  font-weight: 810;
  letter-spacing: -0.045em;

  text-wrap: balance;
}

.sectionIntro h2,
.sectionIntroCentered h2,
.valueCopy h2 {
  color: #102f4d;
}

.sectionIntro > p,
.sectionIntroCentered > p:last-child {
  margin: 0;

  color: #536f87;

  font-size: 15px;
  line-height: 1.7;
}

.sectionIntroCentered {
  max-width: 920px;

  margin: 0 auto 48px;

  text-align: center;
}

.sectionIntroCentered > p:last-child {
  max-width: 740px;

  margin: 20px auto 0;
}


/* ==========================================================
   PURPOSE
========================================================== */

.purposeSection {
  padding: 98px 0 104px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ece5d9
    );
}

.purposeFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    55px
    minmax(0, 1fr)
    55px
    minmax(0, 1fr);

  align-items: stretch;
}

.flowCard {
  min-height: 190px;

  padding: 24px;

  border: 1px solid #cedae3;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f7f5ef
    );

  box-shadow:
    0 23px 42px rgba(31,56,75,0.11),
    0 5px 12px rgba(31,56,75,0.04),
    inset 0 1px 0 #ffffff;
}

.flowCardActive {
  border-color: #9fcbea;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );

  box-shadow:
    0 26px 48px rgba(25,103,159,0.14),
    0 6px 14px rgba(31,56,75,0.05),
    inset 0 1px 0 #ffffff;
}

.flowCard span {
  color: #147fd8;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.09em;
}

.flowCard strong {
  display: block;

  margin-top: 14px;

  color: #102f4d;

  font-size: 20px;
  line-height: 1.25;
}

.flowCard p {
  margin: 12px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.62;
}

.flowArrow {
  align-self: center;
  justify-self: center;

  color: #2787d0;
}


/* ==========================================================
   TRIGGERS
========================================================== */

.triggerSection {
  padding: 100px 0 106px;

  background: #ffffff;
}

.triggerGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 17px;
}

.triggerCard {
  min-height: 220px;

  padding: 25px;

  border: 1px solid #d1dce4;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f6f9fb
    );

  box-shadow:
    0 21px 39px rgba(31,56,75,0.10),
    0 5px 12px rgba(31,56,75,0.04),
    inset 0 1px 0 #ffffff;
}

.triggerCard > span {
  color: #147fd8;

  font-size: 10px;
  font-weight: 850;
}

.triggerCard h3 {
  margin: 28px 0 0;

  color: #102f4d;

  font-size: 20px;
  line-height: 1.25;
}

.triggerCard p {
  margin: 12px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.62;
}


/* ==========================================================
   TASK
========================================================== */

.taskSection {
  padding: 100px 0 106px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ebe4d8
    );
}

.taskExample {
  overflow: hidden;

  border: 1px solid #c9d8e3;
  border-radius: 20px;

  background: #ffffff;

  box-shadow:
    0 28px 52px rgba(31,56,75,0.13),
    0 6px 14px rgba(31,56,75,0.05),
    inset 0 1px 0 #ffffff;
}

.taskExampleHeader {
  display: flex;
  justify-content: space-between;
  gap: 24px;
  align-items: center;

  padding: 24px 27px;

  border-bottom: 1px solid #dce5eb;

  background:
    linear-gradient(
      135deg,
      #f7fbfe,
      #edf6fc
    );
}

.taskExampleHeader span {
  color: #147fd8;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.09em;
}

.taskExampleHeader h3 {
  margin: 7px 0 0;

  color: #102f4d;

  font-size: 22px;
}

.taskStatus {
  flex: 0 0 auto;

  padding: 8px 11px;

  border: 1px solid #b7d6eb;
  border-radius: 8px;

  background: #ffffff;

  color: #147fd8;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.07em;
}

.taskDetails {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));

  gap: 1px;

  background: #dce5eb;
}

.taskDetails > div {
  min-height: 126px;

  padding: 22px;

  background: #ffffff;
}

.taskDetails span {
  color: #147fd8;

  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.taskDetails strong {
  display: block;

  margin-top: 8px;

  color: #153c5b;

  font-size: 13px;
  line-height: 1.5;
}


/* ==========================================================
   NOTIFICATION
========================================================== */

.notificationSection {
  padding: 100px 0 106px;

  background: #ffffff;
}

.notificationGrid {
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));

  gap: 17px;
}

.notificationCard {
  min-height: 215px;

  padding: 25px;

  border: 1px solid #d1dce4;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f6f9fb
    );

  box-shadow:
    0 21px 39px rgba(31,56,75,0.10),
    0 5px 12px rgba(31,56,75,0.04),
    inset 0 1px 0 #ffffff;
}

.notificationIcon {
  width: 46px;
  height: 46px;

  display: grid;
  place-items: center;

  border: 1px solid #c3ddf0;
  border-radius: 12px;

  background: #edf7ff;

  color: #167fd7;
}

.notificationCard h3 {
  margin: 21px 0 0;

  color: #102f4d;

  font-size: 20px;
}

.notificationCard p {
  margin: 11px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.62;
}


/* ==========================================================
   HUMAN ACTIONS
========================================================== */

.actionSection {
  padding: 100px 0;

  background:
    linear-gradient(
      135deg,
      #071e33,
      #0a2d49 58%,
      #071f35
    );
}

.sectionIntroDark h2 {
  color: #ffffff;
}

.sectionIntroDark > p {
  margin: 0;

  color: #a7bfd2;

  font-size: 15px;
  line-height: 1.7;
}

.actionGrid {
  display: grid;
  grid-template-columns: repeat(5, minmax(0, 1fr));

  gap: 13px;
}

.actionCard {
  min-height: 220px;

  padding: 21px;

  border: 1px solid rgba(102,173,228,0.23);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      #103956,
      #092944
    );

  box-shadow:
    0 26px 48px rgba(0,8,20,0.25),
    inset 0 1px 0 rgba(255,255,255,0.05);
}

.actionIcon {
  width: 42px;
  height: 42px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(104,180,235,0.23);
  border-radius: 11px;

  background: rgba(66,149,209,0.08);

  color: #72b8ef;
}

.actionCard h3 {
  margin: 22px 0 0;

  color: #ffffff;

  font-size: 18px;
  line-height: 1.25;
}

.actionCard p {
  margin: 12px 0 0;

  color: #adc3d3;

  font-size: 12px;
  line-height: 1.62;
}


/* ==========================================================
   GOVERNANCE / OPERATIONAL BOUNDARY
========================================================== */

.boundarySection {
  padding: 100px 0 106px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ebe4d8
    );
}

.boundaryFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    55px
    minmax(0, 1fr)
    55px
    minmax(0, 1fr);

  align-items: stretch;
}

.boundaryCard {
  min-height: 270px;

  padding: 25px;

  border: 1px solid #cedae3;
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f7f9fa
    );

  box-shadow:
    0 24px 44px rgba(31,56,75,0.11),
    0 6px 14px rgba(31,56,75,0.04),
    inset 0 1px 0 #ffffff;
}

.boundaryActive {
  border-color: #9fcbea;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );
}

.boundaryIcon {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  border: 1px solid #c3ddf0;
  border-radius: 12px;

  background: #edf7ff;

  color: #147fd8;
}

.boundaryCard > span {
  display: block;

  margin-top: 22px;

  color: #147fd8;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.boundaryCard h3 {
  margin: 9px 0 0;

  color: #102f4d;

  font-size: 21px;
  line-height: 1.25;
}

.boundaryCard p {
  margin: 12px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.62;
}

.boundaryArrow {
  align-self: center;
  justify-self: center;

  color: #2787d0;
}

.boundaryNote {
  display: flex;
  align-items: flex-start;
  gap: 14px;

  margin-top: 28px;

  padding: 20px 22px;

  border: 1px solid #bad6e9;
  border-radius: 14px;

  background: #f5fbff;

  color: #147fd8;
}

.boundaryNote strong {
  display: block;

  color: #153c5b;

  font-size: 14px;
}

.boundaryNote p {
  margin: 6px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.62;
}


/* ==========================================================
   EXAMPLE
========================================================== */

.exampleSection {
  padding: 100px 0 106px;

  background: #ffffff;
}

.exampleFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    38px
    minmax(0, 1fr)
    38px
    minmax(0, 1fr)
    38px
    minmax(0, 1fr);

  align-items: stretch;
}

.exampleCard {
  min-height: 240px;

  padding: 23px;

  border: 1px solid #cfdbe4;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5f8fa
    );

  box-shadow:
    0 22px 40px rgba(31,56,75,0.10),
    inset 0 1px 0 #ffffff;
}

.exampleHighlight {
  border-color: #9fcbea;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );
}

.exampleCard span {
  color: #147fd8;

  font-size: 8px;
  font-weight: 850;
  letter-spacing: 0.08em;
}

.exampleCard h3 {
  margin: 17px 0 0;

  color: #102f4d;

  font-size: 19px;
  line-height: 1.25;
}

.exampleCard p {
  margin: 12px 0 0;

  color: #536f87;

  font-size: 12px;
  line-height: 1.62;
}

.exampleConnector {
  display: grid;
  place-items: center;

  color: #2787d0;
}


/* ==========================================================
   VALUE / OUTPUT
========================================================== */

.valueSection {
  padding: 100px 0 108px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ebe4d8
    );
}

.valueGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(360px, 0.85fr);

  gap: 76px;
  align-items: center;
}

.valueCopy > p {
  max-width: 690px;

  margin: 20px 0 0;

  color: #536f87;

  font-size: 15px;
  line-height: 1.7;
}

.valueCopy ul {
  display: grid;
  gap: 10px;

  margin: 27px 0 0;
  padding: 0;

  list-style: none;
}

.valueCopy li {
  position: relative;

  padding-left: 27px;

  color: #315a78;

  font-size: 14px;
  line-height: 1.55;
}

.valueCopy li::before {
  content: "✓";

  position: absolute;
  left: 0;
  top: 0;

  color: #147fd8;

  font-weight: 900;
}

.outputPanel {
  padding: 30px;

  border: 1px solid #a9d1ed;
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );

  box-shadow:
    0 28px 52px rgba(31,56,75,0.13),
    0 6px 14px rgba(31,56,75,0.05),
    inset 0 1px 0 #ffffff;
}

.outputPanel > span,
.outputNext span {
  color: #147fd8;

  font-size: 9px;
  font-weight: 850;
  letter-spacing: 0.09em;
}

.outputIcon {
  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;

  margin-top: 20px;

  border: 1px solid #b9d9ee;
  border-radius: 15px;

  background: #ffffff;

  color: #147fd8;
}

.outputPanel h3 {
  margin: 20px 0 0;

  color: #102f4d;

  font-size: 27px;
  line-height: 1.18;
}

.outputPanel > p {
  margin: 13px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.65;
}

.outputNext {
  margin-top: 24px;

  padding-top: 21px;

  border-top: 1px solid #cbdfea;
}

.outputNext strong {
  display: block;

  margin-top: 7px;

  color: #102f4d;

  font-size: 17px;
}

.outputNext p {
  margin: 7px 0 0;

  color: #536f87;

  font-size: 12px;
  line-height: 1.55;
}


/* ==========================================================
   LIGHT BACKGROUND CONTRAST PROTECTION

   Prevent global white-text / opacity rules from making
   Page 07 unreadable on cream and white sections.
========================================================== */

.purposeSection,
.triggerSection,
.taskSection,
.notificationSection,
.boundarySection,
.exampleSection,
.valueSection {
  color: #102f4d !important;
}

.purposeSection *,
.triggerSection *,
.taskSection *,
.notificationSection *,
.boundarySection *,
.exampleSection *,
.valueSection * {
  opacity: 1 !important;
  filter: none !important;

  -webkit-text-fill-color: currentColor !important;
}

.purposeSection h1,
.purposeSection h2,
.purposeSection h3,
.triggerSection h1,
.triggerSection h2,
.triggerSection h3,
.taskSection h1,
.taskSection h2,
.taskSection h3,
.notificationSection h1,
.notificationSection h2,
.notificationSection h3,
.boundarySection h1,
.boundarySection h2,
.boundarySection h3,
.exampleSection h1,
.exampleSection h2,
.exampleSection h3,
.valueSection h1,
.valueSection h2,
.valueSection h3 {
  color: #102f4d !important;
  -webkit-text-fill-color: #102f4d !important;
  text-shadow: none !important;
}

.purposeSection p,
.triggerSection p,
.taskSection p,
.notificationSection p,
.boundarySection p,
.exampleSection p,
.valueSection p {
  color: #536f87 !important;
  -webkit-text-fill-color: #536f87 !important;
}

.purposeSection .goldEyebrow,
.taskSection .goldEyebrow,
.boundarySection .goldEyebrow,
.exampleSection .goldEyebrow {
  color: #b47c12 !important;
  -webkit-text-fill-color: #b47c12 !important;
}

.triggerSection .blueDarkEyebrow,
.notificationSection .blueDarkEyebrow,
.valueSection .blueDarkEyebrow {
  color: #147fd8 !important;
  -webkit-text-fill-color: #147fd8 !important;
}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 1100px) {

  .heroLayout,
  .sectionIntro,
  .sectionIntroDark,
  .valueGrid {
    grid-template-columns: 1fr;
  }

  .heroVisual {
    width: min(100%, 680px);
    justify-self: center;
  }

  .purposeFlow,
  .boundaryFlow,
  .exampleFlow {
    grid-template-columns: 1fr;
    gap: 13px;
  }

  .flowArrow,
  .boundaryArrow,
  .exampleConnector svg {
    transform: rotate(90deg);
  }

  .flowArrow,
  .boundaryArrow {
    margin: 10px auto;
  }

  .exampleConnector {
    min-height: 35px;
  }

  .triggerGrid,
  .notificationGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .actionGrid {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .taskDetails {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }
}


@media (max-width: 720px) {

  .shell {
    width: min(100% - 30px, 1180px);
  }

  .hero,
  .purposeSection,
  .triggerSection,
  .taskSection,
  .notificationSection,
  .actionSection,
  .boundarySection,
  .exampleSection,
  .valueSection {
    padding-top: 72px;
    padding-bottom: 76px;
  }

  .heroCopy h1 {
    font-size: 43px;
  }

  .triggerGrid,
  .notificationGrid,
  .actionGrid,
  .taskDetails {
    grid-template-columns: 1fr;
  }

  .taskExampleHeader {
    align-items: flex-start;
    flex-direction: column;
  }
}
