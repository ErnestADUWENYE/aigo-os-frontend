.page {
  --navy-950: #06192b;
  --navy-900: #0b2f4f;
  --navy-850: #123b5c;

  --text-main: #102f4d;
  --text-copy: #58738c;
  --text-copy-dark: #405f79;

  --blue: #177ad4;
  --blue-bright: #68b1f8;

  --gold: #c6902d;
  --green: #67d491;
  --red: #d87970;

  --cream: #f1ece1;
  --cream-alt: #f7f4ed;
  --card: #fffefa;
  --card-edge: #d2dde5;

  overflow: hidden;

  background: var(--cream);
  color: var(--text-main);
}

.shell {
  width: min(1440px, calc(100% - 128px));
  margin-inline: auto;
}


/* ============================================================
   HERO
   ============================================================ */

.hero {
  position: relative;

  min-height: 640px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 80% 25%,
      rgba(46, 139, 226, 0.14),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #051829,
      #082640 68%,
      #061b2e
    );

  color: #ffffff;
}

.heroGrid {
  position: absolute;
  inset: 0;

  opacity: 0.13;

  background-image:
    linear-gradient(
      rgba(91, 160, 218, 0.08) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(91, 160, 218, 0.08) 1px,
      transparent 1px
    );

  background-size: 58px 58px;
}

.heroGlow {
  position: absolute;

  width: 520px;
  height: 520px;

  right: -110px;
  top: -165px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(53, 145, 232, 0.15),
      transparent 68%
    );
}

.heroLayout {
  position: relative;
  z-index: 2;

  min-height: 640px;

  display: grid;

  grid-template-columns:
    minmax(0, 1.28fr)
    minmax(400px, 0.72fr);

  align-items: center;

  gap: 70px;

  padding: 58px 0 62px;
}

.heroCopy {
  max-width: 760px;
  min-width: 0;
}

.heroEyebrow {
  margin: 0;

  color: #72b7fa;

  font-size: 11px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.14em;
}

.heroTitle {
  margin: 18px 0 25px;

  color: #ffffff;

  font-size: clamp(47px, 4.2vw, 68px);
  line-height: 0.99;
  font-weight: 800;

  letter-spacing: -0.052em;
}

.heroTitle span {
  display: block;
  white-space: nowrap;
}

.heroTitle span + span {
  margin-top: 10px;

  color: #b9cbde;

  font-size: 0.78em;
  line-height: 1.06;
  font-weight: 680;

  letter-spacing: -0.04em;
}

.heroLead {
  max-width: 655px;

  margin: 0;

  color: #dce8f1;

  font-size: 17px;
  line-height: 1.7;
}

.heroBody {
  max-width: 640px;

  margin: 15px 0 0;

  color: #9fb8ce;

  font-size: 14px;
  line-height: 1.72;
}

.heroButtons {
  display: flex;
  flex-wrap: wrap;

  gap: 13px;

  margin-top: 27px;
}

.primaryButton,
.secondaryButton {
  min-height: 52px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  padding: 0 22px;

  border-radius: 11px;

  font-size: 14px;
  font-weight: 770;

  text-decoration: none;

  transition:
    transform 170ms ease,
    box-shadow 170ms ease,
    background 170ms ease;
}

.primaryButton {
  color: #ffffff;

  background:
    linear-gradient(
      145deg,
      #3895ff,
      #2678e5
    );

  box-shadow:
    0 13px 28px rgba(30, 117, 221, 0.24);
}

.primaryButton:hover {
  transform: translateY(-2px);
}

.secondaryButton {
  color: #ffffff;

  border:
    1px solid rgba(154, 195, 231, 0.25);

  background:
    rgba(255, 255, 255, 0.045);
}

.secondaryButton:hover {
  background:
    rgba(255, 255, 255, 0.08);
}

.heroChecks {
  display: flex;
  flex-wrap: wrap;

  gap: 10px 18px;

  margin-top: 24px;
}

.heroChecks span {
  display: flex;
  align-items: center;

  gap: 7px;

  color: #a9c0d4;

  font-size: 12px;
  font-weight: 650;
}

.heroChecks svg {
  color: var(--green);
}


/* ============================================================
   HERO AUTHORITY VISUAL
   ============================================================ */

.heroVisualWrap {
  display: flex;
  align-items: center;
  justify-content: flex-end;
}

.authorityVisual {
  width: min(100%, 470px);

  padding: 15px;

  border:
    1px solid rgba(92, 163, 225, 0.24);

  border-radius: 19px;

  background:
    linear-gradient(
      145deg,
      rgba(17, 59, 94, 0.98),
      rgba(7, 34, 57, 0.98)
    );

  box-shadow:
    0 25px 48px rgba(0, 8, 20, 0.28),
    0 8px 17px rgba(0, 0, 0, 0.13),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
}

.visualHeader {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 13px;

  padding: 1px 1px 11px;

  border-bottom:
    1px solid rgba(107, 169, 219, 0.13);
}

.visualHeader span {
  display: block;

  color: #6fb2f2;

  font-size: 7px;
  font-weight: 850;

  letter-spacing: 0.1em;
}

.visualHeader strong {
  display: block;

  margin-top: 4px;

  color: #f0f6fb;

  font-size: 11px;
}

.liveStatus {
  display: flex;
  align-items: center;

  gap: 6px;

  color: #72d393;

  font-size: 7px;
  font-weight: 850;

  white-space: nowrap;
}

.liveStatus i {
  width: 6px;
  height: 6px;

  border-radius: 50%;

  background: #69d58f;

  box-shadow:
    0 0 8px rgba(105, 213, 143, 0.75);
}

.visualCanvas {
  position: relative;

  min-height: 278px;

  display: grid;
  place-items: center;

  margin-top: 12px;

  overflow: hidden;

  border-radius: 14px;

  background:
    linear-gradient(
      rgba(100, 167, 226, 0.045) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(100, 167, 226, 0.045) 1px,
      transparent 1px
    ),
    rgba(3, 22, 38, 0.30);

  background-size: 27px 27px;
}

.actorCore {
  position: absolute;
  z-index: 5;

  width: 105px;
  height: 105px;

  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;

  border:
    1px solid rgba(91, 171, 244, 0.42);

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      #123e62,
      #092841 72%
    );

  box-shadow:
    0 14px 24px rgba(0, 0, 0, 0.18);
}

.actorIcon {
  width: 32px;
  height: 32px;

  display: grid;
  place-items: center;

  margin-bottom: 6px;

  border-radius: 9px;

  background:
    rgba(71, 157, 239, 0.13);

  color: #6bb4fb;
}

.actorCore span {
  color: #70b5f7;

  font-size: 6px;
  font-weight: 850;
}

.actorCore strong {
  margin-top: 3px;

  color: #ffffff;

  font-size: 11px;
}

.actorCore small {
  margin-top: 3px;

  color: #829cb4;

  font-size: 6px;
}

.boundary {
  position: relative;

  width: 91%;
  height: 232px;

  border:
    1px solid rgba(68, 148, 221, 0.39);

  border-radius: 130px;
}

.boundaryLabel {
  position: absolute;

  left: 50%;
  top: -7px;

  transform: translateX(-50%);

  padding: 0 8px;

  background: #0d304e;

  color: #6fb2f2;

  font-size: 6px;
  font-weight: 850;

  letter-spacing: 0.08em;

  white-space: nowrap;
}

.actionNode {
  position: absolute;

  width: 126px;
  min-height: 42px;

  display: grid;

  grid-template-columns:
    20px minmax(0, 1fr);

  align-items: center;

  gap: 6px;

  padding: 6px;

  cursor: pointer;

  border:
    1px solid rgba(97, 160, 213, 0.17);

  border-radius: 8px;

  background:
    linear-gradient(
      145deg,
      #103653,
      #0c2d48
    );

  color: inherit;

  text-align: left;

  box-shadow:
    0 7px 14px rgba(0, 0, 0, 0.14);

  transition:
    transform 200ms ease,
    border-color 200ms ease,
    box-shadow 200ms ease;
}

.actionNode1 {
  left: 12px;
  top: 39px;
}

.actionNode2 {
  left: 12px;
  bottom: 39px;
}

.actionNode3 {
  right: 12px;
  top: 39px;
}

.actionNode4 {
  right: 12px;
  bottom: 39px;
}

.actionNode5 {
  left: 50%;
  top: 8px;

  transform: translateX(-50%);
}

.actionNode6 {
  left: 50%;
  bottom: 8px;

  transform: translateX(-50%);
}

.actionIcon {
  width: 20px;
  height: 20px;

  display: grid;
  place-items: center;

  border-radius: 6px;
}

.actionNode_allowed .actionIcon {
  color: #6ed898;

  background:
    rgba(85, 198, 126, 0.11);
}

.actionNode_conditional .actionIcon {
  color: #e1ad48;

  background:
    rgba(225, 171, 69, 0.11);
}

.actionNode_outside .actionIcon {
  color: #df7b71;

  background:
    rgba(220, 119, 109, 0.11);
}

.actionText strong,
.actionText small {
  display: block;
}

.actionText strong {
  color: #e1ebf4;

  font-size: 6px;
  line-height: 1.25;
}

.actionText small {
  margin-top: 2px;

  color: #8298ac;

  font-size: 5px;
}

.actionNodeActive {
  z-index: 8;

  border-color:
    rgba(91, 171, 244, 0.74);

  box-shadow:
    0 0 17px rgba(52, 143, 227, 0.18),
    0 8px 17px rgba(0, 0, 0, 0.16);
}

.actionNode1.actionNodeActive,
.actionNode2.actionNodeActive,
.actionNode3.actionNodeActive,
.actionNode4.actionNodeActive {
  transform: translateY(-2px);
}

.actionNode5.actionNodeActive,
.actionNode6.actionNodeActive {
  transform:
    translateX(-50%)
    translateY(-2px);
}

.legend {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 5px;

  margin-top: 9px;
}

.legend button {
  min-height: 29px;

  display: flex;
  align-items: center;
  justify-content: center;

  gap: 5px;

  cursor: pointer;

  border:
    1px solid rgba(105, 163, 213, 0.13);

  border-radius: 7px;

  background:
    rgba(255, 255, 255, 0.025);

  color: #91a9be;

  font-size: 6px;
  font-weight: 720;
}

.legendActive {
  border-color:
    rgba(91, 171, 244, 0.4) !important;

  background:
    rgba(59, 139, 212, 0.09) !important;

  color: #d5e1eb !important;
}

.legend i {
  width: 6px;
  height: 6px;

  border-radius: 50%;
}

.greenDot {
  background: #69d58f;
}

.goldDot {
  background: #dda641;
}

.redDot {
  background: #d9786f;
}


/* ============================================================
   LIGHT SURFACES
   PAGE 03 VISUAL STANDARD
   ============================================================ */

.lightSection,
.connectedSection {
  padding: 92px 0 96px;

  background:
    linear-gradient(
      180deg,
      #f2ede2,
      #eae3d6
    );

  color: var(--text-main);
}

.modelSection {
  padding: 96px 0 100px;

  background:
    linear-gradient(
      180deg,
      #faf7f0,
      #f2ede4
    );

  color: var(--text-main);
}


/*
  Strong local specificity is intentional.
  These rules prevent global public-site typography
  from painting light text onto Page 04 light surfaces.
*/

.page .lightSection .splitHeading h2,
.page .connectedSection .splitHeading h2,
.page .modelSection .centerHeading h2 {
  color: #102f4d !important;
  -webkit-text-fill-color: #102f4d !important;

  opacity: 1 !important;

  background: none !important;
  background-image: none !important;

  -webkit-background-clip: border-box !important;
  background-clip: border-box !important;

  filter: none !important;
  text-shadow: none !important;
}

.page .lightSection .splitHeading > p,
.page .connectedSection .splitHeading > p,
.page .modelSection .centerHeading > p:last-child {
  color: #58738c !important;
  -webkit-text-fill-color: #58738c !important;

  opacity: 1 !important;

  background: none !important;
  background-image: none !important;

  filter: none !important;
}

.page .lightSection .goldEyebrow {
  color: #bd8828 !important;
  -webkit-text-fill-color: #bd8828 !important;
}

.page .modelSection .blueEyebrow,
.page .connectedSection .blueEyebrow {
  color: #177ad4 !important;
  -webkit-text-fill-color: #177ad4 !important;
}

.goldEyebrow,
.blueEyebrow,
.darkGoldEyebrow {
  margin: 0;

  font-size: 11px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.14em;
}

.splitHeading {
  display: grid;

  grid-template-columns:
    minmax(0, 1.25fr)
    minmax(360px, 0.75fr);

  align-items: center;

  gap: 72px;

  margin-bottom: 42px;
}

.splitHeading h2,
.centerHeading h2 {
  margin: 14px 0 0;

  font-size: clamp(41px, 3.65vw, 57px);
  line-height: 1.04;
  font-weight: 800;

  letter-spacing: -0.049em;
}

.splitHeading h2 span,
.centerHeading h2 span {
  display: block;
}

.splitHeading > p {
  margin: 0;

  font-size: 16px;
  line-height: 1.72;
}

.centerHeading {
  max-width: 920px;

  margin: 0 auto 45px;

  text-align: center;
}

.centerHeading > p:last-child {
  max-width: 730px;

  margin: 18px auto 0;

  font-size: 15px;
  line-height: 1.68;
}


/* ============================================================
   2.5D CARDS
   ============================================================ */

.largeCard,
.standardCard,
.noteCard {
  position: relative;

  border:
    1px solid #cedbe4;

  background:
    linear-gradient(
      145deg,
      #fffefa 0%,
      #fbfaf6 58%,
      #eee8dc 100%
    );

  box-shadow:
    0 23px 42px rgba(30, 53, 72, 0.13),
    0 8px 18px rgba(30, 53, 72, 0.07),
    0 2px 4px rgba(30, 53, 72, 0.05),
    inset 0 1px 0 rgba(255, 255, 255, 1);

  opacity: 1 !important;
  filter: none !important;
}

.largeCard::before,
.standardCard::before {
  content: "";

  position: absolute;

  left: 12px;
  right: 12px;
  top: 0;

  height: 2px;

  border-radius: 999px;

  background:
    linear-gradient(
      90deg,
      transparent,
      rgba(38, 131, 218, 0.5),
      transparent
    );

  pointer-events: none;
}

.largeCard {
  min-height: 405px;

  padding: 28px;

  border-radius: 20px;
}

.largeCardActive {
  transform: translateY(-5px);

  border-color:
    #98c6eb;

  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f6fbff 61%,
      #e9f3fb 100%
    );

  box-shadow:
    0 31px 55px rgba(34, 95, 145, 0.18),
    0 9px 20px rgba(30, 53, 72, 0.08),
    inset 0 1px 0 #ffffff;
}

.accessComparison {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    94px
    minmax(0, 1fr);

  align-items: center;

  gap: 18px;
}

.cardLabel {
  display: flex;
  align-items: center;

  gap: 13px;
}

.page .lightSection .cardLabel > strong {
  color: #177ad4 !important;
  -webkit-text-fill-color: #177ad4 !important;

  opacity: 1 !important;
}

.cardLabel > strong {
  font-size: 10px;
  font-weight: 850;

  letter-spacing: 0.09em;
}

.iconWell {
  width: 48px;
  height: 48px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border:
    1px solid #c5def3;

  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #eff7ff,
      #dcecf9
    );

  color: #187bd4;

  box-shadow:
    0 9px 18px rgba(35, 112, 179, 0.14),
    inset 0 1px 0 #ffffff;
}

.page .lightSection .largeCard h3,
.page .modelSection .standardCard h3,
.page .connectedSection .standardCard h3 {
  color: #102f4d !important;
  -webkit-text-fill-color: #102f4d !important;

  opacity: 1 !important;

  background: none !important;
  background-image: none !important;

  filter: none !important;
  text-shadow: none !important;
}

.largeCard h3 {
  margin: 27px 0 21px;

  font-size: 24px;
  line-height: 1.12;
  font-weight: 790;

  letter-spacing: -0.035em;
}

.rows {
  display: grid;

  gap: 9px;
}

.rows > div {
  min-height: 48px;

  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 20px;

  padding: 11px 13px;

  border:
    1px solid #d5e0e7;

  border-radius: 10px;

  background:
    linear-gradient(
      145deg,
      #f9fbfc,
      #eff3f6
    );

  box-shadow:
    inset 0 1px 0 #ffffff,
    0 3px 7px rgba(28, 53, 73, 0.04);
}

.page .lightSection .rows span {
  color: #637d94 !important;
  -webkit-text-fill-color: #637d94 !important;
}

.page .lightSection .rows strong {
  color: #0e3553 !important;
  -webkit-text-fill-color: #0e3553 !important;
}

.rows span,
.rows strong {
  font-size: 10px;
}

.rows strong {
  font-weight: 780;
  text-align: right;
}

.page .lightSection .cardFoot {
  color: #58738c !important;
  -webkit-text-fill-color: #58738c !important;
}

.cardFoot {
  margin: 20px 0 0 !important;

  font-size: 13px !important;
  line-height: 1.62 !important;
}

.bridge {
  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 9px;

  color: var(--blue);
}

.bridge i {
  width: 1px;
  height: 38px;

  background:
    linear-gradient(
      transparent,
      #3788d2,
      transparent
    );
}

.noteCard {
  max-width: 900px;

  display: flex;
  align-items: flex-start;

  gap: 14px;

  margin: 30px auto 0;
  padding: 18px 21px;

  border-radius: 14px;

  color: var(--blue);
}

.page .lightSection .noteCard strong,
.page .connectedSection .noteCard strong {
  color: #102f4d !important;
  -webkit-text-fill-color: #102f4d !important;
}

.page .lightSection .noteCard p,
.page .connectedSection .noteCard p {
  color: #58738c !important;
  -webkit-text-fill-color: #58738c !important;
}

.noteCard strong {
  display: block;

  font-size: 14px;
  line-height: 1.42;
}

.noteCard p {
  margin: 5px 0 0 !important;

  font-size: 13px !important;
  line-height: 1.55 !important;
}


/* ============================================================
   AUTHORITY MODEL CARDS
   ============================================================ */

.fourCards {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 17px;
}

.standardCard {
  min-height: 265px;

  padding: 25px;

  overflow: hidden;

  border-radius: 18px;

  transition:
    transform 180ms ease,
    box-shadow 180ms ease,
    border-color 180ms ease;
}

.standardCard:hover {
  transform: translateY(-4px);

  border-color:
    rgba(39, 126, 211, 0.34);

  box-shadow:
    0 29px 49px rgba(23, 48, 68, 0.15),
    0 8px 18px rgba(23, 48, 68, 0.07),
    inset 0 1px 0 #ffffff;
}

.standardCardActive {
  transform: translateY(-4px);

  border-color:
    #98c6eb;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #e9f4fd
    );

  box-shadow:
    0 28px 48px rgba(35, 96, 146, 0.17),
    0 8px 18px rgba(30, 53, 72, 0.07),
    inset 0 1px 0 #ffffff;
}

.cardTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.page .modelSection .cardTop > span:first-child,
.page .connectedSection .flowNumber {
  color: #177ad4 !important;
  -webkit-text-fill-color: #177ad4 !important;
}

.cardTop > span:first-child,
.flowNumber {
  font-size: 10px;
  font-weight: 850;
}

.standardCard h3 {
  margin: 33px 0 11px;

  font-size: 21px;
  line-height: 1.14;
  font-weight: 790;

  letter-spacing: -0.03em;
}

.page .modelSection .standardCard p,
.page .connectedSection .standardCard p {
  color: #58738c !important;
  -webkit-text-fill-color: #58738c !important;

  opacity: 1 !important;

  background: none !important;
  background-image: none !important;

  filter: none !important;
}

.standardCard p {
  margin: 0;

  font-size: 13px;
  line-height: 1.66;
}


/* ============================================================
   DARK SCENARIO
   ============================================================ */

.darkSection {
  padding: 96px 0;

  background:
    linear-gradient(
      145deg,
      #061b2f,
      #0b2e4b
    );

  color: #ffffff;
}

.scenarioLayout {
  display: grid;

  grid-template-columns:
    minmax(0, 0.88fr)
    minmax(530px, 1.12fr);

  align-items: center;

  gap: 70px;
}

.scenarioCopy {
  max-width: 610px;
}

.darkGoldEyebrow {
  color: #d2a142;
}

.scenarioCopy h2,
.finalGrid h2 {
  margin: 14px 0 0;

  color: #ffffff;

  font-size: clamp(40px, 3.55vw, 56px);
  line-height: 1.04;
  font-weight: 800;

  letter-spacing: -0.048em;
}



.scenarioCopy > p {
  margin: 18px 0 0;

  color: #acc1d4;

  font-size: 15px;
  line-height: 1.72;
}

.resultCard {
  display: flex;
  align-items: center;

  gap: 13px;

  margin-top: 27px;
  padding: 15px;

  border:
    1px solid rgba(96, 170, 236, 0.21);

  border-radius: 12px;

  background:
    rgba(255, 255, 255, 0.045);

  color: #70b4fb;

  box-shadow:
    0 12px 24px rgba(0, 0, 0, 0.10);
}

.resultCard span,
.evalHeading span,
.evalResult span {
  display: block;

  color: #6fb2f2;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.1em;
}

.resultCard strong {
  display: block;

  margin-top: 5px;

  color: #e2edf6;

  font-size: 11px;
  line-height: 1.45;
}

.evaluationPanel {
  padding: 24px;

  border:
    1px solid rgba(92, 162, 222, 0.22);

  border-radius: 21px;

  background:
    linear-gradient(
      145deg,
      rgba(16, 57, 90, 0.98),
      rgba(7, 33, 55, 0.98)
    );

  box-shadow:
    0 28px 52px rgba(0, 8, 20, 0.29),
    inset 0 1px 0 rgba(255, 255, 255, 0.04);
}

.evalHeading {
  padding-bottom: 15px;

  border-bottom:
    1px solid rgba(105, 165, 215, 0.14);
}

.evalHeading strong {
  display: block;

  margin-top: 6px;

  color: #ffffff;

  font-size: 17px;
}

.evalGrid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 9px;

  margin-top: 17px;
}

.evalGrid article {
  min-height: 110px;

  padding: 14px;

  border:
    1px solid rgba(99, 162, 216, 0.16);

  border-radius: 11px;

  background:
    linear-gradient(
      145deg,
      rgba(255, 255, 255, 0.05),
      rgba(255, 255, 255, 0.02)
    );
}

.darkIconWell,
.goldIconWell {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  margin-bottom: 11px;

  border-radius: 9px;
}

.darkIconWell {
  color: #6aaff5;

  background:
    rgba(65, 148, 227, 0.11);
}

.goldIconWell {
  color: #dda43d;

  background:
    rgba(220, 163, 62, 0.11);
}

.evalGrid small {
  color: #6eaff0;

  font-size: 8px;
  font-weight: 850;
}

.evalGrid strong {
  display: block;

  margin-top: 6px;

  color: #dfeaf3;

  font-size: 10px;
  line-height: 1.45;
}

.warningCard {
  border-color:
    rgba(224, 166, 64, 0.38) !important;

  background:
    linear-gradient(
      145deg,
      rgba(221, 163, 60, 0.09),
      rgba(255, 255, 255, 0.025)
    ) !important;
}

.evalResult {
  margin-top: 12px;
  padding: 15px;

  border:
    1px solid rgba(218, 163, 66, 0.34);

  border-radius: 11px;

  background:
    rgba(219, 161, 60, 0.075);

  text-align: center;
}

.evalResult span {
  color: #dda63f;
}

.evalResult strong {
  display: block;

  margin-top: 6px;

  color: #f1c365;

  font-size: 13px;
}

.evalResult small {
  display: block;

  margin-top: 6px;

  color: #95adc2;

  font-size: 8px;
}


/* ============================================================
   FINAL CTA
   ============================================================ */

.finalSection {
  padding: 80px 0 84px;

  background:
    linear-gradient(
      135deg,
      #051829,
      #0b2b47
    );

  color: #ffffff;
}

.finalGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(390px, 0.85fr);

  align-items: center;

  gap: 76px;
}

.finalGrid > div:last-child > p {
  margin: 0;

  color: #afc4d7;

  font-size: 15px;
  line-height: 1.72;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1280px) {
  .shell {
    width:
      min(1400px, calc(100% - 80px));
  }

  .heroLayout {
    grid-template-columns:
      minmax(0, 1.27fr)
      minmax(390px, 0.73fr);

    gap: 46px;
  }

  .heroTitle {
    font-size:
      clamp(44px, 4vw, 62px);
  }

  .authorityVisual {
    width: min(100%, 445px);
  }

  .actionNode {
    width: 119px;
  }
}

@media (max-width: 1080px) {
  .hero {
    min-height: auto;
  }

  .heroLayout,
  .scenarioLayout,
  .finalGrid {
    grid-template-columns: 1fr;
  }

  .heroLayout {
    min-height: auto;

    padding: 68px 0;
  }

  .heroTitle span {
    white-space: normal;
  }

  .heroVisualWrap {
    justify-content: center;
  }

  .authorityVisual {
    width: min(100%, 520px);
  }

  .splitHeading {
    grid-template-columns: 1fr;

    gap: 22px;
  }

  .accessComparison {
    grid-template-columns: 1fr;
  }

  .bridge {
    min-height: 68px;
  }

  .bridge i {
    height: 17px;
  }

  .fourCards {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .scenarioCopy {
    max-width: 720px;
  }

  .evaluationPanel {
    max-width: 760px;

    margin-inline: auto;
  }
}

@media (max-width: 760px) {
  .shell {
    width: calc(100% - 34px);
  }

  .heroTitle {
    font-size:
      clamp(40px, 11vw, 55px);
  }

  .visualCanvas {
    min-height: 525px;
  }

  .boundary {
    width: 96%;
    height: 470px;

    border-radius: 34px;
  }

  .actorCore {
    width: 112px;
    height: 112px;
  }

  .actionNode {
    width: calc(50% - 26px);
  }

  .actionNode1 {
    left: 13px;
    top: 53px;
  }

  .actionNode2 {
    left: 13px;
    bottom: 53px;
  }

  .actionNode3 {
    right: 13px;
    top: 53px;
  }

  .actionNode4 {
    right: 13px;
    bottom: 53px;
  }

  .actionNode5 {
    top: 160px;
  }

  .actionNode6 {
    bottom: 160px;
  }

  .legend,
  .fourCards,
  .evalGrid {
    grid-template-columns: 1fr;
  }

  .splitHeading h2,
  .centerHeading h2,
  .scenarioCopy h2,
  .finalGrid h2 {
    font-size:
      clamp(35px, 10vw, 49px);
  }

  .largeCard,
  .standardCard {
    min-height: auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  .page *,
  .page *::before,
  .page *::after {
    transition: none !important;
    animation: none !important;
  }
}

/* === PAGE 04 NATURAL HEADING WRAP === */

.scenarioCopy h2,
.connectedSection .splitHeading h2,
.finalGrid h2 {
  text-wrap: balance;
  white-space: normal;
  overflow-wrap: normal;
  word-break: normal;
}

/*
  Do not force individual words or phrases onto separate lines.
  Let the browser use the full heading width before wrapping.
*/

.scenarioCopy h2 span,
.connectedSection .splitHeading h2 span,
.finalGrid h2 span {
  display: inline;
}

/* === END PAGE 04 NATURAL HEADING WRAP === */

/* ============================================================
   SIX CONNECTED PLATFORM CAPABILITIES
   Global capability-page standard:
   3 x 2 desktop
   2 x 3 tablet
   1 x 6 mobile
   ============================================================ */

.sixCapabilityGrid {
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
}

.sixCapabilityGrid > article {
  min-height: 220px;
}

@media (max-width: 1080px) {
  .sixCapabilityGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}

@media (max-width: 680px) {
  .sixCapabilityGrid {
    grid-template-columns: 1fr;
  }
}
