.aigo-live-demo__workspace {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: minmax(250px, .82fr) minmax(360px, 1.2fr) minmax(260px, .9fr);
  gap: 12px;
  margin-top: 12px;
  perspective: 1500px;
  animation: aigo-demo-enter 420ms ease both;
}

.aigo-live-demo__request,
.aigo-live-demo__engine,
.aigo-live-demo__result {
  overflow: hidden;
  border: 1px solid #193a59;
  border-radius: 12px;
  background:
    linear-gradient(155deg, rgba(12, 38, 63, .95), rgba(5, 22, 38, .97));
  box-shadow:
    inset 0 1px rgba(255,255,255,.035),
    0 28px 60px rgba(0,0,0,.18);
}

.aigo-live-demo__request {
  transform: rotateY(3deg);
  transform-origin: right center;
}

.aigo-live-demo__result {
  transform: rotateY(-3deg);
  transform-origin: left center;
}

.aigo-live-demo__panel-head,
.aigo-live-demo__engine-head {
  min-height: 53px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 16px;
  padding: 0 18px;
  border-bottom: 1px solid #183651;
}

.aigo-live-demo__panel-head span,
.aigo-live-demo__engine-head span {
  color: #667f98;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: .11em;
  text-transform: uppercase;
}

.aigo-live-demo__panel-head > strong {
  color: #57a9fc;
  font-size: 8px;
  letter-spacing: .08em;
}

.aigo-live-demo__actor {
  display: flex;
  align-items: center;
  gap: 13px;
  padding: 20px 18px;
  border-bottom: 1px solid #183651;
}

.aigo-live-demo__actor-icon {
  width: 42px;
  height: 42px;
  flex: 0 0 auto;
  display: grid;
  place-items: center;
  border: 1px solid #3779b8;
  border-radius: 50%;
  color: #72b9ff;
  background: #0b2c49;
  box-shadow: 0 0 28px rgba(47, 139, 228, .15);
  font-size: 10px;
  font-weight: 900;
}

.aigo-live-demo__actor span,
.aigo-live-demo__request-grid span,
.aigo-live-demo__facts span,
.aigo-live-demo__receipt span,
.aigo-live-demo__decision span {
  display: block;
  color: #68829b;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .06em;
  text-transform: uppercase;
}

.aigo-live-demo__actor strong {
  display: block;
  margin-top: 5px;
  color: #eef6ff;
  font-size: 12px;
}

.aigo-live-demo__request-grid {
  display: grid;
}

.aigo-live-demo__request-grid > div {
  padding: 15px 18px;
  border-bottom: 1px solid #15344f;
}

.aigo-live-demo__request-grid > div:last-child {
  border-bottom: 0;
}

.aigo-live-demo__request-grid strong,
.aigo-live-demo__facts strong {
  display: block;
  margin-top: 6px;
  color: #bacbdd;
  font-size: 10px;
  line-height: 1.5;
}

.aigo-live-demo__engine {
  position: relative;
  box-shadow:
    0 0 0 1px rgba(52, 135, 218, .08),
    0 30px 75px rgba(0,0,0,.24),
    0 0 55px rgba(30, 111, 197, .08);
}

.aigo-live-demo__engine::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background:
    radial-gradient(circle at 50% 45%, rgba(38,130,225,.08), transparent 34%);
}

.aigo-live-demo__engine-head > div:first-child strong {
  display: block;
  margin-top: 4px;
  color: #dceaff;
  font-size: 11px;
}

.aigo-live-demo__pulse {
  display: flex;
  align-items: center;
  gap: 7px;
  color: #5facf7;
  font-size: 8px;
  font-weight: 800;
  text-transform: uppercase;
}

.aigo-live-demo__pulse i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4ca9ff;
  box-shadow: 0 0 0 0 rgba(76, 169, 255, .4);
  animation: aigo-pulse 1.7s infinite;
}

.aigo-live-demo__stages {
  position: relative;
  padding: 13px 17px;
}

.aigo-live-demo__stage {
  position: relative;
  min-height: 61px;
  display: grid;
  grid-template-columns: 32px 1fr 10px;
  gap: 10px;
  align-items: center;
  border-bottom: 1px solid #163550;
  opacity: 0;
  transform: translateX(-8px);
  animation: aigo-stage-in 360ms ease forwards;
}

.aigo-live-demo__stage:last-child {
  border-bottom: 0;
}

.aigo-live-demo__stage-index {
  color: #b58b3f;
  font-size: 8px;
  font-weight: 850;
}

.aigo-live-demo__stage strong {
  display: block;
  color: #dce9f5;
  font-size: 10px;
}

.aigo-live-demo__stage span {
  display: block;
  margin-top: 4px;
  color: #6f889f;
  font-size: 8px;
  line-height: 1.4;
}

.aigo-live-demo__stage > i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #46a7ff;
  box-shadow: 0 0 14px rgba(70,167,255,.55);
}

.aigo-live-demo__risk {
  display: grid;
  grid-template-columns: 105px 1fr 48px;
  gap: 13px;
  align-items: center;
  padding: 17px;
  border-top: 1px solid #173651;
}

.aigo-live-demo__risk span {
  display: block;
  color: #6f899f;
  font-size: 8px;
}

.aigo-live-demo__risk > div:first-child strong {
  color: #e4edf6;
  font-size: 10px;
}

.aigo-live-demo__risk > strong {
  color: #c9d7e5;
  font-size: 9px;
  text-align: right;
}

.aigo-live-demo__risk-meter {
  height: 5px;
  overflow: hidden;
  border-radius: 999px;
  background: #122d47;
}

.aigo-live-demo__risk-meter i {
  display: block;
  height: 100%;
  border-radius: inherit;
  background:
    linear-gradient(90deg, #428ae0, #d7a84c);
  transform-origin: left;
  animation: aigo-risk-fill 700ms ease both;
}

.aigo-live-demo__decision {
  padding: 30px 18px 24px;
  border-bottom: 1px solid #173651;
}

.aigo-live-demo__decision strong {
  display: block;
  margin-top: 8px;
  font-size: 18px;
  letter-spacing: -.02em;
}

.aigo-live-demo__decision--allow strong {
  color: #63c9a6;
}

.aigo-live-demo__decision--deny strong {
  color: #ec7a78;
}

.aigo-live-demo__decision--review-required strong,
.aigo-live-demo__decision--escalate strong {
  color: #e2af50;
}

.aigo-live-demo__explanation {
  margin: 0;
  padding: 20px 18px;
  color: #94aac0;
  font-size: 10px;
  line-height: 1.7;
  border-bottom: 1px solid #173651;
}

.aigo-live-demo__facts {
  display: grid;
  grid-template-columns: 1fr;
}

.aigo-live-demo__facts > div {
  padding: 13px 18px;
  border-bottom: 1px solid #173651;
}

.aigo-live-demo__receipt {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12px;
  padding: 17px 18px;
  background: rgba(32, 105, 176, .08);
}

.aigo-live-demo__receipt strong {
  display: block;
  margin-top: 5px;
  color: #72b6f7;
  font-size: 9px;
}

.aigo-live-demo__receipt-check {
  width: 29px;
  height: 29px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  color: #76caae;
  border: 1px solid rgba(118,202,174,.28);
  background: rgba(59,157,126,.08);
}

.aigo-live-demo__evidence {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 24px;
  color: #68839e;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: .08em;
  text-transform: uppercase;
}

.aigo-live-demo__evidence i {
  width: 45px;
  height: 1px;
  margin: 0 12px;
  background: linear-gradient(90deg, transparent, #347dc2, transparent);
}

@keyframes aigo-demo-enter {
  from {
    opacity: 0;
    transform: translateY(12px) scale(.992);
  }

  to {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@keyframes aigo-stage-in {
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes aigo-risk-fill {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

@keyframes aigo-pulse {
  0% {
    box-shadow: 0 0 0 0 rgba(76,169,255,.4);
  }

  70% {
    box-shadow: 0 0 0 9px rgba(76,169,255,0);
  }

  100% {
    box-shadow: 0 0 0 0 rgba(76,169,255,0);
  }
}

@media (max-width: 1050px) {
  .aigo-live-demo__workspace {
    grid-template-columns: 1fr 1.15fr;
  }

  .aigo-live-demo__result {
    grid-column: 1 / -1;
    transform: none;
  }

  .aigo-live-demo__request {
    transform: none;
  }
}

@media (max-width: 820px) {
  .aigo-live-demo {
    padding: 75px 0;
  }

  .aigo-live-demo__heading {
    grid-template-columns: 1fr;
    gap: 24px;
  }

  .aigo-live-demo__scenarios {
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  .aigo-live-demo__workspace {
    grid-template-columns: 1fr;
  }

  .aigo-live-demo__result {
    grid-column: auto;
  }

  .aigo-live-demo__evidence {
    flex-wrap: wrap;
    gap: 9px;
  }

  .aigo-live-demo__evidence i {
    width: 18px;
    margin: 0 2px;
  }
}

@media (max-width: 520px) {
  .aigo-live-demo__scenarios {
    grid-template-columns: 1fr;
  }

  .aigo-live-demo__scenario {
    min-height: 88px;
  }

  .aigo-live-demo__heading h2 {
    font-size: 38px;
  }

  .aigo-live-demo__risk {
    grid-template-columns: 1fr;
  }

  .aigo-live-demo__risk > strong {
    text-align: left;
  }

  .aigo-live-demo__evidence {
    display: grid;
    grid-template-columns: 1fr;
    text-align: center;
  }

  .aigo-live-demo__evidence i {
    width: 1px;
    height: 14px;
    margin: 0 auto;
  }
}

@media (prefers-reduced-motion: reduce) {
  .aigo-live-demo *,
  .aigo-live-demo *::before,
  .aigo-live-demo *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
  }
}


/* =========================================================
   AIGO-OS CAPABILITY DEMONSTRATIONS
   ========================================================= */

.aigo-cap-demo {
  position: relative;
  overflow: hidden;
  padding: 100px 0;
  color: #edf5ff;
  background:
    radial-gradient(circle at 15% 20%, rgba(35,126,232,.14), transparent 28%),
    radial-gradient(circle at 88% 78%, rgba(25,85,160,.13), transparent 32%),
    #061321;
}

.aigo-cap-demo::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .08;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(89,150,212,.2) 1px, transparent 1px),
    linear-gradient(90deg, rgba(89,150,212,.2) 1px, transparent 1px);
  background-size: 48px 48px;
}

.aigo-cap-demo__heading {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns: 1fr minmax(280px, .55fr);
  gap: 70px;
  align-items: end;
}

.aigo-cap-demo__heading span,
.aigo-cap-demo__flow-label,
.aigo-cap-demo__outcome > span {
  color: #58a9f7;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .12em;
  text-transform: uppercase;
}

.aigo-cap-demo__heading h2 {
  margin: 12px 0 0;
  color: #f5f9fe;
  font-size: clamp(36px, 4vw, 52px);
  line-height: 1.02;
  letter-spacing: -.045em;
}

.aigo-cap-demo__heading p {
  margin: 0;
  color: #899fb5;
  font-size: 12px;
  line-height: 1.75;
}

.aigo-cap-demo__scene {
  position: relative;
  z-index: 1;
  display: grid;
  grid-template-columns:
    minmax(360px, 1.1fr)
    minmax(220px, .65fr)
    minmax(300px, .85fr);
  gap: 12px;
  margin-top: 46px;
  perspective: 1500px;
}

.aigo-cap-demo__primary,
.aigo-cap-demo__flow,
.aigo-cap-demo__outcome {
  border: 1px solid #193a59;
  border-radius: 13px;
  background:
    linear-gradient(
      155deg,
      rgba(12,38,63,.96),
      rgba(5,22,38,.98)
    );
  box-shadow:
    inset 0 1px rgba(255,255,255,.04),
    0 28px 70px rgba(0,0,0,.21);
}

.aigo-cap-demo__primary {
  overflow: hidden;
  transform: rotateY(2.5deg);
  transform-origin: right center;
}

.aigo-cap-demo__primary-head {
  min-height: 72px;
  display: flex;
  justify-content: space-between;
  align-items: center;
  gap: 20px;
  padding: 0 20px;
  border-bottom: 1px solid #183651;
}

.aigo-cap-demo__primary-head span,
.aigo-cap-demo__field span,
.aigo-cap-demo__score span {
  display: block;
  color: #68829c;
  font-size: 8px;
  font-weight: 800;
  letter-spacing: .07em;
  text-transform: uppercase;
}

.aigo-cap-demo__primary-head strong {
  display: block;
  margin-top: 5px;
  color: #edf6ff;
  font-size: 15px;
}

.aigo-cap-demo__primary-head small {
  color: #65b6ff;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: .08em;
}

.aigo-cap-demo__field-grid {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
}

.aigo-cap-demo__field {
  min-height: 92px;
  padding: 18px 20px;
  border-right: 1px solid #173650;
  border-bottom: 1px solid #173650;
  opacity: 0;
  transform: translateY(7px);
  animation: aigo-cap-field-in 360ms ease forwards;
}

.aigo-cap-demo__field:nth-child(2n) {
  border-right: 0;
}

.aigo-cap-demo__field strong {
  display: block;
  margin-top: 10px;
  color: #c9d8e7;
  font-size: 11px;
  line-height: 1.45;
}

.aigo-cap-demo__score {
  padding: 19px 20px;
}

.aigo-cap-demo__score > div:first-child {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.aigo-cap-demo__score strong {
  color: #dce9f6;
  font-size: 10px;
}

.aigo-cap-demo__score-track {
  height: 5px;
  margin-top: 12px;
  overflow: hidden;
  border-radius: 999px;
  background: #112e49;
}

.aigo-cap-demo__score-track i {
  display: block;
  width: 78%;
  height: 100%;
  border-radius: inherit;
  background:
    linear-gradient(90deg, #327ed2, #60b5ff);
  transform-origin: left;
  animation: aigo-cap-meter 900ms ease both;
}

.aigo-cap-demo__flow {
  padding: 20px 17px;
  box-shadow:
    0 0 50px rgba(36,125,218,.07),
    inset 0 1px rgba(255,255,255,.035);
}

.aigo-cap-demo__flow-stage {
  min-height: 76px;
  display: grid;
  grid-template-columns: 30px 1fr 9px;
  gap: 10px;
  align-items: center;
  border-bottom: 1px solid #183651;
  opacity: 0;
  transform: translateX(-8px);
  animation: aigo-cap-stage-in 380ms ease forwards;
}

.aigo-cap-demo__flow-stage:last-child {
  border-bottom: 0;
}

.aigo-cap-demo__flow-stage > span {
  color: #b88c3c;
  font-size: 8px;
  font-weight: 850;
}

.aigo-cap-demo__flow-stage strong {
  color: #dbe8f5;
  font-size: 10px;
}

.aigo-cap-demo__flow-stage i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #47a8ff;
  box-shadow: 0 0 15px rgba(71,168,255,.6);
}

.aigo-cap-demo__outcome {
  padding: 20px;
  transform: rotateY(-2.5deg);
  transform-origin: left center;
}

.aigo-cap-demo__outcome-orb {
  width: 170px;
  height: 170px;
  margin: 34px auto;
  display: grid;
  place-items: center;
  border: 1px solid rgba(70,162,248,.3);
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(46,130,216,.16),
      rgba(9,32,54,.18) 55%,
      transparent 56%
    );
  box-shadow:
    0 0 0 18px rgba(37,111,185,.025),
    0 0 0 38px rgba(37,111,185,.016),
    0 0 60px rgba(44,135,226,.12);
  animation: aigo-cap-orb 4s ease-in-out infinite;
}

.aigo-cap-demo__outcome-orb div {
  text-align: center;
}

.aigo-cap-demo__outcome-orb small {
  display: block;
  color: #6d8aa5;
  font-size: 8px;
}

.aigo-cap-demo__outcome-orb strong {
  display: block;
  margin-top: 6px;
  color: #6bb8ff;
  font-size: 13px;
}

.aigo-cap-demo__outcome p {
  margin: 0;
  color: #94a9bd;
  font-size: 10px;
  line-height: 1.7;
  text-align: center;
}

.aigo-cap-demo__evidence {
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 6px;
  margin-top: 22px;
}

.aigo-cap-demo__evidence span {
  min-height: 35px;
  display: grid;
  place-items: center;
  border: 1px solid #1b405f;
  border-radius: 6px;
  color: #6f8ba7;
  background: #09233a;
  font-size: 8px;
  font-weight: 800;
}

@keyframes aigo-cap-field-in {
  to {
    opacity: 1;
    transform: translateY(0);
  }
}

@keyframes aigo-cap-stage-in {
  to {
    opacity: 1;
    transform: translateX(0);
  }
}

@keyframes aigo-cap-meter {
  from {
    transform: scaleX(0);
  }

  to {
    transform: scaleX(1);
  }
}

@keyframes aigo-cap-orb {
  0%,
  100% {
    transform: translateY(0) rotateX(0deg);
  }

  50% {
    transform: translateY(-7px) rotateX(4deg);
  }
}

@media (max-width: 1050px) {
  .aigo-cap-demo__scene {
    grid-template-columns: 1fr 1fr;
  }

  .aigo-cap-demo__outcome {
    grid-column: 1 / -1;
    transform: none;
  }

  .aigo-cap-demo__primary {
    transform: none;
  }
}

@media (max-width: 760px) {
  .aigo-cap-demo {
    padding: 72px 0;
  }

  .aigo-cap-demo__heading {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .aigo-cap-demo__scene {
    grid-template-columns: 1fr;
  }

  .aigo-cap-demo__outcome {
    grid-column: auto;
  }
}

@media (max-width: 520px) {
  .aigo-cap-demo__heading h2 {
    font-size: 38px;
  }

  .aigo-cap-demo__field-grid {
    grid-template-columns: 1fr;
  }

  .aigo-cap-demo__field {
    min-height: 76px;
    border-right: 0;
  }

  .aigo-cap-demo__outcome-orb {
    width: 145px;
    height: 145px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .aigo-cap-demo *,
  .aigo-cap-demo *::before,
  .aigo-cap-demo *::after {
    animation-duration: .001ms !important;
    animation-iteration-count: 1 !important;
    transition-duration: .001ms !important;
  }
}


/* =========================================================
   AIGO-OS NAVIGATION Ã¢â‚¬â€ CLEAN 2026 SYSTEM
   ========================================================= */

.aigo-nav {
  position: sticky;
  top: 0;
  z-index: 10000;
  width: 100%;
  background: #061526;
  border-bottom: 1px solid rgba(129, 164, 205, 0.18);
}

.aigo-nav__bar {
  width: min(1480px, calc(100% - 64px));
  height: 76px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 150px minmax(0, 1fr) auto;
  align-items: stretch;
  gap: 24px;
}

.aigo-nav__brand {
  display: flex;
  align-items: center;
  text-decoration: none;
}

.aigo-nav__logo {
  width: 116px;
  height: auto;
  object-fit: contain;
}

.aigo-nav__desktop {
  min-width: 0;
  display: flex;
  justify-content: center;
  align-items: stretch;
  gap: 4px;
}

.aigo-nav__item {
  display: flex;
  align-items: stretch;
}

.aigo-nav__trigger {
  position: relative;
  appearance: none;
  border: 0;
  background: transparent;
  color: #c6d5e7;
  min-width: 0;
  padding: 0 16px;
  display: flex;
  align-items: center;
  gap: 7px;
  font: inherit;
  font-size: 14px;
  font-weight: 750;
  cursor: pointer;
  text-decoration: none;
  white-space: nowrap;
}

.aigo-nav__trigger:hover,
.aigo-nav__trigger:focus-visible,
.aigo-nav__trigger--active {
  color: #ffffff;
}

.aigo-nav__trigger--active::after {
  content: "";
  position: absolute;
  left: 16px;
  right: 16px;
  bottom: 0;
  height: 2px;
  background: linear-gradient(90deg, #287ce5, #d5aa55);
}

.aigo-nav__trigger span {
  color: #7f99b8;
  font-size: 11px;
}

.aigo-nav__desktop-action {
  display: flex;
