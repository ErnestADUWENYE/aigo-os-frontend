/* =========================================================
   AIGO-OS ANALYTICAL GOVERNANCE ENGINE
   ========================================================= */

.governance-engine {
  position: relative;
  width: min(100%, 560px);
  min-height: 430px;
  justify-self: center;
  padding: 18px;
  border: 1px solid rgba(123, 169, 238, 0.16);
  border-radius: 28px;
  color: #eef5ff;
  background:
    radial-gradient(
      circle at 52% 42%,
      rgba(48, 124, 246, 0.12),
      transparent 36%
    ),
    linear-gradient(
      145deg,
      rgba(13, 34, 59, 0.86),
      rgba(5, 18, 35, 0.92)
    );
  box-shadow:
    0 32px 90px rgba(0, 0, 0, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(20px);
  overflow: hidden;
}

.governance-engine::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  background-image:
    linear-gradient(rgba(98, 154, 239, 0.045) 1px, transparent 1px),
    linear-gradient(90deg, rgba(98, 154, 239, 0.045) 1px, transparent 1px);
  background-size: 28px 28px;
  mask-image: linear-gradient(to bottom, black, transparent 94%);
}

.governance-engine__heading {
  position: relative;
  z-index: 4;
  min-height: 34px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 0 4px 12px;
  border-bottom: 1px solid rgba(122, 164, 228, 0.1);
}

.governance-engine__live {
  display: inline-flex;
  align-items: center;
  gap: 8px;
  color: #d8e5f8;
  font-size: 0.71rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.governance-engine__live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #52a2ff;
  box-shadow:
    0 0 0 5px rgba(82, 162, 255, 0.08),
    0 0 16px rgba(82, 162, 255, 0.48);
  animation: governanceLivePulse 2.3s ease-in-out infinite;
}

.governance-engine__status {
  padding: 5px 9px;
  border: 1px solid rgba(213, 170, 85, 0.17);
  border-radius: 999px;
  color: #d7bc80;
  background: rgba(213, 170, 85, 0.06);
  font-size: 0.62rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.governance-engine__flow {
  position: relative;
  z-index: 3;
  display: grid;
  grid-template-columns: 92px 28px minmax(210px, 1fr) 28px 94px;
  align-items: center;
  gap: 6px;
  min-height: 300px;
  padding: 16px 0 14px;
}

.governance-engine__inputs,
.governance-engine__outcomes {
  display: flex;
  flex-direction: column;
  gap: 9px;
}

.governance-engine__column-label {
  margin-bottom: 3px;
  color: #7188a8;
  font-size: 0.57rem;
  font-weight: 800;
  letter-spacing: 0.1em;
  text-transform: uppercase;
}

.governance-input,
.governance-outcome {
  min-height: 34px;
  display: flex;
  align-items: center;
  gap: 7px;
  padding: 0 8px;
  border: 1px solid rgba(116, 161, 230, 0.13);
  border-radius: 9px;
  color: #c9d7ea;
  background: rgba(10, 29, 51, 0.7);
  font-size: 0.65rem;
  font-weight: 700;
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.035);
}

.governance-input {
  animation:
    governanceInputArrival 5.5s ease-in-out infinite;
  animation-delay: calc(var(--input-index) * -1.05s);
}

.governance-input__signal {
  width: 6px;
  height: 6px;
  flex: 0 0 auto;
  border-radius: 50%;
  background: #4d91fb;
  box-shadow: 0 0 10px rgba(77, 145, 251, 0.55);
}

.governance-engine__connector {
  position: relative;
  height: 100%;
  min-height: 220px;
}

.governance-engine__connector::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  right: 0;
  height: 1px;
  background:
    linear-gradient(
      90deg,
      rgba(64, 133, 241, 0.12),
      rgba(78, 149, 255, 0.68),
      rgba(64, 133, 241, 0.14)
    );
}

.governance-engine__connector > span {
  position: absolute;
  top: calc(50% - 3px);
  left: 0;
  width: 6px;
  height: 6px;
  border-radius: 50%;
  background: #66a6ff;
  box-shadow:
    0 0 8px rgba(102, 166, 255, 0.9),
    0 0 18px rgba(102, 166, 255, 0.5);
  animation: governanceSignalIn 3.4s linear infinite;
}

.governance-engine__connector--out > span {
  background: #d5aa55;
  box-shadow:
    0 0 8px rgba(213, 170, 85, 0.85),
    0 0 18px rgba(213, 170, 85, 0.45);
  animation-name: governanceSignalOut;
}

.governance-engine__connector > span:nth-child(2) {
  animation-delay: -1.15s;
}

.governance-engine__connector > span:nth-child(3) {
  animation-delay: -2.3s;
}

.governance-engine__core {
  position: relative;
  padding: 12px;
  border: 1px solid rgba(93, 156, 255, 0.23);
  border-radius: 18px;
  background:
    linear-gradient(
      160deg,
      rgba(21, 55, 95, 0.92),
      rgba(6, 24, 47, 0.95)
    );
  box-shadow:
    0 18px 45px rgba(0, 0, 0, 0.25),
    0 0 50px rgba(43, 116, 234, 0.08),
    inset 0 1px 0 rgba(255, 255, 255, 0.055);
}

.governance-engine__brand {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 10px;
  padding-bottom: 9px;
  margin-bottom: 8px;
  border-bottom: 1px solid rgba(119, 165, 233, 0.1);
}

.governance-engine__logo {
  width: 86px;
  height: auto;
}

.governance-engine__brand > span {
  color: #8097b8;
  font-size: 0.57rem;
  font-weight: 800;
  letter-spacing: 0.09em;
  text-transform: uppercase;
}

.governance-engine__stages {
  display: grid;
  gap: 5px;
}

.governance-stage {
  min-height: 29px;
  display: grid;
  grid-template-columns: 24px 1fr auto;
  align-items: center;
  gap: 7px;
  padding: 0 8px;
  border: 1px solid rgba(108, 157, 228, 0.1);
  border-radius: 7px;
  background: rgba(7, 25, 47, 0.62);
  animation: governanceStagePulse 7.2s ease-in-out infinite;
}

.governance-stage:nth-child(2) {
  animation-delay: -1.2s;
}

.governance-stage:nth-child(3) {
  animation-delay: -2.4s;
}

.governance-stage:nth-child(4) {
  animation-delay: -3.6s;
}

.governance-stage:nth-child(5) {
  animation-delay: -4.8s;
}

.governance-stage:nth-child(6) {
  animation-delay: -6s;
}

.governance-stage__number {
  color: #56759d;
  font-size: 0.55rem;
  font-weight: 800;
}

.governance-stage__label {
  color: #e4edf9;
  font-size: 0.66rem;
  font-weight: 750;
}

.governance-stage__state {
  color: #77aaff;
  font-size: 0.5rem;
  font-weight: 800;
  letter-spacing: 0.05em;
  text-transform: uppercase;
}

.governance-outcome__check {
  width: 16px;
  height: 16px;
  display: grid;
  place-items: center;
  flex: 0 0 auto;
  border-radius: 50%;
  color: #f1d797;
  background: rgba(213, 170, 85, 0.1);
  font-size: 0.58rem;
}

.governance-engine__footer {
  position: relative;
  z-index: 4;
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  border-top: 1px solid rgba(117, 160, 224, 0.1);
  padding-top: 12px;
}

.governance-engine__footer > div {
  min-width: 0;
  padding: 0 10px;
}

.governance-engine__footer > div:not(:last-child) {
  border-right: 1px solid rgba(117, 160, 224, 0.1);
}

.governance-engine__metric-label {
  display: block;
  margin-bottom: 3px;
  color: #687f9e;
  font-size: 0.51rem;
  font-weight: 800;
  letter-spacing: 0.08em;
  text-transform: uppercase;
}

.governance-engine__footer strong {
  display: block;
  overflow: hidden;
  color: #dce7f6;
  font-size: 0.61rem;
  font-weight: 750;
  text-overflow: ellipsis;
  white-space: nowrap;
}

@keyframes governanceLivePulse {
  0%,
  100% {
    opacity: 0.55;
    transform: scale(0.82);
  }

  50% {
    opacity: 1;
    transform: scale(1);
  }
}

@keyframes governanceInputArrival {
  0%,
  100% {
    border-color: rgba(116, 161, 230, 0.13);
    transform: translateX(0);
  }

  35% {
    border-color: rgba(77, 145, 251, 0.34);
    transform: translateX(2px);
  }
}

@keyframes governanceSignalIn {
  from {
    transform: translateX(0);
    opacity: 0;
  }

  15% {
    opacity: 1;
  }

  85% {
    opacity: 1;
  }

  to {
    transform: translateX(25px);
    opacity: 0;
  }
}

@keyframes governanceSignalOut {
  from {
    transform: translateX(0);
    opacity: 0;
  }

  15% {
    opacity: 1;
  }

  85% {
    opacity: 1;
  }

  to {
    transform: translateX(25px);
    opacity: 0;
  }
}

@keyframes governanceStagePulse {
  0%,
  82%,
  100% {
    border-color: rgba(108, 157, 228, 0.1);
    background: rgba(7, 25, 47, 0.62);
  }

  88% {
    border-color: rgba(87, 151, 255, 0.32);
    background: rgba(20, 58, 101, 0.72);
  }
}

