  letter-spacing: .14em;
  text-transform: uppercase;
}

.trust-architecture__heading h2 {
  max-width: 700px;
  margin: 14px 0 0;
  color: #f4f8fc;
  font-size: clamp(32px, 4vw, 52px);
  line-height: 1.05;
  letter-spacing: -.045em;
}

.trust-architecture__heading p {
  margin: 0;
  color: #8da2ba;
  font-size: 12px;
  line-height: 1.75;
}

.trust-architecture__heading a {
  display: inline-flex;
  gap: 8px;
  margin-top: 20px;
  color: #65a7ff;
  font-size: 10px;
  font-weight: 800;
  text-decoration: none;
}

.trust-architecture__system {
  display: grid;
  grid-template-columns: 1fr 115px 1fr;
  align-items: stretch;
  margin-top: 60px;
}

.trust-architecture__boundary,
.trust-architecture__core {
  min-height: 245px;
  padding: 24px;
  border: 1px solid #1d3959;
  border-radius: 10px;
  background: rgba(8,26,47,.72);
}

.trust-architecture__boundary > span,
.trust-architecture__core-head > span {
  color: #6f8baa;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.trust-architecture__boundary > div {
  display: grid;
  grid-template-columns: repeat(2,1fr);
  gap: 8px;
  margin-top: 35px;
}

.trust-architecture__boundary strong {
