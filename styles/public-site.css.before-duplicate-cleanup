  border-radius: 5px;
  background: #0b2038;
  color: #a9c1dc;
  font-size: 9px;
  font-weight: 750;
}

.trust-architecture__layers {
  display: grid;
  grid-template-columns: repeat(4,1fr);
  gap: 8px;
  margin-top: 35px;
}

.trust-architecture__layers article {
  min-height: 235px;
  padding: 22px;
  border: 1px solid #18344f;
  border-radius: 8px;
  background: rgba(8,25,44,.55);
}

.trust-architecture__layers article > div {
  display: flex;
  justify-content: space-between;
}

.trust-architecture__layers article > div > span {
  color: #d0a247;
  font-size: 9px;
  font-weight: 850;
}

.trust-architecture__layers small {
  color: #617f9e;
  font-size: 8px;
  font-weight: 800;
  text-transform: uppercase;
}

.trust-architecture__layers h3 {
