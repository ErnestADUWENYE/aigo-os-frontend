   ========================================================= */

.public-header {
  position: sticky;
  top: 0;
  z-index: 1000;
  height: 72px;
  border-bottom: 1px solid rgba(156,176,201,.2);
  background: rgba(4,15,29,.94);
  backdrop-filter: blur(18px);
}

.public-header__inner {
  width: min(1380px, calc(100% - 48px));
  height: 72px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 145px 1fr auto;
  align-items: center;
  gap: 28px;
}

.public-header__brand {
  display: inline-flex;
  align-items: center;
  width: fit-content;
}

.public-header__logo {
  width: 108px;
  height: auto;
  object-fit: contain;
}

.public-header__nav {
  height: 100%;
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 3px;
}

.public-header__nav-item {
  display: flex;
  align-items: stretch;
}

.public-header__nav-link {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 13px;
  color: #9fb1c7;
  font-size: 12px;
  font-weight: 720;
  text-decoration: none;
  transition: color .18s ease;
}

.public-header__nav-link:hover,
.public-header__nav-link--active {
  color: #fff;
}

.public-header__nav-link--active::after {
  content: "";
  position: absolute;
  right: 13px;
  bottom: -1px;
  left: 13px;
  height: 2px;
  background: #d4a340;
}

.public-header__chevron {
  color: #657b96;
  font-size: 9px;
  transform: translateY(-1px);
}

.public-header__actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.public-header__signin {
  padding: 10px 12px;
  color: #b3c2d3;
  font-size: 12px;
  font-weight: 750;
  text-decoration: none;
}

.public-header__partner {
  display: inline-flex;
  min-height: 40px;
  align-items: center;
  padding: 0 16px;
  border-radius: 7px;
  background: #1675e8;
  color: #fff;
  font-size: 11px;
  font-weight: 820;
  text-decoration: none;
  box-shadow: 0 8px 24px rgba(22,117,232,.18);
}

.public-header__dropdown {
  position: fixed;
  top: 72px;
  right: 0;
  left: 0;
  visibility: hidden;
  opacity: 0;
  transform: translateY(-7px);
  pointer-events: none;
  transition:
    opacity .16s ease,
    transform .16s ease,
    visibility .16s ease;
}

.public-header__nav-item:hover .public-header__dropdown,
.public-header__nav-item:focus-within .public-header__dropdown {
  visibility: visible;
  opacity: 1;
  transform: translateY(0);
  pointer-events: auto;
}

.public-header__dropdown::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    radial-gradient(circle at 18% 10%, rgba(30,105,208,.12), transparent 30%),
    #071426;
  border-bottom: 1px solid #17314f;
  box-shadow: 0 28px 60px rgba(0,0,0,.25);
}

.public-header__dropdown-shell {
  position: relative;
  width: min(1180px, calc(100% - 64px));
  margin: 0 auto;
  padding: 34px 0 38px;
  display: grid;
  grid-template-columns: 270px 1fr;
  gap: 50px;
}

.public-header__dropdown-intro {
  padding-right: 30px;
  border-right: 1px solid rgba(133,162,198,.17);
}

.public-header__dropdown-intro > span {
  color: #d0a247;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .14em;
  text-transform: uppercase;
}

.public-header__dropdown-intro h2 {
  margin: 15px 0 22px;
  color: #f4f8fc;
  font-size: 19px;
  line-height: 1.35;
  letter-spacing: -.02em;
}

.public-header__dropdown-intro a {
  display: inline-flex;
  gap: 8px;
  color: #65a7ff;
  font-size: 11px;
  font-weight: 800;
  text-decoration: none;
}

.public-header__dropdown-links {
  display: grid;
  grid-template-columns: repeat(2, minmax(0,1fr));
  gap: 5px;
}

.public-header__dropdown-link {
  position: relative;
  min-height: 116px;
  padding: 17px 42px 17px 18px;
  border: 1px solid transparent;
  border-radius: 9px;
  text-decoration: none;
  transition:
    background .16s ease,
    border-color .16s ease;
}

.public-header__dropdown-link:hover {
  border-color: rgba(94,147,214,.22);
  background: rgba(20,54,91,.42);
}

.public-header__dropdown-eyebrow {
  display: block;
  margin-bottom: 7px;
  color: #708aaa;
  font-size: 8px;
  font-weight: 850;
  letter-spacing: .11em;
}

.public-header__dropdown-link strong {
  display: block;
  color: #f1f6fc;
  font-size: 13px;
}

.public-header__dropdown-link p {
  max-width: 330px;
  margin: 7px 0 0;
  color: #879db7;
  font-size: 10px;
  line-height: 1.55;
}

.public-header__dropdown-arrow {
  position: absolute;
  top: 50%;
  right: 18px;
  color: #4f83c2;
  transform: translateY(-50%);
}

.public-header__mobile-toggle,
.public-mobile-nav {
  display: none;
}


