:root {
  --public-bg: #06111f;
  --public-bg-soft: #0b1a2d;
  --public-surface: rgba(10, 27, 47, 0.72);
  --public-surface-strong: rgba(14, 38, 66, 0.92);
  --public-border: rgba(134, 176, 255, 0.16);
  --public-text: #f5f8ff;
  --public-text-muted: #a9b8cf;
  --public-blue: #2f7cff;
  --public-blue-bright: #5aa0ff;
  --public-gold: #d5aa55;
  --public-shadow: 0 24px 80px rgba(0, 0, 0, 0.32);
}

.public-site {
  min-height: 100vh;
  color: var(--public-text);
  background:
    radial-gradient(circle at 18% 12%, rgba(47, 124, 255, 0.16), transparent 34%),
    radial-gradient(circle at 82% 8%, rgba(213, 170, 85, 0.08), transparent 26%),
    linear-gradient(180deg, #071321 0%, #06111f 55%, #081522 100%);
}

.public-site__main {
  min-height: calc(100vh - 84px);
}

.public-header {
  position: sticky;
  top: 0;
  z-index: 50;
  border-bottom: 1px solid rgba(255, 255, 255, 0.07);
  background: rgba(6, 17, 31, 0.78);
  backdrop-filter: blur(18px);
  -webkit-backdrop-filter: blur(18px);
}

.public-header__inner {
  width: min(1440px, calc(100% - 48px));
  min-height: 84px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: auto 1fr auto;
  align-items: center;
  gap: 36px;
}

.public-header__brand {
  display: inline-flex;
  align-items: center;
  text-decoration: none;
}

.public-header__logo {
  display: block;
  width: 132px;
  height: auto;
}

.public-header__nav {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 26px;
}

.public-header__nav-link,
.public-header__signin {
  position: relative;
  color: var(--public-text-muted);
  font-size: 0.93rem;
  font-weight: 600;
  text-decoration: none;
  transition:
    color 180ms ease,
    transform 180ms ease;
}

.public-header__nav-link:hover,
.public-header__signin:hover {
  color: var(--public-text);
  transform: translateY(-1px);
}

.public-header__nav-link::after {
  content: "";
  position: absolute;
  left: 0;
  right: 0;
  bottom: -10px;
  height: 2px;
  transform: scaleX(0);
  transform-origin: center;
  background: linear-gradient(90deg, var(--public-blue), var(--public-gold));
  transition: transform 180ms ease;
}

.public-header__nav-link:hover::after {
  transform: scaleX(1);
}

.public-header__actions {
  display: flex;
  align-items: center;
  gap: 18px;
}

.public-header__partner {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  min-height: 44px;
  padding: 0 18px;
  border: 1px solid rgba(90, 160, 255, 0.34);
  border-radius: 999px;
  color: #ffffff;
  font-size: 0.92rem;
  font-weight: 700;
  text-decoration: none;
  background:
    linear-gradient(135deg, rgba(47, 124, 255, 0.96), rgba(28, 87, 186, 0.96));
  box-shadow:
    0 10px 30px rgba(47, 124, 255, 0.18),
    inset 0 1px 0 rgba(255, 255, 255, 0.14);
  transition:
    transform 180ms ease,
    box-shadow 180ms ease;
}

.public-header__partner:hover {
  transform: translateY(-2px);
  box-shadow:
    0 16px 40px rgba(47, 124, 255, 0.28),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

@media (max-width: 1120px) {
  .public-header__inner {
    grid-template-columns: auto 1fr;
  }

  .public-header__nav {
    display: none;
  }

  .public-header__actions {
    justify-self: end;
  }
}

@media (max-width: 680px) {
  .public-header__inner {
    width: min(100% - 28px, 1440px);
    min-height: 72px;
  }

  .public-header__logo {
    width: 112px;
  }

  .public-header__signin {
    display: none;
  }

  .public-header__partner {
    min-height: 40px;
    padding: 0 14px;
    font-size: 0.84rem;
  }
}

/* =========================================================
   AIGO PUBLIC HERO
   ========================================================= */

.public-hero {
  position: relative;
  overflow: hidden;
  min-height: calc(100vh - 84px);
  padding: 96px 0 34px;
  isolation: isolate;
}

.public-hero__atmosphere {
  position: absolute;
  inset: 0;
  z-index: -2;
  pointer-events: none;
  overflow: hidden;
}

.public-hero__atmosphere::before {
  content: "";
  position: absolute;
  inset: 0;
  background:
    linear-gradient(
      180deg,
      rgba(6, 17, 31, 0.08) 0%,
      rgba(6, 17, 31, 0.32) 60%,
      rgba(6, 17, 31, 0.88) 100%
    );
}

.public-hero__glow {
  position: absolute;
  border-radius: 50%;
  filter: blur(110px);
  opacity: 0.42;
  transform: translateZ(0);
}

.public-hero__glow--blue {
  width: 680px;
  height: 680px;
  top: -220px;
  right: 5%;
  background:
    radial-gradient(
      circle,
      rgba(42, 119, 255, 0.7) 0%,
      rgba(42, 119, 255, 0.2) 45%,
      transparent 72%
    );
  animation: aigoGlowBlue 10s ease-in-out infinite alternate;
}

.public-hero__glow--gold {
  width: 440px;
  height: 440px;
  left: 34%;
  bottom: -220px;
  background:
    radial-gradient(
      circle,
      rgba(213, 170, 85, 0.34) 0%,
      rgba(213, 170, 85, 0.08) 48%,
      transparent 74%
    );
  animation: aigoGlowGold 12s ease-in-out infinite alternate;
}

.public-hero__grid {
  position: absolute;
  inset: 0;
  opacity: 0.16;
  background-image:
    linear-gradient(rgba(111, 156, 223, 0.09) 1px, transparent 1px),
    linear-gradient(90deg, rgba(111, 156, 223, 0.09) 1px, transparent 1px);
  background-size: 72px 72px;
  mask-image:
    linear-gradient(
      to bottom,
      rgba(0, 0, 0, 0.72),
      rgba(0, 0, 0, 0.28) 65%,
      transparent
    );
}

.public-hero__inner {
  width: min(1440px, calc(100% - 72px));
  margin: 0 auto;
  display: grid;
  grid-template-columns: minmax(0, 0.95fr) minmax(540px, 1.05fr);
  align-items: center;
  gap: 70px;
}

.public-hero__content {
  position: relative;
  z-index: 5;
  max-width: 760px;
  padding: 40px 0;
}

.public-hero__eyebrow {
  width: fit-content;
  display: inline-flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 26px;
  padding: 9px 14px;
  border: 1px solid rgba(109, 165, 255, 0.2);
  border-radius: 999px;
  color: #b8c8de;
  background: rgba(15, 37, 65, 0.5);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.055),
    0 8px 30px rgba(0, 0, 0, 0.15);
  backdrop-filter: blur(12px);
  font-size: 0.76rem;
  font-weight: 800;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.public-hero__eyebrow-dot {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #d5aa55;
  box-shadow:
    0 0 0 5px rgba(213, 170, 85, 0.08),
    0 0 18px rgba(213, 170, 85, 0.45);
}

.public-hero__title {
  max-width: 780px;
  margin: 0;
  color: #f7f9ff;
  font-size: clamp(4rem, 6vw, 7.2rem);
  font-weight: 760;
  line-height: 0.96;
  letter-spacing: -0.055em;
  text-wrap: balance;
  text-shadow:
    0 2px 0 rgba(255, 255, 255, 0.03),
    0 18px 55px rgba(0, 0, 0, 0.34);
}

.public-hero__title-accent {
  display: inline;
  color: transparent;
  background:
    linear-gradient(
      100deg,
      #ffffff 0%,
      #b8d1ff 30%,
      #5b9cff 62%,
      #d5aa55 118%
    );
  -webkit-background-clip: text;
  background-clip: text;
}

.public-hero__description {
  max-width: 680px;
  margin: 32px 0 0;
  color: #aabbd2;
  font-size: clamp(1.08rem, 1.3vw, 1.3rem);
  line-height: 1.72;
  letter-spacing: -0.012em;
}

.public-hero__actions {
  display: flex;
  align-items: center;
  gap: 16px;
  margin-top: 38px;
}

.public-hero__primary,
.public-hero__secondary {
  min-height: 54px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 12px;
  border-radius: 999px;
  padding: 0 24px;
  font-size: 0.95rem;
  font-weight: 750;
  text-decoration: none;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease,
    box-shadow 180ms ease;
}

.public-hero__primary {
  color: #ffffff;
  border: 1px solid rgba(101, 166, 255, 0.4);
  background:
    linear-gradient(
      135deg,
      #347ff5 0%,
      #1d61cb 62%,
      #164c9f 100%
    );
  box-shadow:
    0 16px 38px rgba(34, 105, 224, 0.25),
    inset 0 1px 0 rgba(255, 255, 255, 0.18);
}

.public-hero__primary:hover {
  transform: translateY(-3px);
  box-shadow:
    0 22px 52px rgba(34, 105, 224, 0.34),
    inset 0 1px 0 rgba(255, 255, 255, 0.2);
}

.public-hero__primary span {
  font-size: 1.1rem;
  transition: transform 180ms ease;
}

.public-hero__primary:hover span {
  transform: translateX(3px);
}

.public-hero__secondary {
  color: #d6e0ef;
  border: 1px solid rgba(176, 198, 231, 0.16);
  background: rgba(16, 35, 59, 0.52);
  box-shadow:
    inset 0 1px 0 rgba(255, 255, 255, 0.045);
  backdrop-filter: blur(14px);
}

.public-hero__secondary:hover {
  transform: translateY(-3px);
  color: #ffffff;
  border-color: rgba(133, 177, 246, 0.34);
  background: rgba(22, 48, 80, 0.68);
}

.public-hero__principle {
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  gap: 0;
  margin-top: 38px;
  color: #758aa7;
  font-size: 0.79rem;
  font-weight: 700;
  letter-spacing: 0.04em;
}

.public-hero__principle span {
  display: inline-flex;
  align-items: center;
}

.public-hero__principle span:not(:last-child)::after {
  content: "";
  width: 3px;
  height: 3px;
  margin: 0 12px;
  border-radius: 50%;
  background: rgba(213, 170, 85, 0.68);
}

/* =========================================================
   GOVERNANCE VISUAL
   ========================================================= */

.public-hero__visual {
  position: relative;
  width: min(100%, 680px);
  aspect-ratio: 1;
  justify-self: end;
  filter: drop-shadow(0 35px 80px rgba(0, 0, 0, 0.26));
}

.public-hero__visual::before {
  content: "";
  position: absolute;
  inset: 14%;
  border-radius: 50%;
  background:
    radial-gradient(
      circle,
      rgba(60, 133, 255, 0.14),
      rgba(23, 68, 131, 0.045) 44%,
      transparent 70%
    );
  filter: blur(14px);
}

.public-hero__visual::after {
  content: "";
  position: absolute;
  inset: 2%;
  border-radius: 50%;
  background:
    conic-gradient(
      from 120deg,
      transparent 0deg,
      rgba(50, 128, 255, 0.1) 44deg,
      transparent 92deg,
      transparent 205deg,
      rgba(213, 170, 85, 0.08) 265deg,
      transparent 330deg
    );
  animation: aigoAmbientRotate 30s linear infinite;
}

.hero-orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  border-radius: 50%;
  transform: translate(-50%, -50%);
  pointer-events: none;
}

.hero-orbit--outer {
  width: 88%;
  height: 88%;
  border: 1px solid rgba(97, 151, 232, 0.12);
  box-shadow:
    inset 0 0 50px rgba(40, 105, 210, 0.035);
}

.hero-orbit--middle {
  width: 66%;
  height: 66%;
  border: 1px dashed rgba(110, 167, 255, 0.18);
  animation: aigoOrbitRotate 30s linear infinite;
}

.hero-orbit--inner {
  width: 43%;
  height: 43%;
  border: 1px solid rgba(213, 170, 85, 0.16);
  box-shadow:
    0 0 42px rgba(213, 170, 85, 0.035),
    inset 0 0 34px rgba(39, 114, 229, 0.05);
}

.hero-core {
  position: absolute;
  left: 50%;
  top: 50%;
  z-index: 6;
  width: 146px;
  height: 146px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 7px;
  border: 1px solid rgba(119, 172, 255, 0.28);
  border-radius: 34px;
  transform:
    translate(-50%, -50%)
    rotate(45deg);
  background:
    linear-gradient(
      145deg,
      rgba(20, 55, 99, 0.95),
      rgba(8, 26, 50, 0.94)
    );
  box-shadow:
    0 28px 70px rgba(0, 0, 0, 0.36),
    0 0 80px rgba(45, 120, 246, 0.14),
    inset 0 1px 0 rgba(255, 255, 255, 0.09);
  backdrop-filter: blur(18px);
}

.hero-core > * {
  transform: rotate(-45deg);
}

.hero-core__mark {
  position: relative;
  z-index: 3;
  color: #ffffff;
  font-size: 3rem;
  font-weight: 850;
  line-height: 1;
  text-shadow:
    0 0 28px rgba(88, 155, 255, 0.38);
}

.hero-core > span {
  position: relative;
  z-index: 3;
  color: #8ba9d0;
  font-size: 0.67rem;
  font-weight: 800;
  letter-spacing: 0.18em;
}

.hero-core__pulse {
  position: absolute;
  inset: 20px;
  border: 1px solid rgba(213, 170, 85, 0.16);
  border-radius: 24px;
  animation: aigoCorePulse 3.6s ease-in-out infinite;
}

.hero-node {
  position: absolute;
  z-index: 8;
  min-width: 104px;
  min-height: 42px;
  display: inline-flex;
  align-items: center;
  gap: 9px;
  padding: 0 13px;
  border: 1px solid rgba(107, 161, 243, 0.2);
  border-radius: 999px;
  color: #c0cde0;
  background:
    linear-gradient(
      145deg,
      rgba(18, 43, 74, 0.86),
      rgba(8, 25, 47, 0.82)
    );
  box-shadow:
    0 16px 40px rgba(0, 0, 0, 0.22),
    inset 0 1px 0 rgba(255, 255, 255, 0.05);
  backdrop-filter: blur(14px);
  font-size: 0.78rem;
  font-weight: 750;
  letter-spacing: 0.02em;
  animation: aigoNodeFloat 5s ease-in-out infinite;
}

.hero-node__signal {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #4e91ff;
  box-shadow:
    0 0 0 4px rgba(78, 145, 255, 0.08),
    0 0 14px rgba(78, 145, 255, 0.5);
}

.hero-node--discover {
  left: 4%;
  top: 25%;
  animation-delay: -0.5s;
}

.hero-node--identity {
  left: 3%;
  bottom: 24%;
  animation-delay: -2.3s;
}

.hero-node--authority {
  left: 50%;
  top: 4%;
  transform: translateX(-50%);
  animation-delay: -1.1s;
}

.hero-node--risk {
  right: 2%;
  top: 25%;
  animation-delay: -3.1s;
}

.hero-node--decide {
  right: 2%;
  bottom: 24%;
  animation-delay: -1.8s;
}

.hero-node--trace {
  left: 50%;
  bottom: 3%;
  transform: translateX(-50%);
  animation-delay: -3.8s;
}

.hero-node--authority .hero-node__signal,
.hero-node--trace .hero-node__signal {
  background: #d5aa55;
  box-shadow:
    0 0 0 4px rgba(213, 170, 85, 0.08),
    0 0 14px rgba(213, 170, 85, 0.42);
}

.hero-signal {
  position: absolute;
  z-index: 2;
  width: 8px;
  height: 8px;
  border-radius: 50%;
  background: #6ea6ff;
  box-shadow:
    0 0 8px rgba(110, 166, 255, 0.8),
    0 0 24px rgba(110, 166, 255, 0.52);
}

.hero-signal--one {
  left: 13%;
  top: 49%;
  animation: aigoSignalOne 6s ease-in-out infinite;
}

.hero-signal--two {
  right: 12%;
  top: 48%;
  background: #d5aa55;
  animation: aigoSignalTwo 7s ease-in-out infinite;
}

.hero-signal--three {
  left: 49%;
  bottom: 13%;
  animation: aigoSignalThree 6.5s ease-in-out infinite;
}

/* =========================================================
   CONTINUUM
   ========================================================= */

.public-hero__continuum {
  width: min(1180px, calc(100% - 72px));
  margin: 58px auto 0;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #667d9d;
  font-size: 0.73rem;
  font-weight: 800;
  letter-spacing: 0.16em;
  text-transform: uppercase;
}

.public-hero__continuum i {
  width: clamp(28px, 4vw, 74px);
  height: 1px;
  margin: 0 14px;
  background:
    linear-gradient(
      90deg,
      rgba(64, 127, 229, 0.12),
      rgba(70, 139, 249, 0.56),
      rgba(213, 170, 85, 0.38)
    );
}

/* =========================================================
   MOTION
   ========================================================= */

@keyframes aigoGlowBlue {
  0% {
    transform: translate3d(0, 0, 0) scale(1);
  }

  100% {
    transform: translate3d(-50px, 50px, 0) scale(1.12);
  }
}

@keyframes aigoGlowGold {
  0% {
    transform: translate3d(0, 0, 0);
  }

  100% {
    transform: translate3d(70px, -35px, 0);
  }
}

@keyframes aigoAmbientRotate {
  to {
    transform: rotate(360deg);
  }
}

@keyframes aigoOrbitRotate {
  from {
    transform: translate(-50%, -50%) rotate(0deg);
  }

  to {
    transform: translate(-50%, -50%) rotate(360deg);
  }
}

@keyframes aigoCorePulse {
  0%,
  100% {
    opacity: 0.4;
    transform: rotate(-45deg) scale(0.96);
  }

  50% {
    opacity: 1;
    transform: rotate(-45deg) scale(1.08);
  }
}

@keyframes aigoNodeFloat {
  0%,
  100% {
    margin-top: 0;
  }

  50% {
    margin-top: -8px;
  }
}

@keyframes aigoSignalOne {
  0% {
    transform: translate(0, 0);
    opacity: 0;
  }

  20% {
    opacity: 1;
  }

  80% {
    opacity: 1;
  }

  100% {
    transform: translate(210px, 8px);
    opacity: 0;
  }
}

@keyframes aigoSignalTwo {
  0% {
    transform: translate(0, 0);
    opacity: 0;
  }

  20% {
    opacity: 1;
  }

  80% {
    opacity: 1;
  }

  100% {
    transform: translate(-205px, -15px);
    opacity: 0;
  }
}

@keyframes aigoSignalThree {
  0% {
    transform: translate(0, 0);
    opacity: 0;
  }

  20% {
    opacity: 1;
  }

  80% {
    opacity: 1;
  }

  100% {
    transform: translate(4px, -185px);
    opacity: 0;
  }
}

/* =========================================================
   RESPONSIVE HERO
   ========================================================= */

@media (max-width: 1180px) {
  .public-hero {
    padding-top: 70px;
  }

  .public-hero__inner {
    width: min(100% - 48px, 1100px);
    grid-template-columns: 1fr;
    gap: 34px;
  }

  .public-hero__content {
    max-width: 880px;
    text-align: center;
    justify-self: center;
  }

  .public-hero__eyebrow {
    margin-left: auto;
    margin-right: auto;
  }

  .public-hero__description {
    margin-left: auto;
    margin-right: auto;
  }

  .public-hero__actions,
  .public-hero__principle {
    justify-content: center;
  }

  .public-hero__visual {
    width: min(640px, 90vw);
    justify-self: center;
  }
}

@media (max-width: 700px) {
  .public-hero {
    padding: 54px 0 26px;
  }

  .public-hero__inner {
    width: min(100% - 28px, 680px);
  }

  .public-hero__title {
    font-size: clamp(3.2rem, 15vw, 5rem);
  }

  .public-hero__description {
    font-size: 1rem;
    line-height: 1.65;
  }

  .public-hero__actions {
    flex-direction: column;
    align-items: stretch;
  }

  .public-hero__primary,
  .public-hero__secondary {
    width: 100%;
  }

  .public-hero__principle {
    gap: 8px 0;
    font-size: 0.68rem;
  }

  .public-hero__visual {
    width: min(530px, 110vw);
    margin-left: -5vw;
  }

  .hero-node {
    min-width: auto;
    min-height: 36px;
    padding: 0 10px;
    font-size: 0.68rem;
  }

  .hero-core {
    width: 112px;
    height: 112px;
    border-radius: 27px;
  }

  .hero-core__mark {
    font-size: 2.35rem;
  }

  .public-hero__continuum {
    width: calc(100% - 28px);
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 38px;
    line-height: 1.8;
  }

  .public-hero__continuum i {
    width: 18px;
    margin: 0 3px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .public-hero *,
  .public-header * {
    animation-duration: 0.001ms !important;
    animation-iteration-count: 1 !important;
    scroll-behavior: auto !important;
    transition-duration: 0.001ms !important;
  }
}

.hero-core__logo-wrap {
  position: relative;
  z-index: 3;
  width: 78px;
  height: 78px;
  display: grid;
  place-items: center;
  transform: rotate(-45deg);
}

.hero-core__logo {
  width: 72px;
  height: 72px;
  object-fit: contain;
  filter:
    drop-shadow(0 0 18px rgba(82, 145, 255, 0.22))
    drop-shadow(0 0 10px rgba(213, 170, 85, 0.12));
}

.hero-core > span {
  position: relative;
  z-index: 3;
