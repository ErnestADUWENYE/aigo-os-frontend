  border-radius: 6px;
  background: #0a1d33;
  color: #a9bad0;
  font-size: 10px;
}

.trust-architecture__rail {
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

.trust-architecture__rail::before {
  content: "";
  width: 100%;
  height: 1px;
  background: #285381;
}

.trust-architecture__rail i {
  position: absolute;
  width: 5px;
  height: 5px;
  border-radius: 50%;
  background: #4c98f2;
}

.trust-architecture__rail i:nth-child(1) {
  left: 18%;
}

.trust-architecture__rail i:nth-child(2) {
  left: 48%;
}

.trust-architecture__rail i:nth-child(3) {
  left: 78%;
}

.trust-architecture__rail span {
  position: absolute;
  top: calc(50% + 15px);
  color: #5f7e9e;
  font-size: 7px;
  text-transform: uppercase;
  letter-spacing: .08em;
}

.trust-architecture__core {
  border-color: #28588c;
