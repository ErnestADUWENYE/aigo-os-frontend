}

.aigo-live-demo::before {
  content: "";
  position: absolute;
  inset: 0;
  pointer-events: none;
  opacity: .09;
  background-image:
    linear-gradient(rgba(82, 153, 225, .2) 1px, transparent 1px),
    linear-gradient(90deg, rgba(82, 153, 225, .2) 1px, transparent 1px);
