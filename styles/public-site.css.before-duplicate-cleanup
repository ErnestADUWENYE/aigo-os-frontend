/* =========================================================
   HEADER COMMERCIAL ENTRY
   ========================================================= */

.aigo-nav__desktop-action {
  display: flex;
  align-items: center;
  gap: 10px;
}

.aigo-nav__get-started {
  min-height: 42px;
  padding: 0 17px;
  border-radius: 8px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  color: #ffffff !important;
  background: #1676df;
  font-weight: 800;
  text-decoration: none;
  transition:
    background 160ms ease,
    transform 160ms ease;
}

.aigo-nav__get-started:hover {
  background: #2585ed;
  transform: translateY(-1px);
}

.aigo-mobile-nav__actions {
  width: 100%;
  display: grid;
  grid-template-columns: 1fr;
  gap: 10px;
  margin-top: 18px;
}

.aigo-mobile-nav__signin,
.aigo-mobile-nav__get-started {
  width: 100%;
  min-height: 50px;
  box-sizing: border-box;
  display: flex;
  align-items: center;
  justify-content: center;
  border-radius: 8px;
  text-decoration: none;
  font-weight: 800;
}

.aigo-mobile-nav__signin {
  border: 1px solid rgba(255,255,255,.18);
  color: #ffffff;
  background: rgba(255,255,255,.05);
}

.aigo-mobile-nav__get-started {
  color: #ffffff;
  background: #1676df;
}

@media (max-width: 900px) {
  .aigo-nav__get-started {
    display: none;
  }
}
