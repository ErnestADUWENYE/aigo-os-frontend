    min-height: 60px;
  }

  .aigo-mobile-nav__children {
    width: 100%;
  }

  .aigo-mobile-nav__children a {
    width: 100%;
    box-sizing: border-box;
  }

  /* ---------- HOMEPAGE HERO ---------- */

  .public-hero,
  .aigo-home-hero {
    width: 100% !important;
    min-height: auto !important;
    overflow: hidden !important;

    padding-top: 42px !important;
    padding-bottom: 56px !important;
  }

  .public-hero__inner,
  .public-hero__layout,
  .public-hero__content,
  .aigo-home-hero__inner {
    width: calc(100% - 32px) !important;
    max-width: none !important;
    margin-left: auto !important;
    margin-right: auto !important;

    grid-template-columns: 1fr !important;

    gap: 34px !important;
  }

  /* Prevent desktop visual from occupying same space as copy */

  .public-hero__copy,
  .aigo-home-hero__copy {
    width: 100% !important;
    max-width: 100% !important;

    position: relative !important;
    left: auto !important;
    right: auto !important;

    transform: none !important;
  }

  .public-hero h1,
  .public-hero__copy h1,
  .aigo-home-hero h1,
  .aigo-home-hero__copy h1 {
    width: 100% !important;
    max-width: 100% !important;

    margin-left: 0 !important;
    margin-right: 0 !important;

    font-size: clamp(42px, 13vw, 62px) !important;
    line-height: 0.98 !important;
    letter-spacing: -0.045em !important;

    overflow-wrap: normal;
    word-break: normal;
  }

  .public-hero__lead,
  .public-hero__copy p,
  .aigo-home-hero__lead,
  .aigo-home-hero__copy p {
    width: 100% !important;
    max-width: 100% !important;

    font-size: 16px !important;
    line-height: 1.65 !important;
  }

  .public-hero__actions,
  .aigo-home-actions,
  .aigo-home-hero__actions {
    width: 100% !important;

    display: grid !important;
    grid-template-columns: 1fr !important;

    gap: 10px !important;
  }

  .public-hero__actions a,
  .aigo-home-actions a,
  .aigo-home-hero__actions a {
    width: 100% !important;
    max-width: 100% !important;

    box-sizing: border-box;

    justify-content: center;
  }

  /* ---------- GOVERNANCE ENGINE ---------- */

  .governance-engine {
    width: 100% !important;
    max-width: 100% !important;
    min-width: 0 !important;

    margin: 20px auto 0 !important;

    position: relative !important;
    left: auto !important;
    right: auto !important;
    top: auto !important;

    transform: none !important;

    box-sizing: border-box;
  }

  .governance-engine__flow {
    width: 100% !important;

    display: grid !important;
    grid-template-columns: 1fr !important;

    gap: 14px !important;
  }

  .governance-engine__inputs,
  .governance-engine__core,
  .governance-engine__outcomes {
    width: 100% !important;
    max-width: 100% !important;

    box-sizing: border-box;
  }

  .governance-engine__connector {
    display: none !important;
  }

  .governance-engine__stages {
    width: 100%;
  }

  .governance-stage {
    width: 100%;
    box-sizing: border-box;
  }

  .governance-engine__footer {
    grid-template-columns: repeat(2, minmax(0, 1fr)) !important;
  }

  /* ---------- OTHER ADVANCED VISUALS ---------- */

  .aigo-live-demo__workspace,
  .aigo-cap-demo__scene,
  .aigo-integration-story__system {
    width: 100% !important;

    grid-template-columns: 1fr !important;

    transform: none !important;
  }

  .aigo-live-demo__request,
  .aigo-live-demo__engine,
  .aigo-live-demo__result,
  .aigo-cap-demo__primary,
  .aigo-cap-demo__flow,
  .aigo-cap-demo__outcome {
    width: 100% !important;
    max-width: 100% !important;

    transform: none !important;

    box-sizing: border-box;
  }

  /* ---------- GENERIC PUBLIC SECTIONS ---------- */

  .public-section-shell,
  .aigo-home-shell {
    width: calc(100% - 32px) !important;
    max-width: none !important;

    margin-left: auto !important;
    margin-right: auto !important;
  }

  .public-site__main,
  .public-site {
    width: 100%;
    max-width: 100%;
    overflow-x: hidden !important;
  }
}

@media (max-width: 480px) {

  .public-hero h1,
  .public-hero__copy h1,
  .aigo-home-hero h1,
  .aigo-home-hero__copy h1 {
    font-size: 43px !important;
  }

  .governance-engine {
    font-size: 90%;
  }

  .governance-engine__footer {
    grid-template-columns: 1fr 1fr !important;
  }

  .aigo-nav__bar {
    width: calc(100% - 24px) !important;
  }

  .public-section-shell,
  .aigo-home-shell,
  .public-hero__inner,
  .public-hero__layout,
  .aigo-home-hero__inner {
    width: calc(100% - 28px) !important;
  }
}


/* ========================================================================
   AIGO-OS PUBLIC WEBSITE
   Isolated commercial + motion design system
   ======================================================================== */

:root {
  --aigo-public-dark: #051524;
  --aigo-public-dark-2: #081e33;
  --aigo-public-dark-3: #0b2945;
  --aigo-public-blue: #2796f2;
  --aigo-public-blue-soft: #6bc3ff;
  --aigo-public-gold: #d8ab4c;
  --aigo-public-text: #eff7ff;
  --aigo-public-muted: #91a9c0;
  --aigo-public-border: rgba(111, 174, 228, 0.18);
}

.aigo-public-shell {
  width: min(1400px, calc(100% - 80px));
  margin: 0 auto;
}

.aigo-public-kicker {
  color: var(--aigo-public-gold);
  font-size: 11px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.aigo-public-button {
  min-height: 52px;
  padding: 0 22px;
  border-radius: 9px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  font-size: 14px;
  font-weight: 850;
  text-decoration: none;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.aigo-public-button:hover {
  transform: translateY(-2px);
}

.aigo-public-button--primary {
  color: #fff;
  background: #1478db;
  border: 1px solid #278eea;
}

.aigo-public-button--secondary {
  color: #e8f3ff;
  background: rgba(255,255,255,.025);
  border: 1px solid rgba(135,182,226,.22);
}

.aigo-public-actions {
  margin-top: 34px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

/* HERO */

.aigo-public-hero {
  min-height: calc(100svh - 76px);
  padding: 72px 0;
  display: flex;
  align-items: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 75% 28%, rgba(30,132,220,.15), transparent 31%),
    radial-gradient(circle at 8% 90%, rgba(20,105,195,.10), transparent 28%),
    #051524;
}

.aigo-public-hero__grid {
  display: grid;
  grid-template-columns: minmax(0, .92fr) minmax(520px, 1.08fr);
  gap: clamp(48px, 6vw, 100px);
  align-items: center;
}

.aigo-public-hero__copy h1 {
  max-width: 770px;
  margin: 25px 0 0;
  color: #fff;
  font-size: clamp(56px, 6vw, 88px);
  line-height: .94;
  letter-spacing: -.06em;
}

.aigo-public-hero__copy h1 span {
  display: block;
  color: #49aaf5;
}

.aigo-public-hero__lead {
  max-width: 720px;
  margin: 27px 0 0;
  color: #a2b6ca;
  font-size: 17px;
  line-height: 1.72;
}

.aigo-public-hero__principles {
  margin-top: 34px;
  display: flex;
  flex-wrap: wrap;
  gap: 21px;
  color: #7894ae;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.aigo-public-engine {
  position: relative;
  border: 1px solid rgba(104,176,232,.22);
  border-radius: 24px;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(11,39,66,.96), rgba(4,21,37,.98));
  box-shadow: 0 50px 100px rgba(0,0,0,.24);
}

.aigo-public-engine__top,
.aigo-public-engine__bottom {
  min-height: 70px;
  padding: 0 25px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(103,166,218,.14);
}

.aigo-public-engine__top div:first-child {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.aigo-public-engine__top span {
  color: #50b2ff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-engine__top strong {
  color: #dbeafe;
  font-size: 13px;
}

.aigo-public-live {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #86a9c9;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .1em;
}

.aigo-public-live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #41adff;
  box-shadow: 0 0 14px #41adff;
  animation: aigo-public-pulse 1.8s infinite;
}

.aigo-public-engine__stage {
  position: relative;
  min-height: 520px;
  padding: 42px;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.aigo-public-engine__stage::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .08;
  background-image:
    linear-gradient(rgba(85,164,225,.6) 1px, transparent 1px),
    linear-gradient(90deg, rgba(85,164,225,.6) 1px, transparent 1px);
  background-size: 38px 38px;
}

.aigo-public-engine__orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 1px solid rgba(70,160,230,.18);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.aigo-public-engine__orbit--one {
  width: 430px;
  height: 430px;
  animation: aigo-public-spin 32s linear infinite;
}

.aigo-public-engine__orbit--two {
  width: 330px;
  height: 330px;
  border-style: dashed;
  animation: aigo-public-spin-reverse 24s linear infinite;
}

.aigo-public-engine__core {
  position: relative;
  z-index: 3;
  width: min(310px, 70%);
  min-height: 210px;
  padding: 29px;
  border: 1px solid rgba(80,180,246,.3);
  border-radius: 22px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 0%, rgba(48,164,242,.18), transparent 48%),
    #071d31;
  box-shadow:
    0 0 70px rgba(35,145,224,.13),
    inset 0 0 40px rgba(43,157,234,.05);
}

.aigo-public-engine__core > span {
  color: #4eb4ff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .13em;
}

.aigo-public-engine__core strong {
  margin-top: 13px;
  color: #fff;
  font-size: 25px;
  line-height: 1.1;
}

.aigo-public-engine__core p {
  margin: 13px 0 0;
  color: #8ea9c4;
  font-size: 12px;
  line-height: 1.55;
}

.aigo-public-engine__nodes {
  position: absolute;
  z-index: 5;
  inset: 25px;
  pointer-events: none;
}

.aigo-public-engine__node {
  position: absolute;
  width: 126px;
  min-height: 46px;
  padding: 9px 12px;
  border: 1px solid rgba(107,161,208,.15);
  border-radius: 9px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #819cb6;
  background: #071a2c;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .04em;
  pointer-events: auto;
  cursor: pointer;
  transition: 220ms ease;
}

.aigo-public-engine__node span {
  color: #4b7195;
  font-size: 8px;
}

.aigo-public-engine__node--active {
  border-color: rgba(63,174,247,.6);
  color: #fff;
  background: #0a2946;
  box-shadow: 0 0 22px rgba(43,160,237,.15);
}

.aigo-public-engine__node:nth-child(1) {
  top: 4%;
  left: 50%;
  transform: translateX(-50%);
}

.aigo-public-engine__node:nth-child(2) {
  top: 25%;
  right: 0;
}

.aigo-public-engine__node:nth-child(3) {
  bottom: 25%;
  right: 0;
}

.aigo-public-engine__node:nth-child(4) {
  bottom: 4%;
  left: 50%;
  transform: translateX(-50%);
}

.aigo-public-engine__node:nth-child(5) {
  bottom: 25%;
  left: 0;
}

.aigo-public-engine__node:nth-child(6) {
  top: 25%;
  left: 0;
}

.aigo-public-engine__bottom {
  min-height: 62px;
  justify-content: flex-start;
  gap: 9px;
  border-top: 1px solid rgba(103,166,218,.14);
  border-bottom: 0;
  overflow-x: auto;
}

.aigo-public-engine__bottom span {
  padding: 7px 9px;
  border: 1px solid rgba(105,165,218,.12);
  border-radius: 6px;
  color: #7594b1;
  font-size: 8px;
  font-weight: 800;
  white-space: nowrap;
}

/* SHARED SECTIONS */

.aigo-public-why,
.aigo-public-difference,
.aigo-public-usecases {
  padding: 110px 0;
}

.aigo-public-section-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(300px, .55fr);
  gap: 80px;
  align-items: end;
}

.aigo-public-section-heading h2,
.aigo-public-significance h2 {
  max-width: 800px;
  margin: 18px 0 0;
  font-size: clamp(42px, 5vw, 66px);
  line-height: 1;
  letter-spacing: -.045em;
}

.aigo-public-section-heading h2 span,
.aigo-public-significance h2 span {
  display: block;
}

.aigo-public-section-heading > p {
  margin: 0;
  font-size: 16px;
  line-height: 1.75;
}

/* WHY */

.aigo-public-why {
  color: #10263c;
  background: #f6f9fc;
}

.aigo-public-why .aigo-public-section-heading p {
  color: #647b91;
}

.aigo-public-agency {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1px solid #dce6ef;
  border-radius: 18px;
  overflow: hidden;
  background: #fff;
}

.aigo-public-agency__item {
  position: relative;
  min-height: 235px;
  padding: 29px;
  border-right: 1px solid #e1e9f0;
}

.aigo-public-agency__item:last-child {
  border-right: 0;
}

.aigo-public-agency__item > span {
  color: #1678d7;
  font-size: 10px;
  font-weight: 900;
}

.aigo-public-agency__item strong {
  display: block;
  margin-top: 45px;
  color: #102b45;
  font-size: 25px;
}

.aigo-public-agency__item p {
  color: #6d8195;
  font-size: 13px;
  line-height: 1.6;
}

.aigo-public-agency__item i {
  position: absolute;
  top: 50%;
  right: -15px;
  z-index: 2;
  width: 30px;
  height: 30px;
  border: 1px solid #d8e2ea;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #fff;
  color: #1780df;
  font-style: normal;
}

.aigo-public-thesis {
  margin-top: 35px;
  padding: 33px;
  border-radius: 16px;
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  align-items: center;
  gap: 30px;
  background: #071c30;
}

.aigo-public-thesis span {
  color: #d5a94e;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-thesis strong {
  color: #fff;
  font-size: clamp(21px, 2.5vw, 33px);
  font-weight: 700;
}

.aigo-public-thesis em {
  display: block;
  margin-top: 7px;
  color: #54b2fa;
  font-style: normal;
}

/* SIGNIFICANCE */

.aigo-public-significance {
  padding: 120px 0;
  color: #fff;
  background:
    radial-gradient(circle at 75% 40%, rgba(32,126,210,.12), transparent 32%),
    #061526;
}

.aigo-public-significance__grid {
  display: grid;
  grid-template-columns: .78fr 1.22fr;
  gap: 90px;
  align-items: center;
}

.aigo-public-significance h2 span {
  color: #4eacf3;
}

.aigo-public-significance__grid > div:first-child > p {
  margin-top: 27px;
  color: #91a9c1;
  font-size: 15px;
  line-height: 1.75;
}

.aigo-public-significance__visual {
  padding: 28px;
  border: 1px solid rgba(95,165,220,.2);
  border-radius: 20px;
  background: rgba(5,25,43,.85);
}

.aigo-public-signal,
.aigo-public-significance__result {
  padding: 22px;
  border: 1px solid rgba(96,155,207,.16);
  border-radius: 12px;
  background: #082039;
}

.aigo-public-signal > span,
.aigo-public-significance__result > span {
  color: #4eaef4;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-signal > strong {
  display: block;
  margin-top: 9px;
  color: #fff;
  font-size: 18px;
}

.aigo-public-signal > div {
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.aigo-public-signal i {
  padding: 7px 10px;
  border-radius: 6px;
  color: #8fa9c3;
  background: #06192c;
  font-size: 10px;
  font-style: normal;
}

.aigo-public-significance__bridge {
  height: 65px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #547b9f;
}

.aigo-public-significance__bridge span {
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-significance__bridge b {
  color: #3ba4f2;
}

.aigo-public-significance__result > div {
  margin-top: 17px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.aigo-public-significance__result strong {
  min-height: 55px;
  padding: 10px;
  border: 1px solid rgba(104,166,219,.12);
  border-radius: 7px;
  display: flex;
  align-items: center;
  color: #d9e9f7;
  background: #061a2d;
  font-size: 10px;
}

.aigo-public-significance__decision {
  padding: 21px;
  border: 1px solid rgba(213,169,78,.25);
  border-radius: 10px;
  color: #f1d18a;
  background: rgba(213,169,78,.055);
  text-align: center;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .1em;
}

/* MODEL */

.aigo-public-model {
  padding: 120px 0;
  color: #122b44;
  background: #fff;
}

.aigo-public-model > .aigo-public-shell > h2 {
  margin: 18px 0 50px;
  font-size: clamp(56px, 7vw, 92px);
  line-height: .9;
  letter-spacing: -.055em;
}

.aigo-public-model > .aigo-public-shell > h2 span {
  color: #1a7bd7;
}

.aigo-public-model__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid #dde6ee;
  border-radius: 18px;
  overflow: hidden;
}

.aigo-public-model article {
  min-height: 470px;
  padding: 30px;
  border-right: 1px solid #e0e8ef;
}

.aigo-public-model article:last-child {
  border-right: 0;
}

.aigo-public-model__number {
  color: #9eb1c1;
  font-size: 10px;
}

.aigo-public-model article > span {
  display: block;
  margin-top: 42px;
  color: #197adc;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-model h3 {
  max-width: 330px;
  margin: 15px 0 35px;
  color: #142d46;
  font-size: 27px;
  line-height: 1.15;
}

.aigo-public-model article > div:last-child {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.aigo-public-model small {
  padding: 8px 10px;
  border-radius: 6px;
  color: #647d93;
  background: #f4f7fa;
}

/* USE CASE */

.aigo-public-usecases {
  color: #fff;
  background: #061526;
}

.aigo-public-usecases .aigo-public-section-heading p {
  color: #8ea7bf;
}

.aigo-public-usecases h2 span {
  color: #4cabf3;
}

.aigo-public-pill {
  width: fit-content;
  margin-top: 19px;
  padding: 7px 13px;
  border-radius: 999px;
  color: #b6c9da;
  background: rgba(255,255,255,.06);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .08em;
}

.aigo-public-usecases__grid {
  margin-top: 55px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.aigo-public-usecases__grid a {
  min-height: 290px;
  padding: 29px;
  border: 1px solid rgba(110,166,213,.17);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  color: inherit;
  background: #082039;
  text-decoration: none;
  transition: 200ms ease;
}

.aigo-public-usecases__grid a:hover {
  transform: translateY(-4px);
  border-color: rgba(64,164,236,.45);
  background: #0a2845;
}

.aigo-public-usecases__grid a > span {
  color: #4eacf3;
  font-size: 10px;
  font-weight: 900;
}

.aigo-public-usecases__grid h3 {
  margin: 36px 0 0;
  font-size: clamp(24px, 2.7vw, 34px);
}

.aigo-public-usecases__grid p {
  max-width: 580px;
  color: #8ea8c1;
  line-height: 1.65;
}

.aigo-public-usecases__grid a > strong {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  color: #dcecff;
  font-size: 12px;
}

.aigo-public-usecases__grid i {
  color: #52aff5;
  font-style: normal;
}

/* DIFFERENTIATION */

.aigo-public-difference {
  color: #122b44;
  background: #f5f8fb;
}

.aigo-public-difference .aigo-public-section-heading p {
  color: #687f94;
}

.aigo-public-difference h2 span {
  color: #197bdd;
}

.aigo-public-difference__grid {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.aigo-public-difference article {
  padding: 30px;
  border: 1px solid #dce5ed;
  border-radius: 14px;
  background: #fff;
}

.aigo-public-difference article > span {
  color: #8b9eae;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-difference h3 {
  margin: 18px 0 0;
  color: #112b45;
  font-size: 26px;
}

.aigo-public-difference article > p {
  color: #6e8396;
  line-height: 1.65;
}

.aigo-public-difference article > div {
  margin-top: 25px;
  padding: 20px;
  border-radius: 10px;
  background: #071c31;
}

.aigo-public-difference small {
  display: block;
  color: #4eabf1;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .11em;
}

.aigo-public-difference article > div strong {
  display: block;
  margin-top: 9px;
  color: #dceafa;
  font-size: 13px;
  line-height: 1.55;
}

/* FINAL */

.aigo-public-final {
  padding: 120px 0;
  color: #fff;
  background:
    radial-gradient(circle at 15% 0%, rgba(37,131,215,.17), transparent 28%),
    #041321;
}

.aigo-public-final__inner {
  display: grid;
  grid-template-columns: 1.1fr .6fr;
  gap: 80px;
  align-items: end;
}

.aigo-public-final h2 {
  max-width: 850px;
  margin: 20px 0 0;
  font-size: clamp(45px, 5vw, 68px);
  line-height: 1;
  letter-spacing: -.045em;
}

.aigo-public-final h2 span {
  color: #4aacf3;
}

.aigo-public-final__inner > div:last-child p {
  color: #8ea6bd;
  line-height: 1.7;
}

/* MOTION */

@keyframes aigo-public-pulse {
  0%, 100% { opacity: .45; transform: scale(.8); }
  50% { opacity: 1; transform: scale(1.25); }
}

@keyframes aigo-public-spin {
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes aigo-public-spin-reverse {
  to { transform: translate(-50%, -50%) rotate(-360deg); }
}

/* TABLET */

@media (max-width: 1050px) {
  .aigo-public-shell {
    width: calc(100% - 48px);
  }

  .aigo-public-hero__grid,
  .aigo-public-significance__grid {
    grid-template-columns: 1fr;
  }

  .aigo-public-engine {
    max-width: 760px;
  }

  .aigo-public-section-heading {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .aigo-public-agency {
    grid-template-columns: 1fr 1fr;
  }

  .aigo-public-agency__item:nth-child(2) {
    border-right: 0;
  }

  .aigo-public-model__grid {
    grid-template-columns: 1fr;
  }

  .aigo-public-model article {
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid #e0e8ef;
  }

  .aigo-public-model article:last-child {
    border-bottom: 0;
  }
}

/* MOBILE */

@media (max-width: 700px) {
  .aigo-public-shell {
    width: calc(100% - 30px);
  }

  .aigo-public-hero {
    min-height: auto;
    padding: 54px 0 65px;
  }

  .aigo-public-hero__grid {
    gap: 45px;
  }

  .aigo-public-hero__copy h1 {
    font-size: clamp(44px, 13.5vw, 61px);
  }

  .aigo-public-hero__lead {
    font-size: 15px;
  }

  .aigo-public-actions {
    display: grid;
  }

  .aigo-public-button {
    width: 100%;
    box-sizing: border-box;
  }

  .aigo-public-engine__stage {
    min-height: 520px;
    padding: 20px;
  }

  .aigo-public-engine__orbit--one {
    width: 300px;
    height: 300px;
  }

  .aigo-public-engine__orbit--two {
    width: 230px;
    height: 230px;
  }

  .aigo-public-engine__core {
    width: 63%;
    padding: 20px;
  }

  .aigo-public-engine__core strong {
    font-size: 19px;
  }

  .aigo-public-engine__nodes {
    inset: 13px;
  }

  .aigo-public-engine__node {
    width: 96px;
    padding: 7px;
    font-size: 7px;
  }

  .aigo-public-engine__bottom {
    padding: 0 14px;
  }

  .aigo-public-why,
  .aigo-public-significance,
  .aigo-public-model,
  .aigo-public-usecases,
  .aigo-public-difference,
  .aigo-public-final {
    padding: 75px 0;
  }

  .aigo-public-section-heading h2,
  .aigo-public-significance h2 {
    font-size: 41px;
  }

  .aigo-public-agency,
  .aigo-public-usecases__grid,
  .aigo-public-difference__grid {
    grid-template-columns: 1fr;
  }

  .aigo-public-agency__item {
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid #e1e9f0;
  }

  .aigo-public-agency__item:last-child {
    border-bottom: 0;
  }

  .aigo-public-agency__item i {
    display: none;
  }

  .aigo-public-thesis {
    grid-template-columns: 1fr;
  }

  .aigo-public-significance__result > div {
    grid-template-columns: 1fr 1fr;
  }

  .aigo-public-model > .aigo-public-shell > h2 {
    font-size: 58px;
  }

  .aigo-public-final__inner {
    grid-template-columns: 1fr;
    gap: 35px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .aigo-public-engine__orbit,
  .aigo-public-live i {
    animation: none !important;
  }

  .aigo-public-button,
  .aigo-public-usecases__grid a {
    transition: none !important;
  }
}


/* =========================================================
   AIGO-OS STANDARD UI ICONS
   No decorative Unicode characters
   ========================================================= */

.aigo-nav__chevron {
  width: 7px;
  height: 7px;
  flex: 0 0 auto;
  border-right: 1.5px solid currentColor;
  border-bottom: 1.5px solid currentColor;
  transform: rotate(45deg) translateY(-2px);
  transform-origin: center;
  transition: transform 160ms ease;
}

.aigo-nav__chevron--open {
  transform: rotate(225deg) translate(-1px, -1px);
}

.aigo-ui-arrow {
  position: relative;
  width: 17px;
  height: 12px;
  display: inline-block;
  flex: 0 0 auto;
}

.aigo-ui-arrow::before {
  content: "";
  position: absolute;
  top: 50%;
  left: 0;
  width: 14px;
  height: 1.5px;
  background: currentColor;
  transform: translateY(-50%);
}

.aigo-ui-arrow::after {
  content: "";
  position: absolute;
  top: 50%;
  right: 0;
  width: 7px;
  height: 7px;
  border-top: 1.5px solid currentColor;
  border-right: 1.5px solid currentColor;
  transform: translateY(-50%) rotate(45deg);
}


/* ========================================================================
   AIGO-OS PUBLIC WEBSITE
   Isolated commercial + motion design system
   ======================================================================== */

:root {
  --aigo-public-dark: #051524;
  --aigo-public-dark-2: #081e33;
  --aigo-public-dark-3: #0b2945;
  --aigo-public-blue: #2796f2;
  --aigo-public-blue-soft: #6bc3ff;
  --aigo-public-gold: #d8ab4c;
  --aigo-public-text: #eff7ff;
  --aigo-public-muted: #91a9c0;
  --aigo-public-border: rgba(111, 174, 228, 0.18);
}

.aigo-public-shell {
  width: min(1400px, calc(100% - 80px));
  margin: 0 auto;
}

.aigo-public-kicker {
  color: var(--aigo-public-gold);
  font-size: 11px;
  line-height: 1;
  font-weight: 900;
  letter-spacing: 0.15em;
  text-transform: uppercase;
}

.aigo-public-button {
  min-height: 52px;
  padding: 0 22px;
  border-radius: 9px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  gap: 18px;
  font-size: 14px;
  font-weight: 850;
  text-decoration: none;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.aigo-public-button:hover {
  transform: translateY(-2px);
}

.aigo-public-button--primary {
  color: #fff;
  background: #1478db;
  border: 1px solid #278eea;
}

.aigo-public-button--secondary {
  color: #e8f3ff;
  background: rgba(255,255,255,.025);
  border: 1px solid rgba(135,182,226,.22);
}

.aigo-public-actions {
  margin-top: 34px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

/* HERO */

.aigo-public-hero {
  min-height: calc(100svh - 76px);
  padding: 72px 0;
  display: flex;
  align-items: center;
  overflow: hidden;
  background:
    radial-gradient(circle at 75% 28%, rgba(30,132,220,.15), transparent 31%),
    radial-gradient(circle at 8% 90%, rgba(20,105,195,.10), transparent 28%),
    #051524;
}

.aigo-public-hero__grid {
  display: grid;
  grid-template-columns: minmax(0, .92fr) minmax(520px, 1.08fr);
  gap: clamp(48px, 6vw, 100px);
  align-items: center;
}

.aigo-public-hero__copy h1 {
  max-width: 770px;
  margin: 25px 0 0;
  color: #fff;
  font-size: clamp(56px, 6vw, 88px);
  line-height: .94;
  letter-spacing: -.06em;
}

.aigo-public-hero__copy h1 span {
  display: block;
  color: #49aaf5;
}

.aigo-public-hero__lead {
  max-width: 720px;
  margin: 27px 0 0;
  color: #a2b6ca;
  font-size: 17px;
  line-height: 1.72;
}

.aigo-public-hero__principles {
  margin-top: 34px;
  display: flex;
  flex-wrap: wrap;
  gap: 21px;
  color: #7894ae;
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .1em;
  text-transform: uppercase;
}

.aigo-public-engine {
  position: relative;
  border: 1px solid rgba(104,176,232,.22);
  border-radius: 24px;
  overflow: hidden;
  background:
    linear-gradient(145deg, rgba(11,39,66,.96), rgba(4,21,37,.98));
  box-shadow: 0 50px 100px rgba(0,0,0,.24);
}

.aigo-public-engine__top,
.aigo-public-engine__bottom {
  min-height: 70px;
  padding: 0 25px;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1px solid rgba(103,166,218,.14);
}

.aigo-public-engine__top div:first-child {
  display: flex;
  flex-direction: column;
  gap: 3px;
}

.aigo-public-engine__top span {
  color: #50b2ff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-engine__top strong {
  color: #dbeafe;
  font-size: 13px;
}

.aigo-public-live {
  display: flex;
  align-items: center;
  gap: 8px;
  color: #86a9c9;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .1em;
}

.aigo-public-live i {
  width: 7px;
  height: 7px;
  border-radius: 50%;
  background: #41adff;
  box-shadow: 0 0 14px #41adff;
  animation: aigo-public-pulse 1.8s infinite;
}

.aigo-public-engine__stage {
  position: relative;
  min-height: 520px;
  padding: 42px;
  display: grid;
  place-items: center;
  overflow: hidden;
}

.aigo-public-engine__stage::before {
  content: "";
  position: absolute;
  inset: 0;
  opacity: .08;
  background-image:
    linear-gradient(rgba(85,164,225,.6) 1px, transparent 1px),
    linear-gradient(90deg, rgba(85,164,225,.6) 1px, transparent 1px);
  background-size: 38px 38px;
}

.aigo-public-engine__orbit {
  position: absolute;
  left: 50%;
  top: 50%;
  border: 1px solid rgba(70,160,230,.18);
  border-radius: 50%;
  transform: translate(-50%, -50%);
}

.aigo-public-engine__orbit--one {
  width: 430px;
  height: 430px;
  animation: aigo-public-spin 32s linear infinite;
}

.aigo-public-engine__orbit--two {
  width: 330px;
  height: 330px;
  border-style: dashed;
  animation: aigo-public-spin-reverse 24s linear infinite;
}

.aigo-public-engine__core {
  position: relative;
  z-index: 3;
  width: min(310px, 70%);
  min-height: 210px;
  padding: 29px;
  border: 1px solid rgba(80,180,246,.3);
  border-radius: 22px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  background:
    radial-gradient(circle at 50% 0%, rgba(48,164,242,.18), transparent 48%),
    #071d31;
  box-shadow:
    0 0 70px rgba(35,145,224,.13),
    inset 0 0 40px rgba(43,157,234,.05);
}

.aigo-public-engine__core > span {
  color: #4eb4ff;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .13em;
}

.aigo-public-engine__core strong {
  margin-top: 13px;
  color: #fff;
  font-size: 25px;
  line-height: 1.1;
}

.aigo-public-engine__core p {
  margin: 13px 0 0;
  color: #8ea9c4;
  font-size: 12px;
  line-height: 1.55;
}

.aigo-public-engine__nodes {
  position: absolute;
  z-index: 5;
  inset: 25px;
  pointer-events: none;
}

.aigo-public-engine__node {
  position: absolute;
  width: 126px;
  min-height: 46px;
  padding: 9px 12px;
  border: 1px solid rgba(107,161,208,.15);
  border-radius: 9px;
  display: flex;
  align-items: center;
  gap: 8px;
  color: #819cb6;
  background: #071a2c;
  font-size: 9px;
  font-weight: 850;
  letter-spacing: .04em;
  pointer-events: auto;
  cursor: pointer;
  transition: 220ms ease;
}

.aigo-public-engine__node span {
  color: #4b7195;
  font-size: 8px;
}

.aigo-public-engine__node--active {
  border-color: rgba(63,174,247,.6);
  color: #fff;
  background: #0a2946;
  box-shadow: 0 0 22px rgba(43,160,237,.15);
}

.aigo-public-engine__node:nth-child(1) {
  top: 4%;
  left: 50%;
  transform: translateX(-50%);
}

.aigo-public-engine__node:nth-child(2) {
  top: 25%;
  right: 0;
}

.aigo-public-engine__node:nth-child(3) {
  bottom: 25%;
  right: 0;
}

.aigo-public-engine__node:nth-child(4) {
  bottom: 4%;
  left: 50%;
  transform: translateX(-50%);
}

.aigo-public-engine__node:nth-child(5) {
  bottom: 25%;
  left: 0;
}

.aigo-public-engine__node:nth-child(6) {
  top: 25%;
  left: 0;
}

.aigo-public-engine__bottom {
  min-height: 62px;
  justify-content: flex-start;
  gap: 9px;
  border-top: 1px solid rgba(103,166,218,.14);
  border-bottom: 0;
  overflow-x: auto;
}

.aigo-public-engine__bottom span {
  padding: 7px 9px;
  border: 1px solid rgba(105,165,218,.12);
  border-radius: 6px;
  color: #7594b1;
  font-size: 8px;
  font-weight: 800;
  white-space: nowrap;
}

/* SHARED SECTIONS */

.aigo-public-why,
.aigo-public-difference,
.aigo-public-usecases {
  padding: 110px 0;
}

.aigo-public-section-heading {
  display: grid;
  grid-template-columns: minmax(0, 1fr) minmax(300px, .55fr);
  gap: 80px;
  align-items: end;
}

.aigo-public-section-heading h2,
.aigo-public-significance h2 {
  max-width: 800px;
  margin: 18px 0 0;
  font-size: clamp(42px, 5vw, 66px);
  line-height: 1;
  letter-spacing: -.045em;
}

.aigo-public-section-heading h2 span,
.aigo-public-significance h2 span {
  display: block;
}

.aigo-public-section-heading > p {
  margin: 0;
  font-size: 16px;
  line-height: 1.75;
}

/* WHY */

.aigo-public-why {
  color: #10263c;
  background: #f6f9fc;
}

.aigo-public-why .aigo-public-section-heading p {
  color: #647b91;
}

.aigo-public-agency {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(4, minmax(0, 1fr));
  border: 1px solid #dce6ef;
  border-radius: 18px;
  overflow: hidden;
  background: #fff;
}

.aigo-public-agency__item {
  position: relative;
  min-height: 235px;
  padding: 29px;
  border-right: 1px solid #e1e9f0;
}

.aigo-public-agency__item:last-child {
  border-right: 0;
}

.aigo-public-agency__item > span {
  color: #1678d7;
  font-size: 10px;
  font-weight: 900;
}

.aigo-public-agency__item strong {
  display: block;
  margin-top: 45px;
  color: #102b45;
  font-size: 25px;
}

.aigo-public-agency__item p {
  color: #6d8195;
  font-size: 13px;
  line-height: 1.6;
}

.aigo-public-agency__item i {
  position: absolute;
  top: 50%;
  right: -15px;
  z-index: 2;
  width: 30px;
  height: 30px;
  border: 1px solid #d8e2ea;
  border-radius: 50%;
  display: grid;
  place-items: center;
  background: #fff;
  color: #1780df;
  font-style: normal;
}

.aigo-public-thesis {
  margin-top: 35px;
  padding: 33px;
  border-radius: 16px;
  display: grid;
  grid-template-columns: 240px minmax(0, 1fr);
  align-items: center;
  gap: 30px;
  background: #071c30;
}

.aigo-public-thesis span {
  color: #d5a94e;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-thesis strong {
  color: #fff;
  font-size: clamp(21px, 2.5vw, 33px);
  font-weight: 700;
}

.aigo-public-thesis em {
  display: block;
  margin-top: 7px;
  color: #54b2fa;
  font-style: normal;
}

/* SIGNIFICANCE */

.aigo-public-significance {
  padding: 120px 0;
  color: #fff;
  background:
    radial-gradient(circle at 75% 40%, rgba(32,126,210,.12), transparent 32%),
    #061526;
}

.aigo-public-significance__grid {
  display: grid;
  grid-template-columns: .78fr 1.22fr;
  gap: 90px;
  align-items: center;
}

.aigo-public-significance h2 span {
  color: #4eacf3;
}

.aigo-public-significance__grid > div:first-child > p {
  margin-top: 27px;
  color: #91a9c1;
  font-size: 15px;
  line-height: 1.75;
}

.aigo-public-significance__visual {
  padding: 28px;
  border: 1px solid rgba(95,165,220,.2);
  border-radius: 20px;
  background: rgba(5,25,43,.85);
}

.aigo-public-signal,
.aigo-public-significance__result {
  padding: 22px;
  border: 1px solid rgba(96,155,207,.16);
  border-radius: 12px;
  background: #082039;
}

.aigo-public-signal > span,
.aigo-public-significance__result > span {
  color: #4eaef4;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-signal > strong {
  display: block;
  margin-top: 9px;
  color: #fff;
  font-size: 18px;
}

.aigo-public-signal > div {
  margin-top: 18px;
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.aigo-public-signal i {
  padding: 7px 10px;
  border-radius: 6px;
  color: #8fa9c3;
  background: #06192c;
  font-size: 10px;
  font-style: normal;
}

.aigo-public-significance__bridge {
  height: 65px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  color: #547b9f;
}

.aigo-public-significance__bridge span {
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-significance__bridge b {
  color: #3ba4f2;
}

.aigo-public-significance__result > div {
  margin-top: 17px;
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  gap: 8px;
}

.aigo-public-significance__result strong {
  min-height: 55px;
  padding: 10px;
  border: 1px solid rgba(104,166,219,.12);
  border-radius: 7px;
  display: flex;
  align-items: center;
  color: #d9e9f7;
  background: #061a2d;
  font-size: 10px;
}

.aigo-public-significance__decision {
  padding: 21px;
  border: 1px solid rgba(213,169,78,.25);
  border-radius: 10px;
  color: #f1d18a;
  background: rgba(213,169,78,.055);
  text-align: center;
  font-size: 11px;
  font-weight: 900;
  letter-spacing: .1em;
}

/* MODEL */

.aigo-public-model {
  padding: 120px 0;
  color: #122b44;
  background: #fff;
}

.aigo-public-model > .aigo-public-shell > h2 {
  margin: 18px 0 50px;
  font-size: clamp(56px, 7vw, 92px);
  line-height: .9;
  letter-spacing: -.055em;
}

.aigo-public-model > .aigo-public-shell > h2 span {
  color: #1a7bd7;
}

.aigo-public-model__grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  border: 1px solid #dde6ee;
  border-radius: 18px;
  overflow: hidden;
}

.aigo-public-model article {
  min-height: 470px;
  padding: 30px;
  border-right: 1px solid #e0e8ef;
}

.aigo-public-model article:last-child {
  border-right: 0;
}

.aigo-public-model__number {
  color: #9eb1c1;
  font-size: 10px;
}

.aigo-public-model article > span {
  display: block;
  margin-top: 42px;
  color: #197adc;
  font-size: 12px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-model h3 {
  max-width: 330px;
  margin: 15px 0 35px;
  color: #142d46;
  font-size: 27px;
  line-height: 1.15;
}

.aigo-public-model article > div:last-child {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
}

.aigo-public-model small {
  padding: 8px 10px;
  border-radius: 6px;
  color: #647d93;
  background: #f4f7fa;
}

/* USE CASE */

.aigo-public-usecases {
  color: #fff;
  background: #061526;
}

.aigo-public-usecases .aigo-public-section-heading p {
  color: #8ea7bf;
}

.aigo-public-usecases h2 span {
  color: #4cabf3;
}

.aigo-public-pill {
  width: fit-content;
  margin-top: 19px;
  padding: 7px 13px;
  border-radius: 999px;
  color: #b6c9da;
  background: rgba(255,255,255,.06);
  font-size: 10px;
  font-weight: 850;
  letter-spacing: .08em;
}

.aigo-public-usecases__grid {
  margin-top: 55px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.aigo-public-usecases__grid a {
  min-height: 290px;
  padding: 29px;
  border: 1px solid rgba(110,166,213,.17);
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  color: inherit;
  background: #082039;
  text-decoration: none;
  transition: 200ms ease;
}

.aigo-public-usecases__grid a:hover {
  transform: translateY(-4px);
  border-color: rgba(64,164,236,.45);
  background: #0a2845;
}

.aigo-public-usecases__grid a > span {
  color: #4eacf3;
  font-size: 10px;
  font-weight: 900;
}

.aigo-public-usecases__grid h3 {
  margin: 36px 0 0;
  font-size: clamp(24px, 2.7vw, 34px);
}

.aigo-public-usecases__grid p {
  max-width: 580px;
  color: #8ea8c1;
  line-height: 1.65;
}

.aigo-public-usecases__grid a > strong {
  margin-top: auto;
  display: flex;
  justify-content: space-between;
  color: #dcecff;
  font-size: 12px;
}

.aigo-public-usecases__grid i {
  color: #52aff5;
  font-style: normal;
}

/* DIFFERENTIATION */

.aigo-public-difference {
  color: #122b44;
  background: #f5f8fb;
}

.aigo-public-difference .aigo-public-section-heading p {
  color: #687f94;
}

.aigo-public-difference h2 span {
  color: #197bdd;
}

.aigo-public-difference__grid {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 12px;
}

.aigo-public-difference article {
  padding: 30px;
  border: 1px solid #dce5ed;
  border-radius: 14px;
  background: #fff;
}

.aigo-public-difference article > span {
  color: #8b9eae;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-public-difference h3 {
  margin: 18px 0 0;
  color: #112b45;
  font-size: 26px;
}

.aigo-public-difference article > p {
  color: #6e8396;
  line-height: 1.65;
}

.aigo-public-difference article > div {
  margin-top: 25px;
  padding: 20px;
  border-radius: 10px;
  background: #071c31;
}

.aigo-public-difference small {
  display: block;
  color: #4eabf1;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .11em;
}

.aigo-public-difference article > div strong {
  display: block;
  margin-top: 9px;
  color: #dceafa;
  font-size: 13px;
  line-height: 1.55;
}

/* FINAL */

.aigo-public-final {
  padding: 120px 0;
  color: #fff;
  background:
    radial-gradient(circle at 15% 0%, rgba(37,131,215,.17), transparent 28%),
    #041321;
}

.aigo-public-final__inner {
  display: grid;
  grid-template-columns: 1.1fr .6fr;
  gap: 80px;
  align-items: end;
}

.aigo-public-final h2 {
  max-width: 850px;
  margin: 20px 0 0;
  font-size: clamp(45px, 5vw, 68px);
  line-height: 1;
  letter-spacing: -.045em;
}

.aigo-public-final h2 span {
  color: #4aacf3;
}

.aigo-public-final__inner > div:last-child p {
  color: #8ea6bd;
  line-height: 1.7;
}

/* MOTION */

@keyframes aigo-public-pulse {
  0%, 100% { opacity: .45; transform: scale(.8); }
  50% { opacity: 1; transform: scale(1.25); }
}

@keyframes aigo-public-spin {
  to { transform: translate(-50%, -50%) rotate(360deg); }
}

@keyframes aigo-public-spin-reverse {
  to { transform: translate(-50%, -50%) rotate(-360deg); }
}

/* TABLET */

@media (max-width: 1050px) {
  .aigo-public-shell {
    width: calc(100% - 48px);
  }

  .aigo-public-hero__grid,
  .aigo-public-significance__grid {
    grid-template-columns: 1fr;
  }

  .aigo-public-engine {
    max-width: 760px;
  }

  .aigo-public-section-heading {
    grid-template-columns: 1fr;
    gap: 25px;
  }

  .aigo-public-agency {
    grid-template-columns: 1fr 1fr;
  }

  .aigo-public-agency__item:nth-child(2) {
    border-right: 0;
  }

  .aigo-public-model__grid {
    grid-template-columns: 1fr;
  }

  .aigo-public-model article {
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid #e0e8ef;
  }

  .aigo-public-model article:last-child {
    border-bottom: 0;
  }
}

/* MOBILE */

@media (max-width: 700px) {
  .aigo-public-shell {
    width: calc(100% - 30px);
  }

  .aigo-public-hero {
    min-height: auto;
    padding: 54px 0 65px;
  }

  .aigo-public-hero__grid {
    gap: 45px;
  }

  .aigo-public-hero__copy h1 {
    font-size: clamp(44px, 13.5vw, 61px);
  }

  .aigo-public-hero__lead {
    font-size: 15px;
  }

  .aigo-public-actions {
    display: grid;
  }

  .aigo-public-button {
    width: 100%;
    box-sizing: border-box;
  }

  .aigo-public-engine__stage {
    min-height: 520px;
    padding: 20px;
  }

  .aigo-public-engine__orbit--one {
    width: 300px;
    height: 300px;
  }

  .aigo-public-engine__orbit--two {
    width: 230px;
    height: 230px;
  }

  .aigo-public-engine__core {
    width: 63%;
    padding: 20px;
  }

  .aigo-public-engine__core strong {
    font-size: 19px;
  }

  .aigo-public-engine__nodes {
    inset: 13px;
  }

  .aigo-public-engine__node {
    width: 96px;
    padding: 7px;
    font-size: 7px;
  }

  .aigo-public-engine__bottom {
    padding: 0 14px;
  }

  .aigo-public-why,
  .aigo-public-significance,
  .aigo-public-model,
  .aigo-public-usecases,
  .aigo-public-difference,
  .aigo-public-final {
    padding: 75px 0;
  }

  .aigo-public-section-heading h2,
  .aigo-public-significance h2 {
    font-size: 41px;
  }

  .aigo-public-agency,
  .aigo-public-usecases__grid,
  .aigo-public-difference__grid {
    grid-template-columns: 1fr;
  }

  .aigo-public-agency__item {
    min-height: auto;
    border-right: 0;
    border-bottom: 1px solid #e1e9f0;
  }

  .aigo-public-agency__item:last-child {
    border-bottom: 0;
  }

  .aigo-public-agency__item i {
    display: none;
  }

  .aigo-public-thesis {
    grid-template-columns: 1fr;
  }

  .aigo-public-significance__result > div {
    grid-template-columns: 1fr 1fr;
  }

  .aigo-public-model > .aigo-public-shell > h2 {
    font-size: 58px;
  }

  .aigo-public-final__inner {
    grid-template-columns: 1fr;
    gap: 35px;
  }
}

@media (prefers-reduced-motion: reduce) {
  .aigo-public-engine__orbit,
  .aigo-public-live i {
    animation: none !important;
  }

  .aigo-public-button,
  .aigo-public-usecases__grid a {
    transition: none !important;
  }
}




/* =========================================================
   AIGO-OS CAPABILITY STORY SYSTEM
   ========================================================= */

.capability-story-grid {
  display: grid;
  grid-template-columns: minmax(0, 0.82fr) minmax(0, 1.18fr);
  gap: clamp(48px, 8vw, 120px);
  align-items: start;
}

.capability-story-grid h2 {
  max-width: 720px;
  margin: 16px 0 0;
  font-size: clamp(34px, 4vw, 58px);
  line-height: 1.02;
  letter-spacing: -0.045em;
}

.capability-story-copy {
  display: grid;
  gap: 22px;
}

.capability-story-copy p {
  margin: 0;
  max-width: 760px;
  font-size: clamp(17px, 1.45vw, 21px);
  line-height: 1.7;
  color: var(--public-muted, #52606d);
}

.capability-context-grid {
  display: grid;
  grid-template-columns: repeat(3, minmax(0, 1fr));
  margin-top: 56px;
  border-top: 1px solid rgba(15, 32, 48, 0.14);
  border-left: 1px solid rgba(15, 32, 48, 0.14);
}

.capability-context-grid article {
  min-height: 230px;
  padding: 30px;
  border-right: 1px solid rgba(15, 32, 48, 0.14);
  border-bottom: 1px solid rgba(15, 32, 48, 0.14);
}

.capability-context-grid article > span {
  display: block;
  margin-bottom: 36px;
  font-size: 12px;
  font-weight: 800;
  letter-spacing: 0.11em;
  text-transform: uppercase;
}

.capability-context-grid article p {
  margin: 0;
  font-size: 17px;
  line-height: 1.65;
  color: var(--public-muted, #52606d);
}

.aigo-cap-demo__context-line {
  margin-top: 24px;
  padding-top: 20px;
  border-top: 1px solid rgba(255,255,255,0.12);
}

.aigo-cap-demo__context-line span {
  display: block;
  font-size: 13px;
  line-height: 1.5;
  opacity: 0.72;
}

.aigo-cap-demo__context-line i {
  display: block;
  width: 100%;
  height: 2px;
  margin-top: 16px;
  overflow: hidden;
  background: rgba(255,255,255,0.1);
  position: relative;
}

.aigo-cap-demo__context-line i::after {
  content: "";
  position: absolute;
  inset: 0;
  width: 34%;
  background: currentColor;
  animation: aigo-context-scan 3.2s ease-in-out infinite;
}

.aigo-cap-demo__result-core {
  min-height: 190px;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  text-align: center;
  border: 1px solid rgba(255,255,255,0.14);
  border-radius: 50%;
  aspect-ratio: 1;
  margin: 28px auto;
  max-width: 230px;
  position: relative;
}

.aigo-cap-demo__result-core::before {
  content: "";
  position: absolute;
  inset: 12px;
  border: 1px solid rgba(255,255,255,0.08);
  border-radius: inherit;
  animation: aigo-result-pulse 3.4s ease-in-out infinite;
}

.aigo-cap-demo__result-core small {
  position: relative;
  z-index: 1;
  margin-bottom: 10px;
  font-size: 10px;
  letter-spacing: 0.14em;
  opacity: 0.58;
}

.aigo-cap-demo__result-core strong {
  position: relative;
  z-index: 1;
  max-width: 150px;
  font-size: 17px;
  line-height: 1.25;
}

@keyframes aigo-context-scan {
  0% {
    transform: translateX(-110%);
  }

  50% {
    transform: translateX(190%);
  }

  100% {
    transform: translateX(-110%);
  }
}

@keyframes aigo-result-pulse {
  0%,
  100% {
    transform: scale(0.96);
    opacity: 0.45;
  }

  50% {
    transform: scale(1);
    opacity: 1;
  }
}

@media (max-width: 900px) {
  .capability-story-grid {
    grid-template-columns: 1fr;
    gap: 30px;
  }

  .capability-context-grid {
    grid-template-columns: 1fr 1fr;
  }

  .capability-context-grid article {
    min-height: 200px;
  }
}

@media (max-width: 600px) {
  .capability-context-grid {
    grid-template-columns: 1fr;
    margin-top: 34px;
  }

  .capability-context-grid article {
    min-height: 0;
    padding: 24px 20px;
  }

  .capability-context-grid article > span {
    margin-bottom: 18px;
  }

  .capability-story-grid h2 {
    font-size: clamp(32px, 10vw, 44px);
  }
}

@media (prefers-reduced-motion: reduce) {
  .aigo-cap-demo__context-line i::after,
  .aigo-cap-demo__result-core::before {
    animation: none !important;
  }
}


/* =========================================================
   AIGO-OS PLATFORM
   ========================================================= */

.aigo-platform {
  overflow: hidden;
}

.aigo-platform__hero {
  padding: 100px 0 110px;
  color: #fff;
  background:
    radial-gradient(circle at 78% 30%, rgba(40,148,231,.16), transparent 30%),
    #051524;
}

.aigo-platform__hero-grid {
  display: grid;
  grid-template-columns: minmax(0,1fr) minmax(420px,.72fr);
  gap: clamp(50px,8vw,120px);
  align-items: center;
}

.aigo-platform__hero h1 {
  max-width: 860px;
  margin: 22px 0 0;
  font-size: clamp(58px,7vw,96px);
  line-height: .92;
  letter-spacing: -.06em;
}

.aigo-platform__hero h1 span {
  display: block;
  color: #4eacf3;
}

.aigo-platform__hero p {
  max-width: 760px;
  margin: 28px 0 0;
  color: #9ab0c5;
  font-size: 17px;
  line-height: 1.72;
}

.aigo-platform__position {
  padding: 30px;
  border: 1px solid rgba(91,165,221,.2);
  border-radius: 20px;
  background: #081f36;
}

.aigo-platform__position > span,
.aigo-platform__significance-flow > div > span {
  color: #57b1f5;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-platform__position > div {
  margin-top: 25px;
  display: grid;
  gap: 8px;
}

.aigo-platform__position strong {
  padding: 15px 17px;
  border: 1px solid rgba(103,170,221,.13);
  border-radius: 7px;
  color: #dcebf8;
  background: #061a2e;
  font-size: 13px;
}

.aigo-platform__position p {
  margin-top: 24px;
  font-size: 13px;
}

.aigo-platform__problem,
.aigo-platform__lifecycle,
.aigo-platform__capabilities,
.aigo-platform__boundary,
.aigo-platform__execution {
  padding: 110px 0;
}

.aigo-platform__problem {
  background: #fff;
}

.aigo-platform__statement {
  margin-top: 25px;
  display: grid;
  grid-template-columns: 1fr .72fr;
  gap: 90px;
}

.aigo-platform__statement h2,
.aigo-platform__execution h2 {
  margin: 0;
  max-width: 850px;
  font-size: clamp(45px,5.5vw,74px);
  line-height: .98;
  letter-spacing: -.05em;
}

.aigo-platform__statement > div,
.aigo-platform__execution-grid > div:last-child {
  display: grid;
  gap: 20px;
}

.aigo-platform__statement p,
.aigo-platform__execution p {
  margin: 0;
  color: #62778b;
  font-size: 17px;
  line-height: 1.72;
}

.aigo-platform__lifecycle {
  background: #f5f8fb;
}

.aigo-platform__lifecycle-grid {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  border-top: 1px solid #dbe5ed;
  border-left: 1px solid #dbe5ed;
}

.aigo-platform__lifecycle-grid article {
  min-height: 290px;
  padding: 30px;
  border-right: 1px solid #dbe5ed;
  border-bottom: 1px solid #dbe5ed;
  background: rgba(255,255,255,.65);
}

.aigo-platform__lifecycle-grid article > div {
  display: flex;
  justify-content: space-between;
  gap: 15px;
}

.aigo-platform__lifecycle-grid article > div span {
  color: #1b7edc;
  font-size: 11px;
  font-weight: 900;
}

.aigo-platform__lifecycle-grid article small {
  color: #7c91a4;
  font-size: 9px;
  font-weight: 900;
  letter-spacing: .12em;
}

.aigo-platform__lifecycle-grid h3 {
  max-width: 520px;
  margin: 55px 0 0;
  font-size: 27px;
  line-height: 1.12;
}

.aigo-platform__lifecycle-grid p {
  max-width: 590px;
  color: #6b8093;
  line-height: 1.65;
}

.aigo-platform__significance {
  padding: 120px 0;
  color: #fff;
  background: #061526;
}

.aigo-platform__significance-grid {
  display: grid;
  grid-template-columns: .8fr 1.2fr;
  gap: 80px;
  align-items: center;
}

.aigo-platform__significance h2 {
  margin: 18px 0 0;
  font-size: clamp(43px,5vw,68px);
  line-height: .98;
  letter-spacing: -.05em;
}

.aigo-platform__significance h2 span {
  display: block;
  color: #4caaf2;
}

.aigo-platform__significance p {
  color: #8fa8bf;
  line-height: 1.72;
}

.aigo-platform__significance-flow {
  padding: 28px;
  border: 1px solid rgba(99,163,216,.18);
  border-radius: 18px;
  background: #081d32;
}

.aigo-platform__significance-flow > div {
  display: flex;
  flex-wrap: wrap;
  gap: 7px;
  padding: 19px;
  border: 1px solid rgba(98,160,211,.12);
  border-radius: 9px;
  background: #06192b;
}

.aigo-platform__significance-flow > div > span {
  width: 100%;
  margin-bottom: 7px;
}

.aigo-platform__significance-flow strong {
  padding: 8px 10px;
  border-radius: 6px;
  color: #d4e4f2;
  background: #0a2540;
  font-size: 10px;
}

.aigo-platform__significance-flow > i {
  width: 1px;
  height: 34px;
  display: block;
  margin: 0 auto;
  background: #2785ca;
}

.aigo-platform__capabilities {
  background: #fff;
}

.aigo-platform__capability-grid {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(2,minmax(0,1fr));
  gap: 12px;
}

.aigo-platform__capability-grid a {
  min-height: 320px;
  padding: 30px;
  border: 1px solid #dce6ee;
  border-radius: 14px;
  display: flex;
  flex-direction: column;
  color: inherit;
  text-decoration: none;
  background: #f8fafc;
  transition: transform 180ms ease, border-color 180ms ease;
}

.aigo-platform__capability-grid a:hover {
  transform: translateY(-4px);
  border-color: #84bdec;
}

.aigo-platform__capability-grid a > span {
  color: #1b7edb;
  font-size: 10px;
  font-weight: 900;
  letter-spacing: .11em;
}

.aigo-platform__capability-grid h3 {
  margin: 35px 0 0;
  font-size: 29px;
}

.aigo-platform__capability-grid p {
  color: #687e92;
  line-height: 1.65;
}

.aigo-platform__capability-grid a > strong {
  margin-top: auto;
  display: flex;
  align-items: center;
  justify-content: space-between;
  font-size: 12px;
}

.aigo-platform__boundary {
  color: #fff;
  background: #071827;
}

.aigo-platform__boundary .aigo-public-section-heading > p {
  color: #8ca5bc;
}

.aigo-platform__boundary h2 span {
  color: #4caaf2;
}

.aigo-platform__layers {
  margin-top: 60px;
  display: grid;
  grid-template-columns: repeat(5,minmax(0,1fr));
  gap: 8px;
}

.aigo-platform__layers article {
  min-height: 310px;
  padding: 23px;
  border: 1px solid rgba(101,161,212,.15);
  border-radius: 11px;
  background: #091e33;
}

.aigo-platform__layers article > span {
  color: #7897b2;
  font-size: 8px;
  font-weight: 900;
  letter-spacing: .1em;
}

.aigo-platform__layers h3 {
  margin-top: 40px;
  font-size: 19px;
  line-height: 1.2;
}

.aigo-platform__layers p {
  color: #839db5;
  font-size: 12px;
  line-height: 1.6;
}

.aigo-platform__layers .aigo-platform__layers-aigo {
  border-color: rgba(52,157,234,.55);
  background: #0a2a48;
}

.aigo-platform__layers-aigo > span {
