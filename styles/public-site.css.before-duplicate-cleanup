   ========================================================= */

.public-header {
  position: sticky;
  top: 0;
  z-index: 100;
  border-bottom: 1px solid rgba(255,255,255,0.07);
  background: rgba(5, 15, 27, 0.92);
  backdrop-filter: blur(22px);
  -webkit-backdrop-filter: blur(22px);
}

.public-header__inner {
  position: relative;
  width: min(1440px, calc(100% - 48px));
  min-height: 78px;
  margin: 0 auto;
  display: grid;
  grid-template-columns: 150px minmax(0,1fr) auto;
  align-items: center;
  gap: 32px;
}

.public-header__brand {
  display: inline-flex;
  align-items: center;
}

.public-header__logo {
  display: block;
  width: 132px;
  height: auto;
  object-fit: contain;
}

.public-header__nav {
  height: 78px;
  display: flex;
  align-items: stretch;
  justify-content: center;
  gap: 3px;
}

.public-header__nav-item {
  display: flex;
  align-items: stretch;
}

.public-header__nav-link {
  position: relative;
  display: flex;
  align-items: center;
  gap: 6px;
  padding: 0 13px;
  color: #aebdd0;
  font-size: 0.76rem;
  font-weight: 700;
  white-space: nowrap;
  text-decoration: none;
  transition: color 160ms ease;
}

.public-header__nav-link::after {
  content: "";
  position: absolute;
  left: 13px;
  right: 13px;
  bottom: 0;
  height: 2px;
  transform: scaleX(0);
  background: linear-gradient(90deg,#347ff0,#d5aa55);
  transition: transform 160ms ease;
}

.public-header__nav-item:hover
.public-header__nav-link {
  color: #ffffff;
}

.public-header__nav-item:hover
.public-header__nav-link::after {
  transform: scaleX(1);
}

.public-header__chevron {
  color: #687f9d;
  font-size: 0.62rem;
  transition: transform 160ms ease;
}

.public-header__nav-item:hover
.public-header__chevron {
  transform: rotate(180deg);
}

.public-header__dropdown {
  position: absolute;
  top: calc(100% - 1px);
  left: 50%;
  width: min(900px, calc(100vw - 70px));
  display: grid;
  grid-template-columns: 0.72fr 1.28fr;
  visibility: hidden;
  opacity: 0;
  transform: translate(-50%, 8px);
  overflow: hidden;
  border: 1px solid rgba(117,160,222,0.16);
  border-radius: 0 0 16px 16px;
  background: #081728;
  box-shadow: 0 28px 80px rgba(0,0,0,0.38);
  pointer-events: none;
  transition:
    opacity 150ms ease,
    transform 150ms ease,
    visibility 150ms ease;
}

.public-header__nav-item:hover
.public-header__dropdown,
.public-header__nav-item:focus-within
.public-header__dropdown {
  visibility: visible;
  opacity: 1;
  transform: translate(-50%, 0);
  pointer-events: auto;
}

