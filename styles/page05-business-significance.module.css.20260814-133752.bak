.page {
  --navy: #08243b;
  --navy2: #0a3150;
  --ink: #102f4d;
  --body: #58738c;
  --blue: #147fd8;
  --blue-soft: #eef7fe;
  --gold: #b98217;
  --cream: #f2ede3;
  --cream2: #eae3d7;
  --line: #cfdbe4;

  overflow: hidden;

  background: #ffffff;

  color: var(--ink);
}


.shell {
  width: min(1180px, calc(100% - 48px));

  margin: 0 auto;
}


.blueEyebrow,
.blueDarkEyebrow,
.goldEyebrow {
  margin: 0;

  font-size: 10px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.12em;
}


.blueEyebrow {
  color: #70baf1;
}


.blueDarkEyebrow {
  color: #147fd8;
}


.goldEyebrow {
  color: var(--gold);
}


/* ==========================================================
   HERO
========================================================== */

.hero {
  position: relative;

  min-height: 680px;

  display: flex;
  align-items: center;

  padding: 94px 0 84px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 74% 42%,
      rgba(32, 128, 203, 0.16),
      transparent 31%
    ),
    linear-gradient(
      135deg,
      #061b2e 0%,
      #082b47 58%,
      #071f35 100%
    );
}


.heroGrid {
  position: absolute;
  inset: 0;

  opacity: 0.075;

  background-image:
    linear-gradient(
      rgba(103, 177, 232, 0.18) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(103, 177, 232, 0.18) 1px,
      transparent 1px
    );

  background-size: 48px 48px;
}


.heroLayout {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns:
    minmax(0, 1.08fr)
    minmax(390px, 0.92fr);

  gap: 76px;

  align-items: center;
}


.heroCopy {
  max-width: 720px;
}


.heroCopy h1 {
  max-width: 720px;

  margin: 18px 0 0;

  color: #ffffff;

  font-size: clamp(46px, 5vw, 68px);
  line-height: 1.02;
  font-weight: 820;

  letter-spacing: -0.052em;

  text-wrap: balance;
}


.heroLead {
  max-width: 650px;

  margin: 24px 0 0;

  color: #d7e6f1;

  font-size: 18px;
  line-height: 1.62;
}


.heroSupporting {
  max-width: 665px;

  margin: 15px 0 0;

  color: #9fb9cc;

  font-size: 14px;
  line-height: 1.72;
}


.heroActions {
  display: flex;
  flex-wrap: wrap;

  gap: 12px;

  margin-top: 30px;
}


.primaryButton,
.secondaryButton {
  min-height: 46px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  padding: 0 18px;

  border-radius: 8px;

  text-decoration: none;

  font-size: 12px;
  font-weight: 800;
}


.primaryButton {
  background: #ffffff;

  color: #123a5c;
}


.secondaryButton {
  border: 1px solid rgba(139, 192, 235, 0.34);

  background: rgba(255,255,255,0.035);

  color: #e6f1f9;
}


.heroVisual {
  width: 91%;

  justify-self: end;
}


.significancePanel {
  padding: 28px;

  border: 1px solid rgba(99, 173, 230, 0.27);

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #103957,
      #092a45 58%,
      #071f35
    );

  box-shadow:
    0 32px 60px rgba(0, 8, 20, 0.34),
    inset 0 1px 0 rgba(255,255,255,0.05);
}


.significanceTop {
  display: flex;
  align-items: center;

  gap: 15px;
}


.significanceIcon {
  width: 52px;
  height: 52px;

  flex: 0 0 52px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(103, 178, 236, 0.26);
  border-radius: 14px;

  background: rgba(48, 138, 210, 0.10);

  color: #6eb8f2;
}


.significanceTop span,
.significanceQuestion span,
.significanceOutput span {
  display: block;

  color: #73b8ef;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.10em;
}


.significanceTop strong {
  display: block;

  margin-top: 6px;

  color: #ffffff;

  font-size: 17px;
  line-height: 1.35;
}


.significanceTop small {
  display: block;

  margin-top: 5px;

  color: #91abc1;

  font-size: 10px;
}


.significanceQuestion {
  margin-top: 25px;

  padding: 18px;

  border: 1px solid rgba(111, 176, 226, 0.16);
  border-radius: 12px;

  background: rgba(255,255,255,0.035);
}


.significanceQuestion strong {
  display: block;

  margin-top: 7px;

  color: #dceaf5;

  font-size: 14px;
  line-height: 1.48;
}


.significanceOutput {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-top: 14px;

  padding: 17px 18px;

  border: 1px solid rgba(71, 173, 220, 0.27);
  border-radius: 12px;

  background: rgba(44, 131, 188, 0.09);

  color: #71bff2;
}


.significanceOutput strong {
  display: block;

  margin-top: 5px;

  color: #ffffff;

  font-size: 15px;
}


/* ==========================================================
   SECTION INTRO
========================================================== */

.sectionIntro,
.sectionIntroDark {
  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(300px, 0.85fr);

  gap: 72px;

  align-items: end;

  margin-bottom: 48px;
}


.sectionIntro h2,
.sectionIntroDark h2,
.sectionIntroCentered h2 {
  margin: 12px 0 0;

  font-size: clamp(36px, 4vw, 52px);
  line-height: 1.05;
  font-weight: 810;

  letter-spacing: -0.045em;

  text-wrap: balance;
}


.sectionIntro h2,
.sectionIntroCentered h2 {
  color: var(--ink);
}


.sectionIntro > p,
.sectionIntroCentered > p:last-child {
  margin: 0;

  color: var(--body);

  font-size: 15px;
  line-height: 1.7;
}


.sectionIntroCentered {
  max-width: 900px;

  margin: 0 auto 48px;

  text-align: center;
}


.sectionIntroCentered > p:last-child {
  max-width: 720px;

  margin: 20px auto 0;
}


/* ==========================================================
   CORE MAPPING
========================================================== */

.coreSection {
  padding: 96px 0 104px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ece5d9
    );
}


.mappingFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    52px
    minmax(0, 1fr)
    52px
    minmax(0, 1fr)
    52px
    minmax(0, 1fr);

  align-items: stretch;
}


.mappingCard {
  min-height: 250px;

  padding: 25px;

  border: 1px solid #cedae3;
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f7f5ef
    );

  box-shadow:
    0 24px 44px rgba(31, 56, 75, 0.12),
    0 6px 14px rgba(31, 56, 75, 0.04),
    inset 0 1px 0 #ffffff;
}


.mappingCardOutput {
  border-color: #9dcaea;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );

  box-shadow:
    0 26px 48px rgba(27, 105, 164, 0.16),
    0 6px 14px rgba(31, 56, 75, 0.04),
    inset 0 1px 0 #ffffff;
}


.mappingIcon {
  width: 47px;
  height: 47px;

  display: grid;
  place-items: center;

  margin-bottom: 24px;

  border: 1px solid #bedaf0;
  border-radius: 13px;

  background: #edf7ff;

  color: #1680d9;
}


.mappingCard > span {
  color: #147fd8;

  font-size: 9px;
  font-weight: 850;
}


.mappingCard h3 {
  margin: 10px 0 0;

  color: var(--ink);

  font-size: 22px;
  line-height: 1.2;
  font-weight: 790;
}


.mappingCard p {
  margin: 13px 0 0;

  color: var(--body);

  font-size: 13px;
  line-height: 1.65;
}


.mappingArrow {
  display: grid;
  place-items: center;

  color: #2587d6;
}


/* ==========================================================
   SOURCES
========================================================== */

.sourcesSection {
  padding: 100px 0 106px;

  background: #ffffff;
}


.signalGrid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 17px;
}


.signalCard {
  min-height: 225px;

  padding: 25px;

  border: 1px solid #d1dce4;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f6f9fb
    );

  box-shadow:
    0 21px 39px rgba(31, 56, 75, 0.10),
    0 5px 12px rgba(31, 56, 75, 0.04),
    inset 0 1px 0 #ffffff;
}


.signalTop {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-bottom: 22px;
}


.signalIcon {
  width: 45px;
  height: 45px;

  display: grid;
  place-items: center;

  border: 1px solid #c3ddf0;
  border-radius: 12px;

  background: #edf7ff;

  color: #167fd7;
}


.signalTop span {
  color: #147fd8;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}


.signalCard h3 {
  margin: 0;

  color: var(--ink);

  font-size: 20px;
  line-height: 1.22;
  font-weight: 780;

  letter-spacing: -0.02em;
}


.signalCard p {
  margin: 12px 0 0;

  color: var(--body);

  font-size: 13px;
  line-height: 1.62;
}


.sourceNote {
  display: flex;
  align-items: flex-start;

  gap: 13px;

  margin-top: 30px;

  padding: 18px 20px;

  border: 1px solid #c8dbe9;
  border-radius: 13px;

  background: #f9fcfe;

  color: #187ecf;
}


.sourceNote strong {
  display: block;

  color: #153c5b;

  font-size: 13px;
  line-height: 1.5;
}


.sourceNote p {
  margin: 4px 0 0;

  color: #526f87;

  font-size: 13px;
  line-height: 1.62;
}


/* ==========================================================
   EXAMPLE
========================================================== */

.exampleSection {
  padding: 100px 0;

  background:
    linear-gradient(
      135deg,
      #071e33,
      #0a2d49 58%,
      #071f35
    );
}


.sectionIntroDark h2 {
  color: #ffffff;
}


.sectionIntroDark > p {
  margin: 0;

  color: #a7bfd2;

  font-size: 15px;
  line-height: 1.7;
}


.exampleFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 0.86fr)
    60px
    minmax(0, 1fr)
    60px
    minmax(0, 0.92fr);

  align-items: center;
}


.exampleContext,
.exampleBusiness,
.exampleAssessment {
  padding: 25px;

  border: 1px solid rgba(102, 173, 228, 0.25);
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #103956,
      #092944
    );

  box-shadow:
    0 28px 50px rgba(0, 8, 20, 0.28),
    inset 0 1px 0 rgba(255,255,255,0.05);
}


.exampleAssessment {
  border-color: rgba(93, 194, 147, 0.30);

  background:
    linear-gradient(
      145deg,
      #123c50,
      #0c2c42
    );
}


.exampleHeader {
  padding-bottom: 18px;

  border-bottom:
    1px solid rgba(119, 174, 216, 0.13);
}


.exampleHeader span,
.exampleRow span,
.assessmentLabel {
  color: #72b8ef;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}


.exampleHeader strong {
  display: block;

  margin-top: 6px;

  color: #ffffff;

  font-size: 16px;
  line-height: 1.35;
}


.exampleRow {
  padding: 13px 0;

  border-bottom:
    1px solid rgba(119, 174, 216, 0.10);
}


.exampleRow strong {
  display: block;

  margin-top: 5px;

  color: #dce9f3;

  font-size: 11px;
  line-height: 1.45;
}


.exampleArrow {
  display: grid;
  place-items: center;

  color: #69b5ef;
}


.exampleAssessment h3 {
  margin: 10px 0 0;

  color: #ffffff;

  font-size: 22px;
  line-height: 1.25;
}


.exampleAssessment p {
  margin: 14px 0 0;

  color: #b8cedd;

  font-size: 13px;
  line-height: 1.65;
}


/* ==========================================================
   OUTPUT AND HANDOFF
========================================================== */

.outputSection {
  padding: 100px 0 108px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ebe4d8
    );
}


.visibilityGrid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
}


.visibilityCard {
  min-height: 230px;

  padding: 28px;

  border: 1px solid #cfdbe4;
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5f8fa
    );

  box-shadow:
    0 23px 42px rgba(31, 56, 75, 0.11),
    0 6px 13px rgba(31, 56, 75, 0.04),
    inset 0 1px 0 #ffffff;

  color: #147fd8;
}


.visibilityCard > span {
  display: block;

  margin-top: 21px;

  color: #147fd8;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}


.visibilityCard h3 {
  margin: 9px 0 0;

  color: var(--ink);

  font-size: 23px;
  line-height: 1.2;
}


.visibilityCard p {
  margin: 13px 0 0;

  color: var(--body);

  font-size: 13px;
  line-height: 1.65;
}


.handoff {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    90px
    minmax(0, 1fr);

  align-items: stretch;

  gap: 18px;

  margin-top: 34px;
}


.handoffCard {
  padding: 27px;

  border: 1px solid #cddbe5;
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5f9fb
    );

  box-shadow:
    0 22px 42px rgba(31, 56, 75, 0.11),
    inset 0 1px 0 #ffffff;
}


.handoffNext {
  border-color: #a7d0ee;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );
}


.handoffCard > span {
  color: #147fd8;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.08em;
}


.handoffCard > strong {
  display: block;

  margin-top: 10px;

  color: var(--ink);

  font-size: 21px;
  line-height: 1.3;
}


.handoffCard small {
  display: block;

  margin-top: 23px;

  color: #6d879b;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}


.handoffCard p {
  margin: 6px 0 0;

  color: #315a78;

  font-size: 13px;
  line-height: 1.55;
  font-weight: 700;
}


.handoffArrow {
  display: grid;
  place-items: center;

  color: #2186d9;
}


/* ==========================================================
   LIGHT SECTION CONTRAST PROTECTION
========================================================== */

.coreSection,
.sourcesSection,
.outputSection {
  color: #102f4d !important;
}


.coreSection *,
.sourcesSection *,
.outputSection * {
  opacity: 1 !important;
  filter: none !important;

  -webkit-text-fill-color: currentColor !important;

  background-clip: border-box !important;
  -webkit-background-clip: border-box !important;
}


.coreSection h1,
.coreSection h2,
.coreSection h3,
.sourcesSection h1,
.sourcesSection h2,
.sourcesSection h3,
.outputSection h1,
.outputSection h2,
.outputSection h3 {
  color: #102f4d !important;
  -webkit-text-fill-color: #102f4d !important;

  text-shadow: none !important;
}


.coreSection p,
.sourcesSection p,
.outputSection p {
  color: #526f87 !important;
  -webkit-text-fill-color: #526f87 !important;
}


.coreSection .goldEyebrow,
.outputSection .goldEyebrow {
  color: #b47c12 !important;
  -webkit-text-fill-color: #b47c12 !important;
}


.sourcesSection .blueDarkEyebrow {
  color: #147fd8 !important;
  -webkit-text-fill-color: #147fd8 !important;
}


.mappingCard > span,
.signalTop span,
.visibilityCard > span,
.handoffCard > span {
  color: #147fd8 !important;
  -webkit-text-fill-color: #147fd8 !important;
}


.sourceNote strong {
  color: #153c5b !important;
  -webkit-text-fill-color: #153c5b !important;
}


.sourceNote p {
  color: #526f87 !important;
  -webkit-text-fill-color: #526f87 !important;
}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 1080px) {
  .heroLayout,
  .sectionIntro,
  .sectionIntroDark {
    grid-template-columns: 1fr;
  }


  .heroVisual {
    width: min(100%, 680px);

    justify-self: center;
  }


  .mappingFlow {
    grid-template-columns: 1fr;
  }


  .mappingArrow {
    min-height: 55px;
  }


  .mappingArrow svg {
    transform: rotate(90deg);
  }


  .exampleFlow {
    grid-template-columns: 1fr;
  }


  .exampleArrow {
    min-height: 55px;
  }


  .exampleArrow svg {
    transform: rotate(90deg);
  }


  .handoff {
    grid-template-columns: 1fr;
  }


  .handoffArrow {
    min-height: 55px;
  }


  .handoffArrow svg {
    transform: rotate(90deg);
  }
}


@media (max-width: 900px) {
  .signalGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}


@media (max-width: 720px) {
  .shell {
    width: min(100% - 30px, 1180px);
  }


  .hero,
  .coreSection,
  .sourcesSection,
  .exampleSection,
  .outputSection {
    padding-top: 72px;
    padding-bottom: 76px;
  }


  .heroCopy h1 {
    font-size: 44px;
  }


  .signalGrid,
  .visibilityGrid {
    grid-template-columns: 1fr;
  }
}


/* === PAGE 05 FINAL LOCK OVERRIDES === */

/*
   Final editorial structure:
   Hero
   How Business Significance is established
   Business context evidence
   One example
   Wider posture + Governance Decisioning handoff
*/


.hero {
  min-height: 620px;
  padding-top: 80px;
  padding-bottom: 72px;
}


.coreSection {
  padding-top: 82px;
  padding-bottom: 88px;
}


.sourcesSection {
  padding-top: 84px;
  padding-bottom: 88px;
}


.exampleSection {
  padding-top: 86px;
  padding-bottom: 90px;
}


.outputSection {
  padding-top: 84px;
  padding-bottom: 90px;
}


/* Four business-context questions rather than six oversized cards */

.signalGrid {
  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 18px;
}


.signalCard {
  min-height: 205px;
}


/* Compact final handoff */

.handoffActions {
  display: flex;
  justify-content: center;
  flex-wrap: wrap;

  gap: 12px;

  margin-top: 34px;
}


.handoffPrimary,
.handoffSecondary {
  min-height: 46px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 8px;

  padding: 0 18px;

  border-radius: 8px;

  font-size: 12px;
  font-weight: 800;

  text-decoration: none;
}


.handoffPrimary {
  background: #147fd8;

  color: #ffffff !important;

  -webkit-text-fill-color:
    #ffffff !important;
}


.handoffSecondary {
  border: 1px solid #c7d8e5;

  background: #ffffff;

  color: #17486d !important;

  -webkit-text-fill-color:
    #17486d !important;
}


/* Keep light-section text readable */

.coreSection,
.sourcesSection,
.outputSection {
  color: #102f4d !important;
}


.coreSection h1,
.coreSection h2,
.coreSection h3,
.sourcesSection h1,
.sourcesSection h2,
.sourcesSection h3,
.outputSection h1,
.outputSection h2,
.outputSection h3 {
  color: #102f4d !important;

  -webkit-text-fill-color:
    #102f4d !important;
}


.coreSection p,
.sourcesSection p,
.outputSection p {
  color: #526f87 !important;

  -webkit-text-fill-color:
    #526f87 !important;
}


@media (max-width: 900px) {

  .signalGrid {
    grid-template-columns: 1fr;
  }

  .signalCard {
    min-height: 0;
  }
}


@media (max-width: 720px) {

  .hero,
  .coreSection,
  .sourcesSection,
  .exampleSection,
  .outputSection {
    padding-top: 68px;
    padding-bottom: 72px;
  }
}

/* === END PAGE 05 FINAL LOCK OVERRIDES === */

