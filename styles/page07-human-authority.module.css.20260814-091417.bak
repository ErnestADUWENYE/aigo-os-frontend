.page {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: clip;
}

.page,
.page *,
.page *::before,
.page *::after {
  box-sizing: border-box;
}


/* ============================================================
   CANONICAL PAGE WIDTH
   Equal left and right gutters
   ============================================================ */

.shell {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 48px;
}

.keepLine {
  display: block;
  white-space: nowrap;
}

.blueEyebrow,
.goldEyebrow {
  margin: 0;
  font-size: 0.7rem;
  line-height: 1.35;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.blueEyebrow {
  color: #69adff;
}

.goldEyebrow {
  color: #c7953f;
}


/* ============================================================
   BUTTONS
   ============================================================ */

.primaryButton,
.secondaryButton,
.darkSecondaryButton {
  min-height: 48px;
  padding: 0 21px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  border-radius: 10px;

  font-size: 0.91rem;
  font-weight: 720;

  text-decoration: none;

  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.primaryButton {
  border: 1px solid #5b9cff;
  background: #2f7cff;
  color: #ffffff;

  box-shadow:
    0 14px 34px rgba(47, 124, 255, 0.22);
}

.secondaryButton {
  border:
    1px solid rgba(131, 177, 233, 0.24);

  background:
    rgba(255, 255, 255, 0.05);

  color: #eef6ff;
}

.darkSecondaryButton {
  border:
    1px solid rgba(23, 53, 77, 0.15);

  background: #f7f3eb;

  color: #15334a;
}

.primaryButton:hover,
.secondaryButton:hover,
.darkSecondaryButton:hover {
  transform: translateY(-2px);
}

.heroActions {
  margin-top: 27px;

  display: flex;
  flex-wrap: wrap;

  gap: 12px;
}

.sectionAction {
  margin-top: 28px;
}


/* ============================================================
   HERO
   ============================================================ */

.hero {
  position: relative;
  overflow: hidden;

  padding: 78px 0 90px;

  background:
    radial-gradient(
      circle at 79% 18%,
      rgba(48, 125, 255, 0.14),
      transparent 34%
    ),
    #061727;

  color: #f4f8fd;
}

.heroGrid {
  position: absolute;
  inset: 0;

  opacity: 0.3;

  pointer-events: none;

  background:
    linear-gradient(
      rgba(255, 255, 255, 0.017) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.017) 1px,
      transparent 1px
    );

  background-size: 54px 54px;
}

.heroGlow {
  position: absolute;

  right: 1%;
  top: -100px;

  width: 620px;
  height: 620px;

  border-radius: 50%;

  background:
    rgba(47, 124, 255, 0.07);

  filter: blur(90px);
}

.heroLayout {
  position: relative;
  z-index: 1;

  min-height: 620px;

  display: grid;

  grid-template-columns:
    minmax(0, 0.94fr)
    minmax(0, 1.06fr);

  gap: clamp(70px, 7vw, 108px);

  align-items: center;
}

.heroLayout > * {
  min-width: 0;
}

.heroCopy {
  width: 100%;
  max-width: 670px;
}

.heroTitle {
  width: 100%;
  max-width: 760px;

  margin: 20px 0 0;

  font-size:
    clamp(2.95rem, 4vw, 4.5rem);

  line-height: 1;

  letter-spacing: -0.052em;

  font-weight: 660;
}

.heroTitle span + span {
  margin-top: 7px;
}

.heroLead {
  margin: 27px 0 0;

  color: #eef5ff;

  font-size: 1.06rem;
  line-height: 1.68;
}

.heroSupporting {
  margin: 12px 0 0;

  color: #aebed0;

  font-size: 0.95rem;
  line-height: 1.72;
}


/* ============================================================
   AUTHORITY TRANSFER HERO VISUAL
   No overlapping absolute cards
   ============================================================ */

.authorityTransfer {
  width: 100%;
  max-width: 620px;

  margin-left: auto;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    64px
    minmax(0, 1fr);

  grid-template-rows:
    auto
    auto;

  column-gap: 15px;
  row-gap: 17px;

  align-items: center;
}

.transferLabel {
  grid-column: 1 / 4;

  text-align: center;
}

.transferLabel span {
  display: block;

  color: #69adff;

  font-size: 0.55rem;
  font-weight: 800;

  letter-spacing: 0.1em;
}

.transferLabel strong {
  display: block;

  margin-top: 5px;

  color: #90a7ba;

  font-size: 0.66rem;
}

.machineContext,
.humanAuthorityCard {
  min-width: 0;
  min-height: 398px;

  padding: 20px;

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #123b5c,
      #092941
    );

  box-shadow:
    12px 18px 30px
      rgba(0, 0, 0, 0.2);
}

.machineContext {
  border:
    1px solid rgba(99, 170, 248, 0.2);
}

.humanAuthorityCard {
  border:
    1px solid rgba(201, 153, 67, 0.28);

  animation:
    authorityActivation
    7s
    ease-in-out
    infinite;
}

.machineContext > span {
  color: #69adff;

  font-size: 0.54rem;
  font-weight: 800;
}

.machineContext > strong {
  display: block;

  margin-top: 13px;

  color: #f2f7fc;

  font-size: 1.08rem;
}

.machineContext > div,
.humanAuthorityCard > div:not(.authorityStatus):not(.humanChoicePreview) {
  margin-top: 15px;

  padding: 11px;

  border-radius: 9px;

  background:
    rgba(255, 255, 255, 0.045);
}

.machineContext small,
.humanAuthorityCard small {
  display: block;

  color: #718da6;

  font-size: 0.5rem;
}

.machineContext b,
.humanAuthorityCard b {
  display: block;

  margin-top: 5px;

  color: #c9d7e2;

  font-size: 0.65rem;
  line-height: 1.4;
}

.transferBridge {
  display: grid;

  justify-items: center;

  gap: 11px;
}

.bridgeLine {
  width: 1px;
  height: 65px;

  background:
    linear-gradient(
      to bottom,
      transparent,
      #66adff,
      transparent
    );
}

.governanceDecision {
  width: 118px;

  padding: 13px 10px;

  text-align: center;

  border:
    1px solid rgba(205, 158, 68, 0.34);

  border-radius: 12px;

  background: #15374f;
}

.governanceDecision small {
  display: block;

  color: #c99a46;

  font-size: 0.43rem;
  font-weight: 800;
}

.governanceDecision strong {
  display: block;

  margin-top: 6px;

  color: #efc571;

  font-size: 0.59rem;
  line-height: 1.4;
}

.authorityStatus {
  display: flex;

  justify-content: space-between;
  align-items: center;

  gap: 10px;
}

.authorityStatus span {
  color: #69adff;

  font-size: 0.53rem;
  font-weight: 800;
}

.authorityStatus b {
  margin: 0;

  color: #6dd693;

  font-size: 0.52rem;
}

.authorityName {
  display: block;

  margin-top: 19px;

  color: #f3f8fc;

  font-size: 1.25rem;
}

.humanChoicePreview {
  margin-top: 17px;

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 6px;
}

.humanChoicePreview span {
  grid-column: 1 / -1;

  color: #c99a46;

  font-size: 0.5rem;
  font-weight: 800;
}

.humanChoicePreview b {
  margin: 0;

  padding: 7px;

  border-radius: 6px;

  background:
    rgba(255, 255, 255, 0.045);

  color: #aebfd0;

  font-size: 0.5rem;
}

@keyframes authorityActivation {
  0%,
  68%,
  100% {
    border-color:
      rgba(201, 153, 67, 0.28);

    box-shadow:
      12px 18px 30px
        rgba(0, 0, 0, 0.2);
  }

  76% {
    border-color:
      rgba(232, 178, 79, 0.78);

    box-shadow:
      0 0 13px
        rgba(212, 155, 54, 0.28),
      12px 18px 30px
        rgba(0, 0, 0, 0.2);
  }

  86% {
    border-color:
      rgba(201, 153, 67, 0.34);
  }
}

.heroStatement {
  position: relative;
  z-index: 2;

  margin-top: 20px;

  padding: 17px 20px;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    65px
    minmax(0, 1fr)
    65px
    minmax(0, 1fr);

  gap: 10px;

  align-items: center;

  border:
    1px solid rgba(103, 167, 241, 0.13);

  border-radius: 15px;

  background:
    rgba(255, 255, 255, 0.032);
}

.heroStatement strong {
  color: #b9c9d7;

  font-size: 0.66rem;

  text-align: center;
}

.heroStatement > span {
  width: 100%;
  height: 1px;

  background:
    linear-gradient(
      to right,
      transparent,
      #64abff,
      transparent
    );
}


/* ============================================================
   SHARED EDITORIAL
   ============================================================ */

.editorialGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.3fr)
    minmax(320px, 0.7fr);

  gap: clamp(52px, 6vw, 94px);

  align-items: center;
}

.editorialGrid > * {
  min-width: 0;
}

.darkHeadline,
.lightHeadline {
  width: 100%;
  max-width: 980px;

  margin: 19px 0 0;

  font-size:
    clamp(2.5rem, 3.4vw, 3.8rem);

  line-height: 1.03;

  letter-spacing: -0.048em;

  font-weight: 650;
}

.darkHeadline {
  color: #102e47;
}

.lightHeadline {
  color: #f2f7fd;
}

.darkCopy,
.lightCopy {
  max-width: 490px;
}

.darkCopy p,
.lightCopy p {
  margin: 0;

  font-size: 0.98rem;
  line-height: 1.74;
}

.darkCopy p {
  color: #526b7e;
}

.lightCopy p {
  color: #acbed0;
}

.darkCopy p + p,
.lightCopy p + p {
  margin-top: 13px;
}

.sectionIntro {
  width: 100%;
  max-width: 990px;
}

.sectionIntro h2 {
  width: 100%;
  max-width: 1000px;

  margin: 18px 0 0;

  color: #f2f7fd;

  font-size:
    clamp(2.5rem, 3.45vw, 3.85rem);

  line-height: 1.03;

  letter-spacing: -0.048em;
}

.sectionIntro > p:last-child {
  max-width: 760px;

  margin: 21px 0 0;

  color: #aebfd0;

  font-size: 0.98rem;
  line-height: 1.72;
}

.lightStatement,
.darkStatement {
  margin: 31px 0 0;

  padding: 18px 22px;

  border-left: 3px solid #67afff;

  font-size: 0.94rem;
  line-height: 1.65;
}

.lightStatement {
  color: #445e72;

  background:
    rgba(16, 45, 70, 0.04);
}

.darkStatement {
  color: #bdd0df;

  background:
    rgba(255, 255, 255, 0.035);
}


/* ============================================================
   MEANINGFUL OVERSIGHT
   ============================================================ */

.meaningSection {
  padding: 100px 0;

  background: #eee9dd;
}

.authorityComparison {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 14px;
}

.presenceCard,
.authorityCard {
  min-width: 0;
  min-height: 315px;

  padding: 25px;

  border-radius: 19px;
}

.presenceCard {
  border:
    1px solid rgba(35, 58, 77, 0.09);

  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e5ded3
    );
}

.authorityCard {
  border:
    1px solid rgba(71, 144, 221, 0.24);

  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    );
}

.presenceCard > span,
.authorityCard > span {
  color: #74899b;

  font-size: 0.55rem;
  font-weight: 800;
}

.authorityCard > span {
  color: #69adff;
}

.presenceCard h3,
.authorityCard h3 {
  margin: 20px 0 0;

  font-size: 1.28rem;

  line-height: 1.35;
}

.presenceCard h3 {
  color: #18364d;
}

.authorityCard h3 {
  color: #eef6ff;
}

.presenceCard > div,
.authorityCard > div {
  margin-top: 21px;

  display: grid;

  gap: 7px;
}

.presenceCard p,
.authorityCard p {
  margin: 0;

  padding: 10px;

  border-radius: 8px;

  font-size: 0.68rem;
}

.presenceCard p {
  background:
    rgba(17, 48, 70, 0.04);

  color: #5c7283;
}

.authorityCard p {
  background:
    rgba(255, 255, 255, 0.045);

  color: #b1c2d1;
}


/* ============================================================
   AUTHORITY BOUNDARY
   ============================================================ */

.boundarySection {
  padding: 100px 0;

  background: #071b2e;
}

.boundaryWorkspace {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    190px
    minmax(0, 1fr)
    310px;

  gap: 17px;

  align-items: stretch;
}

.boundaryControls {
  display: grid;

  align-content: start;

  gap: 8px;
}

.boundaryButton,
.boundaryButtonActive {
  min-height: 80px;

  padding: 13px;

  border-radius: 10px;

  text-align: left;

  font: inherit;

  cursor: pointer;
}

.boundaryButton {
  border:
    1px solid rgba(100, 160, 227, 0.12);

  background: #0b2943;

  color: #aebfd0;
}

.boundaryButtonActive {
  border:
    1px solid rgba(105, 176, 255, 0.48);

  background: #164567;

  color: #ffffff;

  box-shadow:
    0 0 16px
      rgba(65, 152, 247, 0.12);
}

.boundaryButton span,
.boundaryButtonActive span {
  display: block;

  font-size: 0.62rem;
  font-weight: 700;
}

.boundaryButton strong,
.boundaryButtonActive strong {
  display: block;

  margin-top: 6px;

  color: #718da6;

  font-size: 0.55rem;
}

.boundaryButtonActive strong {
  color: #83bcff;
}

.authorityGauge {
  min-width: 0;
  min-height: 300px;

  padding: 25px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  border:
    1px solid rgba(100, 160, 227, 0.13);

  border-radius: 18px;

  background: #0b2943;
}

.gaugeHeader span {
  display: block;

  color: #69adff;

  font-size: 0.54rem;
  font-weight: 800;
}

.gaugeHeader strong {
  display: block;

  margin-top: 7px;

  color: #dce8f1;

  font-size: 0.81rem;
}

.gaugeTrack {
  position: relative;

  width: 100%;
  height: 74px;

  margin-top: 40px;

  border-radius: 40px;

  background:
    linear-gradient(
      to right,
      rgba(66, 149, 242, 0.16) 0%,
      rgba(66, 149, 242, 0.16) 62%,
      rgba(193, 142, 49, 0.12) 62%,
      rgba(193, 142, 49, 0.12) 100%
    );
}

.gaugeBoundary {
  position: absolute;

  left: 62%;
  top: -18px;
  bottom: -18px;

  width: 1px;

  background: #d2a047;
}

.gaugeBoundary small {
  position: absolute;

  top: -17px;
  left: 50%;

  width: max-content;

  transform: translateX(-50%);

  color: #d0a04b;

  font-size: 0.43rem;
  font-weight: 800;
}

.gaugePosition {
  position: absolute;

  top: 50%;

  width: 34px;
  height: 34px;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  transition:
    left 380ms ease;
}

.gaugePosition span {
  width: 12px;
  height: 12px;

  position: absolute;

  left: 50%;
  top: 50%;

  transform: translate(-50%, -50%);

  border-radius: 50%;

  background: #69adff;
}

.gaugeRoutine {
  left: 22%;

  background:
    rgba(67, 151, 241, 0.17);
}

.gaugeControlled {
  left: 50%;

  background:
    rgba(67, 151, 241, 0.17);
}

.gaugeHuman {
  left: 80%;

  background:
    rgba(204, 153, 62, 0.17);

  box-shadow:
    0 0 22px
      rgba(205, 155, 62, 0.18);
}

.gaugeHuman span {
  background: #e1ac4e;
}

.gaugeLabels {
  margin-top: 14px;

  display: flex;

  justify-content: space-between;

  gap: 20px;

  color: #8198ac;

  font-size: 0.55rem;
}

.boundaryResult {
  min-width: 0;
  min-height: 300px;

  padding: 22px;

  border-radius: 18px;
}

.boundaryResultNormal {
  border:
    1px solid rgba(100, 160, 227, 0.13);

  background: #0b2943;
}

.boundaryResultHuman {
  border:
    1px solid rgba(205, 158, 68, 0.29);

  background:
    rgba(190, 137, 40, 0.07);
}

.boundaryResult > span {
  color: #718da6;

  font-size: 0.53rem;
  font-weight: 800;
}

.boundaryResultHuman > span {
  color: #c99a46;
}

.boundaryResult > strong {
  display: block;

  margin-top: 14px;

  color: #eef6ff;

  font-size: 1rem;
  line-height: 1.4;
}

.boundaryResultHuman > strong {
  color: #efc571;
}

.boundaryResult dl {
  margin: 17px 0 0;

  display: grid;

  gap: 7px;
}

.boundaryResult dl div {
  padding: 8px 9px;

  border-radius: 7px;

  background:
    rgba(255, 255, 255, 0.04);
}

.boundaryResult dt {
  color: #718da6;

  font-size: 0.49rem;
}

.boundaryResult dd {
  margin: 4px 0 0;

  color: #c2d1dd;

  font-size: 0.63rem;
  font-weight: 700;
}


/* ============================================================
   AUTHORITY RESOLUTION
   ============================================================ */

.resolutionSection {
  padding: 100px 0;

  background: #eee9dd;
}

.resolutionFlow {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 10px;
}

.resolutionFlow article {
  min-width: 0;
  min-height: 220px;

  padding: 20px;

  border:
    1px solid rgba(35, 58, 77, 0.09);

  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.resolutionFlow article > span {
  color: #74899b;

  font-size: 0.52rem;
  font-weight: 800;
}

.resolutionFlow article > strong {
  display: block;

  margin-top: 22px;

  color: #18364d;

  font-size: 0.83rem;
  line-height: 1.48;
}

.resolvedAuthority {
  border:
    1px solid rgba(71, 144, 221, 0.24) !important;

  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    ) !important;
}

.resolvedAuthority > span {
  color: #69adff !important;
}

.resolvedAuthority > strong {
  color: #eef6ff !important;

  font-size: 1.05rem !important;
}

.resolvedAuthority > div {
  margin-top: 16px;

  display: grid;

  gap: 6px;
}

.resolvedAuthority small {
  color: #7893aa;

  font-size: 0.48rem;
  font-weight: 800;
}

.resolvedAuthority b {
  padding: 7px 8px;

  border-radius: 6px;

  background:
    rgba(255, 255, 255, 0.045);

  color: #aebfd0;

  font-size: 0.55rem;
}


/* ============================================================
   ENTERPRISE AUTHORITY
   ============================================================ */

.enterpriseSection {
  padding: 100px 0;

  background: #081f34;
}

.enterpriseSources {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    repeat(5, minmax(0, 1fr));

  gap: 9px;
}

.enterpriseSources article {
  min-width: 0;
  min-height: 245px;

  padding: 18px;

  border:
    1px solid rgba(100, 160, 227, 0.12);

  border-radius: 14px;

  background: #0b2943;
}

.enterpriseSources article > span {
  color: #718da6;

  font-size: 0.52rem;
  font-weight: 800;
}

.enterpriseSources article > div {
  margin-top: 18px;

  display: grid;

  gap: 6px;
}

.enterpriseSources article b {
  padding: 8px;

  border-radius: 7px;

  background:
    rgba(255, 255, 255, 0.04);

  color: #aebfd0;

  font-size: 0.6rem;
  line-height: 1.4;
}

.aigoContext {
  border-color:
    rgba(79, 150, 225, 0.26) !important;

  background:
    linear-gradient(
      145deg,
      #16405f,
      #0d2f49
    ) !important;
}

.aigoContext > span {
  color: #69adff !important;
}

.authorityResolutionTarget {
  max-width: 540px;

  margin: 24px auto 0;

  padding: 20px;

  text-align: center;

  border:
    1px solid rgba(205, 158, 68, 0.27);

  border-radius: 15px;

  background:
    rgba(190, 137, 40, 0.07);
}

.authorityResolutionTarget span {
  display: block;

  color: #c99a46;

  font-size: 0.53rem;
  font-weight: 800;
}

.authorityResolutionTarget strong {
  display: block;

  margin-top: 8px;

  color: #efc571;

  font-size: 1.08rem;
}


/* ============================================================
   DECISION CONTEXT
   ============================================================ */

.contextSection {
  padding: 100px 0;

  background: #eee9dd;
}

.interventionView {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    270px
    minmax(0, 0.9fr);

  gap: 13px;
}

.contextPanel,
.decisionPanel,
.decisionOutcome {
  min-width: 0;
  min-height: 425px;

  padding: 22px;

  border-radius: 18px;
}

.contextPanel,
.decisionPanel {
  border:
    1px solid rgba(35, 58, 77, 0.09);

  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.contextPanel > span {
  color: #74899b;

  font-size: 0.54rem;
  font-weight: 800;
}

.contextPanel dl {
  margin: 18px 0 0;

  display: grid;

  gap: 6px;
}

.contextPanel dl div {
  padding: 8px 9px;

  border-radius: 7px;

  background:
    rgba(20, 48, 70, 0.04);
}

.contextPanel dt {
  color: #74899b;

  font-size: 0.49rem;
}

.contextPanel dd {
  margin: 4px 0 0;

  color: #203e54;

  font-size: 0.63rem;
  font-weight: 700;

  line-height: 1.4;
}

.decisionAuthority > span {
  color: #74899b;

  font-size: 0.53rem;
  font-weight: 800;
}

.decisionAuthority > strong {
  display: block;

  margin-top: 14px;

  color: #18364d;

  font-size: 1.17rem;
}

.decisionAuthority > small {
  display: block;

  margin-top: 5px;

  color: #74899b;

  font-size: 0.58rem;
}

.decisionOptions {
  margin-top: 25px;

  display: grid;

  gap: 8px;
}

.decisionOption,
.decisionOptionActive {
  min-height: 46px;

  padding: 10px 12px;

  border-radius: 8px;

  text-align: left;

  font: inherit;

  font-size: 0.64rem;
  font-weight: 700;

  cursor: pointer;
}

.decisionOption {
  border:
    1px solid rgba(35, 58, 77, 0.09);

  background:
    rgba(20, 48, 70, 0.04);

  color: #526a7d;
}

.decisionOptionActive {
  border:
    1px solid rgba(71, 144, 221, 0.28);

  background: #173e5d;

  color: #eef6ff;

  box-shadow:
    0 8px 18px
      rgba(24, 68, 102, 0.12);
}

.decisionOutcome {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.decisionOutcome > span {
  font-size: 0.53rem;
  font-weight: 800;
}

.decisionOutcome > strong {
  margin-top: 14px;

  font-size: 1.1rem;
  line-height: 1.4;
}

.decisionOutcome > p {
  margin: 14px 0 0;

  font-size: 0.69rem;
  line-height: 1.58;
}

.decisionOutcome > div {
  margin-top: 20px;

  padding: 11px;

  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.28);
}

.decisionOutcome small {
  display: block;

  font-size: 0.47rem;
  font-weight: 800;
}

.decisionOutcome b {
  display: block;

  margin-top: 5px;

  font-size: 0.61rem;
  line-height: 1.45;
}

.outcomeApprove {
  border:
    1px solid rgba(74, 154, 101, 0.23);

  background:
    rgba(74, 154, 101, 0.09);

  color: #3a7650;
}

.outcomeCondition {
  border:
    1px solid rgba(191, 142, 49, 0.25);

  background:
    rgba(191, 142, 49, 0.08);

  color: #856322;
}

.outcomeReject {
  border:
    1px solid rgba(171, 92, 70, 0.23);

  background:
    rgba(171, 92, 70, 0.08);

  color: #8b4d3d;
}

.outcomeInformation {
  border:
    1px solid rgba(73, 140, 209, 0.23);

  background:
    rgba(73, 140, 209, 0.08);

  color: #3f6d98;
}


/* ============================================================
   CONTROLLED HUMAN AUTHORITY
   ============================================================ */

.controlledSection {
  padding: 100px 0;

  background: #071b2e;
}

.humanPassport {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    270px
    minmax(0, 1fr)
    230px;

  gap: 13px;
}

.humanPassport > article {
  min-width: 0;
  min-height: 370px;

  padding: 23px;

  border:
    1px solid rgba(99, 160, 228, 0.13);

  border-radius: 18px;

  background: #0b2943;
}

.humanIdentity {
  display: flex;
  flex-direction: column;
  justify-content: center;

  text-align: center;
}

.humanIdentity > span,
.humanScope > span,
.nextAuthority > span {
  color: #69adff;

  font-size: 0.53rem;
  font-weight: 800;
}

.humanIdentity > strong {
  margin-top: 17px;

  color: #eef6ff;

  font-size: 1.2rem;
}

.humanIdentity > small {
  margin-top: 6px;

  color: #8099ad;

  font-size: 0.6rem;
}

.humanSeal {
  width: 82px;
  height: 82px;

  margin: 27px auto 0;

  display: grid;
  place-items: center;

  border-radius: 50%;

  background:
    radial-gradient(
      circle at 35% 30%,
      #1b587f,
      #09283f 68%
    );
}

.humanSeal span {
  width: 21px;
  height: 21px;

  border-radius: 50%;

  background: #69adff;
}

.humanScope dl {
  margin: 17px 0 0;

  display: grid;

  gap: 7px;
}

.humanScope dl div {
  padding: 10px;

  border-radius: 8px;

  background:
    rgba(255, 255, 255, 0.04);
}

.humanScope dt {
  color: #718da6;

  font-size: 0.51rem;
}

.humanScope dd {
  margin: 4px 0 0;

  color: #c4d2dd;

  font-size: 0.65rem;
  font-weight: 700;

  line-height: 1.4;
}

.nextAuthority {
  display: flex;
  flex-direction: column;
  justify-content: center;

  text-align: center;

  border-color:
    rgba(205, 158, 68, 0.24) !important;

  background:
    rgba(190, 137, 40, 0.07) !important;
}

.nextAuthority > span {
  color: #c99a46;
}

.nextAuthority > strong {
  margin-top: 13px;

  color: #efc571;

  font-size: 1rem;
}


/* ============================================================
   PROPORTIONAL OVERSIGHT
   ============================================================ */

.proportionalSection {
  padding: 100px 0;

  background: #eee9dd;
}

.operatingModes {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 12px;
}

.operatingModes article {
  min-width: 0;
  min-height: 255px;

  padding: 22px;

  border:
    1px solid rgba(35, 58, 77, 0.09);

  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.operatingModes article > span {
  color: #74899b;

  font-size: 0.53rem;
  font-weight: 800;
}

.operatingModes h3 {
  margin: 21px 0 0;

  color: #17364e;

  font-size: 1.16rem;
}

.operatingModes p {
  margin: 11px 0 0;

  color: #5e7384;

  font-size: 0.7rem;
  line-height: 1.58;
}

.operatingModes article > strong {
  display: block;

  margin-top: 18px;

  color: #3e6079;

  font-size: 0.65rem;
}

.humanMode {
  border:
    1px solid rgba(71, 144, 221, 0.24) !important;

  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    ) !important;
}

.humanMode > span {
  color: #69adff !important;
}

.humanMode h3 {
  color: #eef6ff !important;
}

.humanMode p,
.humanMode > strong {
  color: #afc1d0 !important;
}


/* ============================================================
   ESCALATION
   ============================================================ */

.escalationSection {
  padding: 100px 0;

  background: #081f34;
}

.escalationWorkspace {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    170px
    220px
    minmax(0, 1fr)
    240px;

  gap: 12px;
}

.escalationControls {
  display: grid;

  align-content: start;

  gap: 8px;
}

.escalationButton,
.escalationButtonActive {
  min-height: 67px;

  padding: 11px;

  border-radius: 9px;

  font: inherit;

  text-align: left;

  cursor: pointer;
}

.escalationButton {
  border:
    1px solid rgba(100, 160, 227, 0.12);

  background: #0b2943;

  color: #aebfd0;
}

.escalationButtonActive {
  border:
    1px solid rgba(105, 176, 255, 0.46);

  background: #164567;

  color: #ffffff;
}

.escalationButton span,
.escalationButtonActive span {
  font-size: 0.61rem;
  font-weight: 700;
}

.escalationContext,
.escalationResult {
  min-height: 338px;

  padding: 21px;

  border:
    1px solid rgba(100, 160, 227, 0.12);

  border-radius: 16px;

  background: #0b2943;
}

.escalationContext > span,
.escalationResult > span {
  color: #718da6;

  font-size: 0.52rem;
  font-weight: 800;
}

.escalationContext > strong,
.escalationResult > strong {
  display: block;

  margin-top: 20px;

  color: #eef6ff;

  font-size: 1.02rem;

  line-height: 1.4;
}

.escalationContext > p,
.escalationResult > p {
  margin: 12px 0 0;

  color: #9fb2c3;

  font-size: 0.67rem;
  line-height: 1.55;
}

.escalationPath {
  display: grid;

  gap: 7px;
}

.escalationPath article {
  min-width: 0;

  padding: 13px;

  border:
    1px solid rgba(100, 160, 227, 0.1);

  border-radius: 10px;

  background: #0b2943;
}

.escalationPath span {
  display: block;

  color: #718da6;

  font-size: 0.49rem;
  font-weight: 800;
}

.escalationPath strong {
  display: block;

  margin-top: 6px;

  color: #b4c6d4;

  font-size: 0.62rem;
}

.escalationActive {
  border-color:
    rgba(205, 158, 68, 0.47) !important;

  background:
    rgba(190, 137, 40, 0.08) !important;

  box-shadow:
    0 0 15px
      rgba(191, 137, 40, 0.08);
}

.escalationActive span {
  color: #c99a46 !important;
}

.escalationActive strong {
  color: #efc571 !important;
}

.escalationResult {
  border-color:
    rgba(205, 158, 68, 0.24);
}


/* ============================================================
   EVIDENCE
   ============================================================ */

.evidenceSection {
  padding: 100px 0;

  background: #eee9dd;
}

.interventionRecord {
  margin-top: 54px;

  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 9px;
}

.interventionRecord article {
  min-width: 0;
  min-height: 145px;

  padding: 17px;

  border:
    1px solid rgba(35, 58, 77, 0.09);

  border-radius: 12px;

  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.interventionRecord article span {
  color: #74899b;

  font-size: 0.51rem;
  font-weight: 800;
}

.interventionRecord article strong {
  display: block;

  margin-top: 18px;

  color: #203e54;

  font-size: 0.7rem;
  line-height: 1.4;
}

.recordHuman,
.recordDecision {
  border-color:
    rgba(75, 145, 220, 0.22) !important;

  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    ) !important;
}

.recordHuman span,
.recordDecision span {
  color: #69adff !important;
}

.recordHuman strong,
.recordDecision strong {
  color: #eef6ff !important;
}

.receiptRecord {
  border-color:
    rgba(192, 143, 52, 0.25) !important;

  background:
    rgba(192, 143, 52, 0.07) !important;
}

.receiptRecord span {
  color: #a4772a !important;
}

.receiptRecord strong {
  color: #6d4d1e !important;
}


/* ============================================================
   PLATFORM MODEL
   ============================================================ */

.roleSection {
  padding: 100px 0;

  background: #071b2e;
}

.platformRail {
  margin-top: 52px;

  display: grid;

  grid-template-columns:
    repeat(6, minmax(0, 1fr));

  gap: 8px;
}

.platformStage,
.platformStageActive,
.platformStageComplete {
  min-width: 0;
  min-height: 135px;

  padding: 16px;

  border-radius: 13px;
}

.platformStage {
  border:
    1px solid rgba(99, 160, 228, 0.11);

  background: #0b2943;
}

.platformStageComplete {
  border:
    1px solid rgba(78, 154, 101, 0.16);

  background:
    rgba(58, 130, 81, 0.07);
}

.platformStageActive {
  border:
    1px solid rgba(205, 158, 68, 0.31);

  background:
    rgba(190, 137, 40, 0.08);
}

.platformStage span,
.platformStageActive span,
.platformStageComplete span {
  color: #718da6;

  font-size: 0.52rem;
  font-weight: 800;
}

.platformStageComplete span {
  color: #5aba7a;
}

.platformStageActive span {
  color: #c99a46;
}

.platformStage strong,
.platformStageActive strong,
.platformStageComplete strong {
  display: block;

  margin-top: 21px;

  font-size: 0.69rem;
  line-height: 1.4;
}

.platformStage strong,
.platformStageComplete strong {
  color: #d5e1eb;
}

.platformStageActive strong {
  color: #efc571;
}

.platformStage small,
.platformStageActive small,
.platformStageComplete small {
  display: block;

  margin-top: 7px;

  color: #718da6;

  font-size: 0.51rem;
}


/* ============================================================
   FINAL CTA
   ============================================================ */

.finalCta {
  position: relative;
  overflow: hidden;

  padding: 105px 48px;

  background: #051423;
}

.finalGlow {
  position: absolute;

  left: 50%;
  top: -180px;

  width: 720px;
  height: 400px;

  transform: translateX(-50%);

  border-radius: 50%;

  background:
    rgba(47, 124, 255, 0.12);

  filter: blur(80px);
}

.finalInner {
  position: relative;
  z-index: 1;

  max-width: 1050px;

  margin-inline: auto;

  text-align: center;
}

.finalInner h2 {
  margin: 18px 0 0;

  color: #f2f7fd;

  font-size:
    clamp(2.65rem, 4vw, 4.45rem);

  line-height: 1;

  letter-spacing: -0.048em;
}

.finalInner > p {
  max-width: 760px;

  margin: 23px auto 0;

  color: #aebed0;

  font-size: 0.97rem;
  line-height: 1.7;
}

.finalInner .heroActions {
  justify-content: center;
}


/* ============================================================
   TABLET
   ============================================================ */

@media (max-width: 1180px) {
  .shell {
    padding-inline: 36px;
  }

  .heroLayout {
    gap: 55px;
  }

  .heroTitle {
    font-size:
      clamp(2.8rem, 3.8vw, 4rem);
  }

  .authorityTransfer {
    max-width: 570px;

    grid-template-columns:
      minmax(0, 1fr)
      54px
      minmax(0, 1fr);
  }

  .enterpriseSources {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

  .platformRail {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }
}


/* ============================================================
   NARROW DESKTOP
   ============================================================ */

@media (max-width: 980px) {
  .shell {
    padding-inline: 28px;
  }

  .heroLayout,
  .editorialGrid {
    grid-template-columns: 1fr;
  }

  .heroCopy {
    max-width: 760px;
  }

  .authorityTransfer {
    max-width: 650px;

    margin-inline: auto;
  }

  .heroStatement {
    grid-template-columns: 1fr;
  }

  .heroStatement > span {
    display: none;
  }

  .boundaryWorkspace,
  .interventionView,
  .humanPassport,
  .escalationWorkspace {
    grid-template-columns: 1fr;
  }

  .boundaryControls,
  .escalationControls {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

  .resolutionFlow,
  .operatingModes {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .interventionRecord {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}


/* ============================================================
   MOBILE
   ============================================================ */

@media (max-width: 700px) {
  .shell {
    padding-inline: 20px;
  }

  .keepLine {
    display: inline;
    white-space: normal;
  }

  .keepLine + .keepLine::before {
    content: " ";
  }

  .hero {
    padding: 60px 0 72px;
  }

  .heroTitle {
    font-size:
      clamp(2.4rem, 10vw, 3.4rem);
  }

  .darkHeadline,
  .lightHeadline,
  .sectionIntro h2 {
    font-size:
      clamp(2.15rem, 9vw, 3rem);
  }

  .authorityTransfer {
    grid-template-columns: 1fr;

    max-width: 420px;
  }

  .transferLabel {
    grid-column: 1;
  }

  .transferBridge {
    transform: rotate(90deg);

    margin-block: -17px;
  }

  .machineContext,
  .humanAuthorityCard {
    min-height: auto;
  }

  .meaningSection,
  .boundarySection,
  .resolutionSection,
  .enterpriseSection,
  .contextSection,
  .controlledSection,
  .proportionalSection,
  .escalationSection,
  .evidenceSection,
  .roleSection {
    padding: 74px 0;
  }

  .authorityComparison,
  .boundaryControls,
  .resolutionFlow,
  .enterpriseSources,
  .operatingModes,
  .escalationControls,
  .interventionRecord,
  .platformRail {
    grid-template-columns: 1fr;
  }

  .heroActions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .heroActions a {
    width: 100%;
  }

  .finalCta {
    padding: 80px 20px;
  }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .humanAuthorityCard {
    animation: none !important;
  }

  .gaugePosition,
  .primaryButton,
  .secondaryButton,
  .darkSecondaryButton {
    transition: none !important;
  }
}

/* ============================================================
   PAGE 07 HERO FINAL CORRECTION
   Fixes:
   - headline collision
   - headline clipping
   - oversized cards
   - squeezed center governance decision
   - weak visual balance
   ============================================================ */

.hero {
  padding-top: 70px !important;
  padding-bottom: 82px !important;
}

.heroLayout {
  min-height: 560px !important;

  grid-template-columns:
    minmax(0, 1.08fr)
    minmax(0, 0.92fr) !important;

  gap: clamp(76px, 6vw, 100px) !important;

  align-items: center !important;
}

.heroCopy {
  width: 100% !important;
  max-width: 720px !important;

  min-width: 0 !important;

  position: relative !important;
  z-index: 5 !important;
}

.heroTitle {
  width: 100% !important;
  max-width: 720px !important;

  margin-top: 18px !important;

  font-size:
    clamp(2.85rem, 3.45vw, 4rem) !important;

  line-height: 1.02 !important;
  letter-spacing: -0.05em !important;

  overflow: visible !important;
}

.heroTitle .keepLine {
  display: block !important;
  white-space: nowrap !important;
}

.heroLead,
.heroSupporting {
  max-width: 650px !important;
}


/* Right-side visual */

.authorityTransfer {
  width: 100% !important;
  max-width: 540px !important;

  margin-left: auto !important;

  grid-template-columns:
    minmax(0, 1fr)
    92px
    minmax(0, 1fr) !important;

  column-gap: 14px !important;
  row-gap: 10px !important;

  align-items: center !important;

  position: relative !important;
  z-index: 3 !important;
}

.transferLabel {
  margin-bottom: 3px !important;
}

.transferLabel span {
  font-size: 0.5rem !important;
}

.transferLabel strong {
  font-size: 0.61rem !important;
}


/* Smaller supporting cards */

.machineContext,
.humanAuthorityCard {
  min-height: 318px !important;

  padding: 17px !important;

  border-radius: 16px !important;
}

.machineContext > strong,
.authorityName {
  font-size: 1rem !important;
  line-height: 1.3 !important;
}

.machineContext > div,
.humanAuthorityCard > div:not(.authorityStatus):not(.humanChoicePreview) {
  margin-top: 10px !important;

  padding: 9px !important;
}

.machineContext small,
.humanAuthorityCard small {
  font-size: 0.46rem !important;
}

.machineContext b,
.humanAuthorityCard b {
  font-size: 0.57rem !important;
  line-height: 1.32 !important;
}


/* Compact decision choices */

.humanChoicePreview {
  margin-top: 12px !important;

  gap: 5px !important;
}

.humanChoicePreview span {
  font-size: 0.46rem !important;
}

.humanChoicePreview b {
  padding: 6px !important;

  font-size: 0.45rem !important;
}


/* Center transfer */

.transferBridge {
  width: 92px !important;

  display: grid !important;
  justify-items: center !important;

  gap: 8px !important;
}

.bridgeLine {
  height: 42px !important;
}

.governanceDecision {
  width: 92px !important;

  padding: 11px 7px !important;

  border-radius: 10px !important;

  position: relative !important;
  z-index: 8 !important;

  box-shadow:
    0 0 18px
      rgba(205, 158, 68, 0.12) !important;

  animation:
    page07DecisionPulse
    6s
    ease-in-out
    infinite !important;
}

.governanceDecision small {
  font-size: 0.37rem !important;
}

.governanceDecision strong {
  margin-top: 5px !important;

  font-size: 0.5rem !important;
  line-height: 1.33 !important;
}


/* Sequential transfer motion */

.machineContext {
  animation:
    page07ActorGlow
    6s
    ease-in-out
    infinite !important;
}

.humanAuthorityCard {
  animation:
    page07HumanGlow
    6s
    ease-in-out
    infinite !important;
}

@keyframes page07ActorGlow {
  0%,
  100% {
    border-color:
      rgba(99, 170, 248, 0.2);

    box-shadow:
      12px 18px 30px
        rgba(0, 0, 0, 0.2);
  }

  10% {
    border-color:
      rgba(106, 182, 255, 0.9);

    box-shadow:
      0 0 11px
        rgba(65, 156, 255, 0.34),
      12px 18px 30px
        rgba(0, 0, 0, 0.2);
  }

  22% {
    border-color:
      rgba(99, 170, 248, 0.22);
  }
}

@keyframes page07DecisionPulse {
  0%,
  26%,
  100% {
    border-color:
      rgba(205, 158, 68, 0.34);

    box-shadow:
      0 0 10px
        rgba(205, 158, 68, 0.08);
  }

  42% {
    border-color:
      rgba(237, 182, 78, 0.95);

    box-shadow:
      0 0 8px
        rgba(232, 176, 71, 0.46),
      0 0 23px
        rgba(210, 150, 46, 0.18);
  }

  54% {
    border-color:
      rgba(205, 158, 68, 0.38);
  }
}

@keyframes page07HumanGlow {
  0%,
  52%,
  100% {
    border-color:
      rgba(201, 153, 67, 0.28);

    box-shadow:
      12px 18px 30px
        rgba(0, 0, 0, 0.2);
  }

  68% {
    border-color:
      rgba(105, 187, 255, 0.9);

    box-shadow:
      0 0 11px
        rgba(65, 156, 255, 0.34),
      12px 18px 30px
        rgba(0, 0, 0, 0.2);
  }

  82% {
    border-color:
      rgba(201, 153, 67, 0.3);
  }
}


/* Stack before collision becomes possible */

@media (max-width: 1040px) {
  .heroLayout {
    grid-template-columns: 1fr !important;

    gap: 46px !important;
  }

  .heroCopy,
  .heroTitle {
    max-width: 760px !important;
  }

  .authorityTransfer {
    max-width: 610px !important;

    margin-inline: auto !important;
  }
}

@media (max-width: 700px) {
  .heroTitle .keepLine {
    display: inline !important;
    white-space: normal !important;
  }

  .heroTitle .keepLine + .keepLine::before {
    content: " ";
  }

  .authorityTransfer {
    grid-template-columns: 1fr !important;

    max-width: 410px !important;
  }

  .transferLabel {
    grid-column: 1 !important;
  }

  .transferBridge {
    width: auto !important;

    transform: rotate(90deg) !important;

    margin-block: -10px !important;
  }

  .machineContext,
  .humanAuthorityCard {
    min-height: auto !important;
  }
}


/* Reduced motion */

@media (prefers-reduced-motion: reduce) {
  .machineContext,
  .governanceDecision,
  .humanAuthorityCard {
    animation: none !important;
  }
}

