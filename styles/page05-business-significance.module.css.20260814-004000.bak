.page {
  width: 100%;
  max-width: 100%;
  min-width: 0;
  overflow-x: clip;
}

.page,
.page *,
.page *::before,
.page *::after {
  box-sizing: border-box;
}


/* ============================================================
   CANONICAL EQUAL-GUTTER SHELL
   ============================================================ */

.shell {
  width: 100%;
  max-width: 1440px;
  margin-inline: auto;
  padding-inline: 48px;
}


/* ============================================================
   SHARED
   ============================================================ */

.blueEyebrow,
.goldEyebrow {
  margin: 0;
  font-size: 0.7rem;
  line-height: 1.4;
  font-weight: 800;
  letter-spacing: 0.13em;
  text-transform: uppercase;
}

.blueEyebrow {
  color: #69adff;
}

.goldEyebrow {
  color: #c7953f;
}

.keepLine {
  display: block;
  white-space: nowrap;
}

.primaryButton,
.secondaryButton,
.darkSecondaryButton {
  min-height: 48px;
  padding: 0 21px;
  display: inline-flex;
  align-items: center;
  justify-content: center;
  border-radius: 10px;
  font-size: 0.91rem;
  font-weight: 720;
  text-decoration: none;
  transition:
    transform 180ms ease,
    border-color 180ms ease,
    background 180ms ease;
}

.primaryButton {
  border: 1px solid #5b9cff;
  background: #2f7cff;
  color: #ffffff;
  box-shadow:
    0 14px 34px rgba(47, 124, 255, 0.22);
}

.secondaryButton {
  border:
    1px solid rgba(131, 177, 233, 0.24);
  background:
    rgba(255, 255, 255, 0.05);
  color: #eef6ff;
}

.darkSecondaryButton {
  border:
    1px solid rgba(23, 53, 77, 0.15);
  background: #f7f3eb;
  color: #15334a;
  box-shadow:
    7px 10px 20px rgba(72, 59, 37, 0.06),
    inset 1px 1px 0
      rgba(255, 255, 255, 0.78);
}

.primaryButton:hover,
.secondaryButton:hover,
.darkSecondaryButton:hover {
  transform: translateY(-2px);
}

.heroActions {
  margin-top: 28px;
  display: flex;
  flex-wrap: wrap;
  gap: 12px;
}

.sectionAction {
  margin-top: 28px;
}


/* ============================================================
   HERO
   ============================================================ */

.hero {
  position: relative;
  overflow: hidden;
  padding: 78px 0 92px;
  background:
    radial-gradient(
      circle at 79% 18%,
      rgba(47, 124, 255, 0.15),
      transparent 34%
    ),
    #061727;
  color: #f4f8fd;
}

.heroGrid {
  position: absolute;
  inset: 0;
  opacity: 0.3;
  pointer-events: none;
  background:
    linear-gradient(
      rgba(255, 255, 255, 0.017) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(255, 255, 255, 0.017) 1px,
      transparent 1px
    );
  background-size: 54px 54px;
}

.heroGlow {
  position: absolute;
  right: 3%;
  top: 2%;
  width: 620px;
  height: 620px;
  border-radius: 50%;
  background:
    rgba(48, 124, 255, 0.07);
  filter: blur(90px);
}

.heroLayout {
  position: relative;
  z-index: 1;
  min-height: 650px;
  display: grid;
  grid-template-columns:
    minmax(0, 0.92fr)
    minmax(0, 1.08fr);
  gap: clamp(66px, 7vw, 104px);
  align-items: center;
}

.heroLayout > * {
  min-width: 0;
}

.heroCopy {
  width: 100%;
  max-width: 640px;
}

.heroTitle {
  margin: 20px 0 0;
  width: 100%;
  max-width: 690px;
  font-size:
    clamp(3.05rem, 4vw, 4.55rem);
  line-height: 1;
  letter-spacing: -0.052em;
  font-weight: 660;
}

.heroTitle span + span {
  margin-top: 7px;
}

.heroLead {
  margin: 28px 0 0;
  color: #eef5ff;
  font-size: 1.08rem;
  line-height: 1.68;
}

.heroSupporting {
  margin: 12px 0 0;
  color: #aebed0;
  font-size: 0.95rem;
  line-height: 1.72;
}


/* ============================================================
   HERO MEANING VISUAL
   ============================================================ */

.heroMeaningVisual {
  position: relative;
  width: 100%;
  max-width: 610px;
  min-height: 570px;
  margin-left: auto;
  overflow: hidden;
}

.visualLabel {
  position: absolute;
  top: 0;
  left: 50%;
  z-index: 10;
  width: max-content;
  max-width: 90%;
  transform: translateX(-50%);
  text-align: center;
}

.visualLabel span {
  display: block;
  color: #68afff;
  font-size: 0.55rem;
  font-weight: 800;
  letter-spacing: 0.1em;
}

.visualLabel strong {
  display: block;
  margin-top: 5px;
  color: #8fa8bd;
  font-size: 0.67rem;
}

.eventCore {
  position: absolute;
  z-index: 5;
  left: 50%;
  top: 43%;
  width: 215px;
  padding: 18px;
  transform: translate(-50%, -50%);
  border:
    1px solid rgba(104, 171, 247, 0.25);
  border-radius: 19px;
  background:
    linear-gradient(
      145deg,
      #123d5e,
      #0a2a46
    );
  box-shadow:
    12px 17px 31px rgba(0, 0, 0, 0.23),
    inset 1px 1px 0
      rgba(255, 255, 255, 0.06);
}

.eventCore > span {
  color: #67afff;
  font-size: 0.51rem;
  font-weight: 800;
}

.eventCore > strong {
  display: block;
  margin-top: 10px;
  color: #eef6ff;
  font-size: 0.88rem;
  line-height: 1.35;
}

.eventCore > div {
  margin-top: 7px;
  padding: 7px 8px;
  border-radius: 7px;
  background:
    rgba(255, 255, 255, 0.045);
}

.eventCore small {
  display: block;
  color: #718ea7;
  font-size: 0.48rem;
}

.eventCore b {
  display: block;
  margin-top: 3px;
  color: #d9e5f0;
  font-size: 0.58rem;
  overflow-wrap: anywhere;
}

.resolvedContext {
  position: absolute;
  inset: 0;
  pointer-events: none;
}

.resolvedContext article {
  position: absolute;
  z-index: 4;
  width: 160px;
  padding: 10px 11px;
  border:
    1px solid rgba(103, 170, 247, 0.15);
  border-radius: 10px;
  background:
    linear-gradient(
      145deg,
      #0f304e,
      #09243c
    );
  box-shadow:
    7px 10px 17px rgba(0, 0, 0, 0.17);
  animation:
    contextMeaningGlow
    12s
    ease-in-out
    infinite;
}

.resolvedContext article span {
  display: block;
  color: #68afff;
  font-size: 0.47rem;
  font-weight: 800;
}

.resolvedContext article strong {
  display: block;
  margin-top: 4px;
  color: #b6c8d7;
  font-size: 0.56rem;
  line-height: 1.35;
}

.contextActor {
  left: 9px;
  top: 93px;
  animation-delay: 0s !important;
}

.contextAuthority {
  right: 5px;
  top: 107px;
  animation-delay: 1.1s !important;
}

.contextSupplier {
  left: 0;
  top: 252px;
  animation-delay: 2.2s !important;
}

.contextVerification {
  right: 0;
  top: 268px;
  animation-delay: 3.3s !important;
}

.contextProcess {
  left: 27px;
  bottom: 117px;
  animation-delay: 4.4s !important;
}

.contextPolicy {
  right: 12px;
  bottom: 105px;
  animation-delay: 5.5s !important;
}

.contextConsequence {
  left: 50%;
  bottom: 67px;
  width: 190px !important;
  transform: translateX(-50%);
  animation-delay: 6.6s !important;
}

@keyframes contextMeaningGlow {
  0%,
  100% {
    border-color:
      rgba(103, 170, 247, 0.14);
    box-shadow:
      7px 10px 17px
        rgba(0, 0, 0, 0.17);
  }

  5%,
  10% {
    border-color:
      rgba(103, 176, 255, 0.58);
    box-shadow:
      0 0 16px
        rgba(83, 165, 255, 0.2),
      7px 10px 17px
        rgba(0, 0, 0, 0.17);
  }
}

.significanceObject {
  position: absolute;
  z-index: 7;
  left: 50%;
  bottom: 12px;
  width: 250px;
  padding: 15px;
  transform: translateX(-50%);
  text-align: center;
  border:
    1px solid rgba(214, 163, 65, 0.35);
  border-radius: 15px;
  background:
    linear-gradient(
      145deg,
      #18384f,
      #0c283f
    );
  box-shadow:
    0 0 22px
      rgba(197, 145, 45, 0.1),
    10px 14px 25px rgba(0, 0, 0, 0.19);
}

.significanceObject span {
  display: block;
  color: #d1a04b;
  font-size: 0.52rem;
  font-weight: 800;
}

.significanceObject strong {
  display: block;
  margin-top: 7px;
  color: #f0c36f;
  font-size: 1.38rem;
}

.significanceObject small {
  display: block;
  margin-top: 5px;
  color: #879fb3;
  font-size: 0.52rem;
}

.governanceNext {
  position: absolute;
  z-index: 2;
  right: 2px;
  bottom: 8px;
  width: 150px;
  padding: 9px;
  opacity: 0.5;
  border:
    1px solid rgba(114, 157, 197, 0.1);
  border-radius: 8px;
  background: rgba(255, 255, 255, 0.025);
}

.governanceNext span {
  display: block;
  color: #6e879d;
  font-size: 0.44rem;
  font-weight: 800;
}

.governanceNext strong {
  display: block;
  margin-top: 3px;
  color: #859bad;
  font-size: 0.5rem;
}

.heroStatement {
  position: relative;
  z-index: 2;
  margin-top: 23px;
  padding: 17px 19px;
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    70px
    minmax(0, 1fr)
    70px
    minmax(0, 1fr);
  gap: 11px;
  align-items: center;
  border:
    1px solid rgba(103, 167, 241, 0.13);
  border-radius: 16px;
  background:
    rgba(255, 255, 255, 0.032);
}

.heroStatement > div:not(.statementPath) span {
  display: block;
  color: #68afff;
  font-size: 0.5rem;
  font-weight: 800;
}

.heroStatement > div:not(.statementPath) strong {
  display: block;
  margin-top: 4px;
  color: #b7c8d7;
  font-size: 0.67rem;
}

.statementPath span {
  width: 100%;
  height: 1px;
  display: block;
  background:
    linear-gradient(
      to right,
      transparent,
      #62aaff,
      transparent
    );
}


/* ============================================================
   SHARED EDITORIAL
   ============================================================ */

.editorialGrid {
  display: grid;
  grid-template-columns:
    minmax(0, 1.3fr)
    minmax(320px, 0.7fr);
  gap: clamp(52px, 6vw, 94px);
  align-items: center;
}

.editorialGrid > * {
  min-width: 0;
}

.darkHeadline,
.lightHeadline,
.darkGovernanceTitle {
  margin: 19px 0 0;
  width: 100%;
  max-width: 970px;
  font-size:
    clamp(2.5rem, 3.4vw, 3.8rem);
  line-height: 1.03;
  letter-spacing: -0.048em;
  font-weight: 650;
}

.darkHeadline,
.darkGovernanceTitle {
  color: #102e47;
}

.lightHeadline {
  color: #f2f7fd;
}

.darkCopy,
.lightCopy {
  max-width: 490px;
}

.darkCopy p,
.lightCopy p {
  margin: 0;
  font-size: 0.98rem;
  line-height: 1.74;
}

.darkCopy p {
  color: #526b7e;
}

.lightCopy p {
  color: #acbed0;
}

.darkCopy p + p,
.lightCopy p + p {
  margin-top: 13px;
}

.sectionIntro {
  width: 100%;
  max-width: 990px;
}

.sectionIntro h2 {
  margin: 18px 0 0;
  width: 100%;
  max-width: 970px;
  color: #f2f7fd;
  font-size:
    clamp(2.5rem, 3.45vw, 3.85rem);
  line-height: 1.03;
  letter-spacing: -0.048em;
}

.sectionIntro > p:last-child {
  max-width: 760px;
  margin: 21px 0 0;
  color: #aebfd0;
  font-size: 0.98rem;
  line-height: 1.72;
}

.lightStatement,
.darkRuntimeStatement {
  margin: 32px 0 0;
  padding: 19px 22px;
  border-left: 3px solid #67afff;
  font-size: 0.94rem;
  line-height: 1.68;
}

.lightStatement {
  color: #435e73;
  background:
    rgba(16, 45, 70, 0.04);
}

.darkRuntimeStatement {
  color: #bed0de;
  background:
    rgba(255, 255, 255, 0.035);
}


/* ============================================================
   SAME EVENT, DIFFERENT MEANING
   ============================================================ */

.meaningSection {
  padding: 100px 0;
  background: #eee9dd;
}

.scenarioWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    190px
    minmax(0, 0.78fr)
    minmax(0, 1.08fr)
    minmax(0, 0.86fr);
  gap: 12px;
  align-items: stretch;
}

.scenarioWorkspace > * {
  min-width: 0;
}

.scenarioButtons {
  display: grid;
  align-content: start;
  gap: 8px;
}

.scenarioButton,
.scenarioButtonActive {
  min-height: 77px;
  padding: 13px;
  border-radius: 11px;
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.scenarioButton {
  border:
    1px solid rgba(31, 58, 79, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e5ded3
    );
  color: #355169;
}

.scenarioButtonActive {
  border:
    1px solid rgba(81, 153, 233, 0.28);
  background: #153d5e;
  color: #eef6ff;
  transform: translateY(-2px);
  box-shadow:
    7px 10px 18px rgba(47, 58, 68, 0.16);
}

.scenarioButton span,
.scenarioButtonActive span {
  display: block;
  color: #74899b;
  font-size: 0.53rem;
  font-weight: 800;
}

.scenarioButtonActive span {
  color: #76b7ff;
}

.scenarioButton strong,
.scenarioButtonActive strong {
  display: block;
  margin-top: 6px;
  font-size: 0.73rem;
}

.constantAction,
.scenarioContext,
.scenarioSignificance {
  min-height: 355px;
  padding: 22px;
  border-radius: 18px;
}

.constantAction,
.scenarioContext {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ddd1
    );
}

.constantAction > span,
.scenarioContext > span,
.scenarioSignificance > span {
  color: #74899b;
  font-size: 0.55rem;
  font-weight: 800;
}

.constantAction > strong {
  display: block;
  margin-top: 19px;
  color: #17364e;
  font-size: 1.13rem;
}

.constantAction > small {
  display: block;
  margin-top: 12px;
  color: #607587;
  font-size: 0.69rem;
  line-height: 1.55;
}

.scenarioContext dl {
  margin: 18px 0 0;
  display: grid;
  gap: 6px;
}

.scenarioContext dl div {
  padding: 8px 9px;
  border-radius: 8px;
  background:
    rgba(20, 48, 70, 0.04);
}

.scenarioContext dt {
  color: #74899b;
  font-size: 0.53rem;
}

.scenarioContext dd {
  margin: 3px 0 0;
  color: #213e54;
  font-size: 0.67rem;
  font-weight: 700;
}

.scenarioSignificance {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.scenarioSignificance > strong {
  margin-top: 16px;
  font-size: 1.3rem;
}

.scenarioSignificance p {
  margin: 13px 0 0;
  font-size: 0.72rem;
  line-height: 1.6;
}

.significanceRoutine {
  border:
    1px solid rgba(78, 156, 104, 0.22);
  background:
    rgba(77, 156, 103, 0.09);
}

.significanceRoutine > strong {
  color: #397c50;
}

.significanceRoutine p {
  color: #506c5b;
}

.significanceConsequential {
  border:
    1px solid rgba(192, 143, 52, 0.27);
  background:
    rgba(193, 143, 49, 0.08);
}

.significanceConsequential > strong {
  color: #9d7028;
}

.significanceConsequential p {
  color: #776548;
}

.significanceHigh {
  border:
    1px solid rgba(176, 102, 79, 0.22);
  background:
    rgba(165, 86, 66, 0.075);
}

.significanceHigh > strong {
  color: #984e3c;
}

.significanceHigh p {
  color: #78574f;
}


/* ============================================================
   MODEL
   ============================================================ */

.modelSection {
  padding: 100px 0;
  background: #071b2e;
}

.dimensionGrid {
  margin-top: 54px;
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 13px;
}

.dimensionCard {
  min-width: 0;
  min-height: 255px;
  padding: 21px;
  border:
    1px solid rgba(101, 162, 231, 0.14);
  border-radius: 18px;
  background:
    linear-gradient(
      145deg,
      #0d2c47,
      #071f34
    );
  box-shadow:
    8px 11px 22px rgba(0, 0, 0, 0.16),
    inset 1px 1px 0
      rgba(255, 255, 255, 0.04);
}

.dimensionTop {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.dimensionTop > span {
  color: #718ca5;
  font-size: 0.56rem;
  font-weight: 800;
}

.dimensionTop > div {
  width: 36px;
  height: 36px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background:
    radial-gradient(
      circle at 35% 30%,
      #20557e,
      #09283f 68%
    );
}

.dimensionTop > div span {
  width: 9px;
  height: 9px;
  border-radius: 50%;
  background: #67afff;
}

.dimensionCard h3 {
  margin: 18px 0 0;
  color: #eef6ff;
  font-size: 1.17rem;
}

.dimensionCard p {
  margin: 9px 0 0;
  color: #879fb5;
  font-size: 0.71rem;
  line-height: 1.53;
}

.dimensionItems {
  margin-top: 15px;
  display: flex;
  flex-wrap: wrap;
  gap: 6px;
}

.dimensionItems span {
  padding: 6px 8px;
  border-radius: 7px;
  background:
    rgba(255, 255, 255, 0.045);
  color: #96aabd;
  font-size: 0.59rem;
}


/* ============================================================
   INTEGRATION
   ============================================================ */

.integrationSection {
  padding: 100px 0;
  background: #eee9dd;
}

.sourceGrid {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 10px;
}

.sourceGrid article {
  min-width: 0;
  min-height: 165px;
  padding: 17px;
  border:
    1px solid rgba(35, 58, 77, 0.09);
  border-radius: 13px;
  background:
    linear-gradient(
      145deg,
      #fbf9f4,
      #e4ded2
    );
  box-shadow:
    6px 8px 15px rgba(68, 57, 38, 0.055);
}

.sourceGrid article > span {
  color: #71879a;
  font-size: 0.53rem;
  font-weight: 800;
}

.sourceGrid strong {
  display: block;
  margin-top: 10px;
  color: #17364e;
  font-size: 0.82rem;
}

.sourceGrid p {
  margin: 8px 0 0;
  color: #5a7183;
  font-size: 0.68rem;
  line-height: 1.55;
}

.integrationMeaning {
  margin-top: 26px;
  display: grid;
  grid-template-columns:
    minmax(80px, 0.22fr)
    minmax(0, 0.78fr);
  gap: 20px;
  align-items: center;
}

.integrationPath span {
  width: 100%;
  height: 2px;
  display: block;
  background:
    linear-gradient(
      to right,
      transparent,
      #5da8ff
    );
}

.integrationMeaning article {
  padding: 22px;
  border:
    1px solid rgba(72, 143, 221, 0.19);
  border-radius: 16px;
  background: #103653;
  box-shadow:
    10px 14px 25px rgba(40, 52, 62, 0.17);
}

.integrationMeaning article span {
  color: #68afff;
  font-size: 0.56rem;
  font-weight: 800;
}

.integrationMeaning article strong {
  display: block;
  margin-top: 8px;
  color: #eef6ff;
  font-size: 0.92rem;
  line-height: 1.48;
}


/* ============================================================
   CORRELATION
   ============================================================ */

.correlationSection {
  padding: 100px 0;
  background: #081f34;
}

.correlationWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    minmax(0, 1.25fr)
    minmax(320px, 0.75fr);
  gap: 25px;
  align-items: center;
}

.correlationWorkspace > * {
  min-width: 0;
}

.correlationObjects {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.correlationObject,
.correlationObjectActive {
  min-width: 0;
  min-height: 105px;
  padding: 14px;
  border-radius: 11px;
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.correlationObject {
  border:
    1px solid rgba(99, 160, 228, 0.11);
  background: #0b2943;
}

.correlationObjectActive {
  border:
    1px solid rgba(103, 176, 255, 0.35);
  background: #143b5d;
  box-shadow:
    6px 9px 17px rgba(0, 0, 0, 0.17);
  transform: translateY(-2px);
}

.correlationObject span,
.correlationObjectActive span {
  display: block;
  color: #718da6;
  font-size: 0.51rem;
  font-weight: 800;
}

.correlationObjectActive span {
  color: #68afff;
}

.correlationObject strong,
.correlationObjectActive strong {
  display: block;
  margin-top: 6px;
  color: #dbe7f1;
  font-size: 0.69rem;
}

.correlationObject small,
.correlationObjectActive small {
  display: block;
  margin-top: 6px;
  color: #718da6;
  font-size: 0.53rem;
}

.correlationCore {
  display: grid;
  gap: 14px;
}

.significanceCoreDeveloping,
.significanceCoreElevated,
.significanceCoreHigh {
  min-height: 270px;
  padding: 29px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border-radius: 22px;
  text-align: center;
}

.significanceCoreDeveloping {
  border:
    1px solid rgba(94, 163, 241, 0.22);
  background: #103653;
}

.significanceCoreElevated {
  border:
    1px solid rgba(205, 159, 72, 0.28);
  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(205, 159, 72, 0.1),
      transparent 38%
    ),
    #12344d;
}

.significanceCoreHigh {
  border:
    1px solid rgba(205, 128, 91, 0.3);
  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(199, 99, 74, 0.11),
      transparent 38%
    ),
    #15364e;
  box-shadow:
    0 0 24px rgba(182, 93, 67, 0.08);
}

.significanceCoreDeveloping span,
.significanceCoreElevated span,
.significanceCoreHigh span {
  color: #7893aa;
  font-size: 0.56rem;
  font-weight: 800;
}

.significanceCoreDeveloping strong,
.significanceCoreElevated strong,
.significanceCoreHigh strong {
  display: block;
  margin-top: 14px;
  font-size: 1.72rem;
}

.significanceCoreDeveloping strong {
  color: #6db5ff;
}

.significanceCoreElevated strong {
  color: #e2b358;
}

.significanceCoreHigh strong {
  color: #edaa8f;
}

.significanceCoreDeveloping small,
.significanceCoreElevated small,
.significanceCoreHigh small {
  margin-top: 10px;
  color: #8da5b8;
  font-size: 0.61rem;
  line-height: 1.5;
}

.contextReasons {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 6px;
}

.contextReasons span {
  padding: 7px 9px;
  border-radius: 7px;
  background:
    rgba(255, 255, 255, 0.045);
  color: #9db1c3;
  font-size: 0.59rem;
}


/* ============================================================
   GOVERNANCE RELEVANCE
   ============================================================ */

.relevanceSection {
  padding: 100px 0;
  background: #eee9dd;
}

.relevanceFlow {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    140px
    minmax(0, 1fr)
    minmax(0, 0.72fr);
  gap: 17px;
  align-items: center;
}

.relevanceFlow > * {
  min-width: 0;
}

.operationalSignals,
.governanceSignals {
  min-height: 310px;
  padding: 22px;
  border-radius: 17px;
}

.operationalSignals {
  border:
    1px solid rgba(35, 58, 77, 0.09);
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e5ded3
    );
}

.governanceSignals {
  border:
    1px solid rgba(76, 145, 220, 0.2);
  background:
    linear-gradient(
      145deg,
      #173e5d,
      #0c2d48
    );
}

.operationalSignals > span,
.governanceSignals > span {
  color: #74899b;
  font-size: 0.54rem;
  font-weight: 800;
}

.governanceSignals > span {
  color: #68afff;
}

.operationalSignals > div,
.governanceSignals > div {
  margin-top: 19px;
  display: grid;
  gap: 8px;
}

.operationalSignals > div span,
.governanceSignals > div span {
  padding: 10px;
  border-radius: 8px;
  font-size: 0.68rem;
}

.operationalSignals > div span {
  background:
    rgba(20, 48, 70, 0.04);
  color: #556d80;
}

.governanceSignals > div span {
  background:
    rgba(255, 255, 255, 0.045);
  color: #b4c5d3;
}

.relevanceFilter {
  text-align: center;
}

.relevanceFilter > div {
  width: 65px;
  height: 65px;
  margin: 0 auto 11px;
  display: grid;
  place-items: center;
  border-radius: 50%;
  background:
    radial-gradient(
      circle at 35% 30%,
      #235a83,
      #0d304b 67%
    );
}

.relevanceFilter > div span {
  width: 17px;
  height: 17px;
  border-radius: 50%;
  background: #67afff;
}

.relevanceFilter strong {
  color: #71869a;
  font-size: 0.62rem;
}

.relevanceResult {
  min-height: 180px;
  padding: 21px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border:
    1px solid rgba(201, 153, 62, 0.25);
  border-radius: 16px;
  background:
    rgba(188, 138, 46, 0.07);
}

.relevanceResult span {
  color: #a77b30;
  font-size: 0.53rem;
  font-weight: 800;
}

.relevanceResult strong {
  margin-top: 11px;
  color: #77541e;
  font-size: 0.96rem;
}


/* ============================================================
   DYNAMIC SIGNIFICANCE
   ============================================================ */

.dynamicSection {
  padding: 100px 0;
  background: #071b2e;
}

.refundWorkspace {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    180px
    minmax(0, 0.85fr)
    minmax(0, 1fr)
    minmax(0, 0.72fr);
  gap: 12px;
}

.refundWorkspace > * {
  min-width: 0;
}

.refundControls {
  display: grid;
  align-content: start;
  gap: 8px;
}

.refundButton,
.refundButtonActive {
  min-height: 75px;
  padding: 12px;
  border-radius: 10px;
  text-align: left;
  font: inherit;
  cursor: pointer;
}

.refundButton {
  border:
    1px solid rgba(100, 160, 227, 0.12);
  background: #0b2943;
  color: #9db2c5;
}

.refundButtonActive {
  border:
    1px solid rgba(103, 176, 255, 0.34);
  background: #153b5d;
  color: #eef6ff;
  transform: translateY(-2px);
}

.refundButton span,
.refundButtonActive span {
  display: block;
  color: #718ca5;
  font-size: 0.52rem;
  font-weight: 800;
}

.refundButton strong,
.refundButtonActive strong {
  display: block;
  margin-top: 6px;
  font-size: 0.72rem;
}

.refundConstant,
.refundContext,
.refundResult {
  min-height: 315px;
  padding: 22px;
  border-radius: 17px;
}

.refundConstant,
.refundContext {
  border:
    1px solid rgba(100, 160, 227, 0.13);
  background: #0c2a45;
}

.refundConstant > span,
.refundContext > span,
.refundResult > span {
  color: #718ea8;
  font-size: 0.55rem;
  font-weight: 800;
}

.refundConstant > strong {
  display: block;
  margin-top: 18px;
  color: #eef6ff;
  font-size: 1.1rem;
}

.refundConstant > small {
  display: block;
  margin-top: 10px;
  color: #91a8bd;
  font-size: 0.67rem;
}

.refundContext dl {
  margin: 18px 0 0;
  display: grid;
  gap: 7px;
}

.refundContext dl div {
  padding: 9px 10px;
  border-radius: 8px;
  background:
    rgba(255, 255, 255, 0.04);
}

.refundContext dt {
  color: #718da6;
  font-size: 0.53rem;
}

.refundContext dd {
  margin: 4px 0 0;
  color: #dbe7f1;
  font-size: 0.67rem;
  font-weight: 700;
}

.refundResult {
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.refundResult strong {
  margin-top: 14px;
  font-size: 1.35rem;
}

.refundRoutine {
  border:
    1px solid rgba(90, 194, 123, 0.24);
  background:
    rgba(59, 148, 88, 0.09);
}

.refundRoutine strong {
  color: #80d49a;
}

.refundElevated {
  border:
    1px solid rgba(209, 160, 67, 0.27);
  background:
    rgba(191, 137, 39, 0.08);
}

.refundElevated strong {
  color: #e2b15a;
}

.refundHigh {
  border:
    1px solid rgba(190, 107, 81, 0.25);
  background:
    rgba(160, 76, 58, 0.08);
}

.refundHigh strong {
  color: #e3a18a;
}


/* ============================================================
   RISK VS SIGNIFICANCE
   ============================================================ */

.meaningRiskSection {
  padding: 100px 0;
  background: #eee9dd;
}

.riskComparison {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    minmax(0, 1fr)
    150px
    minmax(0, 1fr);
  gap: 20px;
  align-items: center;
}

.riskComparison > * {
  min-width: 0;
}

.riskComparison article {
  min-height: 260px;
  padding: 24px;
  border:
    1px solid rgba(35, 58, 77, 0.09);
  border-radius: 17px;
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ddd2
    );
}

.riskComparison article > span {
  color: #74899b;
  font-size: 0.55rem;
  font-weight: 800;
}

.riskComparison article > strong {
  display: block;
  margin-top: 16px;
  color: #17364e;
  font-size: 1.2rem;
}

.riskComparison article p {
  margin: 12px 0 0;
  color: #596f81;
  font-size: 0.74rem;
  line-height: 1.62;
}

.businessMeaningCard {
  border-color:
    rgba(74, 145, 222, 0.23) !important;
  background:
    linear-gradient(
      145deg,
      #173e5e,
      #0c2e49
    ) !important;
  box-shadow:
    10px 14px 25px rgba(41, 54, 64, 0.15);
}

.businessMeaningCard > span {
  color: #68afff !important;
}

.businessMeaningCard > strong {
  color: #eef6ff !important;
}

.businessMeaningCard p {
  color: #afc1d0 !important;
}

.notEqual {
  text-align: center;
}

.notEqual span {
  width: 85px;
  height: 2px;
  display: block;
  margin: 0 auto 9px;
  background:
    linear-gradient(
      to right,
      transparent,
      #5fa8ff,
      transparent
    );
}

.notEqual strong {
  color: #71869a;
  font-size: 0.62rem;
}


/* ============================================================
   EXPLANATION
   ============================================================ */

.explanationSection {
  padding: 100px 0;
  background: #081f34;
}

.explanationVisual {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    260px
    minmax(0, 1fr);
  gap: 20px;
  align-items: stretch;
}

.explanationVisual > * {
  min-width: 0;
}

.explanationSignificance {
  min-height: 330px;
  padding: 26px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border:
    1px solid rgba(205, 128, 91, 0.29);
  border-radius: 20px;
  background:
    radial-gradient(
      circle at 50% 20%,
      rgba(194, 93, 68, 0.1),
      transparent 37%
    ),
    #15364e;
  text-align: center;
}

.explanationSignificance span {
  color: #b18d7f;
  font-size: 0.55rem;
  font-weight: 800;
}

.explanationSignificance strong {
  margin-top: 14px;
  color: #efad94;
  font-size: 1.65rem;
}

.explanationSignificance small {
  margin-top: 8px;
  color: #91a8bb;
  font-size: 0.61rem;
}

.explanationReasons {
  display: grid;
  grid-template-columns:
    repeat(2, minmax(0, 1fr));
  gap: 9px;
}

.explanationReasons article {
  min-width: 0;
  padding: 16px;
  border:
    1px solid rgba(99, 160, 228, 0.12);
  border-radius: 11px;
  background: #0b2943;
}

.explanationReasons span {
  display: block;
  color: #718da6;
  font-size: 0.52rem;
  font-weight: 800;
}

.explanationReasons strong {
  display: block;
  margin-top: 7px;
  color: #dce8f2;
  font-size: 0.7rem;
  line-height: 1.4;
}


/* ============================================================
   GOVERNANCE INPUT
   ============================================================ */

.governanceInputSection {
  padding: 100px 0;
  background: #eee9dd;
}

.governanceInputSection
.sectionIntro h2 {
  color: #102e47;
}

.governanceInputSection
.sectionIntro > p:last-child {
  color: #536c7f;
}

.governanceInputFlow {
  margin-top: 55px;
  display: grid;
  grid-template-columns:
    repeat(4, minmax(0, 1fr));
  gap: 9px;
}

.governanceInputFlow > article {
  min-width: 0;
  min-height: 135px;
  padding: 16px;
  border:
    1px solid rgba(35, 58, 77, 0.09);
  border-radius: 12px;
  background:
    linear-gradient(
      145deg,
      #faf8f3,
      #e4ded2
    );
}

.governanceInputFlow article span {
  color: #74899b;
  font-size: 0.52rem;
  font-weight: 800;
}

.governanceInputFlow article strong {
  display: block;
  margin-top: 15px;
  color: #18364d;
  font-size: 0.72rem;
  line-height: 1.45;
}

.businessSignificanceStage {
  grid-column: 1 / 3;
  min-height: 150px;
  padding: 21px;
  display: flex;
  flex-direction: column;
  justify-content: center;
  border:
    1px solid rgba(194, 139, 41, 0.23);
  border-radius: 13px;
  background:
    rgba(189, 137, 41, 0.075);
}

.businessSignificanceStage span {
  color: #a67a30;
  font-size: 0.54rem;
  font-weight: 800;
}

.businessSignificanceStage strong {
  margin-top: 9px;
  color: #7b5620;
  font-size: 1.28rem;
}

.nextGovernanceStage {
  grid-column: 3 / 5;
  min-height: 150px;
  padding: 21px;
  border:
    1px solid rgba(61, 133, 211, 0.23);
  border-radius: 13px;
  background:
    linear-gradient(
      145deg,
      #173e5e,
      #0c2e49
    );
}

.nextGovernanceStage > span {
  color: #68afff;
  font-size: 0.54rem;
  font-weight: 800;
}

.nextGovernanceStage > strong {
  display: block;
  margin-top: 9px;
  color: #eef6ff;
  font-size: 0.93rem;
}

.nextGovernanceStage > div {
  margin-top: 14px;
  display: flex;
  gap: 7px;
}

.nextGovernanceStage > div span {
  width: 44px;
  height: 8px;
  border-radius: 999px;
  background:
    rgba(255, 255, 255, 0.07);
}

.nextGovernanceStage small {
  display: block;
  margin-top: 12px;
  color: #839bb0;
  font-size: 0.59rem;
}


/* ============================================================
   PLATFORM ROLE
   ============================================================ */

.roleSection {
  padding: 100px 0;
  background: #061727;
}

.platformRail {
  margin-top: 52px;
  display: grid;
  grid-template-columns:
    repeat(6, minmax(0, 1fr));
  gap: 8px;
}

.platformStage,
.platformStageActive,
.platformStageComplete {
  min-width: 0;
  min-height: 130px;
  padding: 16px;
  border-radius: 13px;
}

.platformStage {
  border:
    1px solid rgba(99, 158, 225, 0.11);
  background: #0b2943;
}

.platformStageComplete {
  border:
    1px solid rgba(78, 154, 101, 0.17);
  background:
    rgba(58, 130, 81, 0.07);
}

.platformStageActive {
  border:
    1px solid rgba(205, 158, 68, 0.29);
  background:
    radial-gradient(
      circle at 80% 10%,
      rgba(205, 158, 68, 0.09),
      transparent 30%
    ),
    #15364e;
  box-shadow:
    0 0 18px
      rgba(197, 145, 45, 0.06);
}

.platformStage span,
.platformStageActive span,
.platformStageComplete span {
  color: #718ca5;
  font-size: 0.53rem;
  font-weight: 800;
}

.platformStageActive span {
  color: #d0a04a;
}

.platformStageComplete span {
  color: #69bd83;
}

.platformStage strong,
.platformStageActive strong,
.platformStageComplete strong {
  display: block;
  margin-top: 22px;
  color: #dce7f0;
  font-size: 0.71rem;
  line-height: 1.4;
}

.platformStage small,
.platformStageActive small,
.platformStageComplete small {
  display: block;
  margin-top: 7px;
  color: #718ca5;
  font-size: 0.53rem;
}


/* ============================================================
   FINAL CTA
   ============================================================ */

.finalCta {
  position: relative;
  overflow: hidden;
  padding: 105px 48px;
  background: #051423;
}

.finalGlow {
  position: absolute;
  left: 50%;
  top: -180px;
  width: 720px;
  height: 400px;
  transform: translateX(-50%);
  border-radius: 50%;
  background:
    rgba(47, 124, 255, 0.12);
  filter: blur(80px);
}

.finalInner {
  position: relative;
  z-index: 1;
  max-width: 980px;
  margin-inline: auto;
  text-align: center;
}

.finalInner h2 {
  margin: 18px 0 0;
  color: #f2f7fd;
  font-size:
    clamp(2.65rem, 4vw, 4.45rem);
  line-height: 1;
  letter-spacing: -0.048em;
}

.finalInner > p {
  max-width: 750px;
  margin: 23px auto 0;
  color: #aebed0;
  font-size: 0.97rem;
  line-height: 1.7;
}

.finalInner .heroActions {
  justify-content: center;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1180px) {
  .shell {
    padding-inline: 36px;
  }

  .heroLayout {
    grid-template-columns:
      minmax(0, 1fr)
      minmax(0, 0.95fr);
    gap: 58px;
  }

  .heroTitle {
    font-size:
      clamp(2.85rem, 3.9vw, 4rem);
  }

  .heroMeaningVisual {
    max-width: 560px;
  }

  .darkHeadline,
  .lightHeadline,
  .darkGovernanceTitle,
  .sectionIntro h2 {
    font-size:
      clamp(2.35rem, 3.25vw, 3.45rem);
  }

  .dimensionGrid,
  .sourceGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .scenarioWorkspace,
  .refundWorkspace {
    grid-template-columns:
      180px
      repeat(3, minmax(0, 1fr));
  }

  .platformRail {
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }
}

@media (max-width: 980px) {
  .shell {
    padding-inline: 28px;
  }

  .heroLayout,
  .editorialGrid {
    grid-template-columns: 1fr;
  }

  .heroCopy {
    max-width: 760px;
  }

  .heroMeaningVisual {
    max-width: 700px;
    margin-inline: auto;
  }

  .heroStatement {
    grid-template-columns: 1fr;
  }

  .statementPath {
    display: none;
  }

  .scenarioWorkspace,
  .refundWorkspace {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .scenarioButtons,
  .refundControls {
    grid-column: 1 / -1;
    grid-template-columns:
      repeat(3, minmax(0, 1fr));
  }

  .correlationWorkspace {
    grid-template-columns: 1fr;
  }

  .relevanceFlow {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .relevanceFilter {
    order: 3;
  }

  .relevanceResult {
    order: 4;
  }

  .riskComparison {
    grid-template-columns: 1fr;
  }

  .notEqual {
    padding: 14px 0;
  }

  .explanationVisual {
    grid-template-columns: 1fr;
  }

  .explanationSignificance {
    min-height: 220px;
  }

  .governanceInputFlow {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .businessSignificanceStage,
  .nextGovernanceStage {
    grid-column: auto;
  }
}

@media (max-width: 700px) {
  .shell {
    padding-inline: 20px;
  }

  .keepLine {
    display: inline;
    white-space: normal;
  }

  .keepLine + .keepLine::before {
    content: " ";
  }

  .hero {
    padding: 60px 0 72px;
  }

  .heroTitle {
    font-size:
      clamp(2.45rem, 10vw, 3.45rem);
  }

  .darkHeadline,
  .lightHeadline,
  .darkGovernanceTitle,
  .sectionIntro h2 {
    font-size:
      clamp(2.2rem, 9vw, 3.05rem);
  }

  .heroMeaningVisual {
    min-height: 590px;
    transform: scale(0.9);
    transform-origin: top center;
    margin-bottom: -55px;
  }

  .meaningSection,
  .modelSection,
  .integrationSection,
  .correlationSection,
  .relevanceSection,
  .dynamicSection,
  .meaningRiskSection,
  .explanationSection,
  .governanceInputSection,
  .roleSection {
    padding: 74px 0;
  }

  .scenarioWorkspace,
  .refundWorkspace,
  .dimensionGrid,
  .sourceGrid,
  .correlationObjects,
  .relevanceFlow,
  .explanationReasons,
  .governanceInputFlow,
  .platformRail {
    grid-template-columns: 1fr;
  }

  .scenarioButtons,
  .refundControls {
    grid-template-columns: 1fr;
  }

  .heroActions {
    display: grid;
    grid-template-columns: 1fr;
  }

  .heroActions a {
    width: 100%;
  }

  .finalCta {
    padding: 80px 20px;
  }
}


/* ============================================================
   REDUCED MOTION
   ============================================================ */

@media (prefers-reduced-motion: reduce) {
  .resolvedContext article {
    animation: none !important;
  }

  .primaryButton,
  .secondaryButton,
  .darkSecondaryButton,
  .scenarioButton,
  .scenarioButtonActive,
  .refundButton,
  .refundButtonActive,
  .correlationObject,
  .correlationObjectActive {
    transition: none !important;
  }
}
