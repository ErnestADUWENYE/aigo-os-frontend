.page {
  --navy950: #06192b;
  --navy900: #08253f;
  --navy850: #0d304f;

  --ink: #102f4d;
  --copy: #58738c;

  --blue: #2187df;
  --blueBright: #72b8ff;

  --gold: #c9922f;
  --green: #67d491;
  --violet: #9d86ef;

  --cream: #f2ede2;
  --cream2: #eae3d6;

  overflow: hidden;

  background: var(--cream);
  color: var(--ink);
}


.shell {
  width: min(1440px, calc(100% - 128px));

  margin-inline: auto;
}


/* ============================================================
   EYEBROWS
   ============================================================ */

.blueEyebrow,
.goldEyebrow,
.blueLightEyebrow,
.blueEyebrowLight {
  margin: 0;

  font-size: 11px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.14em;
}


.blueEyebrow {
  color: #72b8ff;
}


.goldEyebrow {
  color: #d0a042;
}


.blueLightEyebrow,
.blueEyebrowLight {
  color: #2187df !important;

  -webkit-text-fill-color:
    #2187df !important;
}


/* ============================================================
   HERO
   ============================================================ */

.hero {
  position: relative;

  min-height: 650px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 80% 23%,
      rgba(47, 140, 255, 0.15),
      transparent 31%
    ),
    linear-gradient(
      135deg,
      #06192b,
      #082640 63%,
      #061a2d
    );

  color: #ffffff;
}


.heroGrid {
  position: absolute;
  inset: 0;

  opacity: 0.14;

  background-image:
    linear-gradient(
      rgba(110, 174, 232, 0.10) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(110, 174, 232, 0.10) 1px,
      transparent 1px
    );

  background-size: 58px 58px;
}


.heroGlow {
  position: absolute;

  width: 650px;
  height: 650px;

  right: -180px;
  top: -190px;

  border-radius: 50%;

  background:
    radial-gradient(
      circle,
      rgba(44, 142, 255, 0.17),
      transparent 69%
    );
}


.heroLayout {
  position: relative;
  z-index: 2;

  min-height: 650px;

  display: grid;

  grid-template-columns:
    minmax(0, 1.08fr)
    minmax(500px, 0.92fr);

  align-items: center;

  gap: 64px;

  padding: 60px 0 64px;
}


.heroCopy {
  max-width: 710px;
}


.heroTitle {
  max-width: 700px;

  margin: 18px 0 24px;

  color: #ffffff;

  font-size: clamp(50px, 4.45vw, 69px);
  line-height: 1.01;
  font-weight: 800;

  letter-spacing: -0.052em;

  text-wrap: balance;
}


.heroLead {
  max-width: 620px;

  margin: 0;

  color: #d9e6f0;

  font-size: 18px;
  line-height: 1.65;
}


.heroSupporting {
  max-width: 620px;

  margin: 15px 0 0;

  color: #9fb7cc;

  font-size: 14px;
  line-height: 1.72;
}


.heroActions {
  display: flex;
  flex-wrap: wrap;

  gap: 13px;

  margin-top: 28px;
}


.primaryButton,
.secondaryButton {
  min-height: 52px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  padding: 0 23px;

  border-radius: 11px;

  font-size: 14px;
  font-weight: 760;

  text-decoration: none;
}


.primaryButton {
  color: #ffffff;

  background:
    linear-gradient(
      145deg,
      #3895ff,
      #2678e5
    );

  box-shadow:
    0 13px 28px rgba(30, 117, 221, 0.24);
}


.secondaryButton {
  color: #ffffff;

  border:
    1px solid rgba(154, 195, 231, 0.25);

  background:
    rgba(255, 255, 255, 0.045);
}


.heroPrinciples {
  display: flex;
  flex-wrap: wrap;

  gap: 10px 18px;

  margin-top: 25px;
}


.heroPrinciples span {
  display: flex;
  align-items: center;

  gap: 7px;

  color: #a9c0d4;

  font-size: 12px;
  font-weight: 650;
}


.heroPrinciples svg {
  color: var(--green);
}


/* ============================================================
   HERO PASSPORT
   ============================================================ */

.passportStage {
  width: 92%;

  justify-self: end;
}


.stageLabel {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  margin: 0 6px 11px;

  color: #6faef0;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.1em;
}


.stageLabel b {
  display: flex;
  align-items: center;

  gap: 7px;

  color: #78d99a;

  font-size: 9px;
}


.stageLabel b i {
  width: 7px;
  height: 7px;

  border-radius: 50%;

  background: #6ad58e;

  box-shadow:
    0 0 13px rgba(106, 213, 142, 0.9);
}


.passportCard {
  padding: 24px;

  border:
    1px solid rgba(95, 166, 229, 0.25);

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #0e3454,
      #08243d
    );

  box-shadow:
    0 30px 58px rgba(0, 8, 20, 0.32),
    inset 0 1px 0 rgba(255,255,255,0.05);

  transform:
    perspective(1200px)
    rotateX(0.5deg)
    rotateY(-0.5deg);
}


.passportTop {
  display: flex;
  align-items: center;

  gap: 15px;

  padding-bottom: 21px;

  border-bottom:
    1px solid rgba(112, 169, 218, 0.14);
}


.passportSeal {
  width: 55px;
  height: 55px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border:
    1px solid rgba(93, 172, 244, 0.26);

  border-radius: 14px;

  background:
    rgba(62, 146, 229, 0.10);

  color: #72b8ff;
}


.passportName span {
  display: block;

  color: #6baef1;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.11em;
}


.passportName strong {
  display: block;

  margin-top: 5px;

  color: #ffffff;

  font-size: 19px;
  line-height: 1.2;
}


.passportName small {
  display: block;

  margin-top: 6px;

  color: #8ba6bf;

  font-size: 10px;
}


.passportFields {
  display: grid;

  gap: 9px;

  margin-top: 20px;
}


.passportField {
  width: 100%;
  min-height: 61px;

  display: grid;

  grid-template-columns:
    36px minmax(0, 1fr);

  align-items: center;

  gap: 11px;

  padding: 10px 12px;

  cursor: pointer;

  border:
    1px solid rgba(98, 160, 216, 0.13);

  border-radius: 10px;

  background:
    rgba(255,255,255,0.028);

  text-align: left;

  transition:
    border-color 230ms ease,
    background 230ms ease,
    box-shadow 230ms ease,
    transform 230ms ease;
}


.fieldIcon {
  width: 34px;
  height: 34px;

  display: grid;
  place-items: center;

  border-radius: 9px;

  background:
    rgba(67, 151, 232, 0.08);

  color: #6bb4fb;
}


.fieldCopy small,
.fieldCopy strong {
  display: block;
}


.fieldCopy small {
  color: #7796b1;

  font-size: 7px;
  font-weight: 800;

  letter-spacing: 0.07em;
}


.fieldCopy strong {
  margin-top: 4px;

  color: #e1ebf4;

  font-size: 10px;
  line-height: 1.35;
}


.passportFieldActive {
  transform: translateX(-3px);

  background:
    rgba(255,255,255,0.055);
}


.passportField_blue.passportFieldActive {
  border-color: #5cabf5;

  box-shadow:
    0 0 24px rgba(71, 157, 239, 0.24);
}


.passportField_gold.passportFieldActive {
  border-color: #d5a84d;

  box-shadow:
    0 0 24px rgba(213, 168, 77, 0.22);
}


.passportField_green.passportFieldActive {
  border-color: #68ce8e;

  box-shadow:
    0 0 24px rgba(104, 206, 142, 0.21);
}


.passportField_violet.passportFieldActive {
  border-color: #9d86ef;

  box-shadow:
    0 0 24px rgba(157, 134, 239, 0.22);
}


.passportFieldActive .fieldCopy small {
  color: #a7bfd4;
}


.passportFieldActive .fieldCopy strong {
  color: #ffffff;
}


/* ============================================================
   SHARED LIGHT TYPOGRAPHY
   ============================================================ */

.coreSection,
.connectedSection {
  color: var(--ink);
}


.coreSection h2,
.coreSection h3,
.connectedSection h2,
.connectedSection h3 {
  color: #102f4d !important;

  -webkit-text-fill-color:
    #102f4d !important;
}


.coreSection p,
.connectedSection p {
  color: #58738c !important;

  -webkit-text-fill-color:
    #58738c !important;
}


.sectionIntro {
  display: grid;

  grid-template-columns:
    minmax(0, 1.22fr)
    minmax(350px, 0.78fr);

  align-items: end;

  gap: 70px;

  margin-bottom: 42px;
}


.sectionIntro h2 {
  max-width: 810px;

  margin: 13px 0 0;

  color: #102f4d;

  font-size: clamp(41px, 3.7vw, 58px);
  line-height: 1.04;
  font-weight: 800;

  letter-spacing: -0.048em;

  text-wrap: balance;
}


.sectionIntro > p {
  max-width: 520px;

  margin: 0 0 4px;

  color: #58738c;

  font-size: 16px;
  line-height: 1.7;
}


/* ============================================================
   CORE IDEA
   ============================================================ */

.coreSection {
  padding: 94px 0 100px;

  background:
    linear-gradient(
      180deg,
      #f3eee3,
      #ebe5d8
    );
}


.coreSection .goldEyebrow {
  color: #c48e25 !important;

  -webkit-text-fill-color:
    #c48e25 !important;
}


.definitionGrid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 18px;
}


.definitionCard {
  position: relative;

  min-height: 280px;

  padding: 27px;

  border:
    1px solid #d1dce4;

  border-radius: 19px;

  background:
    linear-gradient(
      145deg,
      #fffefa 0%,
      #fbfaf6 58%,
      #eee8dc 100%
    );

  box-shadow:
    0 22px 40px rgba(28, 52, 71, 0.12),
    0 7px 16px rgba(28, 52, 71, 0.06),
    inset 0 1px 0 #ffffff;
}


.definitionCardActive {
  border-color:
    #91c4ed;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #eef7ff
    );

  box-shadow:
    0 29px 48px rgba(32, 101, 158, 0.16),
    0 8px 18px rgba(28, 52, 71, 0.07),
    inset 0 1px 0 #ffffff;
}


.definitionIcon {
  width: 49px;
  height: 49px;

  display: grid;
  place-items: center;

  margin-bottom: 25px;

  border:
    1px solid #c5dff4;

  border-radius: 13px;

  background:
    #edf7ff;

  color: #2187df;
}


.definitionCard > span {
  color: #2187df !important;

  font-size: 10px;
  font-weight: 850;

  -webkit-text-fill-color:
    #2187df !important;
}


.definitionCard h3 {
  margin: 26px 0 11px;

  color: #102f4d !important;

  font-size: 24px;
  line-height: 1.15;
  font-weight: 790;

  letter-spacing: -0.03em;

  -webkit-text-fill-color:
    #102f4d !important;
}


.definitionCard p {
  margin: 0;

  color: #58738c !important;

  font-size: 14px;
  line-height: 1.65;

  -webkit-text-fill-color:
    #58738c !important;
}


/* ============================================================
   ONE EXAMPLE
   ============================================================ */

.exampleSection {
  padding: 96px 0 104px;

  background:
    linear-gradient(
      145deg,
      #071d31,
      #0b2d49
    );

  color: #ffffff;
}


.exampleSection .sectionIntro h2 {
  color: #ffffff;

  -webkit-text-fill-color:
    #ffffff;
}


.exampleSection .sectionIntro > p {
  color: #aac0d3;

  -webkit-text-fill-color:
    #aac0d3;
}


.exampleGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.06fr)
    96px
    minmax(360px, 0.94fr);

  align-items: center;

  gap: 20px;
}


.representationsPanel,
.actorPanel {
  border:
    1px solid rgba(95, 165, 225, 0.21);

  border-radius: 21px;

  background:
    linear-gradient(
      145deg,
      rgba(15, 54, 86, 0.98),
      rgba(7, 33, 55, 0.98)
    );

  box-shadow:
    0 25px 48px rgba(0, 8, 20, 0.26),
    inset 0 1px 0 rgba(255,255,255,0.04);
}


.representationsPanel {
  padding: 25px;
}


.panelHeading span {
  display: block;

  color: #6fb2f2;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.1em;
}


.panelHeading strong {
  display: block;

  margin-top: 6px;

  color: #eef6fc;

  font-size: 17px;
}


.representationGrid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 10px;

  margin-top: 22px;
}


.representationCard {
  min-height: 125px;

  padding: 15px;

  border:
    1px solid rgba(101, 163, 217, 0.16);

  border-radius: 11px;

  background:
    rgba(255,255,255,0.045);
}


.representationIcon {
  width: 35px;
  height: 35px;

  display: grid;
  place-items: center;

  margin-bottom: 14px;

  border-radius: 9px;

  background:
    rgba(65, 148, 227, 0.11);

  color: #6aaff5;
}


.representationCard span {
  display: block;

  color: #6baef1;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}


.representationCard strong {
  display: block;

  margin-top: 6px;

  overflow-wrap: anywhere;

  color: #dce8f3;

  font-size: 11px;
  line-height: 1.4;
}


.associateBridge {
  display: flex;
  flex-direction: column;
  align-items: center;

  gap: 8px;

  color: #69aff7;

  text-align: center;
}


.associateBridge span,
.associateBridge strong {
  color: #83a2be;

  font-size: 7px;
  font-weight: 850;

  letter-spacing: 0.09em;
}


.associateBridge i {
  width: 1px;
  height: 38px;

  background:
    linear-gradient(
      transparent,
      #5ca8ec,
      transparent
    );
}


.actorPanel {
  padding: 29px;
}


.actorPanelTop {
  display: flex;
  justify-content: space-between;
  align-items: flex-start;

  gap: 20px;
}


.actorPanelLabel {
  display: block;

  margin-bottom: 17px;

  color: #6fb2f2;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.09em;
}


.actorPanelTop h3 {
  margin: 0;

  color: #ffffff;

  font-size: 29px;
  line-height: 1.13;
  font-weight: 800;

  letter-spacing: -0.03em;
}


.actorId {
  margin: 8px 0 0;

  color: #8ba7bf;

  font-size: 11px;
}


.actorPanelIcon {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  flex: 0 0 auto;

  border:
    1px solid rgba(94, 171, 240, 0.25);

  border-radius: 14px;

  background:
    rgba(66, 152, 235, 0.11);

  color: #6bb4fb;
}


.actorPanelDescription {
  margin: 23px 0 22px;

  color: #aac0d4;

  font-size: 13px;
  line-height: 1.6;
}


.actorContextGrid {
  display: grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap: 10px;
}


.actorContextGrid article {
  min-height: 89px;

  padding: 14px;

  border:
    1px solid rgba(101, 163, 217, 0.15);

  border-radius: 10px;

  background:
    rgba(255,255,255,0.035);
}


.actorContextGrid span {
  display: block;

  color: #6baef1;

  font-size: 7px;
  font-weight: 850;

  letter-spacing: 0.07em;
}


.actorContextGrid strong {
  display: block;

  margin-top: 7px;

  color: #dce7f1;

  font-size: 10px;
  line-height: 1.4;
}


/* ============================================================
   CONNECTED GOVERNANCE
   ============================================================ */

.connectedSection {
  padding: 96px 0 102px;

  background:
    linear-gradient(
      180deg,
      #f3eee3,
      #ebe4d7
    );
}


.boundaryPanel {
  display: grid;

  grid-template-columns:
    minmax(0, 0.9fr)
    minmax(520px, 1.1fr);

  align-items: center;

  gap: 70px;

  margin-bottom: 82px;
}


.boundaryCopy h2 {
  margin: 13px 0 0;

  color: #102f4d !important;

  font-size: clamp(40px, 3.6vw, 56px);
  line-height: 1.04;
  font-weight: 800;

  letter-spacing: -0.048em;

  text-wrap: balance;

  -webkit-text-fill-color:
    #102f4d !important;
}


.boundaryCopy > p:last-child {
  max-width: 610px;

  margin: 18px 0 0;

  color: #58738c !important;

  font-size: 15px;
  line-height: 1.7;

  -webkit-text-fill-color:
    #58738c !important;
}


.boundaryCompare {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    50px
    minmax(0, 1fr);

  align-items: center;

  gap: 12px;
}


.boundaryCell {
  min-height: 165px;

  display: flex;
  flex-direction: column;
  justify-content: center;

  padding: 24px;

  border:
    1px solid #ccdbe5;

  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #fffefa,
      #f1ece2
    );

  box-shadow:
    0 20px 38px rgba(28, 52, 71, 0.12),
    inset 0 1px 0 #ffffff;
}


.boundaryCell span {
  color: #2187df !important;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.09em;

  -webkit-text-fill-color:
    #2187df !important;
}


.boundaryCell strong {
  margin-top: 20px;

  color: #102f4d !important;

  font-size: 18px;
  line-height: 1.4;

  -webkit-text-fill-color:
    #102f4d !important;
}


.boundaryArrow {
  display: grid;
  place-items: center;

  color: #2187df;
}


.capabilityIntro {
  max-width: 850px;

  margin: 0 auto 38px;

  text-align: center;
}


.capabilityIntro h2 {
  margin: 12px 0 0;

  color: #102f4d !important;

  font-size: clamp(38px, 3.3vw, 51px);
  line-height: 1.05;
  font-weight: 800;

  letter-spacing: -0.045em;

  -webkit-text-fill-color:
    #102f4d !important;
}


.capabilityIntro p:last-child {
  max-width: 650px;

  margin: 15px auto 0;

  color: #58738c !important;

  font-size: 14px;
  line-height: 1.65;

  -webkit-text-fill-color:
    #58738c !important;
}


.capabilityWrap {
  width: 100%;
}


/* ============================================================
   FINAL CTA
   ============================================================ */

.finalSection {
  padding: 82px 0 86px;

  background:
    linear-gradient(
      135deg,
      #06192b,
      #0b2b47
    );

  color: #ffffff;
}


.finalGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.12fr)
    minmax(390px, 0.88fr);

  align-items: center;

  gap: 80px;
}


.finalGrid h2 {
  margin: 13px 0 0;

  color: #ffffff;

  font-size: clamp(41px, 3.6vw, 56px);
  line-height: 1.04;
  font-weight: 800;

  letter-spacing: -0.048em;
}


.finalGrid > div:last-child > p {
  margin: 0;

  color: #aec3d6;

  font-size: 15px;
  line-height: 1.7;
}


/* ============================================================
   RESPONSIVE
   ============================================================ */

@media (max-width: 1280px) {
  .shell {
    width:
      min(1400px, calc(100% - 80px));
  }

  .heroLayout {
    grid-template-columns:
      minmax(0, 1.1fr)
      minmax(450px, 0.9fr);

    gap: 48px;
  }

  .passportStage {
    width: 90%;
  }
}


@media (max-width: 1080px) {
  .hero {
    min-height: auto;
  }

  .heroLayout {
    min-height: auto;

    grid-template-columns: 1fr;

    padding: 72px 0;
  }

  .passportStage {
    width: min(100%, 720px);

    justify-self: center;
  }

  .sectionIntro,
  .boundaryPanel,
  .finalGrid {
    grid-template-columns: 1fr;

    gap: 24px;
  }

  .definitionGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .exampleGrid {
    grid-template-columns: 1fr;
  }

  .associateBridge {
    min-height: 80px;
  }

  .associateBridge i {
    height: 18px;
  }

  .boundaryCompare {
    max-width: 760px;
  }
}


@media (max-width: 720px) {
  .shell {
    width: calc(100% - 34px);
  }

  .heroTitle {
    font-size:
      clamp(40px, 11vw, 54px);
  }

  .definitionGrid,
  .representationGrid,
  .actorContextGrid {
    grid-template-columns: 1fr;
  }

  .boundaryCompare {
    grid-template-columns: 1fr;
  }

  .boundaryArrow {
    transform: rotate(90deg);
  }

  .passportTop {
    align-items: flex-start;
  }
}


@media (prefers-reduced-motion: reduce) {
  .page *,
  .page *::before,
  .page *::after {
    transition: none !important;
    animation: none !important;
  }
}

/* === PAGE 03 AI ACTOR PERSISTENCE NOTE === */

.persistenceNote {
  margin-top: 18px;

  padding: 15px 16px;

  border: 1px solid rgba(92, 171, 240, 0.20);
  border-radius: 10px;

  background:
    rgba(45, 137, 220, 0.08);
}

.persistenceNote strong {
  display: block;

  color: #d8e9f7;

  font-size: 12px;
  line-height: 1.5;
  font-weight: 750;
}

/* === END PAGE 03 AI ACTOR PERSISTENCE NOTE === */

/* === PAGE 03 CORE IDEA FLOW === */

.coreSection {
  padding: 96px 0 104px;

  background:
    linear-gradient(
      180deg,
      #f3eee3 0%,
      #ebe4d7 100%
    );

  color: #102f4d;
}


.coreIntro {
  max-width: 980px;

  margin: 0 auto 58px;

  text-align: center;
}


.coreIntro .goldEyebrow {
  color: #c58d23 !important;

  -webkit-text-fill-color:
    #c58d23 !important;
}


.coreIntro h2 {
  max-width: 920px;

  margin: 14px auto 0;

  color: #102f4d !important;

  font-size: clamp(42px, 4vw, 61px);
  line-height: 1.04;
  font-weight: 800;

  letter-spacing: -0.048em;

  text-wrap: balance;

  -webkit-text-fill-color:
    #102f4d !important;
}


.coreIntro > p:last-child {
  max-width: 800px;

  margin: 22px auto 0;

  color: #58738c !important;

  font-size: 16px;
  line-height: 1.68;

  -webkit-text-fill-color:
    #58738c !important;
}


.conceptFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    112px
    minmax(0, 1fr)
    112px
    minmax(0, 1fr);

  align-items: stretch;

  gap: 14px;
}


.conceptCard {
  min-height: 300px;

  padding: 28px;

  border: 1px solid #cfdbe4;
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #fffefa 0%,
      #fbfaf6 56%,
      #eee8dc 100%
    );

  box-shadow:
    0 24px 42px rgba(28, 52, 71, 0.13),
    0 8px 18px rgba(28, 52, 71, 0.06),
    inset 0 1px 0 #ffffff;
}


.conceptCardActor {
  border-color: #abd1ee;

  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #f5faff 52%,
      #e8f3fc 100%
    );

  box-shadow:
    0 28px 48px rgba(36, 107, 164, 0.16),
    0 8px 18px rgba(28, 52, 71, 0.07),
    inset 0 1px 0 #ffffff;
}


.conceptCardPassport {
  border-color: #84bee9;

  background:
    linear-gradient(
      145deg,
      #ffffff 0%,
      #eff8ff 48%,
      #e1f1fc 100%
    );

  box-shadow:
    0 31px 52px rgba(28, 101, 160, 0.18),
    0 9px 20px rgba(28, 52, 71, 0.07),
    inset 0 1px 0 #ffffff;
}


.conceptTop {
  display: flex;
  align-items: center;
  justify-content: space-between;

  gap: 18px;

  margin-bottom: 34px;
}


.conceptNumber {
  color: #137bd4 !important;

  font-size: 11px;
  line-height: 1;
  font-weight: 850;

  letter-spacing: 0.06em;

  -webkit-text-fill-color:
    #137bd4 !important;
}


.conceptIcon {
  width: 53px;
  height: 53px;

  display: grid;
  place-items: center;

  border: 1px solid #c4dff4;
  border-radius: 15px;

  background: #edf7ff;

  color: #1680dd;

  box-shadow:
    0 10px 22px rgba(34, 117, 180, 0.10);
}


.conceptLabel {
  display: block;

  margin-bottom: 11px;

  color: #137bd4 !important;

  font-size: 9px;
  line-height: 1.25;
  font-weight: 850;

  letter-spacing: 0.09em;

  -webkit-text-fill-color:
    #137bd4 !important;
}


.conceptCard h3 {
  margin: 0;

  color: #102f4d !important;

  font-size: 25px;
  line-height: 1.15;
  font-weight: 790;

  letter-spacing: -0.03em;

  -webkit-text-fill-color:
    #102f4d !important;
}


.conceptCard p {
  margin: 16px 0 0;

  color: #58738c !important;

  font-size: 14px;
  line-height: 1.68;

  -webkit-text-fill-color:
    #58738c !important;
}


.conceptConnector {
  display: flex;
  flex-direction: column;

  align-items: center;
  justify-content: center;

  gap: 13px;

  text-align: center;
}


.conceptConnector > span {
  max-width: 105px;

  color: #6d8ba5 !important;

  font-size: 8px;
  line-height: 1.35;
  font-weight: 850;

  letter-spacing: 0.08em;

  -webkit-text-fill-color:
    #6d8ba5 !important;
}


.connectorLine {
  width: 100%;

  display: flex;
  align-items: center;

  color: #1d83dc;
}


.connectorLine i {
  height: 1px;

  flex: 1;

  background:
    linear-gradient(
      90deg,
      rgba(29, 131, 220, 0.12),
      rgba(29, 131, 220, 0.65)
    );
}


.coreBoundary {
  max-width: 860px;

  margin: 40px auto 0;

  padding: 18px 24px;

  border: 1px solid #c8dbe9;
  border-radius: 14px;

  background:
    linear-gradient(
      145deg,
      #fffefa,
      #f2f7fa
    );

  box-shadow:
    0 15px 30px rgba(29, 56, 76, 0.09),
    inset 0 1px 0 #ffffff;

  text-align: center;
}


.coreBoundary strong {
  color: #17476d !important;

  font-size: 14px;
  line-height: 1.5;
  font-weight: 760;

  -webkit-text-fill-color:
    #17476d !important;
}


@media (max-width: 1100px) {
  .conceptFlow {
    grid-template-columns: 1fr;
  }

  .conceptConnector {
    min-height: 84px;
  }

  .connectorLine {
    width: 42px;

    flex-direction: column;
  }

  .connectorLine i {
    width: 1px;
    height: 34px;

    flex: none;

    background:
      linear-gradient(
        180deg,
        rgba(29, 131, 220, 0.12),
        rgba(29, 131, 220, 0.65)
      );
  }

  .connectorLine svg {
    transform: rotate(90deg);
  }
}


@media (max-width: 720px) {
  .coreSection {
    padding: 72px 0 78px;
  }

  .coreIntro {
    margin-bottom: 40px;

    text-align: left;
  }

  .coreIntro h2 {
    margin-left: 0;
    margin-right: 0;
  }

  .coreIntro > p:last-child {
    margin-left: 0;
    margin-right: 0;
  }

  .conceptCard {
    min-height: 0;
  }
}

/* === END PAGE 03 CORE IDEA FLOW === */

/* === PAGE 03 STREAMLINED HERO === */

.heroLayout {
  grid-template-columns:
    minmax(0, 1.1fr)
    minmax(450px, 0.9fr);

  gap: 72px;
}


.heroCopy {
  max-width: 720px;
}


.heroTitle {
  max-width: 690px;
}


.heroLead {
  max-width: 630px;

  font-size: 18px;
  line-height: 1.65;
}


.heroSupporting {
  max-width: 650px;

  margin-top: 16px;

  color: #a9c0d4;

  font-size: 14px;
  line-height: 1.72;
}


.passportStage {
  width: 88%;

  justify-self: end;
}


.passportCard {
  padding: 26px;

  border:
    1px solid rgba(95, 166, 229, 0.28);

  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #103857 0%,
      #0b2b47 48%,
      #071f35 100%
    );

  box-shadow:
    0 30px 55px rgba(0, 9, 22, 0.30),
    0 10px 22px rgba(0, 9, 22, 0.18),
    inset 0 1px 0 rgba(255,255,255,0.05);
}


.passportTop {
  padding-bottom: 24px;
}


.passportName span {
  color: #71b5f5;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.10em;
}


.passportName strong {
  margin-top: 7px;

  color: #ffffff;

  font-size: 21px;
  line-height: 1.2;
}


.passportName small {
  margin-top: 7px;

  color: #91abc2;

  font-size: 10px;
}


.passportFields {
  gap: 10px;

  margin-top: 22px;
}


.passportField {
  min-height: 70px;

  grid-template-columns:
    39px minmax(0, 1fr);

  gap: 12px;

  padding: 12px 14px;

  border:
    1px solid rgba(104, 167, 222, 0.15);

  background:
    rgba(255,255,255,0.035);
}


.passportFieldActive {
  transform: translateX(-3px);

  background:
    rgba(255,255,255,0.065);
}


.fieldCopy small {
  color: #88a6bf;

  font-size: 8px;
}


.fieldCopy strong {
  margin-top: 5px;

  color: #edf5fb;

  font-size: 11px;
}


.passportMeaning {
  margin-top: 20px;

  padding: 15px 16px;

  border:
    1px solid rgba(103, 170, 227, 0.16);

  border-radius: 11px;

  background:
    rgba(42, 127, 199, 0.07);
}


.passportMeaning span {
  display: block;

  color: #6fb4f5;

  font-size: 8px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.09em;
}


.passportMeaning p {
  margin: 7px 0 0;

  color: #a8bed1;

  font-size: 11px;
  line-height: 1.55;
}


@media (max-width: 1080px) {
  .heroLayout {
    grid-template-columns: 1fr;
  }

  .passportStage {
    width: min(100%, 680px);

    justify-self: center;
  }
}


@media (max-width: 720px) {
  .passportStage {
    width: 100%;
  }
}

/* === END PAGE 03 STREAMLINED HERO === */


/* === PAGE 03 FINAL LOCK OVERRIDES === */

/*
   Final editorial layout:
   Hero
   AI Actor resolution + Passport contents
   One example
   Machine Authority handoff
   CTA
*/

.hero {
  min-height: 620px;
}

.heroLayout {
  min-height: 620px;

  padding-top: 54px;
  padding-bottom: 58px;
}


/* Keep the page substantial without presentation-style spacing */

.coreSection {
  padding-top: 82px;
  padding-bottom: 88px;
}

.coreIntro {
  margin-bottom: 46px;
}


/* Passport contents follows the resolution model */

.coreSection .capabilityIntro {
  margin-top: 68px;
  margin-bottom: 32px;
}


/* Three clear Passport dimensions */

.definitionGrid {
  grid-template-columns:
    repeat(3, minmax(0, 1fr));
}

.definitionCard {
  min-height: 235px;
}


/* Explicit example */

.exampleSection {
  padding-top: 84px;
  padding-bottom: 90px;
}


/* Only the useful handoff remains.
   Remove spacing previously reserved for the deleted
   six-capability sequence. */

.connectedSection {
  padding-top: 76px;
  padding-bottom: 80px;
}

.boundaryPanel {
  margin-bottom: 0;
}


/* Closing CTA */

.finalSection {
  padding-top: 70px;
  padding-bottom: 74px;
}


/* Ensure all light-surface text remains readable */

.coreSection,
.connectedSection {
  color: #102f4d !important;
}

.coreSection h1,
.coreSection h2,
.coreSection h3,
.connectedSection h1,
.connectedSection h2,
.connectedSection h3 {
  color: #102f4d !important;

  -webkit-text-fill-color:
    #102f4d !important;
}

.coreSection p,
.connectedSection p {
  color: #58738c !important;

  -webkit-text-fill-color:
    #58738c !important;
}


/* Responsive */

@media (max-width: 1080px) {

  .definitionGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .coreSection .capabilityIntro {
    margin-top: 56px;
  }
}


@media (max-width: 720px) {

  .hero {
    min-height: auto;
  }

  .heroLayout {
    min-height: auto;

    padding-top: 64px;
    padding-bottom: 64px;
  }

  .coreSection,
  .exampleSection,
  .connectedSection {
    padding-top: 68px;
    padding-bottom: 72px;
  }

  .definitionGrid {
    grid-template-columns: 1fr;
  }

  .definitionCard {
    min-height: 0;
  }

  .coreSection .capabilityIntro {
    margin-top: 48px;

    text-align: left;
  }

  .finalSection {
    padding-top: 62px;
    padding-bottom: 66px;
  }
}

/* === END PAGE 03 FINAL LOCK OVERRIDES === */

