.page {
  --navy: #071f34;
  --navy2: #0a304e;
  --ink: #102f4d;
  --body: #536f87;
  --blue: #147fd8;
  --gold: #b47c12;
  --cream: #f2ede3;
  --line: #cedae3;

  overflow: hidden;

  background: #ffffff;
  color: var(--ink);
}

.shell {
  width: min(1180px, calc(100% - 48px));

  margin: 0 auto;
}

.blueEyebrow,
.blueDarkEyebrow,
.goldEyebrow {
  margin: 0;

  font-size: 10px;
  line-height: 1.2;
  font-weight: 850;

  letter-spacing: 0.12em;
}

.blueEyebrow {
  color: #70baf1;
}

.blueDarkEyebrow {
  color: #147fd8;
}

.goldEyebrow {
  color: #b47c12;
}


/* ==========================================================
   HERO
========================================================== */

.hero {
  position: relative;

  min-height: 680px;

  display: flex;
  align-items: center;

  padding: 94px 0 84px;

  overflow: hidden;

  background:
    radial-gradient(
      circle at 77% 41%,
      rgba(36,135,209,0.17),
      transparent 30%
    ),
    linear-gradient(
      135deg,
      #061b2e,
      #082b47 58%,
      #071f35
    );
}

.heroGrid {
  position: absolute;
  inset: 0;

  opacity: 0.07;

  background-image:
    linear-gradient(
      rgba(103,177,232,0.18) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(103,177,232,0.18) 1px,
      transparent 1px
    );

  background-size: 48px 48px;
}

.heroLayout {
  position: relative;
  z-index: 2;

  display: grid;

  grid-template-columns:
    minmax(0, 1.1fr)
    minmax(360px, 0.9fr);

  gap: 76px;

  align-items: center;
}

.heroCopy h1 {
  max-width: 770px;

  margin: 18px 0 0;

  color: #ffffff;

  font-size: clamp(46px, 5vw, 68px);
  line-height: 1.02;
  font-weight: 820;

  letter-spacing: -0.052em;

  text-wrap: balance;
}

.heroLead {
  max-width: 680px;

  margin: 24px 0 0;

  color: #d7e6f1;

  font-size: 18px;
  line-height: 1.62;
}

.heroSupporting {
  max-width: 670px;

  margin: 15px 0 0;

  color: #9fb9cc;

  font-size: 14px;
  line-height: 1.72;
}

.heroActions {
  display: flex;
  flex-wrap: wrap;

  gap: 12px;

  margin-top: 30px;
}

.primaryButton,
.secondaryButton {
  min-height: 46px;

  display: inline-flex;
  align-items: center;
  justify-content: center;

  gap: 9px;

  padding: 0 18px;

  border-radius: 8px;

  text-decoration: none;

  font-size: 12px;
  font-weight: 800;
}

.primaryButton {
  background: #ffffff;
  color: #123a5c;
}

.secondaryButton {
  border: 1px solid rgba(139,192,235,0.34);

  background: rgba(255,255,255,0.035);

  color: #e6f1f9;
}

.heroVisual {
  width: 91%;

  justify-self: end;
}

.receiptPanel {
  padding: 28px;

  border: 1px solid rgba(99,173,230,0.27);
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #103957,
      #092a45 58%,
      #071f35
    );

  box-shadow:
    0 32px 60px rgba(0,8,20,0.34),
    inset 0 1px 0 rgba(255,255,255,0.05);
}

.receiptTop {
  display: flex;
  align-items: center;

  gap: 15px;
}

.receiptIcon {
  width: 52px;
  height: 52px;

  display: grid;
  place-items: center;

  flex: 0 0 52px;

  border: 1px solid rgba(103,178,236,0.26);
  border-radius: 14px;

  background: rgba(48,138,210,0.10);

  color: #6eb8f2;
}

.receiptTop span,
.receiptSummary span,
.receiptStatus span {
  display: block;

  color: #73b8ef;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.10em;
}

.receiptTop strong {
  display: block;

  margin-top: 6px;

  color: #ffffff;

  font-size: 20px;
}

.receiptSummary {
  display: grid;

  gap: 8px;

  margin-top: 24px;
}

.receiptSummary > div {
  padding: 13px 15px;

  border: 1px solid rgba(111,176,226,0.14);
  border-radius: 10px;

  background: rgba(255,255,255,0.025);
}

.receiptSummary strong {
  display: block;

  margin-top: 5px;

  color: #dce9f3;

  font-size: 11px;
  line-height: 1.45;
}

.receiptStatus {
  display: flex;
  align-items: center;

  gap: 12px;

  margin-top: 14px;

  padding: 15px;

  border: 1px solid rgba(83,180,228,0.29);
  border-radius: 11px;

  background: rgba(45,134,190,0.10);

  color: #75bff1;
}

.receiptStatus strong {
  display: block;

  margin-top: 4px;

  color: #ffffff;

  font-size: 12px;
}


/* ==========================================================
   SECTION INTRO
========================================================== */

.sectionIntro,
.sectionIntroDark {
  display: grid;

  grid-template-columns:
    minmax(0, 1.15fr)
    minmax(300px, 0.85fr);

  gap: 72px;

  align-items: end;

  margin-bottom: 48px;
}

.sectionIntro h2,
.sectionIntroCentered h2,
.sectionIntroDark h2,
.outputCopy h2 {
  margin: 12px 0 0;

  font-size: clamp(36px, 4vw, 52px);
  line-height: 1.05;
  font-weight: 810;

  letter-spacing: -0.045em;

  text-wrap: balance;
}

.sectionIntro h2,
.sectionIntroCentered h2,
.outputCopy h2 {
  color: #102f4d;
}

.sectionIntro > p,
.sectionIntroCentered > p:last-child,
.outputCopy > p {
  margin: 0;

  color: #536f87;

  font-size: 15px;
  line-height: 1.7;
}

.sectionIntroCentered {
  max-width: 920px;

  margin: 0 auto 48px;

  text-align: center;
}

.sectionIntroCentered > p:last-child {
  max-width: 740px;

  margin: 20px auto 0;
}


/* ==========================================================
   PURPOSE
========================================================== */

.purposeSection {
  padding: 98px 0 104px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ece5d9
    );
}

.purposeFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    55px
    minmax(0, 1fr)
    55px
    minmax(0, 1fr);

  align-items: stretch;
}

.flowCard {
  min-height: 190px;

  padding: 24px;

  border: 1px solid #cedae3;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f7f5ef
    );

  box-shadow:
    0 23px 42px rgba(31,56,75,0.11),
    0 5px 12px rgba(31,56,75,0.04),
    inset 0 1px 0 #ffffff;
}

.flowCardActive {
  border-color: #9fcbea;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );

  box-shadow:
    0 26px 48px rgba(25,103,159,0.14),
    0 6px 14px rgba(31,56,75,0.05),
    inset 0 1px 0 #ffffff;
}

.flowCard span {
  color: #147fd8;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.09em;
}

.flowCard strong {
  display: block;

  margin-top: 14px;

  color: #102f4d;

  font-size: 20px;
  line-height: 1.25;
}

.flowCard p {
  margin: 12px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.62;
}

.flowArrow,
.assemblyArrow {
  align-self: center;
  justify-self: center;

  color: #2787d0;
}


/* ==========================================================
   CONTENTS
========================================================== */

.contentsSection,
.accessSection,
.exampleSection {
  padding: 100px 0 106px;

  background: #ffffff;
}

.contentsGrid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 18px;
}

.contentCard {
  min-height: 230px;

  padding: 25px;

  border: 1px solid #d1dce4;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f6f9fb
    );

  box-shadow:
    0 21px 39px rgba(31,56,75,0.10),
    0 5px 12px rgba(31,56,75,0.04),
    inset 0 1px 0 #ffffff;
}

.contentCard > span {
  color: #147fd8;

  font-size: 10px;
  font-weight: 850;
}

.contentCard h3 {
  margin: 28px 0 0;

  color: #102f4d;

  font-size: 21px;
  line-height: 1.25;
}

.contentCard p {
  margin: 12px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.62;
}


/* ==========================================================
   ASSEMBLY
========================================================== */

.assemblySection {
  padding: 100px 0 106px;

  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ebe4d8
    );
}

.assemblyFlow {
  display: grid;

  grid-template-columns:
    minmax(0, 1fr)
    38px
    minmax(0, 1fr)
    38px
    minmax(0, 1fr)
    38px
    minmax(0, 1fr);

  align-items: stretch;
}

.assemblyCard {
  min-height: 230px;

  padding: 23px;

  border: 1px solid #cedae3;
  border-radius: 17px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f7f9fa
    );

  box-shadow:
    0 22px 40px rgba(31,56,75,0.10),
    inset 0 1px 0 #ffffff;

  color: #147fd8;
}

.assemblyCard span {
  display: block;

  margin-top: 22px;

  color: #147fd8;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}

.assemblyCard h3 {
  margin: 8px 0 0;

  color: #102f4d;

  font-size: 19px;
  line-height: 1.25;
}

.assemblyCard p {
  margin: 12px 0 0;

  color: #536f87;

  font-size: 12px;
  line-height: 1.62;
}

.assemblyOutput {
  width: min(100%, 620px);

  display: flex;
  align-items: center;

  gap: 14px;

  margin: 30px auto 0;

  padding: 20px 22px;

  border: 1px solid #a9d1ed;
  border-radius: 15px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );

  box-shadow:
    0 19px 36px rgba(31,56,75,0.10);

  color: #147fd8;
}

.assemblyOutput span {
  color: #147fd8;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}

.assemblyOutput strong {
  display: block;

  margin-top: 4px;

  color: #102f4d;

  font-size: 17px;
}


/* ==========================================================
   EXAMPLE RECEIPT
========================================================== */

.exampleReceipt {
  overflow: hidden;

  border: 1px solid #c9d8e3;
  border-radius: 20px;

  background: #ffffff;

  box-shadow:
    0 28px 52px rgba(31,56,75,0.13),
    0 6px 14px rgba(31,56,75,0.05),
    inset 0 1px 0 #ffffff;
}

.exampleHeader {
  display: flex;
  justify-content: space-between;
  align-items: center;

  gap: 24px;

  padding: 24px 27px;

  border-bottom: 1px solid #dce5eb;

  background:
    linear-gradient(
      135deg,
      #f7fbfe,
      #edf6fc
    );
}

.exampleHeader span {
  color: #147fd8;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.09em;
}

.exampleHeader h3 {
  margin: 7px 0 0;

  color: #102f4d;

  font-size: 22px;
}

.exampleTime {
  display: inline-flex;
  align-items: center;

  gap: 8px;

  color: #147fd8;

  font-size: 11px;
  font-weight: 760;
}

.exampleDetails {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 1px;

  background: #dce5eb;
}

.exampleDetails > div {
  min-height: 124px;

  padding: 22px;

  background: #ffffff;
}

.exampleDetails span {
  color: #147fd8;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}

.exampleDetails strong {
  display: block;

  margin-top: 8px;

  color: #153c5b;

  font-size: 13px;
  line-height: 1.5;
}


/* ==========================================================
   ACCESS
========================================================== */

.accessSection {
  background:
    linear-gradient(
      180deg,
      #f3eee4,
      #ebe4d8
    );
}

.accessGrid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 18px;
}

.accessCard {
  min-height: 245px;

  padding: 27px;

  border: 1px solid #cfdbe4;
  border-radius: 18px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #f5f8fa
    );

  box-shadow:
    0 23px 42px rgba(31,56,75,0.11),
    0 6px 13px rgba(31,56,75,0.04),
    inset 0 1px 0 #ffffff;

  color: #147fd8;
}

.accessCard > span {
  display: block;

  margin-top: 21px;

  color: #147fd8;

  font-size: 8px;
  font-weight: 850;

  letter-spacing: 0.08em;
}

.accessCard h3 {
  margin: 9px 0 0;

  color: #102f4d;

  font-size: 23px;
  line-height: 1.2;
}

.accessCard p {
  margin: 13px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.65;
}


/* ==========================================================
   VALUE
========================================================== */

.valueSection {
  padding: 100px 0;

  background:
    linear-gradient(
      135deg,
      #071e33,
      #0a2d49 58%,
      #071f35
    );
}

.sectionIntroDark h2 {
  color: #ffffff;
}

.sectionIntroDark > p {
  margin: 0;

  color: #a7bfd2;

  font-size: 15px;
  line-height: 1.7;
}

.valueGrid {
  display: grid;

  grid-template-columns:
    repeat(4, minmax(0, 1fr));

  gap: 15px;
}

.valueCard {
  min-height: 225px;

  padding: 23px;

  border: 1px solid rgba(102,173,228,0.23);
  border-radius: 16px;

  background:
    linear-gradient(
      145deg,
      #103956,
      #092944
    );

  box-shadow:
    0 26px 48px rgba(0,8,20,0.25),
    inset 0 1px 0 rgba(255,255,255,0.05);
}

.valueIcon {
  width: 44px;
  height: 44px;

  display: grid;
  place-items: center;

  border: 1px solid rgba(104,180,235,0.23);
  border-radius: 11px;

  background: rgba(66,149,209,0.08);

  color: #72b8ef;
}

.valueCard h3 {
  margin: 22px 0 0;

  color: #ffffff;

  font-size: 19px;
  line-height: 1.25;
}

.valueCard p {
  margin: 12px 0 0;

  color: #adc3d3;

  font-size: 12px;
  line-height: 1.62;
}


/* ==========================================================
   OUTPUT
========================================================== */

.outputSection {
  padding: 100px 0 108px;

  background: #ffffff;
}

.outputGrid {
  display: grid;

  grid-template-columns:
    minmax(0, 1.1fr)
    minmax(360px, 0.9fr);

  gap: 76px;

  align-items: center;
}

.outputCopy > p {
  max-width: 690px;

  margin-top: 20px;
}

.outputPanel {
  padding: 30px;

  border: 1px solid #a9d1ed;
  border-radius: 20px;

  background:
    linear-gradient(
      145deg,
      #ffffff,
      #edf7fe
    );

  box-shadow:
    0 28px 52px rgba(31,56,75,0.13),
    0 6px 14px rgba(31,56,75,0.05),
    inset 0 1px 0 #ffffff;
}

.outputIcon {
  width: 58px;
  height: 58px;

  display: grid;
  place-items: center;

  border: 1px solid #b9d9ee;
  border-radius: 15px;

  background: #ffffff;

  color: #147fd8;
}

.outputPanel > span {
  display: block;

  margin-top: 20px;

  color: #147fd8;

  font-size: 9px;
  font-weight: 850;

  letter-spacing: 0.09em;
}

.outputPanel h3 {
  margin: 10px 0 0;

  color: #102f4d;

  font-size: 25px;
  line-height: 1.2;
}

.outputPanel p {
  margin: 13px 0 0;

  color: #536f87;

  font-size: 13px;
  line-height: 1.65;
}


/* ==========================================================
   LIGHT SECTION CONTRAST PROTECTION
========================================================== */

.purposeSection,
.contentsSection,
.assemblySection,
.exampleSection,
.accessSection,
.outputSection {
  color: #102f4d !important;
}

.purposeSection *,
.contentsSection *,
.assemblySection *,
.exampleSection *,
.accessSection *,
.outputSection * {
  opacity: 1 !important;
  filter: none !important;

  -webkit-text-fill-color: currentColor !important;
}

.purposeSection h1,
.purposeSection h2,
.purposeSection h3,
.contentsSection h1,
.contentsSection h2,
.contentsSection h3,
.assemblySection h1,
.assemblySection h2,
.assemblySection h3,
.exampleSection h1,
.exampleSection h2,
.exampleSection h3,
.accessSection h1,
.accessSection h2,
.accessSection h3,
.outputSection h1,
.outputSection h2,
.outputSection h3 {
  color: #102f4d !important;
  -webkit-text-fill-color: #102f4d !important;
  text-shadow: none !important;
}

.purposeSection p,
.contentsSection p,
.assemblySection p,
.exampleSection p,
.accessSection p,
.outputSection p {
  color: #536f87 !important;
  -webkit-text-fill-color: #536f87 !important;
}

.purposeSection .goldEyebrow,
.assemblySection .goldEyebrow,
.exampleSection .goldEyebrow,
.accessSection .goldEyebrow {
  color: #b47c12 !important;
  -webkit-text-fill-color: #b47c12 !important;
}

.contentsSection .blueDarkEyebrow,
.outputSection .blueDarkEyebrow {
  color: #147fd8 !important;
  -webkit-text-fill-color: #147fd8 !important;
}


/* ==========================================================
   RESPONSIVE
========================================================== */

@media (max-width: 1100px) {

  .heroLayout,
  .sectionIntro,
  .sectionIntroDark,
  .outputGrid {
    grid-template-columns: 1fr;
  }

  .heroVisual {
    width: min(100%, 680px);

    justify-self: center;
  }

  .purposeFlow,
  .assemblyFlow {
    grid-template-columns: 1fr;

    gap: 13px;
  }

  .flowArrow,
  .assemblyArrow {
    transform: rotate(90deg);

    margin: 10px auto;
  }

  .contentsGrid,
  .accessGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .valueGrid {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }

  .exampleDetails {
    grid-template-columns:
      repeat(2, minmax(0, 1fr));
  }
}


@media (max-width: 720px) {

  .shell {
    width: min(100% - 30px, 1180px);
  }

  .hero,
  .purposeSection,
  .contentsSection,
  .assemblySection,
  .exampleSection,
  .accessSection,
  .valueSection,
  .outputSection {
    padding-top: 72px;
    padding-bottom: 76px;
  }

  .heroCopy h1 {
    font-size: 43px;
  }

  .contentsGrid,
  .accessGrid,
  .valueGrid,
  .exampleDetails {
    grid-template-columns: 1fr;
  }

  .exampleHeader {
    align-items: flex-start;

    flex-direction: column;
  }
}
